---
/**
 * ResourceCard — one entry in a ResourceGrid. Links to the resource detail
 * page. Shows the category, the resource-type tag, title, excerpt, and meta.
 */
import Badge from "~/components/ui/Badge.astro";
import { RESOURCE_TYPES, resourceHref, resourceImage, type ResourceEntry } from "~/lib/resources";
import { IconArrowRight } from "@tabler/icons-react";

interface Props {
  entry: ResourceEntry;
}
const { entry } = Astro.props as Props;
const d = entry.data;
const href = resourceHref(d);
const typeMeta = RESOURCE_TYPES[d.resource_type];
const thumb = d.images?.thumbnail || resourceImage(d, "thumbnail");
---

<a
  href={href}
  class="group flex h-full flex-col overflow-hidden rounded-2xl bg-[color:var(--color-bg-alt)] ring-1 ring-inset ring-[color:var(--color-rule)] transition-all hover:-translate-y-0.5 hover:ring-[color:var(--color-mint-400)]/60 hover:shadow-[0_24px_48px_-30px_rgba(10,22,40,0.35)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-brand)] focus-visible:ring-offset-2"
>
  <img
    src={thumb}
    alt=""
    width="600"
    height="400"
    loading="lazy"
    decoding="async"
    class="aspect-[3/2] w-full object-cover"
  />
  <div class="flex flex-1 flex-col p-7">
  <div class="mb-4 flex flex-wrap items-center gap-2">
    <Badge tone="brand" variant="soft" size="sm" uppercase>{d.category}</Badge>
    <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">
      {typeMeta.singular}
    </span>
  </div>
  <h3 class="font-display text-xl font-bold leading-snug tracking-tight text-[color:var(--color-ink)]">
    {d.title}
  </h3>
  <p class="mt-3 flex-1 text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">{d.excerpt}</p>
  <div class="mt-5 flex items-center justify-between">
    {d.read_time && (
      <span class="text-xs font-medium text-[color:var(--color-ink-muted)]">{d.read_time} read</span>
    )}
    <span class="inline-flex items-center gap-1.5 text-sm font-bold text-[color:var(--color-brand-pressed)] transition-transform group-hover:translate-x-0.5">
      Read
      <IconArrowRight size={15} stroke={2.5} />
    </span>
  </div>
  </div>
</a>
