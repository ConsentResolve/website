---
// Site-wide "See it live" launcher: a prominent edge tab (desktop) / floating pill (mobile)
// that opens the interactive Live Demo (/demo/sample/) in a NEW WINDOW. It sends people
// straight to the real product demo rather than a curated in-page version. Suppressed on the
// /demo/* pages themselves via the BaseLayout `demoWidget` prop.
const DEMO = "/demo/sample/";
---
<div class="cr-dw">
  <!-- Desktop edge tab -->
  <a class="cr-dw-tab" href={DEMO} target="_blank" rel="noopener" data-demo-launch aria-label="See the live demo (opens in a new tab)">
    <span class="cr-dw-dot" aria-hidden="true"></span>
    <span class="cr-dw-tab-label">See it live</span>
  </a>

  <!-- Mobile pill -->
  <a class="cr-dw-pill" href={DEMO} target="_blank" rel="noopener" data-demo-launch aria-label="See the live demo (opens in a new tab)">
    <span class="cr-dw-dot" aria-hidden="true"></span> Live demo
  </a>
</div>

<style>
  .cr-dw { --dw-navy: var(--color-navy-900, #0A1628); --dw-mint: var(--color-brand, #00E5A0); }

  /* Desktop edge tab — 2× the previous size */
  .cr-dw-tab {
    position: fixed; right: 0; top: 50%; transform: translateY(-50%);
    z-index: 60; display: inline-flex; align-items: center; gap: 14px;
    padding: 26px 18px; text-decoration: none;
    background: var(--dw-navy); color: #fff;
    border-radius: 18px 0 0 18px; box-shadow: -8px 10px 32px rgba(10,22,40,.34);
    writing-mode: vertical-rl; text-orientation: mixed;
    font: 700 20px/1 var(--font-sans, system-ui); letter-spacing: .01em;
    transition: transform .25s cubic-bezier(.22,1,.36,1), background .2s, box-shadow .2s;
  }
  .cr-dw-tab:hover { background: #12233d; transform: translateY(-50%) translateX(-4px); box-shadow: -12px 12px 40px rgba(10,22,40,.4); }
  .cr-dw-tab:focus-visible { outline: 3px solid var(--dw-mint); outline-offset: 2px; }
  .cr-dw-tab-label { rotate: 180deg; }

  .cr-dw-dot {
    width: 13px; height: 13px; border-radius: 50%; background: var(--dw-mint); flex: none;
    box-shadow: 0 0 0 0 rgba(0,229,160,.6); animation: cr-dw-pulse 2.4s infinite;
  }
  @keyframes cr-dw-pulse { 0%{box-shadow:0 0 0 0 rgba(0,229,160,.55)} 70%{box-shadow:0 0 0 12px rgba(0,229,160,0)} 100%{box-shadow:0 0 0 0 rgba(0,229,160,0)} }

  .cr-dw-pill { display: none; }
  @media (max-width: 640px) {
    .cr-dw-tab { display: none; }
    .cr-dw-pill {
      display: inline-flex; align-items: center; gap: 9px; position: fixed; left: 14px; bottom: 84px; z-index: 60;
      padding: 14px 20px; text-decoration: none; border-radius: 999px; background: var(--dw-navy); color: #fff;
      font: 700 16px var(--font-sans, system-ui); box-shadow: 0 8px 22px rgba(10,22,40,.32);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cr-dw-tab { transition: none !important; }
    .cr-dw-dot { animation: none !important; }
  }
</style>

<script>
  function initDemoLaunch() {
    document.querySelectorAll<HTMLElement>("[data-demo-launch]").forEach((a) => {
      if (a.dataset.b) return; a.dataset.b = "1";
      a.addEventListener("click", () => {
        try { (window as any).gtag?.("event", "live_demo_click", { ref: new URLSearchParams(location.search).get("ref") || "" }); } catch (_) {}
      });
    });
  }
  initDemoLaunch();
  document.addEventListener("astro:page-load", initDemoLaunch);
</script>
