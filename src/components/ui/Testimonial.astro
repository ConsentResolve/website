---
import { IconQuote, IconStarFilled } from "@tabler/icons-react";

interface Props {
  quote: string;
  name: string;
  role?: string;
  company?: string;
  avatarSrc?: string;
  rating?: number; // 1-5
  variant?: "card" | "compact" | "dark" | "minimal";
}
const { quote, name, role, company, avatarSrc, rating, variant = "card" } = Astro.props as Props;
const initials = name.split(" ").map((s) => s[0]).slice(0, 2).join("").toUpperCase();
---

{variant === "card" && (
  <figure class="rounded-2xl bg-[color:var(--color-bg-alt)] p-7 ring-1 ring-inset ring-[color:var(--color-rule)]">
    <IconQuote size={22} stroke={1.5} color="var(--color-brand)" className="mb-4 opacity-70" />
    {rating && (
      <div class="mb-3 flex gap-0.5">
        {Array.from({ length: 5 }).map((_, i) => (
          <IconStarFilled size={14} className={i < rating ? "text-amber-400" : "text-[#e6e6e6]"} />
        ))}
      </div>
    )}
    <blockquote class="font-display text-[17px] leading-snug text-[color:var(--color-ink)]">{quote}</blockquote>
    <figcaption class="mt-5 flex items-center gap-3">
      {avatarSrc ? (
        <img src={avatarSrc} alt="" class="size-10 rounded-full object-cover" loading="lazy" />
      ) : (
        <div class="flex size-10 items-center justify-center rounded-full bg-[color:var(--color-navy-900)] font-bold text-[color:var(--color-mint-400)]">{initials}</div>
      )}
      <div>
        <div class="font-semibold text-[color:var(--color-ink)]">{name}</div>
        {(role || company) && (
          <div class="text-sm text-[color:var(--color-ink-muted)]">
            {role}{role && company && " · "}{company}
          </div>
        )}
      </div>
    </figcaption>
  </figure>
)}

{variant === "compact" && (
  <figure class="flex items-start gap-4">
    {avatarSrc ? (
      <img src={avatarSrc} alt="" class="size-12 shrink-0 rounded-full object-cover" loading="lazy" />
    ) : (
      <div class="flex size-12 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-navy-900)] font-bold text-[color:var(--color-mint-400)]">{initials}</div>
    )}
    <div>
      <blockquote class="text-[15px] leading-relaxed text-[color:var(--color-ink)]">"{quote}"</blockquote>
      <figcaption class="mt-2 text-sm text-[color:var(--color-ink-muted)]">
        <span class="font-semibold text-[color:var(--color-ink-2)]">{name}</span>
        {(role || company) && <>, {role}{role && company && " · "}{company}</>}
      </figcaption>
    </div>
  </figure>
)}

{variant === "dark" && (
  <figure class="rounded-2xl bg-[color:var(--color-navy-900)] p-8 text-white">
    <IconQuote size={28} stroke={1.5} color="#00E5A0" className="mb-4" />
    <blockquote class="font-display text-2xl leading-tight">{quote}</blockquote>
    <figcaption class="mt-6 flex items-center gap-3">
      {avatarSrc ? (
        <img src={avatarSrc} alt="" class="size-10 rounded-full object-cover ring-2 ring-[color:var(--color-mint-400)]/30" loading="lazy" />
      ) : (
        <div class="flex size-10 items-center justify-center rounded-full bg-[color:var(--color-mint-400)] font-bold text-[color:var(--color-navy-900)]">{initials}</div>
      )}
      <div>
        <div class="font-semibold">{name}</div>
        {(role || company) && <div class="text-sm text-slate-400">{role}{role && company && " · "}{company}</div>}
      </div>
    </figcaption>
  </figure>
)}

{variant === "minimal" && (
  <figure>
    <blockquote class="font-display text-2xl leading-tight text-[color:var(--color-ink)]">
      "{quote}"
    </blockquote>
    <figcaption class="mt-4 text-sm">
      <span class="font-semibold text-[color:var(--color-ink-2)]">— {name}</span>
      {(role || company) && <span class="text-[color:var(--color-ink-muted)]">, {role}{role && company && " · "}{company}</span>}
    </figcaption>
  </figure>
)}
