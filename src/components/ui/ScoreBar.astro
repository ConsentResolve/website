---
interface Props {
  value: number; // 0-100
  label?: string;
  size?: "sm" | "md";
  showValue?: boolean;
}
const { value, label, size = "md", showValue = true } = Astro.props as Props;
const v = Math.max(0, Math.min(100, value));
// Color zones
const color =
  v >= 80 ? "#00C080" :    // mint
  v >= 60 ? "#3b82f6" :    // blue (not a brand color, but standard "good")
  v >= 40 ? "#f59e0b" :    // amber
  "#dc2626";               // red
const grade =
  v >= 90 ? "A+" :
  v >= 80 ? "A"  :
  v >= 70 ? "B"  :
  v >= 60 ? "C"  :
  v >= 40 ? "D"  : "F";
const trackH = size === "sm" ? "h-1.5" : "h-2";
---

<div class="w-full">
  {(label || showValue) && (
    <div class="mb-1.5 flex items-baseline justify-between gap-3 text-xs">
      {label && <span class="font-medium text-[color:var(--color-ink-2)]">{label}</span>}
      {showValue && (
        <span class="flex items-baseline gap-1.5">
          <span class="font-mono text-sm font-bold tabular-nums text-[color:var(--color-ink)]">{v}</span>
          <span class="font-mono text-[10px] font-semibold uppercase tracking-[0.14em]" style={`color:${color}`}>{grade}</span>
        </span>
      )}
    </div>
  )}
  <div class:list={["relative w-full overflow-hidden rounded-full bg-[color:var(--color-rule)]", trackH]}>
    <div
      class:list={["rounded-full transition-[width] duration-700", trackH]}
      style={`width:${v}%; background:${color}`}
    ></div>
  </div>
</div>
