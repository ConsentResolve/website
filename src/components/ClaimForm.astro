---
// Lean 2-step "claim your 50" form (CRO pass).
// Step 1: website (validated + trade auto-detected) + name + email (+ optional phone)
//         + CONSENT stack + Turnstile → captures the lead & consent, then reveals:
// Step 2: Cal.com booking (prefilled). The Google Ads "Book appointment" conversion fires
//         on Cal's bookingSuccessful (accurate), a GA lead fires on step-1 capture.
import { SMS_CONSENT_DISCLOSURE } from "../../worker/_lib/sms-consent.js";
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const CAL_LINK = import.meta.env.PUBLIC_CAL_LINK || "aaron-phillips-xl2cpq/30min";
const inp = "w-full rounded-lg border border-[color:var(--color-rule)] bg-white px-3.5 py-3 text-[15px] text-[color:var(--color-ink)] outline-none transition focus:border-[color:var(--color-brand)] focus:ring-2 focus:ring-[color:var(--color-brand-soft)]";
---
<div class="cr-claim rounded-2xl border border-[color:var(--color-rule)] bg-[color:var(--color-bg-alt)] p-6 shadow-lg sm:p-7" data-cal-link={CAL_LINK}>
  <h3 class="cr-claim-title font-display text-xl font-bold text-[color:var(--color-ink)]">Claim your 50 leads</h3>
  <p class="cr-claim-sub2 mt-1 text-sm text-[color:var(--color-ink-2)]">Two quick things, then pick a time. Takes about a minute.</p>

  <form class="cr-claim-form mt-5" novalidate>
    <div aria-hidden="true" style="position:absolute;left:-9999px"><input type="text" name="hp" tabindex="-1" autocomplete="off" /></div>

    <!-- Step 1 — everything we need, on one screen -->
    <div data-step="1" class="space-y-4">
      <label class="block">
        <span class="mb-1.5 block text-sm font-semibold text-[color:var(--color-ink)]">Your website</span>
        <input name="website" type="text" inputmode="url" autocomplete="url" required placeholder="yourshop.com" class={inp} />
        <span class="cr-err-site mt-1.5 hidden text-[13px] font-semibold text-[color:var(--color-danger)]">Type a valid website address (e.g. yourshop.com).</span>
      </label>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block"><span class="mb-1.5 block text-sm font-semibold text-[color:var(--color-ink)]">Your name</span><input name="name" type="text" autocomplete="name" required placeholder="Mike Alvarez" class={inp} /><span class="cr-err-name mt-1.5 hidden text-[13px] font-semibold text-[color:var(--color-danger)]">We need a name for the invite.</span></label>
        <label class="block"><span class="mb-1.5 block text-sm font-semibold text-[color:var(--color-ink)]">Work email</span><input name="email" type="email" autocomplete="email" required placeholder="mike@yourshop.com" class={inp} /><span class="cr-err-email mt-1.5 hidden text-[13px] font-semibold text-[color:var(--color-danger)]">That email doesn't look right — check it once?</span></label>
      </div>

      <div class="space-y-2.5 pt-0.5">
        <label class="flex items-start gap-2.5 text-[13px] text-[color:var(--color-ink-2)]"><input type="checkbox" name="consent_contact" value="1" class="mt-0.5 h-4 w-4 shrink-0 rounded border-[color:var(--color-rule)] text-[color:var(--color-brand)]" /><span>I agree Consent Resolve may email me about my request. No spam, unsubscribe anytime.</span></label>
        <label class="flex items-start gap-2.5 text-[13px] text-[color:var(--color-ink-2)]"><input type="checkbox" name="sms_consent" value="1" class="mt-0.5 h-4 w-4 shrink-0 rounded border-[color:var(--color-rule)] text-[color:var(--color-brand)]" /><span>{SMS_CONSENT_DISCLOSURE} See our <a href="/privacy-policy/" class="underline">Privacy Policy</a> and <a href="/terms/" class="underline">Terms</a>. <span class="text-[color:var(--color-ink-muted)]">(Optional.)</span></span></label>
        <input name="phone" type="hidden" />
        <span class="cr-err-consent hidden text-[13px] font-semibold text-[color:var(--color-danger)]">Please check the email box so we can send you the details.</span>
      </div>

      {siteKey && (<div class="cf-turnstile" data-sitekey={siteKey}></div>)}

      <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-[color:var(--color-brand)] px-5 py-3.5 text-base font-bold text-[color:var(--color-on-brand)] transition-colors hover:bg-[color:var(--color-brand-pressed)] disabled:opacity-60"><span class="cr-claim-btn">See my available times →</span></button>
      <p class="text-center text-[13px] text-[color:var(--color-ink-2)]"><strong class="text-[color:var(--color-ink)]">No card to claim.</strong> First 50 on us, then a flat $7 — cancel anytime.</p>
    </div>

    <!-- Step 2 — Cal.com -->
    <div data-step="2" hidden>
      <div class="cr-claim-cal overflow-y-auto rounded-xl" style="height:520px"></div>
      <p class="mt-3 text-center text-[13px] text-[color:var(--color-ink-2)]">Rather just talk? <a href="tel:+17279999846" class="font-semibold text-[color:var(--color-brand-pressed)]">Call (727) 999-9846</a></p>
    </div>

    <input type="hidden" name="trade" /><input type="hidden" name="segment" value="claim50" />
  </form>
</div>

{siteKey && (<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>)}
<script>
  (function (C:any,A:string,L:string){let p=function(a:any,ar:any){a.q.push(ar)};let d=C.document;C.Cal=C.Cal||function(){let cal=C.Cal;let ar=arguments;if(!cal.loaded){cal.ns={};cal.q=cal.q||[];d.head.appendChild(d.createElement("script")).src=A;cal.loaded=true}if(ar[0]===L){const api:any=function(){p(api,arguments)};const ns=ar[1];api.q=api.q||[];if(typeof ns==="string"){cal.ns[ns]=cal.ns[ns]||api;p(cal.ns[ns],ar);p(cal,["initNamespace",ns])}else p(cal,ar);return}p(cal,ar)}})(window,"https://app.cal.com/embed/embed.js","init");

  function initClaim(){
    document.querySelectorAll<HTMLElement>(".cr-claim").forEach((root)=>{
      if(root.dataset.b) return; root.dataset.b="1";
      const f=root.querySelector<HTMLFormElement>(".cr-claim-form"); if(!f) return;
      const calLink=root.dataset.calLink||"";
      const $=(s:string)=>root.querySelector<HTMLElement>(s);
      const el=(n:string)=>f.elements.namedItem(n) as HTMLInputElement;
      const err=(cls:string,on:boolean)=>{ const e=root.querySelector(cls); if(e) e.classList.toggle("hidden",!on); };

      f.addEventListener("submit",async(e)=>{
        e.preventDefault(); let ok=true;
        const raw=el("website").value.trim().replace(/^https?:\/\//i,"").replace(/\/.*$/,"");
        if(!/^[a-z0-9-]+(\.[a-z0-9-]+)+$/i.test(raw)){ err(".cr-err-site",true); ok=false; } else { err(".cr-err-site",false); el("website").value=raw; }
        if(!el("name").value.trim()){ err(".cr-err-name",true); ok=false; } else err(".cr-err-name",false);
        if(!/^[^@\s]+@[^@\s]+\.[a-z]{2,}$/i.test(el("email").value)){ err(".cr-err-email",true); ok=false; } else err(".cr-err-email",false);
        if(!el("consent_contact").checked){ err(".cr-err-consent",true); ok=false; } else err(".cr-err-consent",false);
        if(!ok) return;

        const btn=f.querySelector<HTMLButtonElement>('[type="submit"]'); const lbl=root.querySelector(".cr-claim-btn");
        if(btn) btn.disabled=true; if(lbl) lbl.textContent="Finding your times…";

        // domain validation + trade auto-detect (non-blocking on trade; blocks on unreachable)
        let look:any={};
        try { const r=await fetch("/api/trade-lookup?domain="+encodeURIComponent(raw)); look=await r.json(); } catch(_){}
        if(look && look.ok && look.reachable===false){
          const s=root.querySelector(".cr-err-site"); if(s){ s.textContent="We couldn't reach that site — check the address?"; s.classList.remove("hidden"); }
          if(btn) btn.disabled=false; if(lbl) lbl.textContent="See my available times →"; return;
        }
        el("trade").value=(look && look.trade)||"";

        const payload:Record<string,unknown>={ offer:"FIRST50" }; new FormData(f).forEach((v,k)=>payload[k]=v);
        payload.turnstileToken=(new FormData(f).get("cf-turnstile-response") as string)||"";
        try { await fetch("/api/claim-50",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)}); } catch(_){}
        try{ (window as any).gtag?.("event","generate_lead",{method:"claim50",trade:el("trade").value||"unknown",ref:new URLSearchParams(location.search).get("ref")||""}); }catch(_){}

        const box=$(".cr-claim-cal"); const Cal=(window as any).Cal;
        if(calLink && box && Cal){
          if(!box.id) box.id="cr-claim-cal-el";
          Cal("init",{origin:"https://cal.com"});
          Cal("ui",{hideEventTypeDetails:true,layout:"column_view",theme:"light"});
          Cal("inline",{elementOrSelector:"#"+box.id,calLink,config:{name:el("name").value,email:el("email").value}});
          // Accurate conversion: fire the Google Ads booking conversion only when they actually book.
          Cal("on",{action:"bookingSuccessful",callback:()=>{ try{ (window as any).gtag?.("event","book_meeting",{method:"claim50",trade:el("trade").value||"unknown"}); }catch(_){} }});
        }
        f.querySelector<HTMLElement>('[data-step="1"]')!.hidden=true;
        f.querySelector<HTMLElement>('[data-step="2"]')!.hidden=false;
        const t=root.querySelector(".cr-claim-title"); if(t) (t as HTMLElement).style.display="none";
        const sub=root.querySelector(".cr-claim-sub2"); if(sub) (sub as HTMLElement).style.display="none";
        root.scrollIntoView({block:"start",behavior:"smooth"});
      });
    });
  }
  initClaim();
  document.addEventListener("astro:page-load",initClaim);
</script>
