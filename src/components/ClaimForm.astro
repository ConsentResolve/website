---
// Multi-step "claim your 50" lead form, on the site design system.
// Step 1: website (validated + trade auto-detected via /api/trade-lookup) + CONSENT stack
//         + Cloudflare Turnstile. Step 2: monthly traffic (trade already known).
// Step 3: estimate + name/email/phone. Step 4: Cal.com booking.
// Submits to /api/claim-50, records email + SMS (PEWC) consent, fires the Google Ads
// "Book appointment" conversion on-page, then reveals Cal.com.
import { SMS_CONSENT_DISCLOSURE } from "../../worker/_lib/sms-consent.js";
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const CAL_LINK = import.meta.env.PUBLIC_CAL_LINK || "aaron-phillips-xl2cpq/30min";
const inp = "w-full rounded-lg border border-[color:var(--color-rule)] bg-white px-3.5 py-3 text-[15px] text-[color:var(--color-ink)] outline-none transition focus:border-[color:var(--color-brand)] focus:ring-2 focus:ring-[color:var(--color-brand-soft)]";
const TRAFFIC = [["400","Under 500","just getting going"],["1200","500–2,000","steady"],["3500","2,000–5,000","busy"],["8000","5,000+","running ads hard"]];
---
<div class="cr-claim rounded-2xl border border-[color:var(--color-rule)] bg-[color:var(--color-bg-alt)] p-6 shadow-lg sm:p-7" data-cal-link={CAL_LINK}>
  <div class="flex items-baseline justify-between gap-3">
    <span class="cr-claim-title font-display text-lg font-bold text-[color:var(--color-ink)]">Where should we look?</span>
    <span class="cr-claim-stepn font-mono text-[11px] uppercase tracking-[0.13em] text-[color:var(--color-ink-muted)]" aria-live="polite">Step 1 of 3</span>
  </div>
  <div class="mt-3 h-1 overflow-hidden rounded-full bg-[color:var(--color-rule)]"><div class="cr-claim-prog h-full rounded-full bg-[color:var(--color-brand)] transition-[width] duration-300" style="width:25%"></div></div>

  <form class="cr-claim-form mt-6" novalidate>
    <div aria-hidden="true" style="position:absolute;left:-9999px"><input type="text" name="hp" tabindex="-1" autocomplete="off" /></div>

    <!-- Step 1 — website + consent + turnstile -->
    <div data-step="1" class="space-y-4">
      <label class="block">
        <span class="mb-1.5 block text-sm font-semibold text-[color:var(--color-ink)]">Your website</span>
        <input name="website" type="text" inputmode="url" autocomplete="url" required placeholder="yourshop.com" class={inp} />
        <span class="cr-err-site mt-1.5 hidden text-[13px] font-semibold text-[color:var(--color-danger)]">Type a valid website address (e.g. yourshop.com).</span>
      </label>

      <div class="space-y-2.5">
        <label class="flex items-start gap-2.5 text-[13px] text-[color:var(--color-ink-2)]"><input type="checkbox" name="consent_contact" value="1" class="mt-0.5 h-4 w-4 shrink-0 rounded border-[color:var(--color-rule)] text-[color:var(--color-brand)]" /><span>I agree Consent Resolve may email me about my request. No spam, unsubscribe anytime.</span></label>
        <label class="flex items-start gap-2.5 text-[13px] text-[color:var(--color-ink-2)]"><input type="checkbox" name="sms_consent" value="1" class="mt-0.5 h-4 w-4 shrink-0 rounded border-[color:var(--color-rule)] text-[color:var(--color-brand)]" /><span>{SMS_CONSENT_DISCLOSURE} See our <a href="/privacy-policy/" class="underline">Privacy Policy</a> and <a href="/terms/" class="underline">Terms</a>. <span class="text-[color:var(--color-ink-muted)]">(Optional — add mobile later.)</span></span></label>
        <span class="cr-err-consent hidden text-[13px] font-semibold text-[color:var(--color-danger)]">Please check the email box so we can send your report.</span>
      </div>

      {siteKey && (<div class="cf-turnstile" data-sitekey={siteKey}></div>)}

      <button type="button" data-next="1" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-[color:var(--color-brand)] px-5 py-3.5 text-base font-bold text-[color:var(--color-on-brand)] transition-colors hover:bg-[color:var(--color-brand-pressed)] disabled:opacity-60"><span class="cr-next1-lbl">Claim my 50 leads →</span></button>
      <p class="text-center text-[13px] text-[color:var(--color-ink-2)]"><strong class="text-[color:var(--color-ink)]">No sales script</strong> — the report is yours either way.</p>
    </div>

    <!-- Step 2 — traffic (trade already detected) -->
    <div data-step="2" hidden class="space-y-5">
      <p class="cr-trade-chip hidden rounded-lg bg-[color:var(--color-brand-soft)] px-3 py-2 text-sm font-semibold text-[color:var(--color-brand-pressed)]"></p>
      <div>
        <span class="mb-2 block text-sm font-semibold text-[color:var(--color-ink)]">Roughly how many visit your site a month?</span>
        <div class="grid grid-cols-2 gap-2" data-group="traffic">
          {TRAFFIC.map(([v,l,s]) => (<button type="button" data-v={v} aria-pressed="false" class="cr-opt rounded-lg border border-[color:var(--color-rule)] bg-white px-3 py-3 text-sm font-semibold text-[color:var(--color-ink)] transition hover:border-[color:var(--color-brand)]">{l}<small class="mt-0.5 block font-normal text-xs opacity-70">{s}</small></button>))}
        </div>
      </div>
      <button type="button" data-next="2" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-[color:var(--color-brand)] px-5 py-3.5 text-base font-bold text-[color:var(--color-on-brand)] transition-colors hover:bg-[color:var(--color-brand-pressed)]">Continue →</button>
      <p class="text-center"><button type="button" data-back="1" class="text-sm font-semibold text-[color:var(--color-ink-muted)] underline underline-offset-2">Back</button></p>
    </div>

    <!-- Step 3 — estimate + details -->
    <div data-step="3" hidden class="space-y-4">
      <div class="rounded-xl bg-[color:var(--color-bg-inverse)] p-5 text-[color:var(--color-on-inverse)]">
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-[color:var(--color-brand)]">Your estimate</p>
        <div class="cr-rev-leads mt-1 font-display text-4xl font-extrabold leading-none text-[color:var(--color-brand)]">—</div>
        <p class="mt-2 text-sm leading-relaxed text-[color:var(--color-on-inverse-muted)]">consented homeowners a month you're likely leaving on the table — about <b class="cr-rev-rev text-[color:var(--color-on-inverse)]">—</b> in booked work. Your 50 covers roughly <b class="cr-rev-weeks text-[color:var(--color-on-inverse)]">—</b> of that, before you pay for one.</p>
      </div>
      <label class="block"><span class="mb-1.5 block text-sm font-semibold text-[color:var(--color-ink)]">Your name</span><input name="name" type="text" autocomplete="name" required placeholder="Mike Alvarez" class={inp} /><span class="cr-err-name mt-1.5 hidden text-[13px] font-semibold text-[color:var(--color-danger)]">We need a name for the calendar invite.</span></label>
      <label class="block"><span class="mb-1.5 block text-sm font-semibold text-[color:var(--color-ink)]">Where do we send the report?</span><input name="email" type="email" autocomplete="email" required placeholder="mike@yourshop.com" class={inp} /><span class="cr-err-email mt-1.5 hidden text-[13px] font-semibold text-[color:var(--color-danger)]">That email doesn't look right — check it once?</span></label>
      <label class="block"><span class="mb-1.5 block text-sm font-semibold text-[color:var(--color-ink)]">Mobile <span class="font-normal text-[color:var(--color-ink-muted)]">— so we can text you the link</span></span><input name="phone" type="tel" autocomplete="tel" required placeholder="(555) 123-4567" class={inp} /><span class="cr-err-phone mt-1.5 hidden text-[13px] font-semibold text-[color:var(--color-danger)]">Add a mobile number so we can text the meeting link.</span></label>
      <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-[color:var(--color-brand)] px-5 py-3.5 text-base font-bold text-[color:var(--color-on-brand)] transition-colors hover:bg-[color:var(--color-brand-pressed)] disabled:opacity-60"><span class="cr-claim-sub">Lock in my 50 leads →</span></button>
      <p class="text-center text-[13px] text-[color:var(--color-ink-2)]"><strong class="text-[color:var(--color-ink)]">Next screen picks your time.</strong></p>
      <p class="text-center"><button type="button" data-back="2" class="text-sm font-semibold text-[color:var(--color-ink-muted)] underline underline-offset-2">Back</button></p>
    </div>

    <!-- Step 4 — Cal.com -->
    <div data-step="4" hidden>
      <div class="rounded-xl bg-[color:var(--color-bg-inverse)] p-5 text-center text-[color:var(--color-on-inverse)]">
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-[color:var(--color-brand)]">You're on the list</p>
        <p class="mt-1 text-[15px]">Your 50 are reserved. Grab 15 minutes and we'll install it with you and walk your real numbers.</p>
      </div>
      <div class="cr-claim-cal mt-4" style="min-height:600px"></div>
      <p class="mt-3 text-center text-[13px] text-[color:var(--color-ink-2)]">Rather just talk? <a href="tel:+17272025996" class="font-semibold text-[color:var(--color-brand-pressed)]">Call (727) 202-5996</a></p>
    </div>

    <input type="hidden" name="trade" /><input type="hidden" name="monthly_visitors" /><input type="hidden" name="est_leads" /><input type="hidden" name="est_revenue" /><input type="hidden" name="segment" />
  </form>
</div>

{siteKey && (<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>)}
<script>
  (function (C:any,A:string,L:string){let p=function(a:any,ar:any){a.q.push(ar)};let d=C.document;C.Cal=C.Cal||function(){let cal=C.Cal;let ar=arguments;if(!cal.loaded){cal.ns={};cal.q=cal.q||[];d.head.appendChild(d.createElement("script")).src=A;cal.loaded=true}if(ar[0]===L){const api:any=function(){p(api,arguments)};const ns=ar[1];api.q=api.q||[];if(typeof ns==="string"){cal.ns[ns]=cal.ns[ns]||api;p(cal.ns[ns],ar);p(cal,["initNamespace",ns])}else p(cal,ar);return}p(cal,ar)}})(window,"https://app.cal.com/embed/embed.js","init");

  const CFG = { resolveRate:0.02, closeRate:0.10, ticket:850, freeLeads:50 };
  function initClaim(){
    document.querySelectorAll<HTMLElement>(".cr-claim").forEach((root)=>{
      if(root.dataset.b) return; root.dataset.b="1";
      const f=root.querySelector<HTMLFormElement>(".cr-claim-form"); if(!f) return;
      const calLink=root.dataset.calLink||"";
      const titles=["Where should we look?","One quick thing","Here's your estimate","Pick your 15 minutes"];
      const st={traffic:0};
      const $=(s:string)=>root.querySelector<HTMLElement>(s);
      const el=(n:string)=>f.elements.namedItem(n) as HTMLInputElement;
      function show(n:number){
        f.querySelectorAll<HTMLElement>("[data-step]").forEach(s=>{ (s as HTMLElement).hidden = +s.dataset.step! !== n; });
        ($(".cr-claim-prog") as HTMLElement).style.width=(n/4*100)+"%";
        $(".cr-claim-stepn")!.textContent = n<4 ? "Step "+n+" of 3" : "Almost done";
        $(".cr-claim-title")!.textContent = titles[n-1];
        if(n>1) root.scrollIntoView({block:"center",behavior:"smooth"});
      }
      const err=(cls:string,on:boolean)=>{ const e=root.querySelector(cls); if(e) e.classList.toggle("hidden",!on); };

      // ── Step 1: validate domain + email consent, auto-detect trade, then advance ──
      const next1=f.querySelector<HTMLButtonElement>('[data-next="1"]');
      next1!.addEventListener("click",async()=>{
        const raw=el("website").value.trim().replace(/^https?:\/\//i,"").replace(/\/.*$/,"");
        if(!/^[a-z0-9-]+(\.[a-z0-9-]+)+$/i.test(raw)){ err(".cr-err-site",true); el("website").focus(); return; }
        err(".cr-err-site",false); el("website").value=raw;
        if(!el("consent_contact").checked){ err(".cr-err-consent",true); return; } err(".cr-err-consent",false);
        const lbl=root.querySelector(".cr-next1-lbl"); if(next1) next1.disabled=true; if(lbl) lbl.textContent="Checking your site…";
        let data:any={};
        try { const r=await fetch("/api/trade-lookup?domain="+encodeURIComponent(raw)); data=await r.json(); } catch(_){}
        if(next1) next1.disabled=false; if(lbl) lbl.textContent="Claim my 50 leads →";
        if(data && data.ok && data.reachable===false){
          const e=root.querySelector(".cr-err-site"); if(e){ e.textContent="We couldn't reach that site — check the address?"; e.classList.remove("hidden"); }
          return;
        }
        el("trade").value = (data && data.trade) || "";
        const chip=$(".cr-trade-chip");
        if(chip){ if(data && data.label){ chip.textContent="Great — we'll look at your "+data.label+" site."; chip.classList.remove("hidden"); } else chip.classList.add("hidden"); }
        show(2);
      });

      // ── Step 2: traffic → estimate ──
      f.querySelectorAll<HTMLElement>('[data-group="traffic"] .cr-opt').forEach(b=>{
        b.addEventListener("click",()=>{ b.closest("[data-group]")!.querySelectorAll(".cr-opt").forEach(x=>x.setAttribute("aria-pressed","false")); b.setAttribute("aria-pressed","true"); st.traffic=+b.dataset.v!; el("monthly_visitors").value=b.dataset.v!; });
      });
      f.querySelector('[data-next="2"]')!.addEventListener("click",()=>{
        if(!st.traffic){ alert("Pick your rough monthly traffic so the estimate means something."); return; }
        const leads=Math.max(1,Math.round(st.traffic*CFG.resolveRate));
        const rev=Math.round(leads*CFG.closeRate*CFG.ticket);
        const weeks=Math.round(CFG.freeLeads/leads*4.3);
        $(".cr-rev-leads")!.textContent=String(leads);
        $(".cr-rev-rev")!.textContent="$"+rev.toLocaleString();
        $(".cr-rev-weeks")!.textContent= weeks>=8 ? Math.round(weeks/4.3)+" months" : weeks+" weeks";
        el("est_leads").value=String(leads); el("est_revenue").value=String(rev);
        el("segment").value = st.traffic<500 ? "self_serve_candidate":"sales_qualified";
        show(3);
      });
      f.querySelectorAll<HTMLElement>("[data-back]").forEach(b=>b.addEventListener("click",()=>show(+b.dataset.back!)));

      // ── Step 3: details → submit ──
      f.addEventListener("submit",async(e)=>{
        e.preventDefault(); let ok=true;
        if(!el("name").value.trim()){ err(".cr-err-name",true); ok=false; } else err(".cr-err-name",false);
        if(!/^[^@\s]+@[^@\s]+\.[a-z]{2,}$/i.test(el("email").value)){ err(".cr-err-email",true); ok=false; } else err(".cr-err-email",false);
        if(el("phone").value.replace(/\D/g,"").length<10){ err(".cr-err-phone",true); ok=false; } else err(".cr-err-phone",false);
        if(!ok) return;
        const btn=f.querySelector<HTMLButtonElement>('[type="submit"]'); const lbl=root.querySelector(".cr-claim-sub");
        if(btn) btn.disabled=true; if(lbl) lbl.textContent="Reserving…";
        const payload:Record<string,unknown>={ offer:"FIRST50" }; new FormData(f).forEach((v,k)=>payload[k]=v);
        payload.turnstileToken=(new FormData(f).get("cf-turnstile-response") as string)||"";
        try { await fetch("/api/claim-50",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)}); } catch(_){}
        const g=(window as any).gtag;
        try{ g?.("event","ads_conversion_book_appointment_a",{value:+el("est_revenue").value||0,currency:"USD"}); }catch(_){}
        try{ g?.("event","generate_lead",{method:"claim50"}); }catch(_){}
        const box=$(".cr-claim-cal"); const Cal=(window as any).Cal;
        if(calLink && box && Cal){ if(!box.id) box.id="cr-claim-cal-el"; Cal("init",{origin:"https://cal.com"}); Cal("inline",{elementOrSelector:"#"+box.id,calLink,config:{name:el("name").value,email:el("email").value,theme:"light"}}); }
        show(4);
      });
    });
  }
  initClaim();
  document.addEventListener("astro:page-load",initClaim);
</script>

<style>
  .cr-opt[aria-pressed="true"]{ border-color: var(--color-brand); background: var(--color-brand); color: var(--color-on-brand); }
</style>
