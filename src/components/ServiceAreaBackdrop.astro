---
// Faint topographic / service-area pattern. Pure SVG, no images.
---

<svg
  aria-hidden="true"
  class="pointer-events-none absolute inset-0 h-full w-full"
  style="mask-image: radial-gradient(ellipse at top left, black 25%, transparent 70%);"
  viewBox="0 0 800 600"
  preserveAspectRatio="xMidYMid slice"
>
  <defs>
    <pattern id="dotgrid" x="0" y="0" width="22" height="22" patternUnits="userSpaceOnUse">
      <circle cx="1" cy="1" r="1" fill="rgba(10,22,40,0.18)" />
    </pattern>
  </defs>
  <rect width="800" height="600" fill="url(#dotgrid)" />

  <!-- Stylized topographic contour rings (service area) -->
  <g fill="none" stroke="rgba(10,22,40,0.10)" stroke-width="1.25">
    <ellipse cx="180" cy="220" rx="120" ry="80" />
    <ellipse cx="180" cy="220" rx="170" ry="115" />
    <ellipse cx="180" cy="220" rx="225" ry="155" />
    <ellipse cx="180" cy="220" rx="290" ry="200" />
  </g>

  <!-- Lead pins inside the service area -->
  <g>
    <circle cx="120" cy="180" r="4" fill="#00C080" />
    <circle cx="120" cy="180" r="10" fill="#00C080" opacity="0.18" />
    <circle cx="245" cy="260" r="4" fill="#00C080" />
    <circle cx="245" cy="260" r="10" fill="#00C080" opacity="0.18" />
    <circle cx="90" cy="295" r="4" fill="#00C080" />
    <circle cx="90" cy="295" r="10" fill="#00C080" opacity="0.18" />
    <circle cx="285" cy="180" r="4" fill="#00C080" />
    <circle cx="285" cy="180" r="10" fill="#00C080" opacity="0.18" />
  </g>
</svg>
