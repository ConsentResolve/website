---
/**
 * PrivacyChallenge — the homepage compliance stakes, reframed around the
 * U.S. contractor risk map (June 2026). Replaces the old GDPR/CCPA
 * "Privacy Laws Impact" gauge. Three sourced risk cards — TCPA, CIPA,
 * and Texas enforcement — each linking to /stats/#privacy-enforcement,
 * then the closing line that says how Consent Resolve sidesteps all of it.
 *
 * Voice locked to /style-guide/voice/. Lead with the risk, close with the
 * reassurance — never name vendors, never promise a number to cold-call.
 *
 * Variant prop:
 *   "light" (default) — light section bg, ink copy, mint accent.
 *   "dark"            — dark navy bg with red/amber ambient glows.
 */
import Badge from "~/components/ui/Badge.astro";
import {
  IconShield,
  IconPhoneOff,
  IconWorldX,
  IconGavel,
  IconArrowUpRight,
} from "@tabler/icons-react";

interface Props {
  variant?: "light" | "dark";
}
const { variant = "light" } = Astro.props as Props;

const isDark = variant === "dark";
const sectionClass = isDark ? "section section-dark" : "section bg-[color:var(--color-bg-alt)]";
const headlineClass     = isDark ? "text-white" : "text-[color:var(--color-ink)]";
const accentClass       = isDark ? "text-[color:var(--color-mint-400)]" : "text-[color:var(--color-brand-pressed)]";
const introClass        = isDark ? "text-slate-300" : "text-[color:var(--color-ink-2)]";
const cardBg            = isDark ? "bg-white/[0.03] ring-white/10" : "bg-[color:var(--color-bg)] ring-[color:var(--color-rule)]";
const cardStatClass     = isDark ? "text-white" : "text-[color:var(--color-ink)]";
const cardLabelClass    = isDark ? "text-slate-200" : "text-[color:var(--color-ink)]";
const cardBodyClass     = isDark ? "text-slate-400" : "text-[color:var(--color-ink-2)]";
const sourceClass       = isDark ? "text-slate-400 hover:text-white" : "text-[color:var(--color-ink-muted)] hover:text-[color:var(--color-brand-pressed)]";
const closeBg           = isDark ? "bg-[color:var(--color-brand-soft)]/10 ring-[color:var(--color-brand)]/40" : "bg-[color:var(--color-brand-soft)] ring-[color:var(--color-brand)]/30";
const closeTextClass    = isDark ? "text-slate-100" : "text-[color:var(--color-ink)]";

const risks = [
  {
    Icon: IconPhoneOff,
    tone: "#fca5a5",
    stat: "$500–$1,500",
    label: "TCPA — per illegal call or text",
    body: "Marketing calls and texts to people who never opted in carry a private right of action. Every message is its own claim — and the damages stack.",
    href: "/stats/#privacy-enforcement",
  },
  {
    Icon: IconWorldX,
    tone: "#fca5a5",
    stat: "$5,000",
    label: "CIPA — per tracking violation",
    body: "Non-consented website tracking is treated like wiretapping. Plaintiffs' firms mass-file against ordinary business websites, one demand letter at a time.",
    href: "/stats/#privacy-enforcement",
  },
  {
    Icon: IconGavel,
    tone: "#fbbf24",
    stat: "$1.4B",
    label: "Texas is enforcing",
    body: "Texas settled with Meta for $1.4B and Google for $1.375B over data collected without consent — and filed the first-ever TDPSA suit (Allstate/Arity).",
    href: "/stats/#privacy-enforcement",
  },
];
---

<section class={`${sectionClass} relative overflow-hidden`}>
  {isDark && (
    <>
      <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-red-500/10 blur-[120px]"></div>
      <div aria-hidden="true" class="pointer-events-none absolute -right-32 -bottom-32 size-[420px] rounded-full bg-amber-500/10 blur-[120px]"></div>
    </>
  )}

  <div class="container-content relative">
    <div class="mx-auto mb-12 max-w-2xl text-center">
      <Badge tone="warning" variant="soft" surface={isDark ? "dark" : "light"} size="md" uppercase icon={IconShield}>The real risk</Badge>
      <h2 class:list={["display-2 mt-5", headlineClass]}>
        What actually gets<br/>
        <span class={accentClass}>contractors sued.</span>
      </h2>
      <p class:list={["mt-5 text-lg leading-relaxed", introClass]}>
        It isn't privacy buzzwords. It's how people get reached and how websites get tracked. Three risks do the real damage.
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      {risks.map(({ Icon, tone, stat, label, body, href }) => (
        <div class:list={["flex flex-col rounded-2xl p-6 ring-1 ring-inset", cardBg]}>
          <span class="inline-flex size-10 items-center justify-center rounded-xl bg-red-500/15">
            <Icon size={20} stroke={1.75} color={tone} />
          </span>
          <p class:list={["mt-4 font-display text-3xl font-black tracking-tight tabular-nums", cardStatClass]}>{stat}</p>
          <p class:list={["mt-1 font-display text-sm font-bold tracking-tight", cardLabelClass]}>{label}</p>
          <p class:list={["mt-3 flex-1 text-[13px] leading-relaxed", cardBodyClass]}>{body}</p>
          <a href={href} class:list={["mt-4 inline-flex items-center gap-1 text-[11px] font-bold uppercase tracking-[0.14em]", sourceClass]}>
            See the sources <IconArrowUpRight size={12} stroke={2.5} />
          </a>
        </div>
      ))}
    </div>

    <div class:list={["mx-auto mt-8 max-w-3xl rounded-2xl p-6 ring-1 ring-inset", closeBg]}>
      <p class:list={["text-[15px] leading-relaxed", closeTextClass]}>
        Consent Resolve is built so none of this touches your shop: identification only after a consented yes, an audit receipt on every record, and we never hand you a number to cold-call. Recovered homeowners come back through your funnel and call you.
      </p>
    </div>
  </div>
</section>
