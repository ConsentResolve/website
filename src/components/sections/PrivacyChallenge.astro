---
/**
 * PrivacyChallenge — dark problem-framing section that explains the
 * regulatory reality (GDPR / CCPA require consent) and the cost of
 * getting it wrong. Pairs a stylized "Privacy Laws Impact" dashboard
 * mockup on the left with prose + risk-callout on the right.
 *
 * Different intent from ComplianceBand:
 *   ComplianceBand    — reassurance ("Legal by default. Receipts for
 *                       everything.") — light bg, illustration right.
 *   PrivacyChallenge  — stakes ("Privacy laws make tracking harder.
 *                       Here's what's at risk.") — dark bg, mockup left.
 *
 * Currently wired only on / (homepage). Sitewide promotion to come
 * after the user iterates.
 */
import Badge from "~/components/ui/Badge.astro";
import { IconShield, IconAlertTriangle, IconWorld, IconLock } from "@tabler/icons-react";
---

<section class="section section-dark relative overflow-hidden">
  <!-- Ambient red/orange glow to underscore the risk framing -->
  <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-red-500/10 blur-[120px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -right-32 -bottom-32 size-[420px] rounded-full bg-amber-500/10 blur-[120px]"></div>

  <div class="container-content relative">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_1fr]">

      <!-- =============== LEFT: privacy-laws dashboard mockup ============== -->
      <div class="order-2 lg:order-1">
        <div class="relative rounded-2xl bg-[color:var(--color-navy-900)] p-5 ring-1 ring-inset ring-white/10 shadow-[0_30px_60px_-30px_rgba(0,0,0,0.6)]">
          <!-- Window header — traffic-light dots -->
          <div class="mb-5 flex items-center justify-between">
            <p class="font-display text-sm font-bold tracking-tight text-white">Privacy Laws Impact</p>
            <div class="flex items-center gap-1.5">
              <span class="size-2.5 rounded-full bg-red-500/80"></span>
              <span class="size-2.5 rounded-full bg-amber-400/80"></span>
              <span class="size-2.5 rounded-full bg-emerald-400/80"></span>
            </div>
          </div>

          <!-- Active alert -->
          <div class="rounded-xl bg-red-500/10 p-4 ring-1 ring-inset ring-red-500/30">
            <div class="flex items-start gap-2.5">
              <IconAlertTriangle size={18} stroke={2} color="#fca5a5" class="mt-0.5 shrink-0" />
              <div>
                <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-red-300">GDPR / CCPA active</p>
                <p class="mt-1 text-[12px] text-slate-400">Consent required for tracking</p>
              </div>
            </div>
          </div>

          <!-- Two visitor jurisdiction cards -->
          <div class="mt-3 grid grid-cols-2 gap-3">
            <div class="rounded-xl bg-white/[0.04] p-4 ring-1 ring-inset ring-white/10">
              <div class="flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-400">
                <IconWorld size={14} stroke={1.75} /> EU Visitors
              </div>
              <p class="mt-2 font-display text-xl font-black tracking-tight text-white">GDPR</p>
              <p class="mt-0.5 text-[11px] text-slate-400">Strict consent</p>
            </div>
            <div class="rounded-xl bg-white/[0.04] p-4 ring-1 ring-inset ring-white/10">
              <div class="flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-400">
                <IconWorld size={14} stroke={1.75} /> CA Visitors
              </div>
              <p class="mt-2 font-display text-xl font-black tracking-tight text-white">CCPA</p>
              <p class="mt-0.5 text-[11px] text-slate-400">Opt-out required</p>
            </div>
          </div>

          <!-- Tracking-allowed bar -->
          <div class="mt-3 rounded-xl bg-white/[0.04] p-4 ring-1 ring-inset ring-white/10">
            <div class="flex items-center justify-between">
              <span class="flex items-center gap-1.5 text-[12px] font-semibold text-slate-300">
                <IconLock size={14} stroke={2} />
                Tracking allowed
              </span>
              <span class="font-display text-sm font-bold text-red-300">28%</span>
            </div>
            <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-white/10">
              <div class="h-full rounded-full bg-red-500" style="width:28%"></div>
            </div>
          </div>

          <!-- Consent-required bar -->
          <div class="mt-3 rounded-xl bg-white/[0.04] p-4 ring-1 ring-inset ring-white/10">
            <div class="flex items-center justify-between">
              <span class="flex items-center gap-1.5 text-[12px] font-semibold text-slate-300">
                <IconShield size={14} stroke={2} />
                Consent required
              </span>
              <span class="font-display text-sm font-bold text-amber-300">72%</span>
            </div>
            <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-white/10">
              <div class="h-full rounded-full bg-amber-500" style="width:72%"></div>
            </div>
          </div>

          <!-- Compliance-risk gauge -->
          <div class="mt-3 rounded-xl bg-red-500/[0.06] p-4 ring-1 ring-inset ring-red-500/30">
            <div class="flex items-center justify-between">
              <span class="text-[12px] font-bold uppercase tracking-[0.14em] text-amber-400">Compliance risk</span>
              <span class="font-display text-sm font-bold text-amber-400">High</span>
            </div>
            <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-white/10">
              <div class="h-full rounded-full bg-gradient-to-r from-amber-400 via-orange-500 to-red-500" style="width:88%"></div>
            </div>
            <p class="mt-2 text-[11px] text-slate-400">Without verified consent</p>
          </div>
        </div>
      </div>

      <!-- =============== RIGHT: copy + risk callout =============== -->
      <div class="order-1 lg:order-2">
        <div class="mb-5"><Badge tone="brand" variant="soft" surface="dark" size="md" uppercase icon={IconShield}>Privacy challenge</Badge></div>
        <h2 class="display-2 text-white">
          Website privacy laws make<br/>
          <span class="text-[color:var(--color-mint-400)]">tracking harder.</span>
        </h2>

        <div class="mt-6 space-y-4 text-[15px] leading-relaxed text-slate-300">
          <p>New privacy rules protect website visitors.</p>
          <p>Laws like <strong class="text-white">GDPR and CCPA</strong> require asking permission first.</p>
          <p>Without proof of consent, you risk fines and damage customer trust.</p>
          <p>That leaves you blind to half your audience while risking penalties. You lose the ability to understand visitor behavior, follow up effectively, or prove you asked permission properly.</p>
        </div>

        <!-- Risk callout card -->
        <div class="mt-8 rounded-2xl bg-white/[0.03] p-5 ring-1 ring-inset ring-white/10">
          <div class="flex items-start gap-3">
            <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-red-500/15">
              <IconShield size={20} stroke={1.75} color="#fca5a5" />
            </span>
            <div>
              <p class="font-display text-base font-bold tracking-tight text-white">Compliance risk</p>
              <p class="mt-1 text-[13px] leading-relaxed text-slate-300">GDPR and CCPA require verifiable consent.</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
