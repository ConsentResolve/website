---
/**
 * FAQ section — canonical site-wide treatment.
 *
 * Dark section background, mint eyebrow, display-2 white headline,
 * accordion sitting on a white card with rounded corners. Used on:
 *   - Homepage (via FAQSection wrapper)
 *   - /how-it-works/
 *   - /faq/
 *   - /pricing/ (Billing FAQ)
 *   - /<trade>-leads/ (per-industry FAQ)
 *   - /features/<slug>/ (per-feature FAQ)
 *
 * Use this primitive whenever you need a faq-shaped Q&A block — the
 * styling is locked here so every FAQ on the site reads the same.
 *
 * The component does NOT emit FAQPage JSON-LD; the parent page should
 * pass faqSchema(items) into its <BaseLayout schema={...}> prop so we
 * keep schema generation explicit at the page level.
 */
import Accordion from "~/components/ui/Accordion.tsx";

export interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  headline: string;
  items: FAQItem[];
  /** Index of the question that's open on first render. -1 to start
   *  with everything collapsed. Defaults to 0 (first open). */
  defaultOpen?: number;
}

const { eyebrow = "Common questions", headline, items, defaultOpen = 0 } = Astro.props as Props;
---

<section class="section section-dark">
  <div class="container-content max-w-3xl">
    <div class="mb-12 text-center">
      <p class="eyebrow mb-5 justify-center" style="color:var(--color-mint-400)">{eyebrow}</p>
      <h2 class="display-2 text-white">{headline}</h2>
    </div>
    <div class="rounded-2xl bg-white p-2">
      <div class="px-5">
        <Accordion client:visible items={items} variant="chevron" defaultOpen={defaultOpen} />
      </div>
    </div>
  </div>
</section>
