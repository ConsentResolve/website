---
/**
 * FAQ section — canonical site-wide treatment.
 *
 * Dark navy band, mint eyebrow, display-2 white headline, and the
 * AccordionLarge primitive (each Q&A row is its own bordered white
 * card on a soft inner panel). Used on:
 *   - Homepage (via FAQSection wrapper)
 *   - /how-it-works/
 *   - /faq/
 *   - /pricing/ (Billing FAQ)
 *   - /<trade>-leads/ (per-industry FAQ)
 *   - /features/<slug>/ (per-feature FAQ)
 *
 * Use this primitive whenever you need a faq-shaped Q&A block — the
 * styling is locked here so every FAQ on the site reads the same.
 *
 * The component does NOT emit FAQPage JSON-LD; the parent page should
 * pass faqSchema(items) into its <BaseLayout schema={...}> prop so we
 * keep schema generation explicit at the page level.
 */
import AccordionLarge from "~/components/ui/AccordionLarge.tsx";
import Badge from "~/components/ui/Badge.astro";

export interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  headline: string;
  items: FAQItem[];
  /** Index of the question that's open on first render. -1 to start
   *  with everything collapsed. Defaults to 0 (first open). */
  defaultOpen?: number;
}

const { eyebrow = "Common questions", headline, items, defaultOpen = 0 } = Astro.props as Props;
---

<section class="section section-dark">
  <div class="container-content max-w-4xl">
    <div class="mb-14 text-center">
      <div class="mb-6 flex justify-center"><Badge tone="brand" variant="soft" surface="dark" size="md" uppercase>{eyebrow}</Badge></div>
      <h2 class="display-2 text-white">{headline}</h2>
    </div>
    <div class="rounded-3xl bg-[color:var(--color-bg-alt)] p-5 ring-1 ring-inset ring-white/10 shadow-[0_30px_60px_-30px_rgba(10,22,40,0.6)]">
      <AccordionLarge client:visible items={items} defaultOpen={defaultOpen} />
    </div>
  </div>
</section>
