---
const trades = [
  { icon: "plumbing", label: "Plumbers" },
  { icon: "roofing", label: "Roofers" },
  { icon: "hvac", label: "HVAC" },
  { icon: "electrical_services", label: "Electricians" },
  { icon: "format_paint", label: "Painters" },
  { icon: "grass", label: "Lawn Care" },
  { icon: "handyman", label: "Handymen" },
  { icon: "cleaning_services", label: "House Cleaning" },
  { icon: "pest_control", label: "Pest Control" },
  { icon: "garage", label: "Garage Doors" },
  { icon: "home_repair_service", label: "Appliance Repair" },
  { icon: "key", label: "Locksmiths" },
  { icon: "shower", label: "Power Washing" },
  { icon: "park", label: "Tree Removal" },
  { icon: "engineering", label: "General Contractors" },
  { icon: "carpenter", label: "Deck & Fence" },
];
// duplicate for seamless marquee
const loop = [...trades, ...trades];
---

<section class="relative overflow-hidden border-b border-[color:var(--color-rule)] bg-[color:var(--color-bg-alt)] py-4">
  <div class="container-content flex items-center gap-6">
    <div class="hidden shrink-0 items-center gap-2 md:flex">
      <span class="material-symbols-outlined !text-[18px]">construction</span>
      <span class="text-xs font-bold uppercase tracking-[0.18em] text-[color:var(--color-ink-2)]">
        Built for
      </span>
    </div>
    <div class="trade-marquee relative flex-1 overflow-hidden">
      <div class="trade-track flex items-center gap-8 whitespace-nowrap">
        {loop.map((t) => (
          <div class="flex items-center gap-2 text-[color:var(--color-ink-2)]">
            <span class="material-symbols-outlined !text-[20px]">{t.icon}</span>
            <span class="text-sm font-semibold text-[color:var(--color-ink)]">{t.label}</span>
            <span class="size-1 rounded-full bg-[color:var(--color-rule)]"></span>
          </div>
        ))}
      </div>
      <div class="pointer-events-none absolute inset-y-0 left-0 w-12 bg-gradient-to-r from-[color:var(--color-bg-alt)] to-transparent"></div>
      <div class="pointer-events-none absolute inset-y-0 right-0 w-12 bg-gradient-to-l from-[color:var(--color-bg-alt)] to-transparent"></div>
    </div>
  </div>
</section>

<style>
  .trade-track {
    animation: trade-scroll 50s linear infinite;
    width: max-content;
  }
  .trade-marquee:hover .trade-track {
    animation-play-state: paused;
  }
  @keyframes trade-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .trade-track { animation: none; }
  }
</style>
