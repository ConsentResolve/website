---
import LeadPhone from "~/components/islands/LeadPhone.tsx";
import LeadVisit from "~/components/islands/LeadVisit.tsx";
import Button from "~/components/ui/Button.astro";
import Badge from "~/components/ui/Badge.astro";
import LogoCarousel from "~/components/ui/LogoCarousel.astro";
import { IconArrowRight, IconEye, IconCheck } from "@tabler/icons-react";

const integrations = [
  { name: "Jobber" },
  { name: "Housecall Pro" },
  { name: "ServiceTitan" },
  { name: "HubSpot" },
  { name: "Salesforce" },
  { name: "Slack" },
  { name: "Zapier" },
  { name: "Klaviyo" },
];

interface Props {
  eyebrow?: string;
  title?: string;
  titleAccent?: string;
  subhead?: string;
  ctaLabel?: string;
  ctaHref?: string;
  showPanel?: boolean;
  /** Which visual fills the right-hand panel.
   *   "lead-phone"   — static contact card cycling through homeowners (v1)
   *   "lead-visit"   — anonymous-browse → consent → contact-reveal story
   *   "illustration" — static hand-drawn hero illustration (Recraft asset)
   */
  panelKind?: "lead-phone" | "lead-visit" | "illustration";
  /** When panelKind === "illustration", the asset path under /public. */
  panelSrc?: string;
  /** Alt text for the illustration. */
  panelAlt?: string;
}
const {
  eyebrow = "For ad-buying contractors",
  title = "98 out of 100 visitors leave your site without a word.",
  titleAccent = "Get them back into your funnel.",
  subhead = "You already pay to drive traffic — Google, LSA, Meta, SEO. Consent Resolve recovers the anonymous bounce, with consent, and feeds it back into the retargeting, email, and CRM funnels you already run. Same ad budget, more inbound calls.",
  ctaLabel = "Get Started",
  ctaHref = "https://dashboard.consentresolve.com/register",
  showPanel = true,
  panelKind = "lead-phone",
  panelSrc,
  panelAlt = "",
} = Astro.props as Props;
---

<section class="relative overflow-hidden">
  <!-- Ambient mint glow, top-left -->
  <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/20 blur-[120px]"></div>

  <div class="container-content section relative grid items-center gap-16 lg:grid-cols-[1.05fr_1fr]">
    <div>
      {eyebrow && <div class="mb-7"><Badge tone="brand" variant="soft" size="md" uppercase>{eyebrow}</Badge></div>}
      <h1 class="display-1 mb-7 text-[color:var(--color-ink)]">
        {title}{" "}
        <span class="text-[color:var(--color-brand)] sm:block">{titleAccent}</span>
      </h1>
      <p class="mb-10 max-w-xl text-lg leading-relaxed text-[color:var(--color-ink-2)]">{subhead}</p>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <Button href={ctaHref} variant="primary" size="lg">
          {ctaLabel}
          <IconArrowRight size={18} stroke={2.25} />
        </Button>
        <Button href="/how-it-works/" variant="outline" size="lg">
          <IconEye size={18} stroke={1.75} />
          See how it works
        </Button>
      </div>

      <!-- Trust line -->
      <ul class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-[color:var(--color-ink-2)]">
        <li class="flex items-center gap-1.5">
          <IconCheck size={16} stroke={2.5} color="#00A86E" />
          $7 per recovered lead, never resold
        </li>
        <li class="flex items-center gap-1.5">
          <IconCheck size={16} stroke={2.5} color="#00A86E" />
          Drops into your existing CRM and ad funnels
        </li>
        <li class="flex items-center gap-1.5">
          <IconCheck size={16} stroke={2.5} color="#00A86E" />
          Consent-first, compliant by default
        </li>
      </ul>
    </div>

    {showPanel && (
      <div class="relative">
        {panelKind === "illustration" && panelSrc ? (
          <div class="relative mx-auto w-full max-w-[520px]">
            <!-- Soft floor shadow under the illustration -->
            <div aria-hidden="true" class="pointer-events-none absolute inset-x-10 -bottom-4 h-16 rounded-full bg-[color:var(--color-mint-400)]/20 blur-3xl"></div>
            <img
              src={panelSrc}
              alt={panelAlt}
              width="1024"
              height="1024"
              class="relative mx-auto block h-auto w-full select-none"
              loading="eager"
              decoding="async"
            />
          </div>
        ) : panelKind === "lead-visit" ? (
          <LeadVisit client:visible />
        ) : (
          <LeadPhone client:visible />
        )}
      </div>
    )}
  </div>

  <!-- Integration logo strip -->
  <div class="border-y border-[color:var(--color-rule)] bg-[color:var(--color-bg)]">
    <div class="container-content py-10">
      <LogoCarousel logos={integrations} label="Pushes leads straight to" variant="marquee" speed={45} />
    </div>
  </div>
</section>
