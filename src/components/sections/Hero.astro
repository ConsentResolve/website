---
import LeadPhone from "~/components/islands/LeadPhone.tsx";
import Button from "~/components/ui/Button.astro";
import Badge from "~/components/ui/Badge.astro";
import LogoCarousel from "~/components/ui/LogoCarousel.astro";
import { IconArrowRight, IconEye, IconCheck } from "@tabler/icons-react";

const integrations = [
  { name: "Jobber" },
  { name: "Housecall Pro" },
  { name: "ServiceTitan" },
  { name: "HubSpot" },
  { name: "Salesforce" },
  { name: "Slack" },
  { name: "Zapier" },
  { name: "Klaviyo" },
];

interface Props {
  eyebrow?: string;
  title?: string;
  titleAccent?: string;
  subhead?: string;
  ctaLabel?: string;
  ctaHref?: string;
  showPanel?: boolean;
}
const {
  eyebrow = "Built for home-service pros",
  title = "Most homeowners who visit your site leave without a name.",
  titleAccent = "Now you get their number.",
  subhead = "Unlock the homeowners already shopping your site. When they consent, you get their name and number — warm, and ready for you to call about the quote, the estimate, the job.",
  ctaLabel = "Get Started",
  ctaHref = "https://dashboard.consentresolve.com/register",
  showPanel = true,
} = Astro.props as Props;
---

<section class="relative overflow-hidden">
  <!-- Ambient mint glow, top-left -->
  <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/20 blur-[120px]"></div>

  <div class="container-content section relative grid items-center gap-16 lg:grid-cols-[1.05fr_1fr]">
    <div>
      {eyebrow && <div class="mb-7"><Badge tone="brand" variant="soft" size="md" uppercase>{eyebrow}</Badge></div>}
      <h1 class="display-1 mb-7 text-[color:var(--color-ink)]">
        {title}{" "}
        <span class="text-[color:var(--color-brand)] sm:block">{titleAccent}</span>
      </h1>
      <p class="mb-10 max-w-xl text-lg leading-relaxed text-[color:var(--color-ink-2)]">{subhead}</p>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <Button href={ctaHref} variant="primary" size="lg">
          {ctaLabel}
          <IconArrowRight size={18} stroke={2.25} />
        </Button>
        <Button href="/sample-lead/" variant="outline" size="lg">
          <IconEye size={18} stroke={1.75} />
          See a sample lead
        </Button>
      </div>

      <!-- Trust line -->
      <ul class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-[color:var(--color-ink-2)]">
        <li class="flex items-center gap-1.5">
          <IconCheck size={16} stroke={2.5} color="#00A86E" />
          $7 per lead, never resold
        </li>
        <li class="flex items-center gap-1.5">
          <IconCheck size={16} stroke={2.5} color="#00A86E" />
          Live in 10 minutes
        </li>
        <li class="flex items-center gap-1.5">
          <IconCheck size={16} stroke={2.5} color="#00A86E" />
          Cancel anytime
        </li>
      </ul>
    </div>

    {showPanel && (
      <div class="relative">
        <LeadPhone client:visible />
      </div>
    )}
  </div>

  <!-- Integration logo strip -->
  <div class="border-y border-[color:var(--color-rule)] bg-[color:var(--color-bg)]">
    <div class="container-content py-10">
      <LogoCarousel logos={integrations} label="Pushes leads straight to" variant="marquee" speed={45} />
    </div>
  </div>
</section>
