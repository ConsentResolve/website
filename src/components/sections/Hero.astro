---
import LeadPhone from "~/components/islands/LeadPhone.tsx";
import ServiceAreaBackdrop from "~/components/ServiceAreaBackdrop.astro";
import HexBolt from "~/components/HexBolt.astro";

interface Props {
  eyebrow?: string;
  title?: string;
  titleAccent?: string;
  subhead?: string;
  ctaLabel?: string;
  ctaHref?: string;
  showPanel?: boolean;
}
const {
  eyebrow = "Built for Home Service Pros",
  title = "Most of your website visitors leave without a name.",
  titleAccent = "Now you get the phone number.",
  subhead = "Identify the homeowners shopping your service area — only after they consent. No shared leads, no lawsuits, no surprises.",
  ctaLabel = "Start $10 Trial",
  ctaHref = "/get-started/",
  showPanel = true,
} = Astro.props as Props;
---

<section class="relative overflow-hidden px-6 pb-20 pt-20">
  <ServiceAreaBackdrop />

  <!-- Hex-bolt corner registration marks -->
  <div class="pointer-events-none absolute left-6 top-6 text-[color:var(--color-rule)]"><HexBolt size={18} /></div>
  <div class="pointer-events-none absolute right-6 top-6 text-[color:var(--color-rule)]"><HexBolt size={18} /></div>

  <div class="container-content relative grid items-center gap-12 lg:grid-cols-[1.05fr_1fr]">
    <div class="z-10">
      {eyebrow && (
        <p class="eyebrow mb-6">
          <span class="material-symbols-outlined !text-[14px]">handyman</span>
          {eyebrow}
        </p>
      )}
      <h1 class="mb-6 text-5xl font-black leading-[1.04] tracking-tight md:text-6xl text-[color:var(--color-ink)]">
        {title} <br />
        <span class="italic text-[color:var(--color-brand)]">{titleAccent}</span>
      </h1>
      <p class="mb-8 max-w-xl text-lg text-[color:var(--color-ink-2)]">{subhead}</p>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
        <a href={ctaHref} class="btn-primary px-8 py-4 text-lg glow-hover">
          {ctaLabel}
          <span class="material-symbols-outlined !text-[color:var(--color-on-brand)]">arrow_forward</span>
        </a>
        <a href="/sample-lead/" class="btn-ghost px-6 py-4">
          <span class="material-symbols-outlined !text-[18px]">visibility</span>
          See a sample lead
        </a>
      </div>

      <!-- coverage stat strip -->
      <dl class="mt-10 grid grid-cols-3 gap-6 border-t border-[color:var(--color-rule)] pt-6 max-w-lg">
        <div>
          <dt class="flex items-center gap-1.5 text-xs font-medium uppercase tracking-widest text-[color:var(--color-ink-muted)]">
            <span class="material-symbols-outlined !text-[14px]">construction</span> Trades
          </dt>
          <dd class="mt-1 text-2xl font-black text-[color:var(--color-ink)]">16</dd>
        </div>
        <div>
          <dt class="flex items-center gap-1.5 text-xs font-medium uppercase tracking-widest text-[color:var(--color-ink-muted)]">
            <span class="material-symbols-outlined !text-[14px]">location_city</span> Cities
          </dt>
          <dd class="mt-1 text-2xl font-black text-[color:var(--color-ink)]">35</dd>
        </div>
        <div>
          <dt class="flex items-center gap-1.5 text-xs font-medium uppercase tracking-widest text-[color:var(--color-ink-muted)]">
            <span class="material-symbols-outlined !text-[14px]">map</span> States
          </dt>
          <dd class="mt-1 text-2xl font-black text-[color:var(--color-ink)]">7</dd>
        </div>
      </dl>
    </div>

    {showPanel && (
      <div class="relative z-10">
        <LeadPhone client:visible />
      </div>
    )}
  </div>
</section>
