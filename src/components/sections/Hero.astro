---
import LeadPhone from "~/components/islands/LeadPhone.tsx";
import Button from "~/components/ui/Button.astro";
import AnimatedStat from "~/components/ui/AnimatedStat.tsx";
import LogoCarousel from "~/components/ui/LogoCarousel.astro";
import { IconArrowRight, IconEye, IconTool, IconBuilding, IconMap, IconCoin } from "@tabler/icons-react";

const integrations = [
  { name: "Jobber" },
  { name: "Housecall Pro" },
  { name: "ServiceTitan" },
  { name: "HubSpot" },
  { name: "Salesforce" },
  { name: "Slack" },
  { name: "Zapier" },
  { name: "Klaviyo" },
];

interface Props {
  eyebrow?: string;
  title?: string;
  titleAccent?: string;
  subhead?: string;
  ctaLabel?: string;
  ctaHref?: string;
  showPanel?: boolean;
}
const {
  eyebrow = "Built for Home Service Pros",
  title = "Most of your website visitors leave without a name.",
  titleAccent = "Now you get the phone number.",
  subhead = "Identify the homeowners shopping your service area — only after they consent. No shared leads, no lawsuits, no surprises.",
  ctaLabel = "Start $10 Trial",
  ctaHref = "/get-started/",
  showPanel = true,
} = Astro.props as Props;
---

<section class="relative overflow-hidden">
  <!-- Ambient mint glow, top-left -->
  <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/20 blur-[120px]"></div>

  <div class="container-content section relative grid items-center gap-16 lg:grid-cols-[1.05fr_1fr]">
    <div>
      {eyebrow && <p class="eyebrow mb-7">{eyebrow}</p>}
      <h1 class="display-1 mb-7 text-[color:var(--color-ink)]">
        {title}<br />
        <span class="text-[color:var(--color-brand)]">{titleAccent}</span>
      </h1>
      <p class="mb-10 max-w-xl text-lg leading-relaxed text-[color:var(--color-ink-2)]">{subhead}</p>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <Button href={ctaHref} variant="primary" size="lg">
          {ctaLabel}
          <IconArrowRight size={18} stroke={2.25} />
        </Button>
        <Button href="/sample-lead/" variant="outline" size="lg">
          <IconEye size={18} stroke={1.75} />
          See a sample lead
        </Button>
      </div>
    </div>

    {showPanel && (
      <div class="relative">
        <LeadPhone client:visible />
      </div>
    )}
  </div>

  <!-- Animated trust strip -->
  <div class="border-y border-[color:var(--color-rule)] bg-[color:var(--color-bg-alt)]">
    <div class="container-content grid grid-cols-2 gap-y-8 py-12 md:grid-cols-4">
      <div class="px-6 md:border-r md:border-[color:var(--color-rule)]">
        <AnimatedStat client:visible value={16} label="Trades supported" Icon={IconTool} size="md" />
      </div>
      <div class="px-6 md:border-r md:border-[color:var(--color-rule)]">
        <AnimatedStat client:visible value={35} label="Cities live" Icon={IconBuilding} size="md" />
      </div>
      <div class="px-6 md:border-r md:border-[color:var(--color-rule)]">
        <AnimatedStat client:visible value={7} label="States covered" Icon={IconMap} size="md" />
      </div>
      <div class="px-6">
        <AnimatedStat client:visible value={10} prefix="$" label="To start" Icon={IconCoin} size="md" />
      </div>
    </div>
  </div>

  <!-- Integration logo strip -->
  <div class="border-b border-[color:var(--color-rule)] bg-[color:var(--color-bg)]">
    <div class="container-content py-10">
      <LogoCarousel logos={integrations} label="Pushes leads to" variant="marquee" speed={45} />
    </div>
  </div>
</section>
