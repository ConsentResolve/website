---
import LiveTrafficStream from "~/components/islands/LiveTrafficStream.tsx";

interface Props {
  eyebrow?: string;
  title?: string;
  titleAccent?: string;
  subhead?: string;
  ctaLabel?: string;
  ctaHref?: string;
  showPanel?: boolean;
  showStatStrip?: boolean;
}
const {
  eyebrow = "Built for Home Service Pros",
  title = "Most of your website visitors leave without a name.",
  titleAccent = "Now you get the phone number.",
  subhead = "Identify the homeowners shopping your service area — only after they consent. No shared leads, no lawsuits, no $50 Thumbtack invoices for tire-kickers.",
  ctaLabel = "Start $10 Trial",
  ctaHref = "/get-started/",
  showPanel = true,
  showStatStrip = true,
} = Astro.props as Props;
---

<section class="relative overflow-hidden px-6 pb-16 pt-16">
  <!-- Faint blueprint grid backdrop -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.35]"
    style="background-image: linear-gradient(to right, rgba(10,22,40,0.06) 1px, transparent 1px), linear-gradient(to bottom, rgba(10,22,40,0.06) 1px, transparent 1px); background-size: 28px 28px; mask-image: radial-gradient(ellipse at top left, black 30%, transparent 70%);"
  ></div>

  <div class="container-content relative grid items-center gap-12 lg:grid-cols-2">
    <div class="z-10">
      {eyebrow && (
        <p class="eyebrow mb-6">
          <span class="material-symbols-outlined !text-[14px]">handyman</span>
          {eyebrow}
        </p>
      )}
      <h1 class="mb-6 text-5xl font-black leading-[1.05] tracking-tight md:text-6xl text-[color:var(--color-ink)]">
        {title} <br />
        <span class="italic text-[color:var(--color-brand)]">{titleAccent}</span>
      </h1>
      <p class="mb-8 max-w-xl text-lg text-[color:var(--color-ink-2)]">{subhead}</p>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
        <a href={ctaHref} class="btn-primary px-8 py-4 text-lg glow-hover">
          {ctaLabel}
          <span class="material-symbols-outlined !text-[color:var(--color-on-brand)]">arrow_forward</span>
        </a>
        <a href="/sample-lead/" class="btn-ghost px-6 py-4">
          See a sample lead
        </a>
      </div>

      {showStatStrip && (
        <dl class="mt-10 grid grid-cols-3 gap-6 border-t border-[color:var(--color-rule)] pt-6">
          <div>
            <dt class="text-xs font-medium uppercase tracking-widest text-[color:var(--color-ink-muted)]">Trades</dt>
            <dd class="mt-1 text-2xl font-black text-[color:var(--color-ink)]">16</dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-widest text-[color:var(--color-ink-muted)]">Cities live</dt>
            <dd class="mt-1 text-2xl font-black text-[color:var(--color-ink)]">35</dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-widest text-[color:var(--color-ink-muted)]">States</dt>
            <dd class="mt-1 text-2xl font-black text-[color:var(--color-ink)]">7</dd>
          </div>
        </dl>
      )}

      <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-[color:var(--color-ink-muted)]">
        <span class="flex items-center gap-1.5"><span class="material-symbols-outlined !text-[16px]">verified_user</span> GDPR &amp; CCPA compliant</span>
        <span class="flex items-center gap-1.5"><span class="material-symbols-outlined !text-[16px]">block</span> No shared leads</span>
        <span class="flex items-center gap-1.5"><span class="material-symbols-outlined !text-[16px]">savings</span> Cancel anytime</span>
      </div>
    </div>

    {showPanel && <LiveTrafficStream client:visible />}
  </div>
</section>
