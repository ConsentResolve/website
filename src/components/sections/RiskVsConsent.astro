---
import List from "~/components/ui/List.astro";
import { IconGavel, IconShieldCheck } from "@tabler/icons-react";

const illegal = [
  "Shadow-tracking without user knowledge",
  "Violates GDPR, CCPA, and CPA",
  "No audit trail of where data came from",
  "Risk of class-action settlements",
];
const consent = [
  "Identification only after explicit consent",
  "Iron-clad legal policies via Termageddon",
  "Verifiable audit trail for every reveal",
  "Build trust with future customers",
];
---

<section class="section">
  <div class="container-content">
    <div class="mb-14 text-center">
      <p class="eyebrow mb-5 justify-center">The Choice</p>
      <h2 class="display-2 mx-auto max-w-2xl text-[color:var(--color-ink)]">
        Most visitor-ID tools put your business at risk.
      </h2>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <!-- Illegal -->
      <div class="relative overflow-hidden rounded-2xl bg-[color:var(--color-bg-alt)] p-8" style="box-shadow: 0 0 0 1px rgba(239,68,68,0.18), 0 1px 0 rgba(10,22,40,0.03);">
        <div class="mb-6 flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <div class="flex size-10 items-center justify-center rounded-xl bg-[color:var(--color-danger)]/10">
              <IconGavel size={20} stroke={1.75} color="#EF4444" />
            </div>
            <h3 class="text-lg font-bold tracking-tight text-[color:var(--color-danger)]">The shadow-tracking way</h3>
          </div>
          <span class="rounded-full bg-[color:var(--color-danger)]/10 px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-danger)]">Risky</span>
        </div>
        <List items={illegal} variant="x" tone="danger" />
      </div>

      <!-- Consent -->
      <div class="relative overflow-hidden rounded-2xl bg-[color:var(--color-bg-alt)] p-8" style="box-shadow: 0 0 0 1px rgba(0,192,128,0.25), 0 8px 24px -12px rgba(0,192,128,0.18);">
        <div class="mb-6 flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <div class="flex size-10 items-center justify-center rounded-xl bg-[color:var(--color-brand-soft)]">
              <IconShieldCheck size={20} stroke={1.75} color="#00A86E" />
            </div>
            <h3 class="text-lg font-bold tracking-tight text-[color:var(--color-brand-pressed)]">The consent way</h3>
          </div>
          <span class="rounded-full bg-[color:var(--color-brand-soft)] px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-brand-pressed)]">Compliant</span>
        </div>
        <List items={consent} variant="check" tone="brand" />
      </div>
    </div>
  </div>
</section>
