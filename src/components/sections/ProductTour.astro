---
/**
 * Guided product tour — per-step sticky screens.
 *
 * Each of the five stages renders its OWN screen as a sticky child inside
 * its (tall) step container. As the reader scrolls, the active step's
 * screen sticks to the top while the narrative is read, then naturally
 * scrolls away as the next step takes over. No JS-driven swap — every
 * screen is always in the DOM and visible inside its own step.
 *
 * Pin annotations overlay each screen. A sticky chip nav at the top
 * tracks the active step via IntersectionObserver, purely for visual
 * feedback (the layout works fine without it).
 *
 * Mobile: the sticky CSS only activates at lg+, so the layout
 * gracefully collapses to a normal stack.
 */
import ConsentScreen from "~/components/ui/demo/ConsentScreen.astro";
import VisitorsScreen from "~/components/ui/demo/VisitorsScreen.astro";
import VisitorDetailScreen from "~/components/ui/demo/VisitorDetailScreen.astro";
import IntegrationsScreen from "~/components/ui/demo/IntegrationsScreen.astro";
import DashboardScreen from "~/components/ui/demo/DashboardScreen.astro";
import Badge from "~/components/ui/Badge.astro";
import { IconCheck } from "@tabler/icons-react";

interface Pin { x: number; y: number; label: string }
interface Stage {
  n: string;
  slug: string;
  eyebrow: string;
  headline: string;
  body: string;
  bullets: string[];
  screen: "consent" | "visitors" | "visitor-detail" | "integrations" | "dashboard";
  path: string;
  /** Scale factor — tuned per screen so the key content fits. */
  scale: number;
  pins: Pin[];
}

const stages: Stage[] = [
  {
    n: "01", slug: "install", eyebrow: "Install", path: "consent",
    headline: "Paste one line. Live the same day.",
    body: "Drop the Consent Resolve snippet into your site's <head>. Your existing consent banner does the asking — we wire ourselves in alongside Termageddon-backed policies and start identifying the second a homeowner says yes.",
    bullets: [
      "One universal script — WordPress, Wix, Squarespace, GHL, ServiceTitan",
      "No developer required, no app to install",
      "Termageddon Settings ID auto-configured for legal coverage",
      "Most pros are live within hours of signing up",
    ],
    screen: "consent", scale: 0.68,
    pins: [
      { x: 38, y: 32, label: "One-line install snippet" },
      { x: 45, y: 64, label: "Termageddon Settings ID" },
    ],
  },
  {
    n: "02", slug: "visitors", eyebrow: "Identify", path: "visitors",
    headline: "Real people fill the list in real time.",
    body: "Every consented visitor lands in your Visitors view with a device, location, view count, and time since visit. Search, filter, sort — find exactly the homeowners who matter today.",
    bullets: [
      "Searchable, filterable visitor intelligence",
      "Device + timezone shown at a glance",
      "Visits and pageviews tracked per person",
      "Consent recorded and signed on every record",
    ],
    screen: "visitors", scale: 0.62,
    pins: [
      { x: 22, y: 12, label: "Live visitor count" },
      { x: 38, y: 46, label: "Real names + emails" },
      { x: 76, y: 46, label: "Device + timezone" },
    ],
  },
  {
    n: "03", slug: "lead-detail", eyebrow: "Reach out", path: "visitors/k7…l",
    headline: "Open a lead. Call, text, or push to CRM — right there.",
    body: "Click any visitor for the full lead — animated lead score, contact + enrichment cards, a Termageddon-signed consent record with audit ID, and a timeline of every page they looked at. One tap to act.",
    bullets: [
      "Real name, real mobile, real email",
      "Lead score + engagement, animated on open",
      "Termageddon-signed consent with audit ID",
      "Activity timeline of every page viewed",
    ],
    screen: "visitor-detail", scale: 0.58,
    pins: [
      { x: 24, y: 18, label: "Identity + score" },
      { x: 65, y: 18, label: "Call · Text · Email · CRM" },
      { x: 50, y: 58, label: "Signed consent record" },
    ],
  },
  {
    n: "04", slug: "route", eyebrow: "Route", path: "integrations",
    headline: "Send leads where you already work.",
    body: "Connect Jobber, Housecall Pro, ServiceTitan, HubSpot, GoHighLevel — or anything custom through a webhook. Leads route to the right rep by service area automatically. Nothing falls into the gap between tools.",
    bullets: [
      "One-click connect to common CRMs",
      "Auto-route by rep or service area",
      "Webhook for anything custom",
      "Full lead detail carried over — no double entry",
    ],
    screen: "integrations", scale: 0.62,
    pins: [
      { x: 30, y: 36, label: "One-click connect" },
      { x: 70, y: 62, label: "Status pills per integration" },
    ],
  },
  {
    n: "05", slug: "measure", eyebrow: "Measure", path: "dashboard",
    headline: "See the dollars, every week.",
    body: "The dashboard ties cost per identified lead to the jobs you booked. Trend chart, time-range selector, live visitor feed — and the numbers count up on load so you actually look at them.",
    bullets: [
      "Cost per identified lead",
      "Jobs booked vs leads delivered",
      "Trend chart over your chosen range",
      "Live visitor feed below the metrics",
    ],
    screen: "dashboard", scale: 0.62,
    pins: [
      { x: 30, y: 24, label: "Live metrics" },
      { x: 64, y: 48, label: "Trend chart" },
      { x: 32, y: 84, label: "Real-time visitor feed" },
    ],
  },
];
---

<section class="tour" id="product-tour" aria-label="Guided product tour">
  <div aria-hidden="true" class="tour-glow tour-glow-a"></div>
  <div aria-hidden="true" class="tour-glow tour-glow-b"></div>

  <div class="container-content relative">
    <header class="tour-header">
      <p class="eyebrow mb-5 justify-center">Guided product tour</p>
      <h2 class="display-2 text-[color:var(--color-ink)]">See exactly what you'll be looking at.</h2>
      <p class="mt-5 text-lg leading-relaxed text-[color:var(--color-ink-2)]">
        Five screens in the order you'll use them — from install to the dashboard that proves it paid off.
      </p>
    </header>

    {/* Sticky chip nav */}
    <nav aria-label="Tour stages" class="tour-chipnav">
      <ol>
        {stages.map((s, i) => (
          <li>
            <a
              href={`#tour-${s.slug}`}
              data-chip={s.slug}
              class:list={["tour-chip", i === 0 && "is-active"]}
            >
              <span class="tour-chip-n">{s.n}</span>
              <span class="tour-chip-label">{s.eyebrow}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <ol class="tour-steps">
      {stages.map((stage, i) => (
        <li id={`tour-${stage.slug}`} class="tour-step" data-step={stage.slug}>
          <div class="tour-step-grid">
            {/* Sticky screen column (lg+) — renders once per step, owns its own screen */}
            <div class="tour-screen-col">
              <div class="tour-screen-sticky">
                <div class="tour-frame">
                  <div class="tour-chrome" aria-hidden="true">
                    <span class="tour-chrome-dot" style="background:#FF5F57"></span>
                    <span class="tour-chrome-dot" style="background:#FEBC2E"></span>
                    <span class="tour-chrome-dot" style="background:#28C840"></span>
                    <span class="tour-chrome-url">app.consentresolve.com/{stage.path}</span>
                  </div>
                  <div class="tour-screen" style={`--screen-scale:${stage.scale}`}>
                    <div class="tour-screen-scale">
                      {stage.screen === "consent"        && <ConsentScreen />}
                      {stage.screen === "visitors"       && <VisitorsScreen />}
                      {stage.screen === "visitor-detail" && <VisitorDetailScreen />}
                      {stage.screen === "integrations"   && <IntegrationsScreen />}
                      {stage.screen === "dashboard"      && <DashboardScreen />}
                    </div>
                    {/* Callout pins */}
                    {stage.pins.map((p, pi) => (
                      <span
                        class="tour-pin"
                        style={`left:${p.x}%;top:${p.y}%;--pin-delay:${pi * 110 + 220}ms`}
                      >
                        <span class="tour-pin-dot" aria-hidden="true"></span>
                        <span class="tour-pin-label">{p.label}</span>
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            {/* Narrative column */}
            <div class="tour-narrative">
              <div class="tour-narrative-meta">
                <span class="tour-step-n">{stage.n}</span>
                <Badge tone="brand" variant="soft" size="md" uppercase>{stage.eyebrow}</Badge>
              </div>
              <h3 class="tour-step-title">{stage.headline}</h3>
              <p class="tour-step-body">{stage.body}</p>
              <ul class="tour-step-bullets">
                {stage.bullets.map((b) => (
                  <li>
                    <span class="tour-step-check" aria-hidden="true">
                      <IconCheck size={12} stroke={3} color="var(--color-brand-pressed)" />
                    </span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .tour {
    position: relative;
    overflow: hidden;
    padding-block: 6rem;
    background: var(--color-bg);
  }
  .tour-glow {
    position: absolute;
    width: 620px;
    height: 620px;
    border-radius: 9999px;
    pointer-events: none;
    filter: blur(120px);
  }
  .tour-glow-a { top: -160px; left: -120px;  background: rgba(0, 229, 160, 0.18); }
  .tour-glow-b { bottom: -200px; right: -120px; background: rgba(0, 229, 160, 0.12); }

  .tour-header { max-width: 760px; margin: 0 auto 3rem; text-align: center; }

  /* ── Sticky chip nav ────────────────────────────────── */
  .tour-chipnav {
    position: sticky;
    top: 1rem;
    z-index: 30;
    margin: 0 auto 3.5rem;
    width: fit-content;
    max-width: calc(100% - 1rem);
  }
  .tour-chipnav > ol {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    overflow-x: auto;
    background: var(--color-bg);
    border-radius: 9999px;
    box-shadow:
      0 0 0 1px var(--color-rule),
      0 18px 40px -20px rgba(10, 22, 40, 0.28);
    scrollbar-width: none;
  }
  .tour-chipnav > ol::-webkit-scrollbar { display: none; }
  .tour-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.95rem;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    white-space: nowrap;
    text-decoration: none;
    transition: background-color 0.25s ease, color 0.25s ease;
  }
  .tour-chip-n {
    font-family: var(--font-mono, ui-monospace, monospace);
    color: var(--color-brand-pressed);
  }
  .tour-chip:hover { color: var(--color-ink-2); background: rgba(0, 229, 160, 0.07); }
  .tour-chip.is-active {
    background: var(--color-navy-900);
    color: white;
  }
  .tour-chip.is-active .tour-chip-n { color: var(--color-brand); }

  /* ── Steps ──────────────────────────────────────────── */
  .tour-steps {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .tour-step + .tour-step { margin-top: 2rem; }

  .tour-step-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 1024px) {
    .tour-step {
      /* Tall step so the sticky screen has runway to "stay" while
         the narrative is being read. */
      min-height: 110svh;
    }
    .tour-step-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 4rem;
      align-items: start;
    }
    /* Alternate which side the screen sits on for visual variety */
    .tour-step:nth-child(even) .tour-screen-col   { order: 2; }
    .tour-step:nth-child(even) .tour-narrative    { order: 1; }
  }

  /* ── Screen column — sticky per step ────────────────── */
  .tour-screen-col { position: relative; }
  @media (min-width: 1024px) {
    .tour-screen-sticky {
      position: sticky;
      top: 5.5rem;
    }
  }

  /* Frame */
  .tour-frame {
    position: relative;
    border-radius: 1.25rem;
    overflow: hidden;
    background: var(--color-bg);
    box-shadow:
      0 0 0 1px rgba(10, 22, 40, 0.08),
      0 40px 80px -28px rgba(10, 22, 40, 0.45),
      0 12px 24px -8px rgba(10, 22, 40, 0.22);
    transform: perspective(2400px) rotateY(-3deg) rotateX(2deg);
    transform-origin: center;
    transition: transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .tour-frame:hover { transform: perspective(2400px) rotateY(-1deg) rotateX(1deg); }

  /* Browser chrome */
  .tour-chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.85rem;
    background: linear-gradient(180deg, #fafbfc 0%, #f1f5f9 100%);
    border-bottom: 1px solid rgba(10, 22, 40, 0.08);
  }
  .tour-chrome-dot {
    display: inline-block;
    width: 11px; height: 11px;
    border-radius: 9999px;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.06);
  }
  .tour-chrome-url {
    flex: 1;
    margin: 0 0.6rem;
    text-align: center;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11.5px;
    color: rgba(10, 22, 40, 0.6);
    background: white;
    border: 1px solid rgba(10, 22, 40, 0.06);
    border-radius: 0.5rem;
    padding: 0.32rem 0.7rem;
    max-width: 360px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Screen — fixed 16:10 aspect, content scaled to fit */
  .tour-screen {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-bg);
  }
  .tour-screen-scale {
    width: calc(100% / var(--screen-scale, 0.62));
    height: calc(100% / var(--screen-scale, 0.62));
    transform: scale(var(--screen-scale, 0.62));
    transform-origin: top left;
    pointer-events: none; /* let the page scroll past — these are stills */
  }

  /* Callout pins */
  .tour-pin {
    position: absolute;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    opacity: 0;
    pointer-events: none;
    animation: tour-pin-in 480ms cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
    animation-delay: var(--pin-delay, 0ms);
  }
  @keyframes tour-pin-in {
    from { opacity: 0; transform: translate(-50%, -50%) scale(0.92); }
    to   { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  }
  .tour-pin-dot {
    width: 14px; height: 14px;
    border-radius: 9999px;
    background: var(--color-brand);
    box-shadow:
      0 0 0 4px rgba(0, 229, 160, 0.18),
      0 0 0 8px rgba(0, 229, 160, 0.10),
      0 6px 16px -4px rgba(0, 229, 160, 0.55);
    animation: tour-pin-pulse 2.4s ease-in-out infinite;
    animation-delay: calc(var(--pin-delay, 0ms) + 480ms);
  }
  @keyframes tour-pin-pulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(0, 229, 160, 0.18), 0 0 0 8px rgba(0, 229, 160, 0.10), 0 6px 16px -4px rgba(0, 229, 160, 0.55); }
    50%      { box-shadow: 0 0 0 6px rgba(0, 229, 160, 0.28), 0 0 0 14px rgba(0, 229, 160, 0.06), 0 6px 16px -4px rgba(0, 229, 160, 0.55); }
  }
  .tour-pin-label {
    background: var(--color-navy-900);
    color: white;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.4rem 0.7rem;
    border-radius: 0.5rem;
    white-space: nowrap;
    box-shadow: 0 10px 24px -10px rgba(10, 22, 40, 0.55);
  }

  /* ── Narrative ──────────────────────────────────────── */
  .tour-narrative { padding-top: 0.25rem; }
  @media (min-width: 1024px) {
    .tour-narrative { padding-top: 3rem; }
  }
  .tour-narrative-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
  }
  .tour-step-n {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(48px, 6vw, 80px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    background: linear-gradient(180deg, #00E5A0 0%, #00A86E 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .tour-step-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.625rem, 2.6vw, 2.25rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    margin-bottom: 1rem;
  }
  .tour-step-body {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-2);
    max-width: 38rem;
  }
  .tour-step-bullets {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .tour-step-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-ink-2);
  }
  .tour-step-check {
    margin-top: 2px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px; height: 20px;
    border-radius: 9999px;
    background: var(--color-brand-soft);
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .tour-frame { transform: none; transition: none; }
    .tour-pin { animation: none; opacity: 1; }
    .tour-pin-dot { animation: none; }
  }
</style>

<script>
  (function () {
    const section = document.querySelector<HTMLElement>(".tour");
    if (!section) return;
    const chips = Array.from(section.querySelectorAll<HTMLElement>(".tour-chip"));
    const steps = Array.from(section.querySelectorAll<HTMLElement>(".tour-step"));
    if (!chips.length || !steps.length) return;

    const obs = new IntersectionObserver(
      (entries) => {
        let best: IntersectionObserverEntry | null = null;
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          if (!best || e.intersectionRatio > best.intersectionRatio) best = e;
        }
        if (!best) return;
        const slug = (best.target as HTMLElement).dataset.step;
        chips.forEach((c) => c.classList.toggle("is-active", c.dataset.chip === slug));
      },
      {
        rootMargin: "-35% 0px -45% 0px",
        threshold: [0, 0.25, 0.5, 0.75, 1],
      }
    );
    steps.forEach((s) => obs.observe(s));
  })();
</script>
