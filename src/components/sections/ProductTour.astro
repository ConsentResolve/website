---
/**
 * Guided product tour — section-per-step layout.
 *
 * Five full-width sections, each a 2-column grid on desktop:
 *   - Text column (left): eyebrow + headline + body + 3-bullet checklist
 *   - Screen column (right): browser chrome + scaled-to-fit demo screen
 *
 * No callout pins / hotspot labels — clean read of each screen.
 * Sticky chip nav at the top lets the reader jump directly to any
 * step. Alternating background tints (bg ↔ bg-alt) section to section
 * for vertical rhythm. The screen column collapses below the text on
 * mobile.
 *
 * Per-screen scale tuning lives in the `scale` field — the demo screen
 * renders at native width inside a fixed 16:10 frame with overflow:hidden,
 * so no internal scrollbars.
 */
import ConsentScreen from "~/components/ui/demo/ConsentScreen.astro";
import VisitorsScreen from "~/components/ui/demo/VisitorsScreen.astro";
import VisitorDetailScreen from "~/components/ui/demo/VisitorDetailScreen.astro";
import IntegrationsScreen from "~/components/ui/demo/IntegrationsScreen.astro";
import DashboardScreen from "~/components/ui/demo/DashboardScreen.astro";
import Badge from "~/components/ui/Badge.astro";
import { IconCheck } from "@tabler/icons-react";

interface Stage {
  slug: string;
  eyebrow: string;
  headline: string;
  body: string;
  bullets: string[];
  screen: "consent" | "visitors" | "visitor-detail" | "integrations" | "dashboard";
  path: string;
  /** Scale factor — tuned per screen so its key content fits the frame. */
  scale: number;
}

const stages: Stage[] = [
  {
    slug: "install", eyebrow: "Install", path: "consent",
    headline: "Paste one line. Live in about 10 minutes.",
    body: "Drop the Consent Resolve snippet into your site's <head>. Your existing consent banner does the asking — we wire ourselves in alongside Termageddon-backed policies and start identifying the second a homeowner says yes.",
    bullets: [
      "One universal script — WordPress, Wix, Squarespace, GHL, ServiceTitan",
      "No developer required, no app to install",
      "Most pros are live in about 10 minutes; same day at most",
    ],
    screen: "consent", scale: 0.68,
  },
  {
    slug: "identify", eyebrow: "Identify", path: "visitors",
    headline: "Real people fill the list in real time.",
    body: "Every consented visitor lands in your Visitors view with a device, location, view count, and time since visit. Search, filter, sort — find exactly the homeowners who matter today.",
    bullets: [
      "Searchable, filterable visitor intelligence",
      "Device + timezone shown at a glance",
      "Consent recorded and signed on every record",
    ],
    screen: "visitors", scale: 0.62,
  },
  {
    slug: "review", eyebrow: "Review", path: "visitors/k7…l",
    headline: "Open a recovered visitor — see what they were shopping.",
    body: "Click any recovered visitor for the full record: lead score, contact + enrichment data, a signed, timestamped consent record with audit ID, and a timeline of every page they looked at. The intel that shapes how your funnel re-engages them.",
    bullets: [
      "Consented email + enrichment (name, location where available) on file",
      "Signed, timestamped consent with audit ID",
      "Activity timeline of every page viewed",
    ],
    screen: "visitor-detail", scale: 0.58,
  },
  {
    slug: "feed-funnel", eyebrow: "Feed the funnel", path: "integrations",
    headline: "Drop into the funnel you already run.",
    body: "Recovered visitors flow into your retargeting audiences, your email/SMS sequences, and your CRM — Jobber, Housecall Pro, ServiceTitan, HubSpot, GoHighLevel, or anything custom via webhook. We're an input to your existing marketing machine, not a replacement for it.",
    bullets: [
      "Pushes to retargeting audiences + CRM",
      "One-click connect to common platforms",
      "Webhook for anything custom",
    ],
    screen: "integrations", scale: 0.62,
  },
  {
    slug: "measure", eyebrow: "Measure", path: "dashboard",
    headline: "Watch recovery add up.",
    body: "The dashboard tracks recovered visitors, what's detected and excluded from billing, and the trend over time — so you can tie recovery spend to the jobs your funnel books. The math that matters: same ad budget, more inbound calls, lower blended cost per booked job.",
    bullets: [
      "Recovered + enriched visitor counts",
      "Ad-blocked traffic detected and excluded from billing",
      "Trend chart + live recovery feed",
    ],
    screen: "dashboard", scale: 0.62,
  },
];
---

<section class="tour" id="product-tour" aria-label="Guided product tour">
  <div aria-hidden="true" class="tour-glow tour-glow-a"></div>
  <div aria-hidden="true" class="tour-glow tour-glow-b"></div>

  <div class="container-content relative">
    <header class="tour-header">
      <div class="mb-5 flex justify-center"><Badge tone="brand" variant="soft" size="md" uppercase>Guided product tour</Badge></div>
      <h2 class="display-2 text-[color:var(--color-ink)]">See exactly what you'll be looking at.</h2>
      <p class="mt-5 text-lg leading-relaxed text-[color:var(--color-ink-2)]">
        Five screens, in the order you'll actually use them — from install to the dashboard that proves it paid off.
      </p>
    </header>

    {/* Sticky chip nav — anchor-jump to any step */}
    <nav class="tour-nav" aria-label="Tour stages">
      <ul>
        {stages.map((s) => (
          <li>
            <a href={`#tour-${s.slug}`} class="tour-nav-chip">{s.eyebrow}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  {/* Sections — alternating background tints */}
  {stages.map((stage, i) => (
    <article
      id={`tour-${stage.slug}`}
      class:list={["tour-step", i % 2 === 1 && "tour-step-alt"]}
    >
      <div class="container-content">
        <div class="tour-step-grid">
          {/* Text */}
          <div class="tour-step-text">
            <Badge tone="brand" variant="soft" size="md" uppercase>{stage.eyebrow}</Badge>
            <h3 class="tour-step-title">{stage.headline}</h3>
            <p class="tour-step-body">{stage.body}</p>
            <ul class="tour-step-bullets">
              {stage.bullets.map((b) => (
                <li>
                  <span class="tour-step-check" aria-hidden="true">
                    <IconCheck size={12} stroke={3} color="var(--color-brand-pressed)" />
                  </span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>

          {/* Screen */}
          <div class="tour-step-screen">
            <div class="tour-frame">
              <div class="tour-chrome" aria-hidden="true">
                <span class="tour-chrome-dot" style="background:#FF5F57"></span>
                <span class="tour-chrome-dot" style="background:#FEBC2E"></span>
                <span class="tour-chrome-dot" style="background:#28C840"></span>
                <span class="tour-chrome-url">dashboard.consentresolve.com/{stage.path}</span>
              </div>
              <div class="tour-screen" style={`--screen-scale:${stage.scale}`}>
                <div class="tour-screen-scale">
                  {stage.screen === "consent"        && <ConsentScreen />}
                  {stage.screen === "visitors"       && <VisitorsScreen />}
                  {stage.screen === "visitor-detail" && <VisitorDetailScreen />}
                  {stage.screen === "integrations"   && <IntegrationsScreen />}
                  {stage.screen === "dashboard"      && <DashboardScreen />}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </article>
  ))}
</section>

<style>
  .tour {
    position: relative;
    overflow: hidden;
    background: var(--color-bg);
  }
  .tour-glow {
    position: absolute;
    width: 620px;
    height: 620px;
    border-radius: 9999px;
    pointer-events: none;
    filter: blur(120px);
  }
  .tour-glow-a { top: -160px; left: -120px;  background: rgba(0, 229, 160, 0.18); }
  .tour-glow-b { bottom: -200px; right: -120px; background: rgba(0, 229, 160, 0.12); }

  .tour-header {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    padding-block: 6rem 3rem;
  }

  /* ── Sticky chip nav ────────────────────────────────────────── */
  .tour-nav {
    position: sticky;
    top: 1rem;
    z-index: 30;
    margin: 0 auto;
    width: fit-content;
    max-width: calc(100% - 1rem);
  }
  .tour-nav > ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    overflow-x: auto;
    background: var(--color-bg);
    border-radius: 9999px;
    box-shadow:
      0 0 0 1px var(--color-rule),
      0 18px 40px -20px rgba(10, 22, 40, 0.28);
    scrollbar-width: none;
  }
  .tour-nav > ul::-webkit-scrollbar { display: none; }
  .tour-nav-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1.1rem;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    white-space: nowrap;
    text-decoration: none;
    transition: background-color 0.25s ease, color 0.25s ease;
  }
  .tour-nav-chip:hover {
    color: var(--color-ink-2);
    background: rgba(0, 229, 160, 0.07);
  }
  /* Anchor-target highlight: when the URL hash matches, color the chip */
  .tour-nav-chip:focus {
    outline: none;
    color: var(--color-brand-pressed);
    background: var(--color-brand-soft);
  }

  /* ── Step sections ──────────────────────────────────────────── */
  .tour-step {
    padding-block: 5rem;
    scroll-margin-top: 5rem;
  }
  .tour-step + .tour-step { border-top: 1px solid var(--color-rule); }
  .tour-step-alt { background: var(--color-bg-alt); }

  .tour-step-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .tour-step-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 4rem;
    }
  }

  /* Text column */
  .tour-step-text { max-width: 36rem; }
  .tour-step-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.625rem, 2.8vw, 2.25rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    margin-top: 1.25rem;
    margin-bottom: 1rem;
  }
  .tour-step-body {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-2);
  }
  .tour-step-bullets {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .tour-step-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-ink-2);
  }
  .tour-step-check {
    margin-top: 2px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 9999px;
    background: var(--color-brand-soft);
  }

  /* Screen column */
  .tour-step-screen { position: relative; }
  .tour-frame {
    position: relative;
    border-radius: 1.25rem;
    overflow: hidden;
    background: var(--color-bg);
    box-shadow:
      0 0 0 1px rgba(10, 22, 40, 0.08),
      0 40px 80px -28px rgba(10, 22, 40, 0.45),
      0 12px 24px -8px rgba(10, 22, 40, 0.22);
  }
  .tour-chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.85rem;
    background: linear-gradient(180deg, #fafbfc 0%, #f1f5f9 100%);
    border-bottom: 1px solid rgba(10, 22, 40, 0.08);
  }
  .tour-chrome-dot {
    display: inline-block;
    width: 11px; height: 11px;
    border-radius: 9999px;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.06);
  }
  .tour-chrome-url {
    flex: 1;
    margin: 0 0.6rem;
    text-align: center;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11.5px;
    color: rgba(10, 22, 40, 0.6);
    background: white;
    border: 1px solid rgba(10, 22, 40, 0.06);
    border-radius: 0.5rem;
    padding: 0.32rem 0.7rem;
    max-width: 360px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tour-screen {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-bg);
  }
  .tour-screen-scale {
    width: calc(100% / var(--screen-scale, 0.62));
    height: calc(100% / var(--screen-scale, 0.62));
    transform: scale(var(--screen-scale, 0.62));
    transform-origin: top left;
    pointer-events: none;
  }
</style>
