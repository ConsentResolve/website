---
/**
 * Guided product tour — sticky scroll experience.
 *
 * Layout (lg+): a sticky screen pane on the left holds all five demo
 * screens absolutely-stacked on top of each other; the right column is
 * a narrative scroll-track of five annotation blocks. As the reader
 * scrolls, an IntersectionObserver swaps which screen is `is-active`,
 * crossfading the new one in while callout pins fade in on top of it.
 *
 * Layout (<lg): the sticky behavior collapses to a normal stack with the
 * screen rendered above each annotation — progressive enhancement.
 *
 * No internal scrolling — every screen is rendered at the demo's true
 * width inside a fixed-aspect container, scaled down with CSS transform
 * so the visible portion fits the frame with the right content showing.
 *
 * All annotations and pin positions are driven by the single `stages`
 * array — to retune, edit one block.
 */
import ConsentScreen from "~/components/ui/demo/ConsentScreen.astro";
import VisitorsScreen from "~/components/ui/demo/VisitorsScreen.astro";
import VisitorDetailScreen from "~/components/ui/demo/VisitorDetailScreen.astro";
import IntegrationsScreen from "~/components/ui/demo/IntegrationsScreen.astro";
import DashboardScreen from "~/components/ui/demo/DashboardScreen.astro";
import Badge from "~/components/ui/Badge.astro";
import { IconCheck } from "@tabler/icons-react";

interface Pin { x: number; y: number; label: string }

interface Stage {
  n: string;
  slug: string;
  eyebrow: string;
  headline: string;
  body: string;
  bullets: string[];
  screen: "consent" | "visitors" | "visitor-detail" | "integrations" | "dashboard";
  path: string;
  /** Scale factor — tuned per screen so its key content fits the frame. */
  scale: number;
  /** Callout pins overlaid on the screen (% of the unscaled frame). */
  pins: Pin[];
}

const stages: Stage[] = [
  {
    n: "01", slug: "install", eyebrow: "Install", path: "consent",
    headline: "Paste one line. Live the same day.",
    body: "Drop the Consent Resolve snippet into your site's <head>. Your existing consent banner does the asking — we wire ourselves in alongside Termageddon-backed policies and start identifying the second a homeowner says yes.",
    bullets: [
      "One universal script — WordPress, Wix, Squarespace, GHL, ServiceTitan",
      "No developer required, no app to install",
      "Termageddon Settings ID auto-configured for legal coverage",
      "Most pros are live within hours of signing up",
    ],
    screen: "consent", scale: 0.68,
    pins: [
      { x: 41, y: 28, label: "One-line install snippet" },
      { x: 48, y: 62, label: "Termageddon Settings ID" },
    ],
  },
  {
    n: "02", slug: "visitors", eyebrow: "Identify", path: "visitors",
    headline: "Real people fill the list in real time.",
    body: "Every consented visitor lands in your Visitors view with a device, location, view count, and time since visit. Search, filter, sort — find exactly the homeowners who matter today.",
    bullets: [
      "Searchable, filterable visitor intelligence",
      "Device + timezone shown at a glance",
      "Visits and pageviews tracked per person",
      "Consent recorded and signed on every record",
    ],
    screen: "visitors", scale: 0.62,
    pins: [
      { x: 22, y: 12, label: "Live visitor count" },
      { x: 35, y: 46, label: "Real names + emails" },
      { x: 78, y: 46, label: "Device + timezone" },
    ],
  },
  {
    n: "03", slug: "lead-detail", eyebrow: "Reach out", path: "visitors/k7…l",
    headline: "Open a lead. Call, text, or push to CRM — right there.",
    body: "Click any visitor for the full lead — animated lead score, contact + enrichment cards, a Termageddon-signed consent record with audit ID, and a timeline of every page they looked at. One tap to act.",
    bullets: [
      "Real name, real mobile, real email",
      "Lead score + engagement, animated on open",
      "Termageddon-signed consent with audit ID",
      "Activity timeline of every page viewed",
    ],
    screen: "visitor-detail", scale: 0.58,
    pins: [
      { x: 22, y: 18, label: "Identity + score" },
      { x: 64, y: 18, label: "Call · Text · Email · CRM" },
      { x: 55, y: 60, label: "Signed consent record" },
    ],
  },
  {
    n: "04", slug: "route", eyebrow: "Route", path: "integrations",
    headline: "Send leads where you already work.",
    body: "Connect Jobber, Housecall Pro, ServiceTitan, HubSpot, GoHighLevel — or anything custom through a webhook. Leads route to the right rep by service area automatically. Nothing falls into the gap between tools.",
    bullets: [
      "One-click connect to common CRMs",
      "Auto-route by rep or service area",
      "Webhook for anything custom",
      "Full lead detail carried over — no double entry",
    ],
    screen: "integrations", scale: 0.62,
    pins: [
      { x: 32, y: 36, label: "One-click connect" },
      { x: 70, y: 62, label: "Status pills per integration" },
    ],
  },
  {
    n: "05", slug: "measure", eyebrow: "Measure", path: "dashboard",
    headline: "See the dollars, every week.",
    body: "The dashboard ties cost per identified lead to the jobs you booked. Trend chart, time-range selector, live visitor feed — and the numbers count up on load so you actually look at them.",
    bullets: [
      "Cost per identified lead",
      "Jobs booked vs leads delivered",
      "Trend chart over your chosen range",
      "Live visitor feed below the metrics",
    ],
    screen: "dashboard", scale: 0.62,
    pins: [
      { x: 30, y: 22, label: "Live metrics" },
      { x: 60, y: 50, label: "Trend chart" },
      { x: 32, y: 84, label: "Real-time visitor feed" },
    ],
  },
];
---

<section class="tour" id="product-tour" aria-label="Guided product tour">
  <div aria-hidden="true" class="tour-glow tour-glow-a"></div>
  <div aria-hidden="true" class="tour-glow tour-glow-b"></div>

  <div class="container-content relative">
    <header class="tour-header">
      <p class="eyebrow mb-5 justify-center">Guided product tour</p>
      <h2 class="display-2 text-[color:var(--color-ink)]">See exactly what you'll be looking at.</h2>
      <p class="mt-5 text-lg leading-relaxed text-[color:var(--color-ink-2)]">
        Five screens in the order you'll use them — from install to the dashboard that proves it paid off. Scroll the column below and the product follows along.
      </p>
    </header>

    <div class="tour-grid">
      {/* ── Sticky screen pane ─────────────────────────── */}
      <aside class="tour-sticky" aria-hidden="false">
        {/* Progress rail */}
        <ol class="tour-rail" role="tablist" aria-label="Tour stages">
          {stages.map((s, i) => (
            <li>
              <a
                href={`#tour-${s.slug}`}
                role="tab"
                aria-controls={`tour-${s.slug}`}
                data-rail-stage={s.slug}
                class={`tour-rail-step ${i === 0 ? "is-active" : ""}`}
              >
                <span class="tour-rail-dot" aria-hidden="true"></span>
                <span class="tour-rail-n">{s.n}</span>
                <span class="tour-rail-label">{s.eyebrow}</span>
              </a>
            </li>
          ))}
        </ol>

        {/* Screen shell — all five demo screens stacked, only one active */}
        <div class="tour-screen-shell">
          <div class="tour-chrome" aria-hidden="true">
            <span class="tour-chrome-dot" style="background:#FF5F57"></span>
            <span class="tour-chrome-dot" style="background:#FEBC2E"></span>
            <span class="tour-chrome-dot" style="background:#28C840"></span>
            <span class="tour-chrome-url" data-chrome-url>app.consentresolve.com/{stages[0].path}</span>
          </div>
          <div class="tour-screen-stack">
            {stages.map((s, i) => (
              <div
                class={`tour-screen ${i === 0 ? "is-active" : ""}`}
                data-screen-stage={s.slug}
                data-path={s.path}
                style={`--screen-scale:${s.scale}`}
              >
                <div class="tour-screen-scale">
                  {s.screen === "consent"        && <ConsentScreen />}
                  {s.screen === "visitors"       && <VisitorsScreen />}
                  {s.screen === "visitor-detail" && <VisitorDetailScreen />}
                  {s.screen === "integrations"   && <IntegrationsScreen />}
                  {s.screen === "dashboard"      && <DashboardScreen />}
                </div>
                {/* Callout pins */}
                {s.pins.map((p, pi) => (
                  <span
                    class="tour-pin"
                    style={`left:${p.x}%;top:${p.y}%;--pin-delay:${pi * 90}ms`}
                  >
                    <span class="tour-pin-dot" aria-hidden="true"></span>
                    <span class="tour-pin-label">{p.label}</span>
                  </span>
                ))}
              </div>
            ))}
          </div>
        </div>
      </aside>

      {/* ── Narrative scroll column ────────────────────── */}
      <ol class="tour-narrative">
        {stages.map((s) => (
          <li class="tour-step" id={`tour-${s.slug}`} data-stage={s.slug}>
            <div class="tour-step-inner">
              <div class="tour-step-meta">
                <span class="tour-step-n">{s.n}</span>
                <Badge tone="brand" variant="soft" size="md" uppercase>{s.eyebrow}</Badge>
              </div>
              <h3 class="tour-step-title">{s.headline}</h3>
              <p class="tour-step-body">{s.body}</p>
              <ul class="tour-step-bullets">
                {s.bullets.map((b) => (
                  <li>
                    <span class="tour-step-check" aria-hidden="true">
                      <IconCheck size={12} stroke={3} color="var(--color-brand-pressed)" />
                    </span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
              {/* Mobile-only screen (sticky version is hidden under lg) */}
              <div class="tour-mobile-screen">
                <div class="tour-chrome" aria-hidden="true">
                  <span class="tour-chrome-dot" style="background:#FF5F57"></span>
                  <span class="tour-chrome-dot" style="background:#FEBC2E"></span>
                  <span class="tour-chrome-dot" style="background:#28C840"></span>
                  <span class="tour-chrome-url">app.consentresolve.com/{s.path}</span>
                </div>
                <div class="tour-screen is-active" style={`--screen-scale:${s.scale}`}>
                  <div class="tour-screen-scale">
                    {s.screen === "consent"        && <ConsentScreen />}
                    {s.screen === "visitors"       && <VisitorsScreen />}
                    {s.screen === "visitor-detail" && <VisitorDetailScreen />}
                    {s.screen === "integrations"   && <IntegrationsScreen />}
                    {s.screen === "dashboard"      && <DashboardScreen />}
                  </div>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .tour {
    position: relative;
    overflow: hidden;
    padding-block: 6rem;
    background: var(--color-bg);
  }

  /* Ambient glows behind the section */
  .tour-glow {
    position: absolute;
    inset: auto;
    width: 620px;
    height: 620px;
    border-radius: 9999px;
    pointer-events: none;
    filter: blur(120px);
  }
  .tour-glow-a {
    top: -160px;
    left: -120px;
    background: rgba(0, 229, 160, 0.18);
  }
  .tour-glow-b {
    bottom: -200px;
    right: -120px;
    background: rgba(0, 229, 160, 0.12);
  }

  .tour-header {
    max-width: 760px;
    margin: 0 auto 4.5rem;
    text-align: center;
  }

  /* Layout */
  .tour-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }
  @media (min-width: 1024px) {
    .tour-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 5rem;
      align-items: start;
    }
  }

  /* ── Sticky screen pane ─────────────────────────────── */
  .tour-sticky { display: none; }
  @media (min-width: 1024px) {
    .tour-sticky {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      position: sticky;
      top: 5rem;
    }
  }

  /* Progress rail */
  .tour-rail {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
    padding: 0.75rem;
    list-style: none;
    background: var(--color-bg-alt);
    border-radius: 1rem;
    box-shadow: inset 0 0 0 1px var(--color-rule);
  }
  .tour-rail-step {
    display: grid;
    grid-template-columns: 18px 32px 1fr;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.85rem;
    border-radius: 0.625rem;
    text-decoration: none;
    color: var(--color-ink-muted);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .tour-rail-step:hover { color: var(--color-ink-2); background: rgba(0, 229, 160, 0.06); }
  .tour-rail-dot {
    width: 9px; height: 9px;
    border-radius: 9999px;
    background: var(--color-rule);
    box-shadow: 0 0 0 3px rgba(10, 22, 40, 0.04);
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
    justify-self: center;
  }
  .tour-rail-n {
    font-family: var(--font-mono, ui-monospace, monospace);
    color: var(--color-ink-muted);
    transition: color 0.3s ease;
  }
  .tour-rail-step.is-active {
    background: var(--color-navy-900);
    color: white;
  }
  .tour-rail-step.is-active .tour-rail-dot {
    background: var(--color-brand);
    box-shadow: 0 0 0 3px rgba(0, 229, 160, 0.25);
  }
  .tour-rail-step.is-active .tour-rail-n { color: var(--color-brand); }

  /* Screen shell — fixed aspect, no internal scrolling */
  .tour-screen-shell {
    position: relative;
    border-radius: 1.25rem;
    overflow: hidden;
    background: var(--color-bg);
    box-shadow:
      0 0 0 1px rgba(10, 22, 40, 0.08),
      0 40px 80px -28px rgba(10, 22, 40, 0.45),
      0 12px 24px -8px rgba(10, 22, 40, 0.22);
    transform: perspective(2400px) rotateY(-3deg) rotateX(2deg);
    transform-origin: center;
  }
  /* Browser chrome */
  .tour-chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.85rem;
    background: linear-gradient(180deg, #fafbfc 0%, #f1f5f9 100%);
    border-bottom: 1px solid rgba(10, 22, 40, 0.08);
  }
  .tour-chrome-dot {
    display: inline-block;
    width: 11px; height: 11px;
    border-radius: 9999px;
    box-shadow: inset 0 0 0 1px rgba(0,0,0,0.06);
  }
  .tour-chrome-url {
    flex: 1;
    margin: 0 0.6rem;
    text-align: center;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11.5px;
    color: rgba(10, 22, 40, 0.6);
    background: white;
    border: 1px solid rgba(10, 22, 40, 0.06);
    border-radius: 0.5rem;
    padding: 0.32rem 0.7rem;
    max-width: 360px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Stack — fixed aspect ratio, all screens absolutely positioned */
  .tour-screen-stack {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--color-bg);
  }
  .tour-screen {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(0.985);
    transition: opacity 520ms cubic-bezier(0.22, 0.61, 0.36, 1), transform 520ms cubic-bezier(0.22, 0.61, 0.36, 1);
    pointer-events: none;
    overflow: hidden;
  }
  .tour-screen.is-active {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  /* The internal scale wrapper — renders the demo at its native width
     then scales it down so the content fits the fixed-aspect shell
     without any scrollbars. */
  .tour-screen-scale {
    width: calc(100% / var(--screen-scale, 0.62));
    height: calc(100% / var(--screen-scale, 0.62));
    transform: scale(var(--screen-scale, 0.62));
    transform-origin: top left;
    pointer-events: none;
  }
  .tour-screen.is-active .tour-screen-scale { pointer-events: auto; }

  /* Callout pins */
  .tour-pin {
    position: absolute;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    opacity: 0;
    transition: opacity 360ms ease;
    transition-delay: var(--pin-delay, 0ms);
    pointer-events: none;
  }
  .tour-screen.is-active .tour-pin { opacity: 1; }
  .tour-pin-dot {
    position: relative;
    width: 14px; height: 14px;
    border-radius: 9999px;
    background: var(--color-brand);
    box-shadow:
      0 0 0 4px rgba(0, 229, 160, 0.18),
      0 0 0 8px rgba(0, 229, 160, 0.10),
      0 6px 16px -4px rgba(0, 229, 160, 0.55);
    animation: tour-pin-pulse 2.4s ease-in-out infinite;
  }
  @keyframes tour-pin-pulse {
    0%, 100% {
      box-shadow:
        0 0 0 4px rgba(0, 229, 160, 0.18),
        0 0 0 8px rgba(0, 229, 160, 0.10),
        0 6px 16px -4px rgba(0, 229, 160, 0.55);
    }
    50% {
      box-shadow:
        0 0 0 6px rgba(0, 229, 160, 0.28),
        0 0 0 14px rgba(0, 229, 160, 0.06),
        0 6px 16px -4px rgba(0, 229, 160, 0.55);
    }
  }
  .tour-pin-label {
    background: var(--color-navy-900);
    color: white;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.4rem 0.7rem;
    border-radius: 0.5rem;
    white-space: nowrap;
    box-shadow: 0 10px 24px -10px rgba(10, 22, 40, 0.55);
  }

  /* ── Narrative column ───────────────────────────────── */
  .tour-narrative {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tour-step {
    /* Each step gets a tall scroll runway on desktop so the sticky
       screen has time to "stay" on it before swapping. */
    min-height: 60svh;
    display: flex;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .tour-step { min-height: 78svh; }
    .tour-step:first-child { padding-top: 1rem; }
    .tour-step:last-child { padding-bottom: 6rem; }
  }
  .tour-step-inner { width: 100%; }

  .tour-step-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
  }
  .tour-step-n {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(48px, 6vw, 80px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    background: linear-gradient(180deg, #00E5A0 0%, #00A86E 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .tour-step-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.625rem, 2.6vw, 2.25rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    margin-bottom: 1rem;
  }
  .tour-step-body {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-2);
    max-width: 38rem;
  }
  .tour-step-bullets {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .tour-step-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-ink-2);
  }
  .tour-step-check {
    margin-top: 2px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 9999px;
    background: var(--color-brand-soft);
  }

  /* Mobile-only inline screen (hidden on lg+) */
  .tour-mobile-screen {
    margin-top: 2rem;
    border-radius: 1.125rem;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(10, 22, 40, 0.08),
      0 24px 48px -20px rgba(10, 22, 40, 0.32);
  }
  .tour-mobile-screen .tour-screen-stack { display: contents; }
  .tour-mobile-screen .tour-screen {
    position: relative;
    inset: auto;
    aspect-ratio: 16 / 10;
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .tour-mobile-screen .tour-pin { display: none; }
  @media (min-width: 1024px) {
    .tour-mobile-screen { display: none; }
  }

  /* Reduced motion: no pulse, no parallax tilt, instant fade */
  @media (prefers-reduced-motion: reduce) {
    .tour-screen-shell { transform: none; }
    .tour-pin-dot { animation: none; }
    .tour-screen { transition: opacity 0.001ms linear; transform: none; }
  }
</style>

<script>
  (function () {
    const section = document.querySelector<HTMLElement>(".tour");
    if (!section) return;

    const sticky = section.querySelector<HTMLElement>(".tour-sticky");
    if (!sticky) return;

    const stepEls = Array.from(section.querySelectorAll<HTMLElement>(".tour-step"));
    const screenEls = Array.from(sticky.querySelectorAll<HTMLElement>(".tour-screen"));
    const railEls = Array.from(sticky.querySelectorAll<HTMLElement>(".tour-rail-step"));
    const urlEl = sticky.querySelector<HTMLElement>("[data-chrome-url]");
    if (!stepEls.length || !screenEls.length || !railEls.length) return;

    // Map slug → path for chrome URL updates (data-path attribute on each screen)
    const pathBySlug = new Map<string, string>();
    screenEls.forEach((s) => {
      const slug = s.dataset.screenStage || "";
      const path = s.dataset.path || "";
      if (slug) pathBySlug.set(slug, `app.consentresolve.com/${path}`);
    });

    let activeSlug = stepEls[0]?.dataset.stage || "";

    const setActive = (slug: string) => {
      if (slug === activeSlug) return;
      activeSlug = slug;
      screenEls.forEach((el) => el.classList.toggle("is-active", el.dataset.screenStage === slug));
      railEls.forEach((el) => el.classList.toggle("is-active", el.dataset.railStage === slug));
      if (urlEl && pathBySlug.has(slug)) urlEl.textContent = pathBySlug.get(slug)!;
    };

    // Observe each step. We want the step that's most centered to be active.
    // Use rootMargin to bias the activation window toward the viewport center.
    const obs = new IntersectionObserver(
      (entries) => {
        // Find the most intersecting entry whose target is currently intersecting.
        let best: IntersectionObserverEntry | null = null;
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          if (!best || entry.intersectionRatio > best.intersectionRatio) best = entry;
        }
        if (best) {
          const slug = (best.target as HTMLElement).dataset.stage;
          if (slug) setActive(slug);
        }
      },
      {
        // Top/bottom margins narrow the trigger zone to the middle ~40% of the viewport.
        rootMargin: "-30% 0px -30% 0px",
        threshold: [0, 0.25, 0.5, 0.75, 1],
      }
    );
    stepEls.forEach((el) => obs.observe(el));

    // Smooth scroll for rail clicks (Safari handles scroll-margin via CSS already,
    // we just want the active state to update immediately for snappy feedback).
    railEls.forEach((el) => {
      el.addEventListener("click", () => {
        const slug = el.dataset.railStage;
        if (slug) setActive(slug);
      });
    });
  })();
</script>
