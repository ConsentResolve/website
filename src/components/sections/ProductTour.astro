---
/**
 * Guided product tour — tabbed walkthrough.
 *
 * Layout per stage (vertical stack):
 *   1. Text block on top — eyebrow + headline + body + bullets.
 *   2. Browser-chrome screen below with 2–3 callout pins overlaid.
 *   3. Numbered navigator (01–05) at the bottom + Prev/Next arrows.
 *
 * Only one stage is visible at a time; the navigator swaps which by
 * toggling `is-active` on both the stage panel and the matching tab
 * button. ARIA: nav is a `tablist`, each button a `tab`, each panel
 * a `tabpanel`. Inactive panels carry `hidden` so screen readers and
 * crawlers can skip them.
 *
 * No internal scrolling — every screen is sized at native width inside
 * a fixed-aspect frame, scaled down with CSS transform per screen.
 */
import ConsentScreen from "~/components/ui/demo/ConsentScreen.astro";
import VisitorsScreen from "~/components/ui/demo/VisitorsScreen.astro";
import VisitorDetailScreen from "~/components/ui/demo/VisitorDetailScreen.astro";
import IntegrationsScreen from "~/components/ui/demo/IntegrationsScreen.astro";
import DashboardScreen from "~/components/ui/demo/DashboardScreen.astro";
import Badge from "~/components/ui/Badge.astro";
import { IconCheck, IconArrowLeft, IconArrowRight } from "@tabler/icons-react";

interface Pin { x: number; y: number; label: string }
interface Stage {
  n: string;
  slug: string;
  eyebrow: string;
  headline: string;
  body: string;
  bullets: string[];
  screen: "consent" | "visitors" | "visitor-detail" | "integrations" | "dashboard";
  path: string;
  /** Scale factor — tuned per screen so its key content fits the frame. */
  scale: number;
  /** Callout pins overlaid on the screen (% of the unscaled frame).
   *  Keep to 2–3 per stage for clarity. */
  pins: Pin[];
}

const stages: Stage[] = [
  {
    n: "01", slug: "install", eyebrow: "Install", path: "consent",
    headline: "Paste one line. Live the same day.",
    body: "Drop the Consent Resolve snippet into your site's <head>. Your existing consent banner does the asking — we wire ourselves in alongside Termageddon-backed policies and start identifying the second a homeowner says yes.",
    bullets: [
      "One universal script — WordPress, Wix, Squarespace, GHL, ServiceTitan",
      "No developer required, no app to install",
      "Most pros are live within hours of signing up",
    ],
    screen: "consent", scale: 0.68,
    pins: [
      { x: 41, y: 28, label: "One-line install snippet" },
      { x: 48, y: 62, label: "Termageddon Settings ID" },
    ],
  },
  {
    n: "02", slug: "visitors", eyebrow: "Identify", path: "visitors",
    headline: "Real people fill the list in real time.",
    body: "Every consented visitor lands in your Visitors view with a device, location, view count, and time since visit. Search, filter, sort — find exactly the homeowners who matter today.",
    bullets: [
      "Searchable, filterable visitor intelligence",
      "Device + timezone shown at a glance",
      "Consent recorded and signed on every record",
    ],
    screen: "visitors", scale: 0.62,
    pins: [
      { x: 22, y: 12, label: "Live visitor count" },
      { x: 38, y: 46, label: "Real names + emails" },
      { x: 78, y: 46, label: "Device + timezone" },
    ],
  },
  {
    n: "03", slug: "lead-detail", eyebrow: "Reach out", path: "visitors/k7…l",
    headline: "Open a lead. Call, text, or push to CRM — right there.",
    body: "Click any visitor for the full lead — animated lead score, contact + enrichment cards, a Termageddon-signed consent record with audit ID, and a timeline of every page they looked at. One tap to act.",
    bullets: [
      "Real name, real mobile, real email",
      "Termageddon-signed consent with audit ID",
      "Activity timeline of every page viewed",
    ],
    screen: "visitor-detail", scale: 0.58,
    pins: [
      { x: 24, y: 18, label: "Identity + score" },
      { x: 65, y: 18, label: "Call · Text · Email · CRM" },
      { x: 50, y: 60, label: "Signed consent record" },
    ],
  },
  {
    n: "04", slug: "route", eyebrow: "Route", path: "integrations",
    headline: "Send leads where you already work.",
    body: "Connect Jobber, Housecall Pro, ServiceTitan, HubSpot, GoHighLevel — or anything custom through a webhook. Leads route to the right rep by service area automatically. Nothing falls into the gap between tools.",
    bullets: [
      "One-click connect to common CRMs",
      "Auto-route by rep or service area",
      "Full lead detail carried over — no double entry",
    ],
    screen: "integrations", scale: 0.62,
    pins: [
      { x: 32, y: 36, label: "One-click connect" },
      { x: 70, y: 62, label: "Status pills per integration" },
    ],
  },
  {
    n: "05", slug: "measure", eyebrow: "Measure", path: "dashboard",
    headline: "See the dollars, every week.",
    body: "The dashboard ties cost per identified lead to the jobs you booked. Trend chart, time-range selector, live visitor feed — and the numbers count up on load so you actually look at them.",
    bullets: [
      "Cost per identified lead vs jobs booked",
      "Trend chart over your chosen range",
      "Live visitor feed below the metrics",
    ],
    screen: "dashboard", scale: 0.62,
    pins: [
      { x: 30, y: 22, label: "Live metrics" },
      { x: 60, y: 50, label: "Trend chart" },
      { x: 32, y: 84, label: "Real-time visitor feed" },
    ],
  },
];
---

<section class="tour" id="product-tour" aria-label="Guided product tour">
  <div aria-hidden="true" class="tour-glow tour-glow-a"></div>
  <div aria-hidden="true" class="tour-glow tour-glow-b"></div>

  <div class="container-content relative">
    <header class="tour-header">
      <p class="eyebrow mb-5 justify-center">Guided product tour</p>
      <h2 class="display-2 text-[color:var(--color-ink)]">See exactly what you'll be looking at.</h2>
      <p class="mt-5 text-lg leading-relaxed text-[color:var(--color-ink-2)]">
        Five screens, in the order you'll actually use them — from install to the dashboard that proves it paid off.
      </p>
    </header>

    {/* ── Stage panels ────────────────────────────────────────── */}
    <div class="tour-stages">
      {stages.map((stage, i) => (
        <div
          class={`tour-stage ${i === 0 ? "is-active" : ""}`}
          data-stage={stage.slug}
          role="tabpanel"
          id={`tour-panel-${stage.slug}`}
          aria-labelledby={`tour-tab-${stage.slug}`}
          hidden={i !== 0}
        >
          {/* Text on top */}
          <div class="tour-text">
            <div class="tour-text-meta">
              <span class="tour-step-n">{stage.n}</span>
              <Badge tone="brand" variant="soft" size="md" uppercase>{stage.eyebrow}</Badge>
            </div>
            <h3 class="tour-step-title">{stage.headline}</h3>
            <p class="tour-step-body">{stage.body}</p>
            <ul class="tour-step-bullets">
              {stage.bullets.map((b) => (
                <li>
                  <span class="tour-step-check" aria-hidden="true">
                    <IconCheck size={12} stroke={3} color="var(--color-brand-pressed)" />
                  </span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>

          {/* Screen below */}
          <div class="tour-screen-wrap">
            <div class="tour-frame">
              <div class="tour-chrome" aria-hidden="true">
                <span class="tour-chrome-dot" style="background:#FF5F57"></span>
                <span class="tour-chrome-dot" style="background:#FEBC2E"></span>
                <span class="tour-chrome-dot" style="background:#28C840"></span>
                <span class="tour-chrome-url">app.consentresolve.com/{stage.path}</span>
              </div>
              <div class="tour-screen" style={`--screen-scale:${stage.scale}`}>
                <div class="tour-screen-scale">
                  {stage.screen === "consent"        && <ConsentScreen />}
                  {stage.screen === "visitors"       && <VisitorsScreen />}
                  {stage.screen === "visitor-detail" && <VisitorDetailScreen />}
                  {stage.screen === "integrations"   && <IntegrationsScreen />}
                  {stage.screen === "dashboard"      && <DashboardScreen />}
                </div>
                {/* Callout pins */}
                {stage.pins.map((p, pi) => (
                  <span
                    class="tour-pin"
                    style={`left:${p.x}%;top:${p.y}%;--pin-delay:${pi * 110 + 220}ms`}
                  >
                    <span class="tour-pin-dot" aria-hidden="true"></span>
                    <span class="tour-pin-label">{p.label}</span>
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    {/* ── Stage navigator ─────────────────────────────────────── */}
    <nav class="tour-nav" role="tablist" aria-label="Tour stages">
      <button
        type="button"
        class="tour-nav-arrow"
        data-tour-prev
        aria-label="Previous stage"
      >
        <IconArrowLeft size={18} stroke={2.25} />
        <span class="tour-nav-arrow-label">Prev</span>
      </button>

      <div class="tour-nav-tabs">
        {stages.map((stage, i) => (
          <button
            type="button"
            role="tab"
            id={`tour-tab-${stage.slug}`}
            aria-controls={`tour-panel-${stage.slug}`}
            aria-selected={i === 0 ? "true" : "false"}
            data-tour-tab={stage.slug}
            class={`tour-nav-tab ${i === 0 ? "is-active" : ""}`}
          >
            <span class="tour-nav-tab-n">{stage.n}</span>
            <span class="tour-nav-tab-label">{stage.eyebrow}</span>
          </button>
        ))}
      </div>

      <button
        type="button"
        class="tour-nav-arrow"
        data-tour-next
        aria-label="Next stage"
      >
        <span class="tour-nav-arrow-label">Next</span>
        <IconArrowRight size={18} stroke={2.25} />
      </button>
    </nav>
  </div>
</section>

<style>
  .tour {
    position: relative;
    overflow: hidden;
    padding-block: 6rem;
    background: var(--color-bg);
  }
  .tour-glow {
    position: absolute;
    width: 620px;
    height: 620px;
    border-radius: 9999px;
    pointer-events: none;
    filter: blur(120px);
  }
  .tour-glow-a { top: -160px; left: -120px;  background: rgba(0, 229, 160, 0.18); }
  .tour-glow-b { bottom: -200px; right: -120px; background: rgba(0, 229, 160, 0.12); }

  .tour-header {
    max-width: 760px;
    margin: 0 auto 3.5rem;
    text-align: center;
  }

  /* ── Stages ─────────────────────────────────────────────────── */
  .tour-stages {
    max-width: 1080px;
    margin: 0 auto;
  }
  .tour-stage {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    animation: tour-stage-in 360ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .tour-stage:not(.is-active) { display: none; }
  @keyframes tour-stage-in {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Text on top ────────────────────────────────────────────── */
  .tour-text {
    max-width: 760px;
  }
  .tour-text-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }
  .tour-step-n {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    background: linear-gradient(180deg, #00E5A0 0%, #00A86E 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .tour-step-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.5rem, 2.6vw, 2.125rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    margin-bottom: 0.875rem;
  }
  .tour-step-body {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-2);
    max-width: 38rem;
  }
  .tour-step-bullets {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .tour-step-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-ink-2);
  }
  .tour-step-check {
    margin-top: 2px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 9999px;
    background: var(--color-brand-soft);
  }

  /* ── Screen below ───────────────────────────────────────────── */
  .tour-screen-wrap { position: relative; }
  .tour-frame {
    position: relative;
    border-radius: 1.25rem;
    overflow: hidden;
    background: var(--color-bg);
    box-shadow:
      0 0 0 1px rgba(10, 22, 40, 0.08),
      0 40px 80px -28px rgba(10, 22, 40, 0.45),
      0 12px 24px -8px rgba(10, 22, 40, 0.22);
  }
  .tour-chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.85rem;
    background: linear-gradient(180deg, #fafbfc 0%, #f1f5f9 100%);
    border-bottom: 1px solid rgba(10, 22, 40, 0.08);
  }
  .tour-chrome-dot {
    display: inline-block;
    width: 11px; height: 11px;
    border-radius: 9999px;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.06);
  }
  .tour-chrome-url {
    flex: 1;
    margin: 0 0.6rem;
    text-align: center;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11.5px;
    color: rgba(10, 22, 40, 0.6);
    background: white;
    border: 1px solid rgba(10, 22, 40, 0.06);
    border-radius: 0.5rem;
    padding: 0.32rem 0.7rem;
    max-width: 360px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tour-screen {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-bg);
  }
  .tour-screen-scale {
    width: calc(100% / var(--screen-scale, 0.62));
    height: calc(100% / var(--screen-scale, 0.62));
    transform: scale(var(--screen-scale, 0.62));
    transform-origin: top left;
    pointer-events: none;
  }

  /* Callout pins */
  .tour-pin {
    position: absolute;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    opacity: 0;
    pointer-events: none;
    animation: tour-pin-in 480ms cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
    animation-delay: var(--pin-delay, 0ms);
  }
  @keyframes tour-pin-in {
    from { opacity: 0; transform: translate(-50%, -50%) scale(0.92); }
    to   { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  }
  .tour-pin-dot {
    width: 14px; height: 14px;
    border-radius: 9999px;
    background: var(--color-brand);
    box-shadow:
      0 0 0 4px rgba(0, 229, 160, 0.18),
      0 0 0 8px rgba(0, 229, 160, 0.10),
      0 6px 16px -4px rgba(0, 229, 160, 0.55);
    animation: tour-pin-pulse 2.4s ease-in-out infinite;
    animation-delay: calc(var(--pin-delay, 0ms) + 480ms);
  }
  @keyframes tour-pin-pulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(0, 229, 160, 0.18), 0 0 0 8px rgba(0, 229, 160, 0.10), 0 6px 16px -4px rgba(0, 229, 160, 0.55); }
    50%      { box-shadow: 0 0 0 6px rgba(0, 229, 160, 0.28), 0 0 0 14px rgba(0, 229, 160, 0.06), 0 6px 16px -4px rgba(0, 229, 160, 0.55); }
  }
  .tour-pin-label {
    background: var(--color-navy-900);
    color: white;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.4rem 0.7rem;
    border-radius: 0.5rem;
    white-space: nowrap;
    box-shadow: 0 10px 24px -10px rgba(10, 22, 40, 0.55);
  }

  /* ── Navigator ──────────────────────────────────────────────── */
  .tour-nav {
    margin: 3rem auto 0;
    max-width: 1080px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .tour-nav-arrow {
    appearance: none;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.1rem;
    border-radius: 9999px;
    background: transparent;
    color: var(--color-ink-2);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    box-shadow: inset 0 0 0 1px var(--color-rule);
    transition: color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  }
  .tour-nav-arrow:hover {
    color: var(--color-brand-pressed);
    background: var(--color-brand-soft);
    box-shadow: inset 0 0 0 1px rgba(0, 229, 160, 0.4);
  }
  .tour-nav-arrow:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    background: transparent;
    color: var(--color-ink-muted);
    box-shadow: inset 0 0 0 1px var(--color-rule);
  }
  .tour-nav-arrow-label { display: inline-block; }
  @media (max-width: 480px) {
    .tour-nav-arrow-label { display: none; }
  }

  .tour-nav-tabs {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem;
    background: var(--color-bg-alt);
    border-radius: 9999px;
    box-shadow: inset 0 0 0 1px var(--color-rule);
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .tour-nav-tabs::-webkit-scrollbar { display: none; }

  .tour-nav-tab {
    appearance: none;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-radius: 9999px;
    background: transparent;
    color: var(--color-ink-muted);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
  }
  .tour-nav-tab:hover {
    color: var(--color-ink-2);
    background: rgba(0, 229, 160, 0.07);
  }
  .tour-nav-tab-n {
    font-family: var(--font-mono, ui-monospace, monospace);
    color: var(--color-brand-pressed);
    transition: color 0.25s ease;
  }
  .tour-nav-tab.is-active {
    background: var(--color-navy-900);
    color: white;
    box-shadow: 0 10px 24px -12px rgba(10, 22, 40, 0.45);
  }
  .tour-nav-tab.is-active .tour-nav-tab-n { color: var(--color-brand); }

  /* Below 720px: hide the label on the tab buttons, just show the number. */
  @media (max-width: 720px) {
    .tour-nav-tab-label { display: none; }
    .tour-nav-tab { padding: 0.6rem 0.85rem; }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .tour-stage { animation: none; }
    .tour-pin { animation: none; opacity: 1; }
    .tour-pin-dot { animation: none; }
  }
</style>

<script>
  // Tabbed walkthrough — single source of truth for the active stage
  // is the data-tour-tab attribute on the navigator buttons. Clicking
  // any tab (or prev/next) updates the panel + tab states + the
  // chrome URL on the *active* panel.
  (function () {
    const section = document.querySelector<HTMLElement>(".tour");
    if (!section) return;

    const panels = Array.from(section.querySelectorAll<HTMLElement>(".tour-stage"));
    const tabs = Array.from(section.querySelectorAll<HTMLElement>("[data-tour-tab]"));
    const prevBtn = section.querySelector<HTMLButtonElement>("[data-tour-prev]");
    const nextBtn = section.querySelector<HTMLButtonElement>("[data-tour-next]");
    if (!panels.length || !tabs.length) return;

    const slugs = tabs.map((t) => t.dataset.tourTab as string);
    let activeIdx = Math.max(0, slugs.indexOf(panels.find((p) => p.classList.contains("is-active"))?.dataset.stage || slugs[0]));

    const setActive = (i: number) => {
      const clamped = Math.max(0, Math.min(slugs.length - 1, i));
      if (clamped === activeIdx) return;
      const slug = slugs[clamped];

      // Restart the pin/stage enter animation by toggling display.
      panels.forEach((p) => {
        const match = p.dataset.stage === slug;
        p.classList.toggle("is-active", match);
        if (match) p.removeAttribute("hidden");
        else p.setAttribute("hidden", "");
      });
      tabs.forEach((t) => {
        const match = t.dataset.tourTab === slug;
        t.classList.toggle("is-active", match);
        t.setAttribute("aria-selected", match ? "true" : "false");
      });

      activeIdx = clamped;
      syncArrowState();
    };

    const syncArrowState = () => {
      if (prevBtn) prevBtn.disabled = activeIdx === 0;
      if (nextBtn) nextBtn.disabled = activeIdx === slugs.length - 1;
    };
    syncArrowState();

    tabs.forEach((t, i) => {
      t.addEventListener("click", () => setActive(i));
      // Keyboard: Left/Right arrow keys move between tabs.
      t.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "ArrowRight") { e.preventDefault(); setActive(activeIdx + 1); tabs[Math.min(activeIdx, tabs.length - 1)]?.focus(); }
        if (e.key === "ArrowLeft")  { e.preventDefault(); setActive(activeIdx - 1); tabs[Math.max(activeIdx, 0)]?.focus(); }
        if (e.key === "Home")       { e.preventDefault(); setActive(0); tabs[0]?.focus(); }
        if (e.key === "End")        { e.preventDefault(); setActive(slugs.length - 1); tabs[slugs.length - 1]?.focus(); }
      });
    });
    prevBtn?.addEventListener("click", () => setActive(activeIdx - 1));
    nextBtn?.addEventListener("click", () => setActive(activeIdx + 1));
  })();
</script>
