---
import Illustration from "~/components/Illustration.astro";
import List from "~/components/ui/List.astro";
import Callout from "~/components/ui/Callout.astro";
import Badge from "~/components/ui/Badge.astro";
---

<section class="section bg-[color:var(--color-bg-alt)]">
  <div class="container-content grid items-center gap-16 md:grid-cols-[1fr_1fr]">
    <div>
      <div class="mb-5"><Badge tone="brand" variant="soft" size="md" uppercase>Compliance</Badge></div>
      <h2 class="display-2 mb-6 text-[color:var(--color-ink)]">
        Consent-first by default. Receipts for everything.
      </h2>
      <p class="mb-8 text-lg leading-relaxed text-[color:var(--color-ink-2)]">
        We don't just hand you a contact — we protect your shop. Identification fires only after a consented yes, every record carries a signed audit receipt, and we never hand you a number to cold-call. Your privacy policy stays current through our Termageddon partnership.
      </p>
      <div class="mb-8">
        <List
          items={[
            "TCPA · we never give you a number to cold-call",
            "CIPA · nothing tracks before the consented yes",
            "State privacy · built for the patchwork, incl. Texas TDPSA",
            "Audit receipt on every record",
          ]}
          variant="filled-check"
          tone="brand"
        />
      </div>
      <Callout variant="trust" title="A receipt for every lead">
        Every reveal is timestamped and signed. If a regulator ever asks, you've got proof. <a href="/why-consent-first/" class="font-semibold text-[color:var(--color-brand-pressed)] hover:underline">How we think about the law →</a>
      </Callout>
    </div>
    <div>
      <Illustration name="style/08-shield-doc" alt="Compliant data handling" class="w-full h-auto max-w-md mx-auto" />
    </div>
  </div>
</section>
