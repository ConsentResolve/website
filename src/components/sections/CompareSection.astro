---
import ComparisonCard from "~/components/ui/ComparisonCard.astro";
import { IconArrowRight } from "@tabler/icons-react";
---

<section class="section section-dark relative overflow-hidden">
  <!-- Ambient mint glow -->
  <div aria-hidden="true" class="pointer-events-none absolute -right-32 top-1/3 size-[520px] rounded-full bg-[color:var(--color-mint-400)]/15 blur-[120px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -left-32 bottom-1/4 size-[420px] rounded-full bg-[color:var(--color-mint-400)]/10 blur-[100px]"></div>

  <div class="container-content relative">
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <p class="eyebrow mb-5 justify-center" style="color:var(--color-mint-400)">Stacked against the shared-lead crowd</p>
      <h2 class="font-display text-4xl md:text-6xl font-black tracking-tight leading-[1.02] text-white">
        We don't sell leads.<br/>
        <span class="text-[color:var(--color-mint-400)]">We hand them back to you.</span>
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-slate-300">
        Here's why pros are walking away from shared-lead platforms — where the same lead gets sold to four other shops.
      </p>
    </div>

    <div class="grid gap-7 md:gap-8 lg:grid-cols-3 pt-6">
      <ComparisonCard
        featured
        ribbonLabel="Editor's Pick"
        brand="Consent Resolve"
        logoColor="#0A1628"
        rating={4.9}
        score={96}
        price="$7"
        priceSub="Per lead · 10 leads for $10 to start"
        bestFor="owner-operators"
        pros={[
          "Exclusive leads — never resold",
          "Real homeowner names + numbers",
          "Legal by default (GDPR / CCPA / CPA)",
        ]}
        cons={[
          "New platform (founded 2026)",
          "Smaller network than legacy resellers",
        ]}
        ctaLabel="Start $10 Trial"
        ctaHref="/get-started/"
        reviewHref="/how-it-works/"
      />
      <ComparisonCard
        brand="Thumbtack"
        logoColor="#04b760"
        rating={3.4}
        score={64}
        price="$46"
        priceSub="Avg per lead · range $25–$75"
        bestFor="high-volume shops"
        pros={[
          "High lead volume",
          "Quick to start",
          "Mobile dispatch app",
        ]}
        cons={[
          "Same lead sold to 4–5 shops",
          "Billed for a 'no thanks' reply",
        ]}
        ctaLabel="Compare in detail"
        ctaHref="/compare/thumbtack/"
        reviewHref="/compare/thumbtack/"
      />
      <ComparisonCard
        brand="Angi"
        logoColor="#a3151c"
        rating={2.9}
        score={52}
        price="$50"
        priceSub="Avg per lead · range $15–$100+"
        bestFor="legacy shops"
        pros={[
          "Known brand",
          "Vetted-pro program",
          "Wide trade coverage",
        ]}
        cons={[
          "Leads shared with 3–8 shops",
          "30–35% cancellation penalty",
        ]}
        ctaLabel="Compare in detail"
        ctaHref="/compare/angi/"
        reviewHref="/compare/angi/"
      />
    </div>

    <div class="mt-14 text-center">
      <a
        href="/compare/"
        class="inline-flex items-center gap-2 rounded-lg px-6 py-3 text-sm font-bold uppercase tracking-[0.14em] text-white ring-1 ring-inset ring-white/25 transition-all hover:bg-white/10 hover:ring-[color:var(--color-mint-400)]/50"
      >
        See all platforms compared
        <IconArrowRight size={16} stroke={2.25} />
      </a>
    </div>
  </div>
</section>
