---
interface Props {
  heading?: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const {
  heading = "Start small. Stay safe.",
  body = "Why risk a $50,000 lawsuit for unconsented data when you can start identifying legally for just $10?",
  ctaLabel = "Start $10 Trial Today",
  ctaHref = "/get-started/",
} = Astro.props as Props;
---

<section class="section-dark relative overflow-hidden px-6 py-24">
  <!-- subtle blueprint grid backdrop -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
    style="background-image: linear-gradient(to right, rgba(0,229,160,0.05) 1px, transparent 1px), linear-gradient(to bottom, rgba(0,229,160,0.05) 1px, transparent 1px); background-size: 40px 40px;"
  ></div>

  <!-- service van silhouette, decorative -->
  <svg
    aria-hidden="true"
    viewBox="0 0 240 110"
    class="pointer-events-none absolute -bottom-2 -right-4 h-28 w-auto opacity-[0.07]"
  >
    <g fill="white">
      <!-- cab -->
      <path d="M10,80 L10,40 Q10,30 20,30 L60,30 L80,55 L80,80 Z" />
      <!-- box body -->
      <rect x="78" y="22" width="130" height="58" />
      <!-- bumper -->
      <rect x="6" y="80" width="208" height="6" />
      <!-- wheels -->
      <circle cx="42" cy="90" r="12" />
      <circle cx="170" cy="90" r="12" />
      <circle cx="42" cy="90" r="6" fill="#0A1628" />
      <circle cx="170" cy="90" r="6" fill="#0A1628" />
      <!-- door panel lines -->
      <rect x="92" y="34" width="2" height="36" fill="#0A1628" />
      <rect x="138" y="34" width="2" height="36" fill="#0A1628" />
      <rect x="184" y="34" width="2" height="36" fill="#0A1628" />
    </g>
  </svg>

  <div class="container-content relative">
    <div class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-[color:var(--color-bg-inverse-alt)] p-12">
      <!-- mint corner accent -->
      <div class="absolute left-0 top-0 h-1 w-full bg-[color:var(--color-brand)]"></div>
      <div class="absolute -top-12 -right-12 size-48 rounded-full bg-[color:var(--color-brand)]/15 blur-3xl"></div>

      <div class="grid items-center gap-12 md:grid-cols-2">
        <div class="text-left">
          <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-[color:var(--color-brand)]/30 bg-[color:var(--color-brand)]/10 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-[color:var(--color-brand)]">
            <span class="material-symbols-outlined !text-[14px] !text-[color:var(--color-brand)]">bolt</span>
            Get started today
          </p>
          <h2 class="mb-6 text-4xl font-black text-white md:text-5xl">{heading}</h2>
          <p class="mb-8 text-lg text-slate-300">{body}</p>
          <a
            href={ctaHref}
            class="inline-flex items-center gap-2 rounded-xl bg-[color:var(--color-brand)] px-10 py-5 text-xl font-black text-[color:var(--color-navy-900)] transition-all hover:bg-[color:var(--color-mint-300)] hover:shadow-[0_8px_32px_-8px_rgba(0,229,160,0.55)]"
          >
            {ctaLabel}
            <span class="material-symbols-outlined !text-[color:var(--color-navy-900)]">arrow_forward</span>
          </a>
        </div>
        <div class="space-y-4">
          <div class="flex items-center justify-between rounded-2xl border border-white/10 bg-white/5 p-6">
            <span class="flex items-center gap-3 text-slate-300">
              <span class="material-symbols-outlined !text-[20px] !text-[color:var(--color-brand)]">payments</span>
              Monthly Trial Fee
            </span>
            <span class="text-2xl font-black text-[color:var(--color-brand)]">$10</span>
          </div>
          <div class="flex items-center justify-between rounded-2xl border border-[color:var(--color-danger)]/30 bg-[color:var(--color-danger)]/10 p-6">
            <span class="flex items-center gap-3 text-slate-300">
              <span class="material-symbols-outlined !text-[20px] !text-[color:var(--color-danger)]">gavel</span>
              Potential Legal Fine
            </span>
            <span class="text-2xl font-black text-[color:var(--color-danger)]">$50,000+</span>
          </div>
          <div class="pt-4 flex items-center justify-center gap-2 text-xs text-slate-400">
            <span class="material-symbols-outlined !text-sm">lock</span> 256-bit Encrypted · Cancel Anytime
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
