---
import { IconArrowRight, IconBolt, IconCash, IconGavel, IconLock } from "@tabler/icons-react";

interface Props {
  heading?: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const {
  heading = "Start small. Stay safe.",
  body = "Why risk a $50,000 lawsuit for unconsented data when you can start identifying legally for just $10?",
  ctaLabel = "Start $10 Trial Today",
  ctaHref = "/get-started/",
} = Astro.props as Props;
---

<section class="section-dark relative overflow-hidden">
  <!-- ambient mint -->
  <div aria-hidden="true" class="pointer-events-none absolute -right-32 top-1/2 size-[480px] -translate-y-1/2 rounded-full bg-[color:var(--color-mint-400)]/15 blur-[120px]"></div>

  <div class="container-content section">
    <div class="grid items-center gap-16 md:grid-cols-[1.1fr_1fr]">
      <div>
        <p class="eyebrow mb-6">Get started today</p>
        <h2 class="display-1 mb-7 text-white">{heading}</h2>
        <p class="mb-10 max-w-xl text-lg leading-relaxed text-slate-300">{body}</p>
        <a
          href={ctaHref}
          class="inline-flex items-center gap-2 rounded-lg bg-[color:var(--color-mint-400)] px-7 py-4 text-base font-semibold text-[color:var(--color-navy-900)] transition-all hover:bg-[color:var(--color-mint-300)] hover:shadow-[0_16px_40px_-12px_rgba(0,229,160,0.6)] hover:-translate-y-0.5"
        >
          <IconBolt size={18} stroke={2.25} />
          {ctaLabel}
          <IconArrowRight size={18} stroke={2.25} />
        </a>
      </div>

      <div class="space-y-3">
        <div class="flex items-center justify-between rounded-2xl bg-white/[0.04] p-6 ring-1 ring-inset ring-white/10">
          <span class="flex items-center gap-3 text-[15px] text-slate-300">
            <IconCash size={20} stroke={1.5} color="#00E5A0" />
            Monthly trial fee
          </span>
          <span class="font-display text-3xl font-bold tracking-tight text-[color:var(--color-mint-400)]">$10</span>
        </div>
        <div class="flex items-center justify-between rounded-2xl bg-[color:var(--color-danger)]/[0.08] p-6 ring-1 ring-inset ring-[color:var(--color-danger)]/20">
          <span class="flex items-center gap-3 text-[15px] text-slate-300">
            <IconGavel size={20} stroke={1.5} color="#EF4444" />
            Potential legal fine
          </span>
          <span class="font-display text-3xl font-bold tracking-tight text-[color:var(--color-danger)]">$50,000+</span>
        </div>
        <div class="flex items-center justify-center gap-1.5 pt-5 text-xs text-slate-400">
          <IconLock size={12} stroke={1.75} />
          256-bit encrypted · Cancel anytime · No card to start
        </div>
      </div>
    </div>
  </div>
</section>
