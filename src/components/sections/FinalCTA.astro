---
interface Props {
  heading?: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const {
  heading = "Start small. Stay safe.",
  body = "Why risk a $50,000 lawsuit for unconsented data when you can start identifying legally for just $10?",
  ctaLabel = "Start $10 Trial Today",
  ctaHref = "/get-started/",
} = Astro.props as Props;
---

<section class="px-6 py-24 bg-[color:var(--color-paper)]">
  <div class="mx-auto max-w-[1000px]">
    <div class="relative overflow-hidden rounded-[2rem] border border-[color:var(--color-rule)] bg-white p-12 text-center shadow-[0_24px_60px_-32px_rgba(19,22,17,0.18)]">
      <div class="absolute left-0 top-0 h-1 w-full bg-[color:var(--color-vermilion)]"></div>
      <div class="grid items-center gap-12 md:grid-cols-2">
        <div class="text-left">
          <h2 class="mb-6 text-4xl font-black text-[color:var(--color-ink)]">{heading}</h2>
          <p class="mb-8 text-lg text-[color:var(--color-ink-2)]">{body}</p>
          <a href={ctaHref} class="btn-primary w-full px-10 py-5 text-xl glow-hover sm:w-auto">
            {ctaLabel}
          </a>
        </div>
        <div class="space-y-4">
          <div class="flex items-center justify-between rounded-2xl border border-[color:var(--color-rule)] bg-[color:var(--color-paper)] p-6">
            <span class="text-[color:var(--color-ink-2)]">Monthly Trial Fee</span>
            <span class="text-2xl font-black text-[color:var(--color-vermilion)]">$10</span>
          </div>
          <div class="flex items-center justify-between rounded-2xl border border-[color:var(--color-danger)]/30 bg-[color:var(--color-danger)]/5 p-6">
            <span class="text-[color:var(--color-ink-2)]">Potential Legal Fine</span>
            <span class="text-2xl font-black text-[color:var(--color-danger)]">$50,000+</span>
          </div>
          <div class="pt-4 flex items-center justify-center gap-2 text-xs text-[color:var(--color-ink-muted)]">
            <span class="material-symbols-outlined !text-sm">lock</span> 256-bit Encrypted Dashboard · Cancel Anytime
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
