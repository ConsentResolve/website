---
import Button from "~/components/ui/Button.astro";
import Badge from "~/components/ui/Badge.astro";
import { IconArrowRight, IconBolt, IconCash, IconLock, IconCheck } from "@tabler/icons-react";

interface Props {
  heading?: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const {
  heading = "Your next job is already shopping your site.",
  body = "Go get it. Flat $7 per lead — yours alone, never resold. Call them, book the jobs, and see what consented leads are worth. Legal from the first click. Cancel anytime.",
  ctaLabel = "Get Started",
  ctaHref = "https://dashboard.consentresolve.com/register",
} = Astro.props as Props;
---

<section class="section-dark relative overflow-hidden">
  <div aria-hidden="true" class="pointer-events-none absolute -right-32 top-1/2 size-[480px] -translate-y-1/2 rounded-full bg-[color:var(--color-mint-400)]/15 blur-[120px]"></div>

  <div class="container-content section">
    <div class="grid items-center gap-16 md:grid-cols-[1.1fr_1fr]">
      <div>
        <div class="mb-6"><Badge tone="brand" variant="soft" surface="dark" size="md" uppercase>Get started today</Badge></div>
        <h2 class="display-1 mb-7 text-white">{heading}</h2>
        <p class="mb-10 max-w-xl text-lg leading-relaxed text-slate-300">{body}</p>
        <Button
          href={ctaHref}
          size="lg"
          class="!bg-[color:var(--color-mint-400)] !text-[color:var(--color-navy-900)] hover:!bg-[color:var(--color-mint-300)] hover:shadow-[0_16px_40px_-12px_rgba(0,229,160,0.6)] hover:-translate-y-0.5"
        >
          <IconBolt size={18} stroke={2.25} />
          {ctaLabel}
          <IconArrowRight size={18} stroke={2.25} />
        </Button>
      </div>

      <div class="space-y-3">
        <div class="flex items-center justify-between rounded-2xl bg-white/[0.04] p-6 ring-1 ring-inset ring-white/10">
          <span class="flex items-center gap-3 text-[15px] text-slate-300">
            <IconCash size={20} stroke={1.5} color="#00E5A0" />
            Per lead — flat
          </span>
          <span class="font-display text-3xl font-bold tracking-tight text-[color:var(--color-mint-400)]">$7</span>
        </div>
        <div class="flex items-center justify-between rounded-2xl bg-white/[0.04] p-6 ring-1 ring-inset ring-white/10">
          <span class="flex items-center gap-3 text-[15px] text-slate-300">
            <IconCheck size={20} stroke={2} color="#00E5A0" />
            Exclusive — never resold
          </span>
          <span class="font-display text-base font-semibold tracking-tight text-[color:var(--color-mint-400)]">Yours alone</span>
        </div>
        <div class="flex items-center justify-center gap-1.5 pt-5 text-xs text-slate-400">
          <IconLock size={12} stroke={1.75} />
          256-bit encrypted · Card required · Cancel anytime
        </div>
      </div>
    </div>
  </div>
</section>
