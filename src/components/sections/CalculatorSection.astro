---
import LeadROICalculator from "~/components/ui/LeadROICalculator.tsx";
import MetricCard from "~/components/ui/MetricCard.astro";
import { IconUserCheck, IconCash, IconClock } from "@tabler/icons-react";

const trend = [12, 18, 24, 28, 34, 38, 47, 52, 58, 66, 72, 84];
const revTrend = [4, 7, 9, 12, 14, 18, 22, 27, 30, 34, 38, 44];
const dipTrend = [240, 220, 210, 195, 184, 172, 158, 142, 124, 108, 96, 87];
---

<section class="section section-dark">
  <div class="container-content">
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <p class="eyebrow mb-5 justify-center" style="color:var(--color-mint-400)">Run the numbers</p>
      <h2 class="display-2 text-white">
        See what exclusive leads do to your bottom line.
      </h2>
      <p class="mt-3 text-lg leading-relaxed text-slate-300">
        Put in your real numbers. No email, no signup wall.
      </p>
    </div>

    <!-- Network impact -->
    <div class="mx-auto mb-10 max-w-4xl">
      <p class="mb-4 text-center text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">
        Network impact · last 30 days <span class="ml-1 text-slate-500">[ILLUSTRATIVE — REPLACE]</span>
      </p>
      <div class="grid gap-4 md:grid-cols-3">
        <MetricCard variant="dark" label="Avg leads / shop" value="84"
          delta={{ direction: "up", value: "+22%", period: "vs last month" }}
          sparkline={trend} icon={IconUserCheck} />
        <MetricCard variant="dark" label="Avg booked revenue" value="$28.4k"
          delta={{ direction: "up", value: "+18%", period: "MoM" }}
          sparkline={revTrend} icon={IconCash} />
        <MetricCard variant="dark" label="Avg cost / job" value="$87"
          delta={{ direction: "down", value: "−63%", period: "vs Thumbtack" }}
          sparkline={dipTrend} icon={IconClock} />
      </div>
    </div>

    <div class="mx-auto max-w-4xl">
      <LeadROICalculator client:visible variant="dark" />
    </div>
  </div>
</section>
