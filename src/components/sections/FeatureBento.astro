---
/**
 * Homepage feature section — grouped by the four "everything it does"
 * categories from /features/. Pulls from src/data/features.ts so this
 * stays in lockstep with the dedicated /features/ pages.
 */
import FeatureCard from "~/components/ui/FeatureCard.astro";
import { FEATURE_GROUPS } from "~/data/features";
import { FEATURE_ICONS } from "~/lib/feature-icons";
import { IconArrowRight } from "@tabler/icons-react";
---

<section class="section">
  <div class="container-content">
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <p class="eyebrow mb-5 justify-center">Everything it does</p>
      <h2 class="display-2 text-[color:var(--color-ink)]">
        Every visitor who leaves without calling<br/>
        <span class="text-[color:var(--color-brand-pressed)]">is a job you'll never know you lost.</span>
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-[color:var(--color-ink-2)]">
        Consent Resolve turns the anonymous people on your website into named leads you can actually call — exclusively yours, every one opted in.
      </p>
    </div>

    <div class="space-y-20">
      {FEATURE_GROUPS.map((group) => (
        <div>
          <div class="mx-auto mb-10 max-w-3xl text-center">
            <h3 class="font-display text-2xl font-black tracking-tight text-[color:var(--color-ink)] md:text-3xl">
              {group.title}
            </h3>
            <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">{group.blurb}</p>
          </div>

          <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {group.features.map((f) => {
              const Icon = FEATURE_ICONS[f.iconKey];
              return (
                <a href={`/features/${f.slug}/`} class="block focus:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-brand)] focus-visible:ring-offset-2 rounded-2xl">
                  <FeatureCard variant="showcase" icon={Icon} title={f.name} body={f.tagline} />
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </div>

    <div class="mt-16 text-center">
      <a
        href="/features/"
        class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-brand)] px-7 py-3.5 text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--color-navy-900)] shadow-[0_18px_36px_-18px_rgba(0,229,160,0.55)] transition-all hover:-translate-y-0.5 hover:bg-[color:var(--color-brand-pressed)] hover:text-white"
      >
        See every feature
        <IconArrowRight size={16} stroke={2.5} />
      </a>
    </div>
  </div>
</section>
