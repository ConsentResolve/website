---
import {
  IconUserSearch, IconMapPin, IconTool, IconClock,
  IconArrowsLeftRight, IconBan, IconShieldCheck, IconTrendingUp,
} from "@tabler/icons-react";

interface Feature { Icon: any; title: string; body: string; }
const features: Feature[] = [
  { Icon: IconUserSearch, title: "Verified name & number", body: "The actual homeowner — first, last, mobile. Not a household label." },
  { Icon: IconMapPin, title: "Address & service area", body: "Drops a pin on your map. Filter by zip, route, or radius." },
  { Icon: IconTool, title: "What they're shopping for", body: "Captured intent: 'water heater quote', 'roof inspection', 'AC tune-up'." },
  { Icon: IconClock, title: "Sub-5-minute alerts", body: "Slack, SMS, or email the second consent fires. First to call wins." },
  { Icon: IconArrowsLeftRight, title: "CRM & dispatch sync", body: "Pushes to Jobber, Housecall Pro, ServiceTitan, HubSpot, or your sheet." },
  { Icon: IconBan, title: "Never shared", body: "Goes to you only. Not auctioned to three other shops." },
  { Icon: IconShieldCheck, title: "Compliant by default", body: "GDPR, CCPA, CPA. Iron-clad audit trail via Termageddon." },
  { Icon: IconTrendingUp, title: "Return-visit alerts", body: "If a homeowner comes back to your site, you know. Time it right." },
];
---

<section class="section">
  <div class="container-content">
    <div class="mb-14 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow mb-5">Tools included</p>
        <h2 class="display-2 text-[color:var(--color-ink)]">Everything in your toolbox.</h2>
      </div>
      <p class="max-w-md text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">
        What lands in your dashboard the moment a homeowner consents.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-px overflow-hidden rounded-2xl bg-[#e6e6e6] sm:grid-cols-2 lg:grid-cols-4" style="box-shadow: 0 0 0 1px #e6e6e6;">
      {features.map((f) => (
        <div class="group relative bg-[color:var(--color-bg-alt)] p-7 transition-colors hover:bg-[color:var(--color-bg)]">
          <div class="mb-5 inline-flex size-11 items-center justify-center rounded-xl bg-[color:var(--color-bg)] text-[color:var(--color-ink-2)] group-hover:bg-[color:var(--color-brand-soft)] group-hover:text-[color:var(--color-brand-pressed)] transition-colors">
            <f.Icon size={20} stroke={1.5} />
          </div>
          <h3 class="mb-2 text-[15px] font-semibold tracking-tight text-[color:var(--color-ink)]">{f.title}</h3>
          <p class="text-[14px] leading-relaxed text-[color:var(--color-ink-2)]">{f.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
