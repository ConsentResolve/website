---
import FeatureCard from "~/components/ui/FeatureCard.astro";
import {
  IconUserCheck,
  IconMapPin,
  IconClipboardCheck,
  IconBellRinging,
  IconPlugConnected,
  IconRefresh,
  IconLock,
  IconShieldCheck,
  IconCode,
} from "@tabler/icons-react";

const features = [
  { Icon: IconUserCheck,      title: "Real names. Real numbers.",     body: "First name, last name, mobile phone. The actual homeowner — not a household label, not a P.O. box, not a lead three shops already bought." },
  { Icon: IconMapPin,         title: "Mapped to your zip.",           body: "Every lead drops a pin on your service-area map. Filter by zip, route, or distance from the shop." },
  { Icon: IconClipboardCheck, title: "Why they're shopping.",         body: "\"AC tune-up.\" \"Water-heater quote.\" \"Roof inspection.\" What they want, captured the moment they consent." },
  { Icon: IconBellRinging,    title: "On your phone in five.",        body: "A Slack, text, or email the second a homeowner consents. First one to call usually wins the job." },
  { Icon: IconPlugConnected,  title: "Lands in your CRM.",            body: "Pushes straight to Jobber, Housecall Pro, ServiceTitan, HubSpot, Klaviyo — or anything else through a webhook." },
  { Icon: IconRefresh,        title: "They came back? You'll know.",  body: "Return-visit alerts fire when a known homeowner is back on your site. Time your follow-up right." },
  { Icon: IconLock,           title: "Yours alone. Never resold.",    body: "Not auctioned to four other shops. Not flipped next week. One consent, one contractor — you." },
  { Icon: IconShieldCheck,    title: "Legal by default.",             body: "GDPR, CCPA, and CPA covered from day one. Iron-clad audit trail, backed by Termageddon." },
  { Icon: IconCode,           title: "Set up in ten minutes.",        body: "Paste one line of code. WordPress, Wix, Squarespace, ServiceTitan sites — it just works." },
];
---

<section class="section">
  <div class="container-content">
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <p class="eyebrow mb-5 justify-center">Tools included</p>
      <h2 class="display-2 text-[color:var(--color-ink)]">
        Everything in your toolbox.
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-[color:var(--color-ink-2)]">
        The second a homeowner consents, here's what shows up.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <FeatureCard variant="showcase" icon={f.Icon} title={f.title} body={f.body} />
      ))}
    </div>
  </div>
</section>
