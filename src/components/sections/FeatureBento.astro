---
import FeatureCard from "~/components/ui/FeatureCard.astro";
import {
  IconUserCheck,
  IconMapPin,
  IconClipboardCheck,
  IconBellRinging,
  IconPlugConnected,
  IconLock,
  IconShieldCheck,
  IconRefresh,
  IconBolt,
} from "@tabler/icons-react";
---

<section class="section">
  <div class="container-content">
    <div class="mb-14 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow mb-5">Tools included</p>
        <h2 class="display-2 text-[color:var(--color-ink)]">Everything in your toolbox.</h2>
      </div>
      <p class="max-w-md text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">
        What lands in your dashboard the moment a homeowner consents.
      </p>
    </div>

    <!-- Bento grid: 1 featured (lg, 2-col) + 6 regular -->
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-4">
      <!-- Featured card spans 2 columns -->
      <div class="md:col-span-2 lg:col-span-2 lg:row-span-2">
        <FeatureCard
          size="lg"
          variant="featured"
          icon={IconBolt}
          title="The unfair advantage"
          body="Identify the homeowners shopping your service area — only after they consent. First contractor to call wins. We get you on the phone in under five minutes, with a name, number, and what they need."
          badge="Best for service pros"
        />
      </div>

      <FeatureCard variant="lift" icon={IconUserCheck} title="Verified name & phone" body="The actual homeowner — first, last, mobile. Not a household label." />
      <FeatureCard variant="lift" icon={IconMapPin} title="Service area pin" body="Drops on your map. Filter by zip, route, or radius from your shop." />
      <FeatureCard variant="lift" icon={IconClipboardCheck} title="Captured intent" body="'AC tune-up', 'roof inspection', 'water heater quote' — at the moment of consent." />
      <FeatureCard variant="lift" icon={IconBellRinging} title="Sub-5-min alerts" body="Slack, SMS, or email the second consent fires. First to call wins." />
      <FeatureCard variant="lift" icon={IconPlugConnected} title="CRM & dispatch sync" body="Pushes to Jobber, Housecall Pro, ServiceTitan, HubSpot, or your sheet." />
      <FeatureCard variant="lift" icon={IconRefresh} title="Return-visit alerts" body="If a homeowner comes back to your site, you know. Time it right." />
    </div>

    <!-- Footer row: compliance + exclusivity in accent-bar style -->
    <div class="mt-5 grid grid-cols-1 gap-5 md:grid-cols-2">
      <FeatureCard variant="accent-bar" icon={IconShieldCheck} title="Compliant by default" body="GDPR, CCPA, CPA. Iron-clad audit trail via Termageddon. Auditor-ready from day one." />
      <FeatureCard variant="accent-bar" icon={IconLock} title="Never shared" body="Goes to you only. Not auctioned to three other shops. Not resold next week." />
    </div>
  </div>
</section>
