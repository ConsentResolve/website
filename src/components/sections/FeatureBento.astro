---
import FeatureCard from "~/components/ui/FeatureCard.astro";
import {
  IconUserCheck,
  IconMapPin,
  IconClipboardCheck,
  IconBellRinging,
  IconPlugConnected,
  IconLock,
  IconShieldCheck,
  IconRefresh,
  IconBolt,
} from "@tabler/icons-react";

const features = [
  { Icon: IconUserCheck,      title: "Real names. Real numbers.",     body: "First name, last name, mobile phone. The actual homeowner — not a household label, not a P.O. box, not a stale lead." },
  { Icon: IconMapPin,         title: "Mapped to your zip.",           body: "Every lead drops a pin on your service area map. Filter by zip, route, or radius from your shop." },
  { Icon: IconClipboardCheck, title: "Why they're shopping.",         body: "'AC tune-up', 'water heater quote', 'roof inspection' — intent captured at the moment of consent." },
  { Icon: IconBellRinging,    title: "On your phone in five.",        body: "Slack, SMS, or email the second a homeowner consents. First contractor to call wins the job." },
  { Icon: IconPlugConnected,  title: "Lands in your CRM.",            body: "Native push to Jobber, Housecall Pro, ServiceTitan, HubSpot, Klaviyo — anything via webhook." },
  { Icon: IconRefresh,        title: "They came back? You'll know.",  body: "Return-visit alerts fire when an identified lead returns to your site. Time the follow-up." },
  { Icon: IconLock,           title: "Yours alone. Never resold.",    body: "Not auctioned to four other shops. Not flipped next week. One consent, one contractor — you." },
  { Icon: IconShieldCheck,    title: "Audit-ready by default.",       body: "GDPR, CCPA, and CPA compliant from day one. Iron-clad audit trail backed by Termageddon." },
  { Icon: IconBolt,           title: "Set up in ten minutes.",        body: "Paste one line of code. Works on WordPress, Wix, Squarespace, ServiceTitan websites — anything." },
];
---

<section class="section">
  <div class="container-content">
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <p class="eyebrow mb-5 justify-center">Tools included</p>
      <h2 class="display-2 text-[color:var(--color-ink)]">
        Everything in your toolbox.
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-[color:var(--color-ink-2)]">
        What lands in your dashboard the moment a homeowner consents.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <FeatureCard variant="showcase" icon={f.Icon} title={f.title} body={f.body} />
      ))}
    </div>
  </div>
</section>
