---
import Funnel from "~/components/ui/Funnel.astro";
import AnimatedStat from "~/components/ui/AnimatedStat.tsx";
import { IconUserOff, IconUsersGroup, IconCoin } from "@tabler/icons-react";
---

<section class="section section-dark">
  <div class="container-content">
    <div class="mb-14 max-w-2xl">
      <p class="eyebrow mb-5" style="color:var(--color-mint-400)">The problem</p>
      <h2 class="display-2 text-white">
        Every visitor who leaves without a name is a job you didn't win.
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-slate-300">
        You paid to get that homeowner to your site — an ad, a search, a referral. Then most of them leave without a trace. They price-shop, then call the next guy. You never even knew they stopped by.
      </p>
    </div>

    <div class="grid items-start gap-12 lg:grid-cols-[1.1fr_1fr]">
      <!-- Funnel -->
      <div class="rounded-2xl bg-white/[0.03] p-7 ring-1 ring-inset ring-white/10">
        <p class="mb-5 text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">Typical contractor site · 1,000 visitors / month</p>
        <div style="--color-bg: rgba(255,255,255,0.08); --color-ink: #ffffff; --color-ink-muted: #94a3b8;">
          <Funnel
            stages={[
              { label: "Site visitors", value: 1000 },
              { label: "Stayed >30s", value: 420 },
              { label: "Viewed pricing", value: 180 },
              { label: "Filled a form", value: 22 },
              { label: "Answered the phone", value: 9 },
              { label: "Booked a job", value: 3 },
            ]}
          />
        </div>
      </div>

      <!-- 3 standout stats -->
      <div class="space-y-4">
        <div class="rounded-2xl bg-white/[0.03] p-6 ring-1 ring-inset ring-white/10">
          <div class="mb-3 inline-flex size-10 items-center justify-center rounded-xl bg-[color:var(--color-danger)]/15">
            <IconUserOff size={20} stroke={1.75} color="#fca5a5" />
          </div>
          <AnimatedStat client:visible value={95} suffix="%" tone="danger" size="lg" />
          <p class="mt-2 text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">Walk away anonymous</p>
          <p class="mt-2 text-sm leading-relaxed text-slate-300">Homeowners who shop your site, then call a competitor you'll never know existed.</p>
        </div>

        <div class="rounded-2xl bg-white/[0.03] p-6 ring-1 ring-inset ring-white/10">
          <div class="mb-3 inline-flex size-10 items-center justify-center rounded-xl bg-[color:var(--color-mint-400)]/15">
            <IconUsersGroup size={20} stroke={1.75} color="#00E5A0" />
          </div>
          <div class="font-display text-4xl md:text-5xl font-bold leading-none tracking-tight text-[color:var(--color-mint-400)]">4–6×</div>
          <p class="mt-2 text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">Shared-lead resell rate <span class="ml-1 text-slate-500">[ILLUSTRATIVE]</span></p>
          <p class="mt-2 text-sm leading-relaxed text-slate-300">Thumbtack and Angi auction the same lead to four other shops. You pay to compete.</p>
        </div>

        <div class="rounded-2xl bg-white/[0.03] p-6 ring-1 ring-inset ring-white/10">
          <div class="mb-3 inline-flex size-10 items-center justify-center rounded-xl bg-white/10">
            <IconCoin size={20} stroke={1.75} color="#cbd5e1" />
          </div>
          <div class="font-display text-4xl md:text-5xl font-bold leading-none tracking-tight text-white">$X,XXX</div>
          <p class="mt-2 text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">Left on the table each month <span class="ml-1 text-slate-500">[ILLUSTRATIVE]</span></p>
          <p class="mt-2 text-sm leading-relaxed text-slate-300">Example for a 60-job-per-month shop on shared leads. Run your real numbers below.</p>
        </div>
      </div>
    </div>
  </div>
</section>
