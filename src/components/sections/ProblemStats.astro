---
import Illustration from "~/components/Illustration.astro";
import { IconUserOff, IconUsersGroup, IconCoin } from "@tabler/icons-react";

interface Stat { label: string; value: string; tone: "danger" | "primary" | "neutral"; note: string; Icon: any; }
const stats: Stat[] = [
  { label: "Walk away anonymous", value: "98%", tone: "danger", Icon: IconUserOff, note: "Homeowners price-shop your site, then call a competitor you'll never know existed." },
  { label: "Shared-lead resell rate", value: "4–6×", tone: "primary", Icon: IconUsersGroup, note: "Thumbtack and Angi auction the same lead to four other shops. You're paying to compete." },
  { label: "Jobs left on the table", value: "$XX,XXX", tone: "neutral", Icon: IconCoin, note: "Monthly revenue lost to whichever contractor calls back first." },
];

const toneClass = (t: Stat["tone"]) =>
  t === "danger" ? "text-[color:var(--color-danger)]"
  : t === "primary" ? "text-[color:var(--color-brand)]"
  : "text-[color:var(--color-ink)]";
---

<section class="section section-dark">
  <div class="container-content grid items-center gap-16 lg:grid-cols-[0.9fr_1.1fr]">
    <!-- Illustration slot -->
    <div class="relative">
      <Illustration name="anonymous-traffic" alt="Anonymous website visitors walking away" class="w-full h-auto max-w-md mx-auto" />
    </div>

    <div>
      <p class="eyebrow mb-5">The Problem</p>
      <h2 class="display-2 mb-10 text-[color:var(--color-ink)]">
        Every anonymous visitor is a job you<br class="hidden md:block"/> didn't win.
      </h2>
      <div class="space-y-3">
        {stats.map((s) => (
          <div class="flex items-start gap-5 py-5 border-t border-[color:var(--color-rule)]">
            <div class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-[color:var(--color-bg)]">
              <s.Icon size={20} stroke={1.75} />
            </div>
            <div class="flex-1">
              <div class="flex items-baseline gap-4">
                <span class={`text-[2rem] font-bold tracking-tight font-display ${toneClass(s.tone)}`}>{s.value}</span>
                <span class="text-xs font-semibold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">{s.label}</span>
              </div>
              <p class="mt-1.5 text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">{s.note}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
