---
interface Stat { label: string; value: string; tone: "danger" | "primary" | "neutral"; note: string; }
interface Props {
  heading?: string;
  stats?: Stat[];
}
const {
  heading = "Every anonymous visitor is a job you didn't win.",
  stats = [
    { label: "Walk away anonymous", value: "98%", tone: "danger", note: "Homeowners who price-shop your site, then call a competitor you'll never know existed." },
    { label: "Times a shared lead is resold", value: "4–6×", tone: "primary", note: "What Thumbtack and Angi don't tell you. You're paying for the same lead as four other shops." },
    { label: "Jobs left on the table", value: "$XX,XXX", tone: "neutral", note: "Monthly revenue lost to whichever contractor calls back first." },
  ],
} = Astro.props as Props;

const toneClass = (t: Stat["tone"]) =>
  t === "danger" ? "text-[color:var(--color-danger)]" : t === "primary" ? "text-[color:var(--color-brand)]" : "text-[color:var(--color-ink)]";
---

<section class="bg-[color:var(--color-bg-alt)] py-20">
  <div class="mx-auto max-w-[960px] px-6 text-center">
    <h2 class="mb-12 text-3xl font-bold md:text-4xl text-[color:var(--color-ink)]">{heading}</h2>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {stats.map((s) => (
        <div class="card p-8">
          <p class="mb-2 text-sm font-medium uppercase tracking-widest text-[color:var(--color-ink-muted)]">{s.label}</p>
          <p class={`text-5xl font-black ${toneClass(s.tone)}`}>{s.value}</p>
          <p class="mt-4 text-sm text-[color:var(--color-ink-2)]">{s.note}</p>
        </div>
      ))}
    </div>
  </div>
</section>
