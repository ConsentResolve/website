---
import HexBolt from "~/components/HexBolt.astro";

interface Stat { label: string; value: string; tone: "danger" | "primary" | "neutral"; note: string; icon: string; }
interface Props {
  heading?: string;
  stats?: Stat[];
}
const {
  heading = "Every anonymous visitor is a job you didn't win.",
  stats = [
    { label: "Walk away anonymous", value: "98%", tone: "danger", icon: "person_off", note: "Homeowners who price-shop your site, then call a competitor you'll never know existed." },
    { label: "Times a shared lead is resold", value: "4–6×", tone: "primary", icon: "group_remove", note: "Thumbtack and Angi auction the same lead to four other shops. You're paying to compete." },
    { label: "Jobs left on the table", value: "$XX,XXX", tone: "neutral", icon: "savings", note: "Monthly revenue lost to whichever contractor calls back first." },
  ],
} = Astro.props as Props;

const toneClass = (t: Stat["tone"]) =>
  t === "danger" ? "text-[color:var(--color-danger)]" : t === "primary" ? "text-[color:var(--color-brand)]" : "text-[color:var(--color-ink)]";
---

<section class="relative bg-[color:var(--color-bg-alt)] py-24">
  <div class="container-content grid items-center gap-12 lg:grid-cols-[1fr_1.1fr]">
    <!-- VISUAL: row of houses, all anonymous except one revealed -->
    <div class="relative">
      <svg
        aria-hidden="true"
        viewBox="0 0 440 320"
        class="w-full h-auto"
      >
        <!-- ground line -->
        <line x1="0" y1="260" x2="440" y2="260" stroke="var(--color-rule)" stroke-dasharray="3 5" />

        <!-- anonymous house 1 -->
        <g opacity="0.35">
          <polygon points="35,200 70,165 105,200 105,260 35,260" fill="none" stroke="var(--color-ink-muted)" stroke-width="1.5" />
          <rect x="60" y="220" width="20" height="40" fill="none" stroke="var(--color-ink-muted)" stroke-width="1.5" />
          <text x="70" y="186" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="14" font-weight="700" fill="var(--color-ink-muted)">?</text>
        </g>
        <!-- anonymous house 2 -->
        <g opacity="0.35">
          <polygon points="125,205 165,170 205,205 205,260 125,260" fill="none" stroke="var(--color-ink-muted)" stroke-width="1.5" />
          <rect x="155" y="225" width="20" height="35" fill="none" stroke="var(--color-ink-muted)" stroke-width="1.5" />
          <text x="165" y="192" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="14" font-weight="700" fill="var(--color-ink-muted)">?</text>
        </g>

        <!-- REVEALED house (center, larger) -->
        <g>
          <polygon points="220,180 280,130 340,180 340,260 220,260" fill="white" stroke="var(--color-ink)" stroke-width="2" />
          <rect x="265" y="215" width="30" height="45" fill="var(--color-brand-soft)" stroke="var(--color-ink)" stroke-width="2" />
          <rect x="232" y="195" width="20" height="20" fill="var(--color-brand-soft)" stroke="var(--color-ink)" stroke-width="2" />
          <rect x="308" y="195" width="20" height="20" fill="var(--color-brand-soft)" stroke="var(--color-ink)" stroke-width="2" />

          <!-- pin -->
          <g transform="translate(280, 110)">
            <path d="M0,-25 C-12,-25 -20,-15 -20,-3 C-20,12 0,28 0,28 C0,28 20,12 20,-3 C20,-15 12,-25 0,-25 Z" fill="#00C080" stroke="var(--color-navy-900)" stroke-width="1.5" />
            <circle cx="0" cy="-5" r="6" fill="white" />
          </g>

          <!-- name + phone tag -->
          <g transform="translate(355, 175)">
            <rect x="0" y="-22" width="80" height="56" rx="6" fill="white" stroke="var(--color-ink)" stroke-width="1.5" />
            <text x="40" y="-6" text-anchor="middle" font-family="Hanken Grotesk, sans-serif" font-size="11" font-weight="700" fill="var(--color-ink)">Sarah J.</text>
            <text x="40" y="10" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="9" fill="var(--color-ink-2)">(512) 555-0142</text>
            <line x1="6" y1="18" x2="74" y2="18" stroke="var(--color-rule)" />
            <text x="40" y="29" text-anchor="middle" font-family="Hanken Grotesk, sans-serif" font-size="8" font-weight="600" fill="var(--color-brand)" letter-spacing="0.1em">CONSENTED</text>
          </g>
          <line x1="305" y1="155" x2="355" y2="170" stroke="var(--color-ink)" stroke-width="1.25" stroke-dasharray="2 3" />
        </g>

        <!-- anonymous house 4 -->
        <g opacity="0.35">
          <polygon points="240,210 0,0 0,0 0,0" fill="none" />
        </g>
      </svg>
    </div>

    <div>
      <p class="eyebrow mb-4"><span class="material-symbols-outlined !text-[14px]">priority_high</span> The problem</p>
      <h2 class="mb-10 text-3xl font-bold md:text-4xl text-[color:var(--color-ink)] leading-tight">{heading}</h2>
      <div class="space-y-4">
        {stats.map((s) => (
          <div class="relative flex items-start gap-5 rounded-2xl border border-[color:var(--color-rule)] bg-[color:var(--color-bg)] p-5">
            <span class="absolute right-3 top-3 text-[color:var(--color-rule)]"><HexBolt size={12} /></span>
            <div class="flex size-14 shrink-0 items-center justify-center rounded-xl bg-[color:var(--color-bg-alt)] border border-[color:var(--color-rule)]">
              <span class="material-symbols-outlined !text-[26px]">{s.icon}</span>
            </div>
            <div class="flex-1">
              <div class="flex items-baseline gap-3">
                <span class={`text-3xl font-black ${toneClass(s.tone)}`}>{s.value}</span>
                <span class="text-xs font-bold uppercase tracking-widest text-[color:var(--color-ink-muted)]">{s.label}</span>
              </div>
              <p class="mt-1 text-sm text-[color:var(--color-ink-2)]">{s.note}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
