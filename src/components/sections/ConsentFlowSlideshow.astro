---
/**
 * ConsentFlowSlideshow — the canonical "how it works in 3" hero animation.
 *
 * A dark, CSS-only slideshow that cross-fades three cards on a 9s loop
 * (3s each): (1) the "I Accept" button rises on a consent banner, (2) a
 * cursor moves in and clicks "I Accept", (3) an email flies into the CRM.
 *
 * Extracted June 2026 from /features/ so the SAME animation ships on the
 * features hero AND every /[trade]-leads/ industry landing-page hero. To
 * change copy or motion, edit here once — both call sites update.
 *
 * No JS island — pure CSS. Honors prefers-reduced-motion (shows step 1,
 * freezes the rest). The cards carry their own dark background + glow, so
 * the component drops onto a light OR dark hero without extra treatment.
 */
import { IconPointer, IconMail } from "@tabler/icons-react";

const flowSteps: { n: number; hex: string; kind: "banner" | "cursor" | "crm"; title: string; body: string }[] = [
  { n: 1, hex: "#00E5A0", kind: "banner", title: "Consent Banner Appears", body: "A privacy-compliant banner asks visitors for permission to identify them." },
  { n: 2, hex: "#22D3EE", kind: "cursor", title: "Visitor Grants Consent", body: "When they agree, we match them to verified identity data through a trusted, deterministic source." },
  { n: 3, hex: "#A78BFA", kind: "crm",    title: "You Get the Lead",       body: "Name, email, and contact details sent directly to your CRM." },
];
---

<div class="flow-slideshow">
  <div class="flow-stage">
    {flowSteps.map((s, i) => (
      <div class="flowcard" style={`--accent:${s.hex}; --i:${i};`}>
        <span class="flowcard-num">{s.n}</span>
        <h3 class="flowcard-title">{s.title}</h3>
        <p class="flowcard-body">{s.body}</p>
        <div class="flowcard-scene">
        {s.kind === "banner" && (
          <div class="sc sc-banner">
            <span class="sc-line"></span>
            <span class="sc-line sc-line--short"></span>
            <span class="sc-accept">I Accept</span>
          </div>
        )}
        {s.kind === "cursor" && (
          <div class="sc sc-cursor">
            <span class="sc-accept sc-accept--press">I Accept</span>
            <span class="sc-pointer"><IconPointer size={22} stroke={2} /></span>
          </div>
        )}
        {s.kind === "crm" && (
          <div class="sc sc-crm">
            <span class="sc-chip sc-chip--from"><IconMail size={13} stroke={2} /> email</span>
            <span class="sc-flyer"><IconMail size={14} stroke={2.25} /></span>
            <span class="sc-chip sc-chip--to">CRM</span>
          </div>
        )}
      </div>
      </div>
    ))}
  </div>
  <div class="flow-dots" aria-hidden="true">
    {flowSteps.map((s, i) => (
      <span class="flow-dot" style={`--accent:${s.hex}; --i:${i};`}></span>
    ))}
  </div>
</div>

<style>
  /* Hero 3-part slideshow — one dark card visible at a time, cross-fading
     1 → 2 → 3 on a 9s loop (3s per card). Cards are stacked in one grid
     cell so the stage sizes to the tallest card and they fade in place. */
  .flow-slideshow {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .flow-stage {
    display: grid;
  }
  .flowcard {
    grid-area: 1 / 1;
    border-radius: 1rem;
    background: rgba(15, 32, 48, 0.6);
    padding: 1.6rem 1.6rem 1.7rem;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 30%, rgba(255, 255, 255, 0.06)),
                0 24px 64px -28px var(--accent);
    opacity: 0;
    animation: slideFade 9s ease-in-out infinite;
    animation-delay: calc(var(--i) * 3s);
  }
  .flowcard-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.6rem;
    font-family: var(--font-display, "Bricolage Grotesque", serif);
    font-weight: 800;
    font-size: 1.05rem;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
  }
  .flowcard-title {
    margin: 0.9rem 0 0;
    font-family: var(--font-display, "Bricolage Grotesque", serif);
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .flowcard-body {
    margin: 0.5rem 0 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: #94a3b8;
  }
  /* Per-step micro-animation stage at the bottom of each card. */
  .flowcard-scene {
    position: relative;
    overflow: hidden;
    margin-top: 1.2rem;
    height: 3.5rem;
    border-radius: 0.7rem;
    padding: 0 0.9rem;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, rgba(255, 255, 255, 0.02));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 24%, transparent);
  }
  .sc {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    height: 100%;
  }
  .sc-accept {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #0a1628;
    background: var(--accent);
    padding: 0.34rem 0.7rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  /* (1) BANNER — text lines on the left; "I Accept" scrolls up after a pause */
  .sc-line {
    height: 0.4rem;
    width: 3.6rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
  }
  .sc-line--short { width: 2rem; }
  .sc-banner .sc-accept {
    margin-left: auto;
    transform: translateY(150%);
    opacity: 0;
    animation: acceptRise 9s ease-in-out infinite;
    animation-delay: calc(var(--i) * 3s);
  }
  @keyframes acceptRise {
    0%, 12%   { transform: translateY(150%); opacity: 0; }
    19%, 30%  { transform: translateY(0); opacity: 1; }
    34%, 100% { transform: translateY(150%); opacity: 0; }
  }
  /* (2) CURSOR — "I Accept" sits left; pointer moves in and clicks it */
  .sc-cursor .sc-accept--press {
    animation: btnPress 9s ease-in-out infinite;
    animation-delay: calc(var(--i) * 3s);
  }
  @keyframes btnPress {
    0%, 15%   { transform: scale(1); filter: brightness(1); }
    19%, 23%  { transform: scale(0.92); filter: brightness(1.18); }
    27%, 100% { transform: scale(1); filter: brightness(1); }
  }
  .sc-pointer {
    position: absolute;
    left: 0;
    top: 0;
    color: #f8fafc;
    transform: translate(5.4rem, 2.3rem) scale(0.9);
    opacity: 0;
    animation: curMove 9s ease-in-out infinite;
    animation-delay: calc(var(--i) * 3s);
  }
  @keyframes curMove {
    0%        { transform: translate(5.4rem, 2.3rem) scale(0.9); opacity: 0; }
    7%        { opacity: 1; }
    17%       { transform: translate(2.1rem, 0.7rem) scale(1); opacity: 1; }
    19%, 23%  { transform: translate(2.1rem, 0.7rem) scale(0.84); opacity: 1; }
    27%       { transform: translate(2.1rem, 0.7rem) scale(1); opacity: 1; }
    31%, 100% { opacity: 0; }
  }
  /* (3) CRM — email chip on left, envelope flies to the CRM box on right */
  .sc-crm { justify-content: space-between; }
  .sc-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    padding: 0.3rem 0.55rem;
    border-radius: 0.5rem;
    white-space: nowrap;
  }
  .sc-chip--to {
    animation: crmReceive 9s ease-in-out infinite;
    animation-delay: calc(var(--i) * 3s);
  }
  @keyframes crmReceive {
    0%, 22%   { box-shadow: 0 0 0 0 transparent; transform: scale(1); }
    27%       { box-shadow: 0 0 0 2px var(--accent); transform: scale(1.08); }
    33%, 100% { box-shadow: 0 0 0 0 transparent; transform: scale(1); }
  }
  .sc-flyer {
    position: absolute;
    left: 3.1rem;
    top: 50%;
    color: var(--accent);
    transform: translateY(-50%) translateX(0);
    opacity: 0;
    animation: mailFly 9s ease-in-out infinite;
    animation-delay: calc(var(--i) * 3s);
  }
  @keyframes mailFly {
    0%, 9%    { transform: translateY(-50%) translateX(0); opacity: 0; }
    13%       { opacity: 1; }
    25%       { transform: translateY(-50%) translateX(7.5rem); opacity: 1; }
    29%, 100% { transform: translateY(-50%) translateX(7.5rem); opacity: 0; }
  }
  .flow-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }
  .flow-dot {
    height: 0.5rem;
    width: 0.5rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    animation: dotActive 9s ease-in-out infinite;
    animation-delay: calc(var(--i) * 3s);
  }
  @keyframes slideFade {
    0%   { opacity: 0; transform: translateY(10px) scale(0.99); }
    4%   { opacity: 1; transform: none; }
    30%  { opacity: 1; transform: none; }
    34%  { opacity: 0; transform: translateY(-10px) scale(0.99); }
    100% { opacity: 0; }
  }
  @keyframes dotActive {
    0%, 3%    { width: 0.5rem; background: rgba(255, 255, 255, 0.18); }
    5%, 30%   { width: 1.6rem; background: var(--accent); }
    34%, 100% { width: 0.5rem; background: rgba(255, 255, 255, 0.18); }
  }
  /* Reduced motion: no slideshow — show the first step, hide the rest,
     and freeze every inner micro-animation into a static resting state. */
  @media (prefers-reduced-motion: reduce) {
    .flowcard { animation: none; opacity: 0; }
    .flowcard:first-child { opacity: 1; }
    .flow-dots { display: none; }
    .sc-accept, .sc-pointer, .sc-flyer, .sc-chip--to { animation: none !important; }
    .sc-banner .sc-accept { transform: none; opacity: 1; }
    .sc-pointer, .sc-flyer { display: none; }
  }
</style>
