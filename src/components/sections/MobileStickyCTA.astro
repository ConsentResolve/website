---
/**
 * Mobile-only sticky bottom action bar. Hidden on lg+. Auto-hides on
 * /404 (recovery happens inline). Pure CSS — no JS island.
 * The CTA targets the dashboard register URL directly (no /get-started/
 * landing page exists on this site).
 *
 * The bar sits in a position:fixed wrapper, padded to clear the
 * iOS home indicator (env(safe-area-inset-bottom)). Add `cr-no-sticky`
 * to <body> on any page that should suppress it.
 */
const pathname = Astro.url.pathname;
const suppress = pathname === "/404/" || pathname === "/404";
// On the /[trade]-leads/ paid-ad landing pages, the secondary action promotes
// the live demo (the page's primary CTA) instead of the generic "How it works".
const isLeadsLP = /-leads\/?$/.test(pathname);
---

{!suppress && (
  <Fragment>
  <div
    aria-hidden="false"
    class="lg:hidden fixed inset-x-0 bottom-0 z-40 pb-[max(env(safe-area-inset-bottom),0.5rem)] pt-2 px-3 bg-gradient-to-t from-[color:var(--color-bg)] via-[color:var(--color-bg)]/95 to-transparent"
    role="region"
    aria-label="Quick actions"
  >
    <div class="flex items-center gap-2 rounded-2xl bg-[color:var(--color-navy-900)] p-2 ring-1 ring-inset ring-white/10 shadow-[0_18px_36px_-12px_rgba(10,22,40,0.55)]">
      {/* Secondary action — hidden on the narrowest phones. On /[trade]-leads/
          landing pages the PRIMARY (brand) button is the live demo and this
          secondary carries "Get Started"; elsewhere it's how-it-works. */}
      <a
        href={isLeadsLP ? "https://dashboard.consentresolve.com/register" : "/how-it-works/"}
        class="hidden flex-1 items-center justify-center gap-1.5 rounded-xl px-3 py-3 text-[12px] font-bold uppercase tracking-[0.14em] text-white ring-1 ring-inset ring-white/15 hover:bg-white/5 sm:inline-flex"
      >
        {isLeadsLP ? "Get Started — $7" : "How it works"}
      </a>
      <a
        href={isLeadsLP ? "/demo/?utm_source=industry_lp&utm_medium=landing_page&utm_content=sticky" : "https://dashboard.consentresolve.com/register"}
        class="inline-flex flex-1 items-center justify-center gap-1.5 rounded-xl bg-[color:var(--color-brand)] px-3 py-3 text-[12px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-navy-900)] hover:bg-[color:var(--color-brand-pressed)] hover:text-white"
      >
        {isLeadsLP ? "See a live demo" : "Get Started — $7"}
      </a>
      {/* Chat with us — opens Crisp (window.crOpenChat, defined in BaseLayout) */}
      <button
        type="button"
        onclick="window.crOpenChat&&window.crOpenChat()"
        class="inline-flex flex-1 items-center justify-center gap-1.5 rounded-xl px-3 py-3 text-[12px] font-bold uppercase tracking-[0.14em] text-white ring-1 ring-inset ring-white/15 hover:bg-white/5"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
        Chat with Us
      </button>
    </div>
  </div>
  </Fragment>
)}
