---
import { PRIMARY_NAV } from "~/lib/site";
---

<header class="sticky top-0 z-50 w-full border-b border-white/10 bg-[color:var(--color-background-dark)]/80 backdrop-blur-md">
  <div class="container-content flex h-16 items-center justify-between">
    <a href="/" class="flex items-center gap-2 group">
      <div class="size-8 rounded-lg bg-[color:var(--color-primary)] flex items-center justify-center">
        <span class="material-symbols-outlined !text-[color:var(--color-background-dark)]">security</span>
      </div>
      <h2 class="text-xl font-bold tracking-tight">Consent Resolve</h2>
    </a>
    <nav class="hidden md:flex items-center gap-8" aria-label="Primary">
      {PRIMARY_NAV.map((item) => (
        <a class="text-sm font-medium hover:text-[color:var(--color-primary)] transition-colors" href={item.href}>{item.label}</a>
      ))}
    </nav>
    <a href="/get-started/" class="bg-[color:var(--color-primary)] text-[color:var(--color-background-dark)] px-5 py-2 rounded-lg font-bold text-sm glow-hover transition-all">
      Start $10 Trial
    </a>
  </div>
</header>
