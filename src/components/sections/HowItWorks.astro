---
import Illustration from "~/components/Illustration.astro";
import { IconCode, IconClick, IconPhoneRinging } from "@tabler/icons-react";

interface Step { Icon: any; title: string; body: string; illustration: string; }
const steps: Step[] = [
  { Icon: IconCode, title: "Drop in one line of code", body: "Paste our snippet on your site. Works with WordPress, Wix, Squarespace, ServiceTitan websites — anything.", illustration: "step-install" },
  { Icon: IconClick, title: "Homeowner taps Yes", body: "A compliant banner asks for consent. The ones ready to hire opt in.", illustration: "step-consent" },
  { Icon: IconPhoneRinging, title: "Call them back in 5 minutes", body: "Name, phone, and what service they're shopping — pushed to your CRM, Slack, or email instantly.", illustration: "step-call" },
];
---

<section class="section section-dark">
  <div class="container-content">
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <p class="eyebrow mb-5 justify-center">How it works</p>
      <h2 class="display-2 text-[color:var(--color-ink)]">From anonymous visitor to dispatched job in three steps.</h2>
    </div>

    <div class="grid gap-12 md:grid-cols-3">
      {steps.map((s, i) => (
        <div class="relative">
          <div class="aspect-[4/3] mb-6 overflow-hidden rounded-2xl bg-[color:var(--color-bg)]">
            <Illustration name={s.illustration} alt={s.title} class="h-full w-full object-contain p-6" />
          </div>
          <div class="flex items-center gap-3 mb-3">
            <span class="step-badge">0{i + 1}</span>
            <span class="text-[color:var(--color-ink-2)]">
              <s.Icon size={20} stroke={1.75} />
            </span>
          </div>
          <h3 class="mb-2 text-xl font-semibold tracking-tight text-[color:var(--color-ink)]">{s.title}</h3>
          <p class="text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">{s.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
