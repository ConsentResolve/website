---
/**
 * HowItWorks — canonical 4-step comet (promoted from preview Nov 2026).
 *
 * Dark theme, four-node horizontal layout (stacked on mobile), with an
 * animated comet sweeping the progress track and lighting each step in
 * sequence. Used on / (homepage), /how-it-works/, every industry page,
 * and previewed in /style-guide/how-it-works/.
 *
 * Illustrations: brand-locked SVGs generated via Recraft (custom Brand
 * Style 214dccd1-…) and HSL-snapped to the 4-color palette.
 *   01 anonymous-visit  — ghost in a browser window
 *   02 say-yes          — thumbs-up + consent dialog with checkmark
 *   03 lead-revealed    — contact card with avatar + reveal sparks
 *   04 call-and-close   — phone arcing to a handshake + checkmark badge
 * Source files: public/illustrations/hiw/*.svg
 * Regenerate: python3 scripts/generate-recraft.py --set=hiw \
 *               --style-id=214dccd1-dca3-43e6-b005-c664e1b33338
 *             python3 scripts/recolor-illustrations.py \
 *               --in-dir=public/illustrations/hiw
 */
---

<section class="hiw">
  <div class="hiw-orb hiw-orb-a" aria-hidden="true"></div>
  <div class="hiw-orb hiw-orb-b" aria-hidden="true"></div>

  <div class="container-content relative">
    <header class="hiw-head">
      <h2>From an anonymous bounce to an inbound call — in four steps.</h2>
    </header>

    <ol class="hiw-steps">
      <div class="hiw-track" aria-hidden="true">
        <span class="hiw-comet"></span>
      </div>

      <li class="hiw-step" data-idx="0" style="--delay:0s">
        <div class="hiw-node hiw-node-illu">
          <img src="/illustrations/hiw/01-anonymous-visit.svg" alt="" />
        </div>
        <div class="hiw-badge">Step 01</div>
        <h3>Anonymous Bounce</h3>
        <p>A homeowner lands from your Google, LSA, Meta, or SEO traffic. 98 out of 100 leave without contacting you.</p>
      </li>

      <li class="hiw-step" data-idx="1" style="--delay:0.16s">
        <div class="hiw-node hiw-node-illu">
          <img src="/illustrations/hiw/02-say-yes.svg" alt="" />
        </div>
        <div class="hiw-badge">Step 02</div>
        <h3>They Say Yes</h3>
        <p>Your consent banner asks. The homeowner accepts. Now the bounce can be recovered — consent-first, compliant, audit-logged.</p>
      </li>

      <li class="hiw-step" data-idx="2" style="--delay:0.32s">
        <div class="hiw-node hiw-node-illu">
          <img src="/illustrations/hiw/03-lead-revealed.svg" alt="" />
        </div>
        <div class="hiw-badge">Step 03</div>
        <h3>Fed Into Your Funnel</h3>
        <p>The recovered visitor flows into your retargeting audiences, your email/SMS sequences, and your CRM — the funnel you already run.</p>
      </li>

      <li class="hiw-step" data-idx="3" style="--delay:0.48s">
        <div class="hiw-node hiw-node-illu">
          <img src="/illustrations/hiw/04-call-and-close.svg" alt="" />
        </div>
        <div class="hiw-badge">Step 04</div>
        <h3>Inbound Call</h3>
        <p>The homeowner returns on their own time — through your retargeting, your follow-up email, your nurture — and calls you. A warm inbound, not a cold outbound.</p>
      </li>
    </ol>
  </div>
</section>

<style>
  .hiw {
    position: relative;
    overflow: hidden;
    background: #0a1628;
    color: #fff;
    padding-block: 6rem;
  }

  /* Ambient floating orbs */
  .hiw-orb {
    position: absolute;
    width: 540px;
    height: 540px;
    border-radius: 9999px;
    pointer-events: none;
    filter: blur(40px);
  }
  .hiw-orb-a {
    top: -180px;
    left: -160px;
    background: radial-gradient(closest-side, rgba(0, 229, 160, 0.18), transparent 70%);
    animation: hiw-orb-a 16s ease-in-out infinite alternate;
  }
  .hiw-orb-b {
    bottom: -200px;
    right: -180px;
    background: radial-gradient(closest-side, rgba(0, 229, 160, 0.12), transparent 70%);
    animation: hiw-orb-b 21s ease-in-out infinite alternate;
  }
  @keyframes hiw-orb-a { from { transform: translate(0, 0); } to { transform: translate(60px, 40px); } }
  @keyframes hiw-orb-b { from { transform: translate(0, 0); } to { transform: translate(-50px, -30px); } }

  .hiw-head { text-align: center; max-width: 820px; margin: 0 auto 3rem; }
  .hiw-head h2 {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.03em;
    font-size: clamp(1.875rem, 3.5vw, 2.5rem);
    color: #fff;
    line-height: 1.05;
  }

  /* Steps */
  .hiw-steps {
    position: relative;
    max-width: 1140px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    list-style: none;
    padding: 0;
  }
  @media (min-width: 768px) {
    .hiw-steps { grid-template-columns: repeat(2, 1fr); gap: 2.5rem 1.5rem; }
  }
  @media (min-width: 1024px) {
    .hiw-steps { grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  }

  .hiw-step {
    position: relative;
    text-align: center;
    opacity: 0;
    transform: translateY(14px);
    animation: hiw-step-in 0.55s ease-out forwards;
    animation-delay: var(--delay, 0s);
  }
  @keyframes hiw-step-in { to { opacity: 1; transform: translateY(0); } }

  /* Node — white circle holding the illustration. Stays white when lit
     (so the navy outline + mint fills of the illustration remain
     readable); the "lit" treatment is a halo + scale + saturation
     boost rather than a background color flip. */
  .hiw-node {
    position: relative;
    width: 156px;
    height: 156px;
    border-radius: 9999px;
    margin: 0 auto;
    background: #ffffff;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: box-shadow 0.3s ease, transform 0.4s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .hiw-node-illu img {
    width: 88%;
    height: 88%;
    object-fit: contain;
    filter: saturate(0.95);
    transition: filter 0.4s ease, transform 0.4s ease;
  }

  /* Lit state: halo ring + pulse + saturated illustration */
  .hiw-step.cr-hiw-lit .hiw-node {
    transform: scale(1.06);
    animation: hiw-halo 1.5s ease-in-out infinite;
  }
  .hiw-step.cr-hiw-lit .hiw-node-illu img {
    filter: saturate(1.15);
    transform: scale(1.04);
  }
  @keyframes hiw-halo {
    0%, 100% {
      box-shadow:
        inset 0 0 0 1px rgba(255, 255, 255, 0.2),
        0 0 0 4px rgba(0, 229, 160, 0.35),
        0 0 24px rgba(0, 229, 160, 0.45);
    }
    50% {
      box-shadow:
        inset 0 0 0 1px rgba(255, 255, 255, 0.2),
        0 0 0 8px rgba(0, 229, 160, 0.18),
        0 0 36px rgba(0, 229, 160, 0.55);
    }
  }

  /* Step badge */
  .hiw-badge {
    display: inline-block;
    margin-top: 1.5rem;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border-radius: 9999px;
    transition: all 0.3s ease;
  }
  .hiw-step.cr-hiw-lit .hiw-badge {
    background: #00E5A0;
    color: #062418;
    border-color: #00E5A0;
    box-shadow: 0 0 14px rgba(0, 229, 160, 0.45);
  }

  .hiw-step h3 {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: #fff;
    margin-top: 0.875rem;
  }
  .hiw-step p {
    color: #a1a1aa;
    font-size: 0.875rem;
    line-height: 1.55;
    margin-top: 0.4rem;
    max-width: 220px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Progress track — 4 nodes at 12.5%, 37.5%, 62.5%, 87.5% of the row */
  .hiw-track {
    position: absolute;
    top: 78px;
    left: 12.5%;
    right: 12.5%;
    height: 2px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 9999px;
    overflow: hidden;
    display: none;
  }
  @media (min-width: 1024px) {
    .hiw-track { display: block; }
  }
  .hiw-comet {
    position: absolute;
    inset: 0 auto;
    left: 0;
    width: 25%;
    background: #00E5A0;
    border-radius: 9999px;
    transform: translateX(-120%);
  }
  .hiw-comet.cr-hiw-comet-run {
    animation: cr-hiw-comet 5s linear forwards;
  }
  @keyframes cr-hiw-comet {
    0%   { transform: translateX(-120%); }
    100% { transform: translateX(420%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hiw-step { animation: none; opacity: 1; transform: none; }
    .hiw-orb-a, .hiw-orb-b { animation: none; }
    .hiw-comet { display: none; }
  }
</style>

<script>
  // Comet sequencer — 5s sweep, four equally-spaced light windows.
  // Gated by IntersectionObserver: only runs while the section is on
  // screen, pauses when offscreen. Saves battery/CPU on long pages.
  (function () {
    const section = document.querySelector<HTMLElement>(".hiw");
    if (!section) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const nodes = Array.from(section.querySelectorAll<HTMLElement>(".hiw-step"));
    const comet = section.querySelector<HTMLElement>(".hiw-comet");
    if (!comet || nodes.length !== 4) return;

    const S1_ON = 250;
    const S1_OFF = 1050;
    const S2_ON = 1450;
    const S2_OFF = 2250;
    const S3_ON = 2650;
    const S3_OFF = 3450;
    const S4_ON = 3850;
    const HOLD = 4500;
    const CYCLE = S4_ON + HOLD + 500;

    let timers: number[] = [];
    let running = false;
    const clear = () => { timers.forEach((t) => clearTimeout(t)); timers = []; };
    const lit = (i: number) => nodes[i].classList.add("cr-hiw-lit");
    const unlit = (i: number) => nodes[i].classList.remove("cr-hiw-lit");
    const unlitAll = () => nodes.forEach((n) => n.classList.remove("cr-hiw-lit"));

    function run() {
      if (!running) return;
      clear();
      unlitAll();
      comet.classList.remove("cr-hiw-comet-run");
      void comet.offsetWidth;
      comet.classList.add("cr-hiw-comet-run");

      timers.push(window.setTimeout(() => lit(0), S1_ON));
      timers.push(window.setTimeout(() => unlit(0), S1_OFF));
      timers.push(window.setTimeout(() => lit(1), S2_ON));
      timers.push(window.setTimeout(() => unlit(1), S2_OFF));
      timers.push(window.setTimeout(() => lit(2), S3_ON));
      timers.push(window.setTimeout(() => unlit(2), S3_OFF));
      timers.push(window.setTimeout(() => lit(3), S4_ON));
      timers.push(window.setTimeout(() => unlit(3), S4_ON + HOLD));
      timers.push(window.setTimeout(run, CYCLE));
    }

    const start = () => {
      if (running) return;
      running = true;
      window.setTimeout(run, 800);
    };
    const stop = () => {
      running = false;
      clear();
      unlitAll();
      comet.classList.remove("cr-hiw-comet-run");
    };

    if ("IntersectionObserver" in window) {
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((e) => (e.isIntersecting ? start() : stop()));
      }, { threshold: 0.15 });
      obs.observe(section);
    } else {
      start();
    }
  })();
</script>
