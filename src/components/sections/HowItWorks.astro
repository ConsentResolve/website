---
/**
 * HowItWorks — the canonical "how it works" section for Consent Resolve.
 *
 * As of June 2026 this is a thin wrapper around the StepFlow primitive
 * (src/components/ui/StepFlow.astro) so the same five-step recovery
 * flow ships everywhere it's used: /how-it-works/ and every /[trade]-
 * leads/ industry page.
 *
 * Promoted from the original animated dark-comet section to the new
 * five-step illustrated strip (visit → consent → accept → feed → win).
 * The previous comet implementation is preserved in git history at
 * commit 778999b^.
 *
 * To swap copy: edit the steps array below. To swap layout / arrow
 * treatment / payoff tile: edit the StepFlow primitive — every call
 * site reflects the change automatically.
 */
import StepFlow from "~/components/ui/StepFlow.astro";
---

<StepFlow
  eyebrow="How it works in five"
  title="Five steps. One outcome."
  titleAccent="More calls. More jobs."
  steps={[
    {
      illustration: "/illustrations/steps/01-homeowner-visit.svg",
      alt: "A homeowner browsing a contractor's website",
      title: "Homeowner visits<br/>your website",
      blurb: "From a Google ad, LSA, or just searching your town.",
    },
    {
      illustration: "/illustrations/steps/02-we-handle-consent.svg",
      alt: "A consent banner with a shield checkmark badge",
      title: "We handle<br/>consent",
      blurb: "Our banner asks. Your privacy policy stays current — Termageddon-backed.",
    },
    {
      illustration: "/illustrations/steps/03-homeowner-accepts.svg",
      alt: "A hand pressing accept on a cookie consent banner",
      title: "Homeowner<br/>says yes",
      blurb: "No yes, no data. That's what keeps you on the right side of the rules.",
    },
    {
      illustration: "/illustrations/steps/04-feed-to-funnel.svg",
      alt: "A contact card sliding into a CRM inbox",
      title: "We feed contact<br/>to your funnel",
      blurb: "Lands in Jobber, Housecall Pro, ServiceTitan, HubSpot, Klaviyo — in seconds.",
    },
    {
      illustration: "/illustrations/steps/05-more-calls-more-jobs.svg",
      alt: "A service pro answering a ringing phone",
      title: "More calls.<br/>More jobs.",
      blurb: "Warm inbound calls from homeowners who already saw you in their inbox.",
      highlight: true,
    },
  ]}
>
  <slot />
</StepFlow>
