---
/**
 * FAQPreview — PREVIEW variant of FAQ.astro.
 *
 * Same dark-band + mint eyebrow + white-card section chrome, but each
 * Q&A row is now its own rounded bordered card via AccordionLarge,
 * and every type + padding scale is roughly 1.75× the canonical
 * Accordion. The container card grows in step.
 *
 * NOT wired into any production page yet — only previewed in
 * /style-guide/faq/. Promote to FAQ.astro when approved.
 */
import AccordionLarge from "~/components/ui/AccordionLarge.tsx";

export interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  headline: string;
  items: FAQItem[];
  defaultOpen?: number;
}

const { eyebrow = "Common questions", headline, items, defaultOpen = 0 } = Astro.props as Props;
---

<section class="section section-dark">
  <div class="container-content max-w-4xl">
    <div class="mb-14 text-center">
      <p class="eyebrow mb-6 justify-center" style="color:var(--color-mint-400)">{eyebrow}</p>
      <h2 class="display-2 text-white">{headline}</h2>
    </div>
    <div class="rounded-3xl bg-[color:var(--color-bg-alt)] p-5 ring-1 ring-inset ring-white/10 shadow-[0_30px_60px_-30px_rgba(10,22,40,0.6)]">
      <AccordionLarge client:visible items={items} defaultOpen={defaultOpen} />
    </div>
  </div>
</section>
