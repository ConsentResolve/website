---
/**
 * FAQSection — homepage FAQ wrapper with the canonical hard-coded
 * questions every contractor asks before signing up. Delegates all
 * styling to the shared <FAQ> primitive so the visual treatment
 * stays in lockstep with every other FAQ on the site.
 */
import FAQ from "~/components/sections/FAQ.astro";

const faqs = [
  {
    question: "Is this legal?",
    answer: "Yes — because a homeowner's name shows up only after they consent. We keep your privacy policy, cookie banner, and disclosures in sync through Termageddon. The shady tools that track people in secret are the illegal ones. We're not one.",
  },
  {
    question: "Do I have to change my privacy policy?",
    answer: "We handle it. Termageddon generates and updates the policies for you, so you stay covered without the legwork.",
  },
  {
    question: "What if a homeowner doesn't consent?",
    answer: "Then you get nothing on them — and that's the point. No consent, no data. That's what keeps you safe.",
  },
  {
    question: "How fast does a lead reach me?",
    answer: "Seconds. A Slack, text, or email fires the moment they consent, and it lands in your CRM at the same time.",
  },
  {
    question: "Which CRMs do you work with?",
    answer: "Jobber, Housecall Pro, ServiceTitan, HubSpot, Klaviyo, and just about anything else through a webhook.",
  },
  {
    question: "Can I cancel anytime?",
    answer: "Yes. Flat $7 a lead — card required, no contract, cancel whenever you want.",
  },
];
---

<FAQ headline="What pros ask before they start." items={faqs} />
