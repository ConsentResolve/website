---
import Accordion from "~/components/ui/Accordion.tsx";

const faqs = [
  {
    question: "Is visitor identification legal?",
    answer: "Yes — when identification happens only after explicit consent, as Consent Resolve does. We integrate with Termageddon to keep your privacy policy, cookie banner, and data-handling disclosures in sync. Shadow-tracking visitor-ID tools are illegal in most jurisdictions; we are not one of them.",
  },
  {
    question: "Do I need to update my privacy policy?",
    answer: "We handle this for you via Termageddon. Your policy auto-updates with every change to your data practices. No lawyer phone calls. No outdated cookie banners.",
  },
  {
    question: "What happens if a homeowner doesn't consent?",
    answer: "Nothing identifying is captured. Anonymous visitors stay anonymous. You only ever see leads who explicitly opted in — which is the entire point. Consent is the moat.",
  },
  {
    question: "How fast does a lead arrive in my inbox?",
    answer: "Real-time. The moment a homeowner taps Yes, the lead is pushed to your CRM, Slack, or email — typically within 2 seconds. The contractor who calls back first wins the job.",
  },
  {
    question: "Which CRMs do you integrate with?",
    answer: "Jobber, Housecall Pro, ServiceTitan, HubSpot, Salesforce, and Klaviyo natively. Anything else, we push via Zapier or a webhook.",
  },
  {
    question: "Can I cancel anytime?",
    answer: "Yes. Month-to-month, no contract, no annual lock-in. Cancel from your dashboard with one click. We'll refund any unused portion of your current month.",
  },
];
---

<section class="section section-dark">
  <div class="container-content max-w-3xl">
    <div class="mb-12 text-center">
      <p class="eyebrow mb-5 justify-center" style="color:var(--color-mint-400)">Common questions</p>
      <h2 class="display-2 text-white">
        Everything contractors ask before signing up.
      </h2>
    </div>
    <div class="rounded-2xl bg-white p-2">
      <div class="px-5">
        <Accordion client:visible items={faqs} variant="chevron" defaultOpen={0} />
      </div>
    </div>
  </div>
</section>
