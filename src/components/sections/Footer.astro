---
import { FOOTER_NAV } from "~/lib/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-[color:var(--color-rule)] bg-[color:var(--color-bg-alt)] py-16 px-6">
  <div class="container-content grid gap-12 md:grid-cols-5">
    <div class="md:col-span-1">
      <div class="flex items-center gap-2">
        <div class="size-6 rounded bg-[color:var(--color-brand)] flex items-center justify-center">
          <span class="material-symbols-outlined !text-[color:var(--color-on-brand)] !text-[14px]">verified_user</span>
        </div>
        <h2 class="text-lg font-bold tracking-tight">Consent Resolve</h2>
      </div>
      <p class="mt-4 text-sm text-[color:var(--color-ink-muted)]">Identify visitors after consent. No lawsuits, no risk.</p>
    </div>
    {Object.entries(FOOTER_NAV).map(([heading, links]) => (
      <div>
        <h3 class="text-sm font-bold uppercase tracking-widest text-[color:var(--color-ink)] mb-4">{heading}</h3>
        <ul class="space-y-2 text-sm text-[color:var(--color-ink-2)]">
          {links.map((l) => (
            <li><a class="hover:text-[color:var(--color-brand)]" href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="container-content mt-12 pt-8 border-t border-[color:var(--color-rule)] text-xs text-[color:var(--color-ink-muted)] flex flex-col md:flex-row justify-between gap-2">
    <p>© {year} Consent Resolve. All rights reserved.</p>
    <p>GDPR · CCPA · CPA compliant</p>
  </div>
</footer>
