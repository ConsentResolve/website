---
import { FOOTER_NAV } from "~/lib/site";
import { IconShieldCheck } from "@tabler/icons-react";
const year = new Date().getFullYear();
---

<footer class="border-t border-[color:var(--color-rule)] bg-[color:var(--color-bg-alt)]">
  <div class="container-content py-20">
    <div class="grid gap-12 md:grid-cols-6">
      <div class="md:col-span-2">
        <div class="flex items-center gap-2.5">
          <div class="flex size-8 items-center justify-center rounded-lg bg-[color:var(--color-navy-900)]">
            <IconShieldCheck size={18} stroke={2.25} color="#00E5A0" />
          </div>
          <span class="text-base font-semibold tracking-tight text-[color:var(--color-ink)]">Consent Resolve</span>
        </div>
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-[color:var(--color-ink-2)]">
          Lead identification for home service businesses. Compliant by default.
        </p>
        <!-- NAP block for local SEO + accessibility -->
        <address class="mt-6 text-xs not-italic leading-relaxed text-[color:var(--color-ink-muted)]">
          <strong class="text-[color:var(--color-ink-2)]">Consent Resolve</strong><br/>
          1907 Gulf Way #1<br/>
          St Pete Beach, FL 33706<br/>
          <a href="tel:+17272025996" class="hover:text-[color:var(--color-brand-pressed)]">(727) 202-5996</a><br/>
          <a href="mailto:hello@consentresolve.com" class="hover:text-[color:var(--color-brand-pressed)]">hello@consentresolve.com</a>
        </address>
      </div>
      {Object.entries(FOOTER_NAV).map(([heading, links]) => (
        <div>
          <h3 class="mb-4 text-xs font-semibold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">{heading}</h3>
          <ul class="space-y-2.5">
            {links.map((l) => (
              <li>
                <a class="text-sm text-[color:var(--color-ink-2)] transition-colors hover:text-[color:var(--color-brand-pressed)]" href={l.href}>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-16 flex flex-col items-start justify-between gap-3 border-t border-[color:var(--color-rule)] pt-8 text-xs text-[color:var(--color-ink-muted)] md:flex-row md:items-center">
      <p>© {year} Consent Resolve. All rights reserved.</p>
      <p>GDPR · CCPA · CPA compliant</p>
    </div>
  </div>
</footer>
