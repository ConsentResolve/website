  .mcr-problem { display: flex; flex-direction: column; height: 100%; padding: 1.5rem 1.15rem 1.1rem; justify-content: flex-start; gap: 0.85rem; }
  /* Visitor grid — same story as the trade landing pages: ghost (anonymous) ->
     check (consented) -> person (identified lead); the 98 get X'd out and vanish. */
  .mcr-leak { display: grid; grid-template-columns: repeat(10, 1fr); gap: 0.28rem; width: 100%; max-width: 288px; margin-inline: auto; }
  /* Resting state is VISIBLE — never depend on an animation's fill-mode to hold a
