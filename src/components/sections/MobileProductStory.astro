<script is:inline>
  (function () {
    var el = document.getElementById("cr-story");
    if (!el) return;
    var stage = document.getElementById("mcr-stage");
    var cards = [].slice.call(el.querySelectorAll(".mcr-card"));
    var pips = [].slice.call(el.querySelectorAll(".mcr-pip"));
    var actions = document.getElementById("mcr-actions");
    var backBtn = el.querySelector(".mcr-btn-back");
    var likeBtn = el.querySelector(".mcr-btn-like");
    var mv = el.querySelector("[data-meet-video]");
    var mp = el.querySelector("[data-meet-play]");
    var i = 0, n = cards.length, animating = false, hintTimer = null;

    // Video: poster + a play button. No autoplay, no loop, no mute toggle. Tap Play
    // -> plays through once with sound and stops; the button reappears to replay.
    if (mv && mp) {
      mp.addEventListener("click", function (e) {
        e.stopPropagation();
        mv.muted = false; mv.volume = 1;
        var p = mv.play(); if (p && p.catch) p.catch(function () {});
        mp.style.display = "none";
      });
      // Show the button whenever the clip isn't playing. Once it has FINISHED, the button
      // becomes an outlined-triangle "replay" (is-replay) so it doesn't read as the nav arrow.
      mv.addEventListener("play", function () { mp.style.display = "none"; mp.classList.remove("is-replay"); });
      mv.addEventListener("ended", function () { mp.style.display = ""; mp.classList.add("is-replay"); });
      mv.addEventListener("pause", function () { if (!mv.ended && mv.currentTime > 0) mp.style.display = ""; });
    }

    function isLast() { return i === n - 1; }

    // --- visitor grid (card 2) -------------------------------------------------
    var leak = el.querySelector("[data-leak]");
    var leakCells = leak ? [].slice.call(leak.querySelectorAll(".lc")) : [];
    var leakTimers = [];
    function leakLater(fn, ms) { leakTimers.push(setTimeout(fn, ms)); }
    function leakReset() {
      leakTimers.forEach(clearTimeout); leakTimers = [];
      if (!leak) return;
      leak.classList.remove("populate");
      leakCells.forEach(function (c) { c.classList.remove("is-check", "is-lead", "is-vanishing", "is-gone"); });
    }
    function leakPlay() {
      leakReset();
      if (!leak) return;
      void leak.offsetWidth;                       // reflow so the stagger restarts
      leak.classList.add("populate");
      // the 2 who fill a form: ghost -> check -> person
      [0, 1].forEach(function (k) {
        leakLater(function () {
          var c = leakCells[k]; if (!c) return;
          c.classList.add("is-check");
          leakLater(function () { c.classList.remove("is-check"); c.classList.add("is-lead"); }, 340);
        }, 900 + k * 180);
      });
      // then the other 98 get X'd out and vanish
      leakLater(function () {
        for (var k = 2; k < leakCells.length; k++) {
          (function (c, n) {
            leakLater(function () {
              c.classList.add("is-vanishing");
              leakLater(function () { c.classList.add("is-gone"); }, 760);
            }, n * 14);
          })(leakCells[k], k - 2);
        }
      }, 1650);
      // once the vanish is done, reveal the "tap the arrow to see how we solve this" hint
      var solveHint = el.querySelector("[data-solve-hint]");
      leakLater(function () { if (solveHint) solveHint.classList.add("show"); }, 1650 + 98 * 14 + 760 + 300);
    }

    // Count-up for the "This is you" ad stat strip; pops + pulses the ROAS tile at the end.
    function countUpRoas() {
      var wrap = el.querySelector("[data-roas]"); if (!wrap) return;
      wrap.classList.remove("is-counted");
      var els = [].slice.call(wrap.querySelectorAll("[data-count]"));
      var dur = 900, t0 = null;
      els.forEach(function (b) { b.dataset.final = b.textContent; });
      function frame(t) {
        if (t0 == null) t0 = t;
        var p = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - p, 3);
        els.forEach(function (b) {
          var to = parseFloat(b.getAttribute("data-count")), dec = parseInt(b.getAttribute("data-dec") || "0", 10);
          var v = to * e, out = dec ? v.toFixed(dec) : Math.round(v).toLocaleString("en-US");
          b.textContent = (b.getAttribute("data-prefix") || "") + out + (b.getAttribute("data-suffix") || "");
        });
        if (p < 1) requestAnimationFrame(frame);
        else { els.forEach(function (b) { b.textContent = b.dataset.final; }); wrap.classList.add("is-counted"); }
      }
      requestAnimationFrame(frame);
    }

    function render() {
      cards.forEach(function (c, k) {
        c.classList.remove("is-active", "is-peek", "fly-left", "fly-right", "is-dragging");
        c.style.transform = "";
        if (k === i) c.classList.add("is-active");
        else if (k === i + 1) c.classList.add("is-peek");
      });
      pips.forEach(function (p, k) {
        p.classList.toggle("is-done", k < i);
        p.classList.toggle("is-active", k === i);
      });
      backBtn.disabled = i === 0;
      // On the final (CTA) card the buttons are the real links, so hide the deck controls.
      actions.classList.toggle("is-hidden", isLast());
      // The clip never autoplays. Leaving card 0 pauses + rewinds it and restores the
      // play button, so it never keeps talking off-screen and always offers a clean replay.
      if (mv && mp) {
        if (i !== 0) {
          mv.pause();
          try { mv.currentTime = 0; } catch (_) {}
          mp.style.display = ""; mp.classList.remove("is-replay"); // reset to the filled play
        }
      }
      // Card 1: count the ad numbers up each time it's shown.
      if (i === 1) setTimeout(countUpRoas, 250);
      // Replay the visitor grid every time we land on it; reset its solve-hint on leave.
      if (leak) {
        if (i === 2) leakPlay();
        else { leakReset(); var sh = el.querySelector("[data-solve-hint]"); if (sh) sh.classList.remove("show"); }
      }
      // Flash the forward arrow ~4s after landing on any non-final card, to nudge on.
      likeBtn.classList.remove("is-hint");
      if (hintTimer) clearTimeout(hintTimer);
      if (!isLast()) hintTimer = setTimeout(function () { likeBtn.classList.add("is-hint"); }, 4000);
      // Reaching the CTA card = they watched the whole pitch. This is the mid-funnel
      // signal a conversion campaign can actually optimize on.
      if (isLast() && !window.__crStoryDone) {
        window.__crStoryDone = 1;
        if (window.crTrack) window.crTrack("StoryComplete", { content_name: "meet_story" });
      }
    }

    function go(k) { i = Math.max(0, Math.min(n - 1, k)); render(); }
    window.crStoryGo = go;

    function snapBack(card) { card.classList.remove("is-dragging"); card.style.transform = ""; }

    // Back: go DIRECTLY to the previous card and let the CSS crossfade it in. The old
    // path flung the current card away with fly("left"), which briefly revealed the peek
    // card behind it — the NEXT card, not the previous — so the deck flashed the wrong
    // page before landing. A direct go() never shows a card that isn't the destination.
    function goBack() {
      if (animating || i === 0) return;
      go(i - 1);
    }

    // Swipes ALWAYS advance, regardless of direction — the card just flings off the way
    // the finger went. Navigation back is only via the back button (goBack).
    function flyForward(flingDir) {
      if (animating) return;
      var card = cards[i];
      if (isLast()) { snapBack(card); return; }
      animating = true;
      card.classList.add(flingDir === "left" ? "fly-left" : "fly-right");
      setTimeout(function () { animating = false; go(i + 1); }, 300);
    }

    likeBtn.addEventListener("click", function () { flyForward("right"); });
    backBtn.addEventListener("click", goBack);

    window.crOpenStory = function () {
      go(0);
      el.classList.add("is-open");
      el.setAttribute("aria-hidden", "false");
      document.body.classList.add("cr-story-lock");
      if (window.crTrack) window.crTrack("ViewContent", { content_name: "meet_story", content_category: "demo" });
    };
    window.crCloseStory = function () {
      el.classList.remove("is-open");
      el.setAttribute("aria-hidden", "true");
      document.body.classList.remove("cr-story-lock");
    };

    // Ad deep-link: /how-it-works/?story=1 opens the deck straight away, so a paid
    // click lands in the 2-minute demo instead of a page they have to hunt through.
    // Desktop is unaffected (the deck is lg:hidden) and falls back to the walkthrough.
    try {
      if (/[?&]story=1\b/.test(location.search)) {
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", function () { window.crOpenStory(); });
        } else window.crOpenStory();
      }
    } catch (_) {}

    // Keyboard (desktop QA + a11y)
    document.addEventListener("keydown", function (e) {
      if (!el.classList.contains("is-open")) return;
      if (e.key === "Escape") window.crCloseStory();
      else if (e.key === "ArrowRight") flyForward("right");
      else if (e.key === "ArrowLeft") goBack();
    });

    // Drag / swipe physics on the active card
    var startX = 0, startY = 0, dx = 0, dragging = false, decided = false, horizontal = false;
    stage.addEventListener("touchstart", function (e) {
      if (animating || isLast()) return;
      // Let the sound button take its own tap instead of advancing the card.
      if (e.target && e.target.closest && e.target.closest("[data-meet-play]")) return;
      var card = cards[i];
      if (!card.classList.contains("is-active")) return;
      startX = e.touches[0].clientX; startY = e.touches[0].clientY;
      dx = 0; dragging = true; decided = false; horizontal = false;
    }, { passive: true });
    stage.addEventListener("touchmove", function (e) {
      if (!dragging) return;
      var t = e.touches[0];
      dx = t.clientX - startX;
      var dy = t.clientY - startY;
      if (!decided) {
        decided = true;
        horizontal = Math.abs(dx) > Math.abs(dy);
        if (horizontal) cards[i].classList.add("is-dragging");
      }
      if (!horizontal) return;
      // Forward-only deck: a swipe EITHER way advances, so let the card follow the
      // finger in whichever direction it's dragged.
      cards[i].style.transform = "translateX(" + dx + "px) rotate(" + (dx / 22) + "deg)";
    }, { passive: true });
    stage.addEventListener("touchend", function () {
      if (!dragging) return;
      dragging = false;
      var card = cards[i];
      if (!horizontal) { // treat a tap as advance
        if (Math.abs(dx) < 8) flyForward("right");
        return;
      }
      // Either direction past the threshold advances; use the back button to go back.
      if (Math.abs(dx) > 80) flyForward(dx < 0 ? "left" : "right");
      else snapBack(card);
    });
  })();
</script>
