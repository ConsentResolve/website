---
/**
 * MobileProductStory — "Meet Consent Resolve": a mobile-only, Tinder-style
 * swipe deck that pitches a first-time visitor who's never heard of us.
 *
 * Structure follows StoryBrand (SB7): the contractor is the HERO with a
 * PROBLEM (anonymous visitors leaking away), Consent Resolve is the GUIDE with
 * empathy + authority, offers a PLAN (3 steps), the signature "it's a match"
 * reveal is the TRANSFORMATION, and the last card is the call to ACTION.
 *
 * Design language = a dating app: full-bleed profile cards you drag/swipe,
 * blurred anonymous "faces" that resolve into a named, consented lead, round
 * action buttons, progress pips. Opened from the mobile sticky "Demo" button
 * via window.crOpenStory(). Pure CSS + vanilla JS, no framework island,
 * fully self-contained (no external images). Rendered once in BaseLayout,
 * mobile-only (lg:hidden).
 */
import { SITE } from "~/lib/site";

const REGISTER = "https://dashboard.consentresolve.com/register";

// Vertical Tyler clip that plays as the "profile video" on the first card.
// Rendered by scripts/gen_meet_intro.py. Empty string = fall back to the static
// brand mark, so the deck never ships a broken <video> before the clip exists.
const INTRO_VIDEO = "https://pub-27fc71b9070247178d8756a59bef0b33.r2.dev/social/sprint/meet-intro.mp4?v=2";
const INTRO_POSTER = "/team/meet-intro-poster.jpg?v=2";

const CARDS = 7; // keep in sync with the <section data-card> count below
---

<div id="cr-story" class="mcr lg:hidden" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Meet Consent Resolve">
  {/* Top chrome: progress pips + close */}
  <div class="mcr-top">
    <div class="mcr-pips">
      {Array.from({ length: CARDS }).map((_, i) => (
        <span class="mcr-pip" data-pip={i}></span>
      ))}
    </div>
    <div class="mcr-chrome">
      {/* One-tap call — replaces the "Meet Consent Resolve" label. */}
      <a class="mcr-brand mcr-call" href={`tel:${SITE.phoneE164}`} onclick="window.crTrack&&window.crTrack('Contact',{method:'call',source:'meet_story_top'})">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-mint-400,#2ee6a6)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.4 2.1L8 9.8a16 16 0 0 0 6 6l1.4-1.2a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.7a2 2 0 0 1 1.7 2z"></path></svg>
        Call {SITE.phone}
      </a>
      <button type="button" class="mcr-close" aria-label="Close" onclick="window.crCloseStory&&window.crCloseStory()">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </div>

  {/* Card stack */}
  <div class="mcr-stage" id="mcr-stage">

    {/* 0 — GUIDE intro: Consent Resolve as a dating profile */}
    <section class="mcr-card" data-card="0">
      <div class="mcr-profile mcr-p-brand">
        <div class="mcr-photo mcr-photo-brand">
          {INTRO_VIDEO ? (
            <Fragment>
              {/* Tyler's "profile video" — poster + a play button. No autoplay, no loop,
                  no mute toggle: tap Play once, it plays through with sound and stops. */}
              <video
                data-meet-video
                class="mcr-video"
                playsinline preload="auto"
                poster={INTRO_POSTER}
                src={INTRO_VIDEO}
              ></video>
              <button type="button" data-meet-play class="mcr-play" aria-label="Play the intro">
                <svg class="mcr-play-ico" width="30" height="30" viewBox="0 0 24 24" stroke-linejoin="round" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
              </button>
            </Fragment>
          ) : (
            <div class="mcr-logo">
              <svg width="52" height="52" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6" stroke="#081019" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
          )}
          <span class="mcr-verify">✓ Consent-first · Verified</span>
        </div>
        <div class="mcr-meta">
          <h2>Consent Resolve <span class="mcr-age">est. permission</span></h2>
          <p class="mcr-tag">Turns anonymous website visitors into consented leads</p>
          <p class="mcr-bio">I help home-service pros actually meet the homeowners already on their site — only when they say yes. 100% legal. $7 a lead, never resold.</p>
          <div class="mcr-tags"><span>Consent-first</span><span>$7 a lead</span><span>Never resold</span></div>
          <p class="mcr-swipe-hint">Swipe to meet the pros we're for →</p>
        </div>
      </div>
    </section>

    {/* 1 — HERO: this is you */}
    <section class="mcr-card" data-card="1">
      <div class="mcr-profile">
        <div class="mcr-photo mcr-photo-ad">
          {/* Mock Facebook feed ad + the Ads-Manager stat strip. */}
          <div class="mcr-fbad">
            <div class="mcr-fb-top">
              <span class="mcr-fb-ava">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#081019" stroke-width="2" aria-hidden="true"><path d="M3 21h18M5 21V10l7-5 7 5v11" stroke-linejoin="round"/></svg>
              </span>
              <div class="mcr-fb-who"><b>Your Company</b><small>Sponsored · <span aria-hidden="true">🌐</span></small></div>
              <span class="mcr-fb-dots" aria-hidden="true">•••</span>
            </div>
            <p class="mcr-fb-copy">Same-day service, done right. Book online in 60 seconds. 👇</p>
            <div class="mcr-fb-img">
              <span class="mcr-fb-badge">LIMITED SPOTS</span>
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.55)" stroke-width="1.5" aria-hidden="true"><path d="M3 21h18M5 21V10l7-5 7 5v11M9 21v-5h6v5" stroke-linejoin="round"/></svg>
              <span class="mcr-fb-imgcap">Trusted by 500+ local homeowners</span>
            </div>
            <div class="mcr-fb-bar">
              <div><span class="mcr-fb-url">yoursite.com</span><span class="mcr-fb-head">Book Your Service Today</span></div>
              <span class="mcr-fb-btn">Learn more</span>
            </div>
            <div class="mcr-fb-eng">
              <span class="mcr-fb-react"><span class="mcr-fb-emo">👍❤️</span> 47</span>
              <span>6 comments · 2 shares</span>
            </div>
            <div class="mcr-fb-acts">
              <span>👍 Like</span><span>💬 Comment</span><span>↪ Share</span>
            </div>
          </div>
          <div class="mcr-roas" data-roas>
            <span><small>Spend</small><b data-count="1000" data-prefix="$">$1,000</b></span>
            <span><small>Revenue</small><b data-count="1200" data-prefix="$">$1,200</b></span>
            <span class="mcr-roas-hi"><small>ROAS</small><b data-count="1.2" data-dec="1" data-suffix="×">1.2×</b></span>
          </div>
          <span class="mcr-scrim-label">The Home-Service Pro</span>
        </div>
        <div class="mcr-meta">
          <h2>This is you.</h2>
          <p class="mcr-bio">Great on the tools. You run ads like this one — and at 1.2× you're paying a dollar to make a dollar twenty.</p>
          <p class="mcr-bio mcr-dim">There's just one problem…</p>
        </div>
      </div>
    </section>

    {/* 2 — PROBLEM / stakes: blurred anonymous faces */}
    <section class="mcr-card" data-card="2">
      <div class="mcr-problem">
        {/* Same visitor-grid story as the trade landing pages: 100 ghosts land, the 2
            who fill a form turn ghost -> check -> person, then the other 98 get X'd
            out and vanish. Replays each time the card becomes active. */}
        <div class="leakgrid mcr-leak" data-leak aria-hidden="true">
          {Array.from({ length: 100 }).map((_, i) => (
            <span class="lc" style={`--i:${i}`}>
              <span class="lc-ghost">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><path d="M9 10h.01M15 10h.01M6 20V9a6 6 0 0 1 12 0v11l-2-1.5L14 20l-2-1.5L10 20l-2-1.5z"/></svg>
              </span>
              {i < 2 && (
                <Fragment>
                  <span class="lc-check">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6"/></svg>
                  </span>
                  <span class="lc-person">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
                  </span>
                </Fragment>
              )}
              <i class="lc-x"></i>
            </span>
          ))}
        </div>
        <div class="mcr-meta mcr-meta-center">
          <p class="mcr-stat">98 of 100</p>
          <h2>leave without a word.</h2>
          <p class="mcr-bio">You paid for every one of these visits. Then they vanished — no name, no number. Ghosted.</p>
          {/* Revealed by JS once the vanish animation finishes (data-solve-hint). */}
          <p class="mcr-solve-hint" data-solve-hint>Tap the right arrow to see how we solve this →</p>
        </div>
      </div>
    </section>

    {/* 3 — GUIDE empathy + authority */}
    <section class="mcr-card" data-card="3">
      <div class="mcr-say">
        <div class="mcr-say-mark">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6" stroke="var(--color-mint-400,#2ee6a6)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <h2>We think that's a rip-off.</h2>
        <p class="mcr-bio">So we built the fix — the only visitor-ID layer that asks the homeowner first. You meet the people already raising their hand, and you stay compliant doing it.</p>
        <div class="mcr-badges">
          <span>⚖️ 100% Legal</span>
          <span>🛡️ Bank-Level Consent</span>
          <span>🔒 Owned, Exclusive Leads</span>
          <span>⚡ Near Realtime</span>
        </div>
      </div>
    </section>

    {/* 4 — PLAN: 3 steps */}
    <section class="mcr-card" data-card="4">
      <div class="mcr-plan">
        <p class="mcr-eyebrow">The plan</p>
        <h2>How we get you introduced.</h2>
        <ol>
          <li><span class="mcr-step">1</span><div><b>Add one line</b><small>Drop our snippet on your site. Live in ~10 minutes.</small></div></li>
          <li><span class="mcr-step">2</span><div><b>A homeowner says yes</b><small>Your consent banner asks. They accept.</small></div></li>
          <li><span class="mcr-step">3</span><div><b>You get their email address</b><small>Plus their name and what they were looking at.</small></div></li>
        </ol>
      </div>
    </section>

    {/* 5 — TRANSFORMATION: the match (blur -> named lead) */}
    <section class="mcr-card mcr-match-card" data-card="5">
      <div class="mcr-match">
        <p class="mcr-match-title">It's a match.</p>
        <div class="mcr-match-avatars">
          <span class="mcr-ava mcr-ava-pro">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#081019" stroke-width="1.8" aria-hidden="true"><path d="M3 21h18M5 21V10l7-5 7 5v11" stroke-linejoin="round"/></svg>
          </span>
          <span class="mcr-heart">♥</span>
          <span class="mcr-ava mcr-ava-lead">J</span>
        </div>
        <div class="mcr-reveal">
          <div class="mcr-reveal-blur" aria-hidden="true" style="--bg:linear-gradient(150deg,#c2255c,#e64980)">
            <svg viewBox="0 0 24 24" fill="rgba(255,255,255,0.55)"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
          </div>
          <div class="mcr-reveal-card">
            <b>Jordan M. <span class="mcr-consent">✓ consented</span></b>
            <small>jordan.m@gmail.com</small>
            <div class="mcr-chips"><span>Viewed: AC replacement</span><span>Ready to book</span></div>
          </div>
        </div>
        <p class="mcr-bio mcr-meta-center">Jordan said yes. Now she's a lead only <b>you</b> get — not resold to five competitors.</p>
      </div>
    </section>

    {/* 6 — SUCCESS + CTA */}
    <section class="mcr-card mcr-cta-card" data-card="6">
      <div class="mcr-cta">
        <div class="mcr-cta-mark">
          <svg width="38" height="38" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6" stroke="var(--color-mint-400,#2ee6a6)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <h2>Ready for New Leads?</h2>
        <p>Pick whichever's easiest. Most pros are live in about 10 minutes.</p>

        {/* Call — real tel: link with the number on show. */}
        <div class="mcr-contact">
          <a class="mcr-phone" href={`tel:${SITE.phoneE164}`} onclick="window.crTrack&&window.crTrack('Contact',{method:'call',source:'meet_story'})">{SITE.phone}</a>
          <a class="mcr-cbtn mcr-cbtn-wide" href={`tel:${SITE.phoneE164}`} onclick="window.crTrack&&window.crTrack('Contact',{method:'call',source:'meet_story'})">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.4 2.1L8 9.8a16 16 0 0 0 6 6l1.4-1.2a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.7a2 2 0 0 1 1.7 2z"></path></svg>
            Call
          </a>
        </div>

        {/* Live chat — close the deck first so the Crisp box isn't stuck behind it. */}
        <button
          type="button"
          class="mcr-cta-secondary"
          onclick="window.crTrack&&window.crTrack('Contact',{method:'chat',source:'meet_story'});window.crCloseStory&&window.crCloseStory();window.crOpenChat&&window.crOpenChat()"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H8l-4 4V5a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2z"></path></svg>
          Live Chat
        </button>

        <a class="mcr-cta-primary" href={REGISTER} onclick="window.crTrack&&window.crTrack('StartSignup',{source:'meet_story'})">Get Started — $7 a lead →</a>
        <button type="button" class="mcr-cta-restart" onclick="window.crStoryGo&&window.crStoryGo(0)">↺ Start over</button>
      </div>
    </section>
  </div>

  {/* Dating-app action buttons */}
  <div class="mcr-actions" id="mcr-actions">
    <button type="button" class="mcr-btn mcr-btn-back" aria-label="Back">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <button type="button" class="mcr-btn mcr-btn-like" aria-label="Next">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </button>
  </div>
</div>

<style is:global>
  .mcr {
    position: fixed; inset: 0; z-index: 100; display: none; flex-direction: column;
    background: radial-gradient(130% 90% at 50% -10%, #14243c 0%, var(--color-navy-900,#081019) 62%);
    color: #fff; -webkit-tap-highlight-color: transparent; overscroll-behavior: contain;
    font-feature-settings: "ss01";
  }
  .mcr.is-open { display: flex; }
  body.cr-story-lock { overflow: hidden; }

  /* Top chrome */
  .mcr-top { position: relative; z-index: 20; padding: max(env(safe-area-inset-top),0.7rem) 0.9rem 0; }
  .mcr-pips { display: flex; gap: 5px; }
  .mcr-pip { flex: 1; height: 3px; border-radius: 2px; background: rgba(255,255,255,0.2); transition: background .3s; }
  .mcr-pip.is-done { background: rgba(255,255,255,0.45); }
  .mcr-pip.is-active { background: var(--color-mint-400,#2ee6a6); }
  .mcr-chrome { position: relative; display: flex; align-items: center; justify-content: center; margin-top: 0.65rem; min-height: 40px; }
  .mcr-brand { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 700; font-size: 0.88rem; letter-spacing: -0.01em; }
  /* Centered call button (pill). */
  .mcr-call { text-decoration: none; padding: 0.45rem 1rem; border-radius: 999px; background: rgba(46,230,166,0.12); border: 1px solid rgba(46,230,166,0.45); color: var(--color-mint-400,#2ee6a6); font-weight: 800; }
  .mcr-call:active { background: rgba(46,230,166,0.22); }
  .mcr-call:active { background: rgba(46,230,166,0.14); }
  .mcr-close { position: absolute; right: -8px; top: 50%; transform: translateY(-50%); display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; color: rgba(255,255,255,0.85); background: none; border: 0; }

  /* Stage + card stack */
  .mcr-stage { position: relative; flex: 1; margin: 0.7rem 0.9rem 0; }
  .mcr-card {
    position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center;
    padding: 0; border-radius: 22px; overflow: hidden;
    background: #0c1a2e; border: 1px solid rgba(255,255,255,0.09);
    box-shadow: 0 24px 60px -24px rgba(0,0,0,0.8);
    opacity: 0; visibility: hidden; transform: scale(.92) translateY(16px); transform-origin: center bottom;
    transition: transform .32s cubic-bezier(.2,.8,.2,1), opacity .3s;
    will-change: transform;
  }
  .mcr-card.is-peek { opacity: 1; visibility: visible; transform: scale(.94) translateY(12px); }
  .mcr-card.is-active { opacity: 1; visibility: visible; transform: none; z-index: 5; touch-action: pan-y; }
  .mcr-card.is-dragging { transition: none; }
  .mcr-card.fly-right { transform: translateX(130%) rotate(14deg) !important; opacity: 0; }
  .mcr-card.fly-left { transform: translateX(-130%) rotate(-14deg) !important; opacity: 0; }
  @media (prefers-reduced-motion: reduce) { .mcr-card { transition: opacity .2s; } }

  /* Profile-style cards (photo + meta) */
  .mcr-profile { display: flex; flex-direction: column; height: 100%; }
  .mcr-photo { position: relative; flex: 1 1 auto; min-height: 0; display: flex; align-items: center; justify-content: center; }
  .mcr-photo::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 45%, rgba(6,12,22,0.85) 100%); }
  .mcr-photo-brand { background: radial-gradient(120% 90% at 50% 30%, #2ee6a6 0%, #12b886 55%, #0b7a5a 100%); }
  .mcr-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* Centered play button over the poster — filled mint circle for the first play. */
  .mcr-play { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); z-index: 4; display: inline-flex; align-items: center; justify-content: center; width: 68px; height: 68px; padding-left: 4px; border-radius: 50%; border: 0; background: var(--color-mint-400,#2ee6a6); color: #081019; box-shadow: 0 12px 30px -8px rgba(0,0,0,0.6); }
  .mcr-play:active { transform: translate(-50%,-50%) scale(0.94); }
  .mcr-play-ico { fill: currentColor; }
  /* Replay state (video finished): a plain OUTLINED triangle — no filled circle, so it
     reads as "replay this clip" and isn't confused with the mint nav arrow. */
  .mcr-play.is-replay { width: 60px; height: 60px; padding-left: 0; background: none; box-shadow: none; color: var(--color-mint-400,#2ee6a6); filter: drop-shadow(0 3px 10px rgba(0,0,0,0.55)); }
  .mcr-play.is-replay .mcr-play-ico { fill: none; stroke: currentColor; stroke-width: 2; }
  .mcr-logo { width: 96px; height: 96px; border-radius: 28px; background: rgba(255,255,255,0.92); display: flex; align-items: center; justify-content: center; box-shadow: 0 20px 50px -12px rgba(0,0,0,0.5); }
  .mcr-verify { position: absolute; top: 14px; left: 14px; z-index: 2; font-size: 0.72rem; font-weight: 700; color: #081019; background: rgba(255,255,255,0.9); padding: 0.28rem 0.6rem; border-radius: 999px; }
  .mcr-hero-ic { width: 92px; height: 92px; border-radius: 24px; background: rgba(46,230,166,0.12); border: 1px solid rgba(46,230,166,0.35); display: flex; align-items: center; justify-content: center; }
  .mcr-scrim-label { position: absolute; bottom: 14px; left: 16px; z-index: 2; font-size: 0.78rem; font-weight: 700; color: rgba(255,255,255,0.8); text-transform: uppercase; letter-spacing: 0.1em; }

  .mcr-meta { flex: 0 0 auto; padding: 1rem 1.15rem 1.2rem; }
  .mcr-meta-center { text-align: center; }
  .mcr-meta h2, .mcr-say h2, .mcr-plan h2, .mcr-cta h2 { margin: 0; font-size: clamp(1.55rem,6.5vw,2rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.02em; text-wrap: balance; }
  .mcr-age { font-size: 0.95rem; font-weight: 600; color: rgba(255,255,255,0.5); letter-spacing: 0; }
  .mcr-tag { margin: 0.4rem 0 0; font-size: 0.95rem; font-weight: 600; color: var(--color-mint-400,#2ee6a6); }
  .mcr-bio { margin: 0.55rem 0 0; font-size: 0.97rem; line-height: 1.5; color: rgba(255,255,255,0.74); }
  .mcr-bio.mcr-dim { color: rgba(255,255,255,0.5); font-style: italic; }
  .mcr-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.8rem; }
  .mcr-tags span { font-size: 0.74rem; font-weight: 600; padding: 0.3rem 0.6rem; border-radius: 999px; background: rgba(46,230,166,0.12); color: var(--color-mint-400,#2ee6a6); border: 1px solid rgba(46,230,166,0.25); }
  .mcr-swipe-hint { margin: 0.9rem 0 0; text-align: center; font-size: 0.8rem; color: rgba(255,255,255,0.5); animation: mcrPulse 1.8s ease-in-out infinite; }
