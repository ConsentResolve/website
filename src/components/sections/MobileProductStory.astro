  @keyframes checkPop { 0% { transform: scale(.2); } 60% { transform: scale(1.3); } 100% { transform: scale(1); } }
  @keyframes xPop { 0% { transform: scale(0); } 60% { transform: scale(1.25); } 100% { transform: scale(1); } }
  @keyframes vanishOut { to { opacity: 0; transform: scale(.25) rotate(-8deg); } }
