---
import "~/styles/global.css";
import SEO from "~/components/SEO.astro";
import Nav from "~/components/sections/Nav.astro";
import Footer from "~/components/sections/Footer.astro";
import MobileStickyCTA from "~/components/sections/MobileStickyCTA.astro";
import MobileProductStory from "~/components/sections/MobileProductStory.astro";
import DemoWidget from "~/components/DemoWidget.astro";

interface Props {
  title: string;
  ogTitle?: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: "website" | "article";
  schema?: unknown[];
  /** Site-wide "See it live" demo widget (links to /demo/sample/ in a new tab). On by
   *  default; pass false on the /demo/* pages themselves so it isn't self-referential. */
  demoWidget?: boolean;
}
const props = Astro.props as Props;
const showDemoWidget = props.demoWidget !== false;

// Ad-platform pixels — only emitted when the ID env var is set (no-op otherwise).
// Set in Cloudflare Pages env: PUBLIC_META_PIXEL_ID, PUBLIC_TIKTOK_PIXEL_ID.
const META_PIXEL_ID = import.meta.env.PUBLIC_META_PIXEL_ID || "1611275646787663";
// Second Meta pixel owned by the CR ads Business Manager (the one the launcher token can
// read) — audiences for ad retargeting build here. Fires alongside the original pixel.
const META_ADS_PIXEL_ID = "1045574481147406";
const TIKTOK_PIXEL_ID = import.meta.env.PUBLIC_TIKTOK_PIXEL_ID;
const GOOGLE_ADS_ID = import.meta.env.PUBLIC_GOOGLE_ADS_ID || "AW-18263188422"; // remarketing tag
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Hanken+Grotesk:wght@300..800&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    <SEO {...props} />

    <!-- ConsentResolve CMP (cookie consent banner + script blocker), wraps Usercentrics -->
    <link rel="preconnect" href="https://cdn.consentresolve.com" />
    <script is:inline src="https://cdn.consentresolve.com/consentresolve.js"></script>
    <script is:inline>ConsentResolve.init({siteId:'9a7ac777-3ca8-483a-b452-0c4deba31c3c',usercentricsSettingsId:'NToLbWs-EAo6fS'});ConsentResolve.page();</script>

    <!-- Meta Pixel (ad measurement) — CONSENT-GATED via ConsentResolve/Usercentrics
         autoblocker: type=text/plain keeps it inert; the CMP flips it to executable
         only after the user consents to the "Facebook Pixel" service. The data-usercentrics
         value MUST match the service name configured in the ConsentResolve/Usercentrics
         dashboard. Emitted only when PUBLIC_META_PIXEL_ID is set. -->
    {META_PIXEL_ID && (
      <script is:inline type="text/plain" data-usercentrics="Facebook Pixel" set:html={`!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${META_PIXEL_ID}');fbq('init','${META_ADS_PIXEL_ID}');fbq('track','PageView');`} />
    )}

    <!-- TikTok Pixel (ad measurement) — CONSENT-GATED (autoblocker; data-usercentrics
         must match the configured "TikTok Pixel" service). Emitted only when PUBLIC_TIKTOK_PIXEL_ID is set. -->
    {TIKTOK_PIXEL_ID && (
      <script is:inline type="text/plain" data-usercentrics="TikTok Pixel" set:html={`!function(w,d,t){w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];ttq.methods=["page","track","identify","instances","debug","on","off","once","ready","alias","group","enableCookie","disableCookie","holdConsent","revokeConsent","grantConsent"];ttq.setAndDefer=function(e,n){e[n]=function(){e.push([n].concat(Array.prototype.slice.call(arguments,0)))}};for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);ttq.instance=function(e){for(var n=ttq._i[e]||[],i=0;i<ttq.methods.length;i++)ttq.setAndDefer(n,ttq.methods[i]);return n};ttq.load=function(e,n){var r="https://analytics.tiktok.com/i18n/pixel/events.js",o=n&&n.partner;ttq._i=ttq._i||{};ttq._i[e]=[];ttq._i[e]._u=r;ttq._t=ttq._t||{};ttq._t[e]=+new Date;ttq._o=ttq._o||{};ttq._o[e]=n||{};var s=d.createElement("script");s.type="text/javascript";s.async=!0;s.src=r+"?sdkid="+e+"&lib="+t;var a=d.getElementsByTagName("script")[0];a.parentNode.insertBefore(s,a)};ttq.load('${TIKTOK_PIXEL_ID}');ttq.page()}(window,document,'ttq');`} />
    )}

    <!-- Leadsy AI vtag (visitor identification) — CONSENT-GATED via ConsentResolve/Usercentrics
         autoblocker: type=text/plain keeps it inert until the user consents to the "Leadsy"
         service. The data-usercentrics value MUST match the service name configured in the
         ConsentResolve/Usercentrics dashboard, or the script never loads. -->
    <script is:inline type="text/plain" data-usercentrics="Leadsy" id="vtag-ai-js" async src="https://r2.leadsy.ai/tag.js" data-pid="1a05vWNgmDU1HfyCP" data-version="062024"></script>

    <!-- RB2B (GetEmails) website-visitor identification — CONSENT-GATED via the
         ConsentResolve/Usercentrics autoblocker: type=text/plain keeps it inert until the
         visitor consents to the "RB2B" service (Termageddon built-in, template 22sYxVE_5GTFil).
         Fires only after consent — consistent with our consent-first stance. key=9NMMZHRE54NW. -->
    <script is:inline type="text/plain" data-usercentrics="RB2B">
      !function(key){if(window.reb2b)return;window.reb2b={loaded:true};var s=document.createElement("script");s.async=true;s.src="https://b2bjsstore.s3.us-west-2.amazonaws.com/b/"+key+"/"+key+".js.gz";document.getElementsByTagName("script")[0].parentNode.insertBefore(s,document.getElementsByTagName("script")[0]);}("9NMMZHRE54NW");
    </script>

    <!-- Apollo.io website visitor tracker (visitor identification; replaced RB2B) —
         CONSENT-GATED via ConsentResolve/Usercentrics autoblocker: type=text/plain keeps
         it inert until the user consents to the "Apollo" service. data-usercentrics MUST
         match the service name configured in the CMP/Termageddon, or it never loads. -->
    <script is:inline type="text/plain" data-usercentrics="Apollo">
      function initApollo(){var n=Math.random().toString(36).substring(7),o=document.createElement("script");o.src="https://assets.apollo.io/micro/website-tracker/tracker.iife.js?nocache="+n,o.async=!0,o.defer=!0,o.onload=function(){window.trackingFunctions.onLoad({appId:"6a398efaaa2d0a001467ff7f"})},document.head.appendChild(o)}initApollo();
    </script>

    <!-- Leadfeeder / Dealfront website-visitor tracker (COMPANY-level identification) —
         CONSENT-GATED via ConsentResolve/Usercentrics autoblocker: type=text/plain keeps
         it inert until the visitor consents to the "Leadfeeder" service. data-usercentrics
         MUST match the EXACT service name configured in Termageddon, or it never loads.
         Site id kn9Eq4R0mJk8RlvP. -->
    <script is:inline type="text/plain" data-usercentrics="Leadfeeder">
      (function(ss,ex){window.ldfdr=window.ldfdr||function(){(ldfdr._q=ldfdr._q||[]).push([].slice.call(arguments));};(function(d,s){fs=d.getElementsByTagName(s)[0];function ce(src){var cs=d.createElement(s);cs.src=src;cs.async=1;fs.parentNode.insertBefore(cs,fs);};ce('https://sc.lfeeder.com/lftracker_v1_'+ss+(ex?'_'+ex:'')+'.js');})(document,'script');})('kn9Eq4R0mJk8RlvP');
    </script>



    <!-- First-party pageview beacon (no PII) → /api/hit, powers the campaign dashboard Clicks KPI -->
    <script is:inline>
      (function(){try{var u=new URL(location.href);var src=u.searchParams.get("utm_source")||"";
        if(src&&!/(^|;\s*)cr_src=/.test(document.cookie)){document.cookie="cr_src="+encodeURIComponent(src)+"; Path=/; Max-Age=2592000; SameSite=Lax";}
        // Anonymous first-party visitor id — stays anonymous until the visitor identifies
        // themselves (demo form), at which point we stitch their prior pageviews to the contact.
        var vid=(document.cookie.match(/(?:^|;\s*)cr_vid=([^;]+)/)||[])[1];
        if(!vid){vid=Date.now().toString(36)+Math.random().toString(36).slice(2,10);document.cookie="cr_vid="+vid+"; Path=/; Max-Age=31536000; SameSite=Lax";}
        var b={path:location.pathname,utm_source:src,utm_campaign:u.searchParams.get("utm_campaign")||"",ref:document.referrer||"",vid:vid};
        var s=JSON.stringify(b);
        if(navigator.sendBeacon){navigator.sendBeacon("/api/hit",new Blob([s],{type:"application/json"}));}
        else{fetch("/api/hit",{method:"POST",headers:{"Content-Type":"application/json"},body:s,keepalive:true});}
      }catch(e){}})();
    </script>

    <!-- First-party presence heartbeat (no PII) → /api/ping. Powers Site Spy's real-time
         "on the site now" — pings while the tab is visible so live presence is accurate. -->
    <script is:inline>
      (function(){try{
        function vid(){return (document.cookie.match(/(?:^|;\s*)cr_vid=([^;]+)/)||[])[1]||"";}
        // Best-effort consent read from the CMP (Usercentrics API the CR CMP wraps).
        function consent(){ try{ if(window.UC_UI&&UC_UI.getServicesBaseInfo){ var svc=UC_UI.getServicesBaseInfo()||[];
          if(!svc.length) return "unknown";
          return svc.some(function(s){return s&&s.consent&&s.consent.status===true;})?"granted":"denied"; } }catch(e){} return "unknown"; }
        function ping(){ if(document.visibilityState!=="visible") return; var v=vid(); if(!v) return;
          var s=JSON.stringify({vid:v,path:location.pathname,consent:consent()});
          if(navigator.sendBeacon){navigator.sendBeacon("/api/ping",new Blob([s],{type:"application/json"}));}
          else{fetch("/api/ping",{method:"POST",headers:{"Content-Type":"application/json"},body:s,keepalive:true});}
        }
        ping();
        setInterval(ping,20000);
        document.addEventListener("visibilitychange",function(){ if(document.visibilityState==="visible") ping(); });
        // Video-view beacon — fire once per <video> on first play so Site Spy can show
        // which videos a visitor consumed. Recorded as a traffic hit with a "video:" path.
        var _seenVid={};
        document.addEventListener("play",function(e){ try{
          var el=e.target; if(!el||el.tagName!=="VIDEO") return;
          var key=(el.currentSrc||el.getAttribute("data-vid-name")||el.id||"video"); if(_seenVid[key]) return; _seenVid[key]=1;
          var name=(el.getAttribute("data-vid-name")||(el.currentSrc||"").split("/").pop()||el.id||"video").split("?")[0];
          var v=vid(); if(!v) return;
          var s=JSON.stringify({vid:v,path:"video:"+name,ref:location.pathname});
          if(navigator.sendBeacon){navigator.sendBeacon("/api/hit",new Blob([s],{type:"application/json"}));}
        }catch(e){} },true);
      }catch(e){}})();
    </script>

    <!-- Google Analytics (GA4) + Google Ads (AW-) via GOOGLE CONSENT MODE v2.
         Consent Mode is enabled in the ConsentResolve/Usercentrics (Termageddon) CMP, which
         fires gtag('consent','update',…) on the user's choice. VERIFIED 2026-07-28 (real
         browser): Accept All grants all four signals — analytics_storage (Google Analytics
         service → Statistics) + ad_storage/ad_user_data/ad_personalization (Google Ads service
         → Marketing). We set all four DENIED by default here (before gtag), so the tag boots
         cookieless and sends only anonymous modeled pings until the CMP upgrades to granted.
         The loader is intentionally NOT type=text/plain — Consent Mode needs gtag present to
         model declined conversions. No _ga/_gcl cookies are set while denied. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied', analytics_storage: 'denied',
        ad_user_data: 'denied', ad_personalization: 'denied',
        wait_for_update: 500
      });
      gtag('js', new Date());
      gtag('config', 'G-6JTD5SZNFY');
      gtag('config', 'AW-18263188422');
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-6JTD5SZNFY"></script>

    <!-- Meta Pixel is consent-gated above (PUBLIC_META_PIXEL_ID). The old un-gated
         duplicate was removed — it double-counted PageViews and bypassed consent. -->

    <!-- Microsoft Clarity (session recording) — CONSENT-GATED via ConsentResolve/Usercentrics
         autoblocker: type=text/plain keeps it inert until the user consents to the
         "Microsoft Clarity" service. data-usercentrics MUST match the configured service name. -->
    <script is:inline type="text/plain" data-usercentrics="Microsoft Clarity">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "vgfli9rxb5");
    </script>

    <!-- Retell AI chat (Mack) — CONSENT-GATED via ConsentResolve/Usercentrics autoblocker:
         type=text/plain keeps it inert until the visitor consents to the "Retell Chat"
         service. data-usercentrics MUST match the EXACT service name configured in the CMP
         ("Retell Chat"), or the chat stays blocked forever — same requirement Crisp had.
         On consent, the autoblocker executes this inline script, which injects the widget
         (public + chat-agent keys are publishable, safe in the client). -->
    <script is:inline type="text/plain" data-usercentrics="Retell Chat">(function(){try{if(window.__retellChatLoaded)return;window.__retellChatLoaded=1;var s=document.createElement("script");s.id="retell-widget";s.type="module";s.src="https://dashboard.retellai.com/retell-widget-v2.js";s.setAttribute("data-public-key","public_key_c635ded46e18e33c6b219");s.setAttribute("data-agent-id","agent_53dfb7733266901d4989695004");if(window.__retellOpenOnLoad)s.setAttribute("data-auto-open","true");(document.head||document.getElementsByTagName("head")[0]).appendChild(s);}catch(e){}})();</script>

    <!-- Conversion tracking helper. ONE call site for every ad-measurable action so
         campaigns have something to optimize toward besides PageView (which was all
         we fired, which is why paid traffic spend was unmeasurable).
         Standard Meta events use track(); anything else becomes trackCustom().
         Safe by design: no-ops when the pixel is absent — the pixel is consent-gated,
         so pre-consent visitors simply aren't counted. That undercounts conversions
         on purpose; it is the consent-first tradeoff, not a bug. -->
    <script is:inline>
      (function(){
        var STD={PageView:1,ViewContent:1,Lead:1,Contact:1,CompleteRegistration:1,Schedule:1,
                 SubmitApplication:1,StartTrial:1,Subscribe:1,Search:1,AddToCart:1,Purchase:1};
        window.crTrack=function(ev, params){
          params=params||{};
          try{ if(window.fbq) window.fbq(STD[ev]?"track":"trackCustom", ev, params); }catch(e){}
          try{ if(window.ttq&&window.ttq.track) window.ttq.track(ev, params); }catch(e){}
          try{ if(window.gtag) window.gtag("event", ev, params); }catch(e){}
          try{ if(window.__crTrackDebug) console.log("[crTrack]", ev, params); }catch(e){}
        };
      })();
    </script>

    <!-- Chat opener used by our own "Chat with us" / "Chat with Tyler" controls.
         Clicking is explicit intent: prompt the CMP so the consent-gated loader boots
         Mack (Retell) and auto-opens; if Mack is already booted, open his launcher.
         After ~5s with no CMP response, boot on the explicit intent. mailto is the
         last-resort fallback. -->
    <script is:inline>window.crOpenChat=function(){try{var PK="public_key_c635ded46e18e33c6b219",AID="agent_53dfb7733266901d4989695004";function clickFab(){var b=document.querySelector('#retell-widget-fab,[class*="retell"] [class*="fab"],[class*="retell"] button');if(b){b.click();return true;}return false;}function boot(open){if(window.__retellChatLoaded)return;window.__retellChatLoaded=1;var s=document.createElement("script");s.id="retell-widget";s.type="module";s.src="https://dashboard.retellai.com/retell-widget-v2.js";s.setAttribute("data-public-key",PK);s.setAttribute("data-agent-id",AID);if(open)s.setAttribute("data-auto-open","true");(document.head||document.getElementsByTagName("head")[0]).appendChild(s);}if(window.__retellChatLoaded){var n=0,iv=setInterval(function(){if(clickFab()||++n>24)clearInterval(iv);},250);return;}window.__retellOpenOnLoad=true;try{if(window.ConsentResolve&&ConsentResolve.showBanner)ConsentResolve.showBanner();else if(window.UC_UI&&UC_UI.showFirstLayer)UC_UI.showFirstLayer();}catch(e){}var t=0,ivb=setInterval(function(){if(window.__retellChatLoaded){clearInterval(ivb);var m=0,iv2=setInterval(function(){if(clickFab()||++m>24)clearInterval(iv2);},250);return;}if(++t>10){clearInterval(ivb);boot(true);}},500);}catch(e){try{window.location.href="mailto:hello@consentresolve.com";}catch(_){}}};</script>
  </head>
  <body class="bg-[color:var(--color-bg)] text-[color:var(--color-ink)]">
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileStickyCTA />
    <MobileProductStory />
    {showDemoWidget && <DemoWidget />}
  </body>
</html>
