---
import "~/styles/global.css";
import SEO from "~/components/SEO.astro";
import Nav from "~/components/sections/Nav.astro";
import Footer from "~/components/sections/Footer.astro";
import MobileStickyCTA from "~/components/sections/MobileStickyCTA.astro";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: "website" | "article";
  schema?: unknown[];
}
const props = Astro.props as Props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Hanken+Grotesk:wght@300..800&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    <SEO {...props} />

    <!-- ConsentResolve CMP (cookie consent banner + script blocker), wraps Usercentrics -->
    <link rel="preconnect" href="https://cdn.consentresolve.com" />
    <script is:inline src="https://cdn.consentresolve.com/consentresolve.js"></script>
    <script is:inline>ConsentResolve.init({siteId:'9a7ac777-3ca8-483a-b452-0c4deba31c3c',usercentricsSettingsId:'NToLbWs-EAo6fS'});ConsentResolve.page();</script>

    <!-- Leadsy AI vtag (visitor identification) -->
    <script is:inline id="vtag-ai-js" async src="https://r2.leadsy.ai/tag.js" data-pid="1a05vWNgmDU1HfyCP" data-version="062024"></script>

    <!-- Google Analytics (GA4) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-6JTD5SZNFY"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-6JTD5SZNFY');
    </script>

    <!-- Meta Pixel -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1611275646787663');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=1611275646787663&ev=PageView&noscript=1" /></noscript>

    <!-- Tawk.to live chat -->
    <script is:inline type="text/javascript">
      var Tawk_API=Tawk_API||{}, Tawk_LoadStart=new Date();
      (function(){
        var s1=document.createElement("script"),s0=document.getElementsByTagName("script")[0];
        s1.async=true;
        s1.src='https://embed.tawk.to/69aa06f84716c51c370262e9/1jj02mf7b';
        s1.charset='UTF-8';
        s1.setAttribute('crossorigin','*');
        s0.parentNode.insertBefore(s1,s0);
      })();
    </script>

    <!-- Hide Tawk.to branding (widget + chat iframe) -->
    <script is:inline type="text/javascript">
      (function removeTawkBranding() {
        "use strict";

        var STYLE_ID = "hide-tawk-branding";

        var BRANDING_CSS = [
          "a[href*='tawk.to'] { display: none !important; }",
          "a[href*='utm_source=tawk-messenger'] { display: none !important; }",
          "a[title*='Add Chat to your website'] { display: none !important; }",
          ".tawk-branding { display: none !important; }",
          "[class*='tawk-branding'] { display: none !important; }",
          ".tawk-padding-small { display: none !important; }",
          ".tawk-icon-popout { display: none !important; }",
        ].join("\n");

        function injectStyle(doc) {
          if (!doc || doc.getElementById(STYLE_ID)) return;
          var style = doc.createElement("style");
          style.id = STYLE_ID;
          style.textContent = BRANDING_CSS;
          (doc.head || doc.documentElement).appendChild(style);
        }

        function handleIframe(iframe) {
          var title = (iframe.title || "").toLowerCase();
          if (title.indexOf("chat") === -1) return;
          iframe.addEventListener("load", function () {
            try { injectStyle(iframe.contentDocument); } catch (e) {}
          });
        }

        // Observe for new iframes (Tawk rebuilds its widget).
        var observer = new MutationObserver(function (mutations) {
          mutations.forEach(function (m) {
            m.addedNodes.forEach(function (node) {
              if (node.nodeName === "IFRAME") handleIframe(node);
            });
          });
        });

        function start() {
          injectStyle(document);
          // Catch any chat iframe already present, then watch for new ones.
          document.querySelectorAll("iframe").forEach(handleIframe);
          observer.observe(document.body, { childList: true, subtree: true });
        }

        // This runs in <head>, so wait until <body> exists.
        if (document.body) start();
        else document.addEventListener("DOMContentLoaded", start);
      })();
    </script>

    <!-- iMessage-style notification chime (1.5s after load) -->
    <script is:inline type="text/javascript">
      (function () {
        const playiMessageSound = () => {
          const audioContext = new (window.AudioContext || window.webkitAudioContext)();

          // First tone (higher pitch - C6)
          const oscillator1 = audioContext.createOscillator();
          const gainNode1 = audioContext.createGain();

          oscillator1.connect(gainNode1);
          gainNode1.connect(audioContext.destination);

          oscillator1.frequency.value = 1109; // C6
          oscillator1.type = 'sine';

          gainNode1.gain.setValueAtTime(0, audioContext.currentTime);
          gainNode1.gain.linearRampToValueAtTime(0.3, audioContext.currentTime + 0.01);
          gainNode1.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.15);

          oscillator1.start(audioContext.currentTime);
          oscillator1.stop(audioContext.currentTime + 0.15);

          // Second tone (lower pitch - A5) - plays shortly after first
          const oscillator2 = audioContext.createOscillator();
          const gainNode2 = audioContext.createGain();

          oscillator2.connect(gainNode2);
          gainNode2.connect(audioContext.destination);

          oscillator2.frequency.value = 880; // A5
          oscillator2.type = 'sine';

          gainNode2.gain.setValueAtTime(0, audioContext.currentTime + 0.08);
          gainNode2.gain.linearRampToValueAtTime(0.3, audioContext.currentTime + 0.09);
          gainNode2.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.25);

          oscillator2.start(audioContext.currentTime + 0.08);
          oscillator2.stop(audioContext.currentTime + 0.25);
        };

        // Call after 1.5 second delay
        setTimeout(() => {
          try { playiMessageSound(); } catch (e) {}
        }, 1500);
      })();
    </script>

    <!-- Microsoft Clarity -->
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "vgfli9rxb5");
    </script>
  </head>
  <body class="bg-[color:var(--color-bg)] text-[color:var(--color-ink)]">
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileStickyCTA />
  </body>
</html>
