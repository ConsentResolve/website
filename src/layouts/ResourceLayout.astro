---
/**
 * ResourceLayout — shared chrome for every Resource Center detail page
 * (how-to-guide, glossary, plain-language-explainer, blog). Handles
 * server-rendered SEO meta + JSON-LD, breadcrumbs, the article hero,
 * Key-Takeaways boxes (top + bottom), the rendered Markdown body, the FAQ
 * accordion, and the CTA band.
 *
 * Type-specific section ORDER lives in each Markdown body (the spec's section
 * orders per resource type), so this layout stays universal.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import Badge from "~/components/ui/Badge.astro";
import FAQ from "~/components/sections/FAQ.astro";
import KeyTakeaways from "~/components/resources/KeyTakeaways.astro";
import ComplianceNote from "~/components/resources/ComplianceNote.astro";
import type { ResourceData } from "~/content.config";
import { resourceImage } from "~/lib/resources";
import { authorUrl, type Author } from "~/data/authors";
import { IconArrowRight, IconArrowUpRight, IconBrandLinkedin } from "@tabler/icons-react";

interface Props {
  data: ResourceData;
  schemas: unknown[];
  /** Crumb label for the resource-type index, e.g. "How-To Guides". */
  typeLabel: string;
  /** Path to the type index, e.g. "/resources/how-to-guides/". */
  typeHref: string;
  /** Blog only: real author + optional reviewer (drives byline, author box). */
  author?: Author;
  reviewer?: Author;
}
const { data, schemas, typeLabel, typeHref, author, reviewer } = Astro.props as Props;
const isBlog = Boolean(author);

const ogImage =
  data.images?.og_image ||
  data.images?.featured_image ||
  data.featured_image ||
  resourceImage(data, "og");
const dateStr = (data.updated_at || data.published_at)?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "Resources", href: "/resources/" },
  { name: typeLabel, href: typeHref },
  { name: data.title, href: new URL(data.canonical_url).pathname },
];

// Title strategy (title-strategy.md §3): <title> = seo_title, with the brand
// suffix appended only when it still fits the 60-char hard cap. Social title
// (og/twitter) = the authored og_hook — the punchy, numeral-led line.
const BRAND_SUFFIX = " · Consent Resolve";
const seoTitle =
  data.seo_title.length + BRAND_SUFFIX.length <= 60
    ? `${data.seo_title}${BRAND_SUFFIX}`
    : data.seo_title;
const ogTitle = data.og_hook || data.seo_title;
---

<BaseLayout
  title={seoTitle}
  ogTitle={ogTitle}
  description={data.seo_description}
  canonical={data.canonical_url}
  ogType="article"
  ogImage={ogImage}
  schema={schemas}
>
  <Breadcrumbs items={breadcrumbs} />

  <article class="container-content max-w-3xl pb-8 pt-8">
    <!-- Hero -->
    <header class="mb-8 border-b border-[color:var(--color-rule)] pb-8">
      <div class="mb-5 flex flex-wrap items-center gap-3">
        <Badge tone="brand" variant="soft" size="md" uppercase>{data.category}</Badge>
        <span class="text-xs font-semibold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">
          {typeLabel.replace(/s$/, "")}
        </span>
      </div>
      <h1 class="display-1 text-[color:var(--color-ink)]">{data.title}</h1>
      <p class="mt-6 text-lg leading-relaxed text-[color:var(--color-ink-2)]">{data.excerpt}</p>
      <div class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-[color:var(--color-ink-muted)]">
        {author ? (
          <>
            <span>By <a href={authorUrl(author.slug)} class="font-semibold text-[color:var(--color-ink-2)] hover:text-[color:var(--color-brand-pressed)]">{author.name}</a>, {author.title} at Consent Resolve</span>
            {data.read_time && <><span aria-hidden="true">·</span><span>{data.read_time} read</span></>}
            {reviewer && <><span aria-hidden="true">·</span><span>Reviewed by <a href={authorUrl(reviewer.slug)} class="font-semibold text-[color:var(--color-ink-2)] hover:text-[color:var(--color-brand-pressed)]">{reviewer.name}</a>, {reviewer.title}</span></>}
          </>
        ) : (
          <>
            {!data.hide_byline && <span>By {data.author}</span>}
            {data.read_time && <>{!data.hide_byline && <span aria-hidden="true">·</span>}<span>{data.read_time} read</span></>}
            {dateStr && <><span aria-hidden="true">·</span><span>Updated {dateStr}</span></>}
          </>
        )}
      </div>
    </header>

    {data.tldr && (
      <aside class="tldr my-8 rounded-2xl border-l-4 border-[color:var(--color-brand)] bg-[color:var(--color-brand-soft)] p-6 ring-1 ring-inset ring-[color:var(--color-rule)]" aria-label="The short answer">
        <div class="mb-2"><Badge tone="brand" variant="soft" size="sm" uppercase>The short answer</Badge></div>
        <p class="text-[17px] leading-relaxed text-[color:var(--color-ink)]">{data.tldr}</p>
      </aside>
    )}
    {/* Blog: key takeaways near the top. Guides/explainers: top only when no TL;DR. */}
    {isBlog
      ? data.key_takeaways && <KeyTakeaways text={data.key_takeaways} placement="top" />
      : !data.tldr && data.key_takeaways && <KeyTakeaways text={data.key_takeaways} placement="top" />}

    <!-- Rendered Markdown body -->
    <div class="rc-prose"><slot /></div>

    {data.compliance_note && <ComplianceNote text={data.compliance_note} />}

    {(data.sources.length > 0 || data.disclaimer) && (
      <aside class="my-8 rounded-2xl border border-[color:var(--color-rule)] bg-[color:var(--color-bg-alt)] p-6">
        {data.sources.length > 0 && (
          <>
            <div class="mb-2 text-xs font-bold uppercase tracking-[0.1em] text-[color:var(--color-ink-muted)]">Primary sources</div>
            <ul class="flex flex-col gap-1.5">
              {data.sources.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-sm font-semibold text-[color:var(--color-brand-pressed)] hover:underline">
                    {s.label}
                    <IconArrowUpRight size={14} stroke={2.2} />
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
        {data.disclaimer && (
          <p class={`text-xs leading-relaxed text-[color:var(--color-ink-muted)] ${data.sources.length > 0 ? "mt-3" : ""}`}>
            This is educational information, not legal advice. Consult a qualified attorney about your specific situation.
          </p>
        )}
      </aside>
    )}

    {/* Blog: a "Recap" box near the end. Guides/explainers: key takeaways at bottom. */}
    {isBlog
      ? data.recap && <KeyTakeaways text={data.recap} placement="bottom" />
      : data.key_takeaways && <KeyTakeaways text={data.key_takeaways} placement="bottom" />}

    {data.related.length > 0 && (
      <aside class="my-8">
        <div class="mb-3 text-xs font-bold uppercase tracking-[0.1em] text-[color:var(--color-ink-muted)]">Related</div>
        <div class="flex flex-wrap gap-2">
          {data.related.map((r) => (
            <a href={r.url} class="rounded-lg bg-[color:var(--color-brand-soft)] px-3 py-1.5 text-sm font-medium text-[color:var(--color-brand-pressed)] transition hover:ring-1 hover:ring-[color:var(--color-mint-400)]/60">{r.label}</a>
          ))}
        </div>
      </aside>
    )}

    <!-- CTA band -->
    <div class="mt-10 rounded-3xl bg-[color:var(--color-bg-inverse)] p-8 text-center ring-1 ring-inset ring-white/10">
      <a
        href={data.primary_cta.url}
        class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-brand)] px-7 py-3.5 text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--color-navy-900)] shadow-[0_18px_36px_-18px_rgba(0,229,160,0.55)] transition-all hover:-translate-y-0.5 hover:bg-[color:var(--color-brand-pressed)] hover:text-white"
      >
        {data.primary_cta.label}
        <IconArrowRight size={16} stroke={2.5} />
      </a>
      {data.secondary_cta && (
        <p class="mt-5">
          <a
            href={data.secondary_cta.url}
            class="inline-flex items-center gap-2 text-sm font-semibold text-[color:var(--color-on-inverse)] underline-offset-4 hover:underline"
          >
            {data.secondary_cta.label}
            <IconArrowRight size={14} stroke={2.2} />
          </a>
        </p>
      )}
    </div>

    {isBlog && author && (
      <aside class="mt-10 flex flex-col gap-5 rounded-2xl bg-[color:var(--color-bg-alt)] p-6 ring-1 ring-inset ring-[color:var(--color-rule)] sm:flex-row">
        <img src={author.photo} alt={author.name} width="80" height="80" class="size-16 shrink-0 rounded-xl object-cover ring-1 ring-inset ring-[color:var(--color-rule)]" />
        <div>
          <div class="font-display text-lg font-bold text-[color:var(--color-ink)]">{author.name}</div>
          <div class="text-sm text-[color:var(--color-ink-muted)]">{author.title} · Consent Resolve</div>
          <p class="mt-2 text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">{author.longBio}</p>
          <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm font-semibold">
            <a href={author.linkedin} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-[color:var(--color-brand-pressed)]"><IconBrandLinkedin size={15} stroke={2} /> Follow on LinkedIn</a>
            <a href="/about/" class="text-[color:var(--color-ink-2)] hover:text-[color:var(--color-ink)]">Meet the team →</a>
            <a href={authorUrl(author.slug)} class="text-[color:var(--color-ink-2)] hover:text-[color:var(--color-ink)]">More from {author.name.split(" ")[0]} →</a>
          </div>
        </div>
      </aside>
    )}
  </article>

  {data.faq_items.length > 0 && (
    <FAQ eyebrow="FAQ" headline="Frequently asked questions" items={data.faq_items} />
  )}
</BaseLayout>

<style is:global>
  .rc-prose {
    color: var(--color-ink-2);
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .rc-prose > * + * {
    margin-top: 1.25rem;
  }
  .rc-prose h2 {
    font-family: var(--font-display, inherit);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    font-size: 1.6rem;
    line-height: 1.25;
    margin-top: 2.5rem;
    scroll-margin-top: 5rem;
  }
  .rc-prose h3 {
    font-family: var(--font-display, inherit);
    font-weight: 700;
    color: var(--color-ink);
    font-size: 1.25rem;
    margin-top: 2rem;
  }
  .rc-prose p {
    color: var(--color-ink-2);
  }
  .rc-prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    margin-top: 1.5rem;
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    overflow: hidden;
  }
  .rc-prose th,
  .rc-prose td {
    text-align: left;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--color-rule);
    vertical-align: top;
  }
  .rc-prose thead th {
    background: var(--color-brand-soft);
    color: var(--color-ink);
    font-weight: 700;
    font-family: var(--font-display, inherit);
  }
  .rc-prose tbody tr:last-child td {
    border-bottom: none;
  }
  .rc-prose tbody tr:nth-child(even) {
    background: var(--color-bg-alt);
  }
  .rc-prose strong {
    color: var(--color-ink);
    font-weight: 700;
  }
  .rc-prose a {
    color: var(--color-brand-pressed);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .rc-prose a:hover {
    color: var(--color-ink);
  }
  .rc-prose ul,
  .rc-prose ol {
    padding-left: 1.5rem;
  }
  .rc-prose ul {
    list-style: disc;
  }
  .rc-prose ol {
    list-style: decimal;
  }
  .rc-prose li + li {
    margin-top: 0.6rem;
  }
  .rc-prose li::marker {
    color: var(--color-ink-muted);
  }
</style>
