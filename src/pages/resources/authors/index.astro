---
/** Authors archive — /resources/authors/. Lists the five Consent Resolve authors. */
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import Badge from "~/components/ui/Badge.astro";
import { SITE } from "~/lib/site";
import { AUTHORS, AUTHOR_ORDER, authorUrl } from "~/data/authors";
import { itemListSchema } from "~/lib/seo";
import { IconArrowRight } from "@tabler/icons-react";

const canonical = `${SITE.url}/resources/authors/`;
const schemas = [
  itemListSchema({ name: "Consent Resolve Authors", items: AUTHOR_ORDER.map((s) => ({ name: AUTHORS[s].name, url: `${SITE.url}${authorUrl(s)}` })) }),
];
const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "Resources", href: "/resources/" },
  { name: "Authors", href: "/resources/authors/" },
];
---

<BaseLayout title="Authors · Consent Resolve" description="The people behind the Consent Resolve Resource Center — real operators in privacy, engineering, marketing, and home-service sales." canonical={canonical} schema={schemas}>
  <Breadcrumbs items={breadcrumbs} />
  <section class="container-content pb-2 pt-10">
    <div class="max-w-3xl">
      <div class="mb-6"><Badge tone="brand" variant="soft" size="md" uppercase>Authors</Badge></div>
      <h1 class="display-1 text-[color:var(--color-ink)]">Who's behind the writing.</h1>
      <p class="mt-6 text-lg leading-relaxed text-[color:var(--color-ink-2)]">Every post is written by a named member of the team whose experience matches the topic — not anonymous content.</p>
    </div>
  </section>
  <section class="section-tight pt-8">
    <div class="container-content grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {AUTHOR_ORDER.map((s) => {
        const a = AUTHORS[s];
        return (
          <a href={authorUrl(s)} class="group flex flex-col rounded-2xl bg-[color:var(--color-bg-alt)] p-7 ring-1 ring-inset ring-[color:var(--color-rule)] transition-all hover:-translate-y-0.5 hover:ring-[color:var(--color-mint-400)]/60">
            <img src={a.photo} alt={a.name} width="64" height="64" class="size-16 rounded-xl object-cover ring-1 ring-inset ring-[color:var(--color-rule)]" />
            <div class="mt-4 font-display text-lg font-bold text-[color:var(--color-ink)]">{a.name}</div>
            <div class="text-sm text-[color:var(--color-ink-muted)]">{a.title}</div>
            <p class="mt-3 flex-1 text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">{a.writesAbout}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-[color:var(--color-brand-pressed)] group-hover:translate-x-0.5">View profile <IconArrowRight size={15} stroke={2.5} /></span>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
