---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import Badge from "~/components/ui/Badge.astro";
import ResourceGrid from "~/components/resources/ResourceGrid.astro";
import { itemListSchema } from "~/lib/seo";
import { SITE } from "~/lib/site";
import { RESOURCE_TYPES, resourceHref, getResources } from "~/lib/resources";

const meta = RESOURCE_TYPES["blog"];
const entries = await getResources("blog");
const canonical = `${SITE.url}/resources/blog/`;
const schemas = [
  itemListSchema({
    name: "Consent Resolve Blog",
    items: entries.map((e) => ({ name: e.data.title, url: `${SITE.url}${resourceHref(e.data)}` })),
  }),
];
const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "Resources", href: "/resources/" },
  { name: meta.label, href: "/resources/blog/" },
];
---

<BaseLayout
  title="Blog · Consent Resolve Resource Center"
  description={meta.blurb}
  canonical={canonical}
  schema={schemas}
>
  <Breadcrumbs items={breadcrumbs} />
  <section class="container-content pb-4 pt-10">
    <div class="max-w-3xl">
      <div class="mb-6"><Badge tone="brand" variant="soft" size="md" uppercase>{meta.label}</Badge></div>
      <h1 class="display-1 text-[color:var(--color-ink)]">Blog</h1>
      <p class="mt-6 text-lg leading-relaxed text-[color:var(--color-ink-2)]">{meta.blurb}</p>
    </div>
  </section>
  <section class="section-tight pt-6">
    <div class="container-content"><ResourceGrid entries={entries} /></div>
  </section>
</BaseLayout>
