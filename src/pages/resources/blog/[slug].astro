---
/**
 * Blog post detail — /resources/blog/[slug]/.
 * Body section order: Hook → Problem → Insight → Evidence →
 * Practical Takeaways → CTA → FAQs. Schema: BlogPosting + FAQPage.
 */
import { getCollection, render } from "astro:content";
import ResourceLayout from "~/layouts/ResourceLayout.astro";
import { articleSchema, faqSchema } from "~/lib/seo";

export async function getStaticPaths() {
  const all = await getCollection("resources");
  return all
    .filter((e) => e.data.resource_type === "blog")
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

const schemas: unknown[] = [
  articleSchema({
    type: "BlogPosting",
    headline: data.title,
    description: data.excerpt,
    url: data.canonical_url,
    datePublished: data.published_at,
    dateModified: data.updated_at,
    image: data.images?.og_image || data.images?.featured_image || data.featured_image,
  }),
];
if (data.faq_items.length > 0) schemas.push(faqSchema(data.faq_items));
---

<ResourceLayout
  data={data}
  schemas={schemas}
  typeLabel="Blog"
  typeHref="/resources/blog/"
>
  <Content />
</ResourceLayout>
