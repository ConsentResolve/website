---
/**
 * Resource Center hub — /resources/. Lists every resource type that has
 * published entries, grouped by type, newest first. Emits ItemList JSON-LD.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import Badge from "~/components/ui/Badge.astro";
import ResourceGrid from "~/components/resources/ResourceGrid.astro";
import { itemListSchema } from "~/lib/seo";
import { SITE } from "~/lib/site";
import {
  RESOURCE_TYPES,
  RESOURCE_TYPE_ORDER,
  typeHref,
  resourceHref,
  getResources,
} from "~/lib/resources";
import { IconArrowRight } from "@tabler/icons-react";

const all = await getResources();

// Group by type, preserving the canonical type order.
const groups = RESOURCE_TYPE_ORDER.map((type) => ({
  type,
  meta: RESOURCE_TYPES[type],
  entries: all.filter((e) => e.data.resource_type === type),
})).filter((g) => g.entries.length > 0);

const canonical = `${SITE.url}/resources/`;
const schemas = [
  itemListSchema({
    name: "Consent Resolve Resource Center",
    items: all.map((e) => ({
      name: e.data.title,
      url: `${SITE.url}${resourceHref(e.data)}`,
    })),
  }),
];

const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "Resources", href: "/resources/" },
];
---

<BaseLayout
  title="Resource Center | Consent Resolve"
  description="Guides, glossary, and explainers on consent-first, privacy-safe lead generation for home-service contractors. Turn anonymous visitors into known leads."
  canonical={canonical}
  schema={schemas}
>
  <Breadcrumbs items={breadcrumbs} />

  <!-- Hero -->
  <section class="container-content pb-4 pt-10">
    <div class="max-w-3xl">
      <div class="mb-6"><Badge tone="brand" variant="soft" size="md" uppercase>Resource Center</Badge></div>
      <h1 class="display-1 text-[color:var(--color-ink)]">Turn anonymous visitors into known leads.</h1>
      <p class="mt-6 text-lg leading-relaxed text-[color:var(--color-ink-2)]">
        Practical, consent-first playbooks for home-service contractors — how to
        get found, capture the traffic you already pay for, and book more jobs,
        without the privacy-law exposure of scrape-and-cold-call tools.
      </p>
    </div>
  </section>

  {groups.map((g) => (
    <section class="section-tight">
      <div class="container-content">
        <div class="mb-8 flex items-end justify-between gap-4">
          <div>
            <h2 class="display-2 text-[color:var(--color-ink)]">{g.meta.label}</h2>
            <p class="mt-3 max-w-2xl text-[color:var(--color-ink-2)]">{g.meta.blurb}</p>
          </div>
          <a
            href={typeHref(g.type)}
            class="hidden shrink-0 items-center gap-1.5 text-sm font-bold text-[color:var(--color-brand-pressed)] hover:text-[color:var(--color-ink)] sm:inline-flex"
          >
            View all
            <IconArrowRight size={15} stroke={2.5} />
          </a>
        </div>
        <ResourceGrid entries={g.entries} />
      </div>
    </section>
  ))}
</BaseLayout>
