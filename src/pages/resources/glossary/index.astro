---
/**
 * Glossary — /resources/glossary/. Single-page reference of 138 plain-English
 * home-service marketing, lead-gen, visitor-ID, and privacy/consent terms.
 * Rebuilt in the Consent Resolve design system (brand tokens + BaseLayout).
 * Search + category filter + A–Z jump are vanilla JS. Emits DefinedTermSet.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import Badge from "~/components/ui/Badge.astro";
import { SITE } from "~/lib/site";
import { getResources, resourceHref } from "~/lib/resources";
import { GLOSSARY_TERMS, GLOSSARY_CATEGORIES } from "~/data/glossary";
import { IconArrowRight } from "@tabler/icons-react";

// Data-driven "Go deeper →": map each glossary term id to its matching
// Straight Answers explainer (via the article's glossary_slug field).
const explainers = await getResources("plain-language-explainer");
const goDeeper: Record<string, string> = {};
for (const e of explainers) {
  if (e.data.glossary_slug) goDeeper[e.data.glossary_slug] = resourceHref(e.data);
}

const canonical = `${SITE.url}/resources/glossary/`;

// Group terms by first letter (A–Z).
const byLetter = new Map<string, typeof GLOSSARY_TERMS>();
for (const t of [...GLOSSARY_TERMS].sort((a, b) => a.term.toLowerCase().localeCompare(b.term.toLowerCase()))) {
  const L = /[a-z]/i.test(t.term[0]) ? t.term[0].toUpperCase() : "#";
  if (!byLetter.has(L)) byLetter.set(L, []);
  byLetter.get(L)!.push(t);
}
const ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
const letters = [...byLetter.keys()];
const catLabel = Object.fromEntries(GLOSSARY_CATEGORIES.map((c) => [c.key, c.label]));

const termSetSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "@id": `${canonical}#termset`,
  name: "Home Service Marketing & Consent Glossary",
  description:
    "A reference guide to marketing, lead generation, visitor identification, and privacy & consent terms home-service contractors need to know.",
  url: canonical,
  hasDefinedTerm: GLOSSARY_TERMS.map((t) => ({
    "@type": "DefinedTerm",
    "@id": `${canonical}#${t.id}`,
    name: t.term,
    description: t.definition,
    inDefinedTermSet: `${canonical}#termset`,
  })),
};

const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "Resources", href: "/resources/" },
  { name: "Glossary", href: "/resources/glossary/" },
];
---

<BaseLayout
  title="Home-Service Marketing & Consent Glossary | Consent Resolve"
  description="Plain-English glossary of marketing, lead-gen, visitor-ID, and privacy terms for contractors — TCPA, CPL, LTV, consent-first, and more."
  canonical={canonical}
  schema={[termSetSchema]}
>
  <Breadcrumbs items={breadcrumbs} />

  <!-- Hero -->
  <section class="container-content pb-2 pt-10">
    <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <div class="mb-6"><Badge tone="brand" variant="soft" size="md" uppercase>Resources · Glossary</Badge></div>
        <h1 class="display-1 text-[color:var(--color-ink)]">The home-service marketing &amp; consent glossary.</h1>
        <p class="mt-6 text-lg leading-relaxed text-[color:var(--color-ink-2)]">
          Plain-English definitions of the marketing, lead, and privacy terms you'll run into working with us —
          and the consent terms most lead vendors hope you never learn.
        </p>
        <p class="mt-4 text-sm text-[color:var(--color-ink-muted)]"><b class="text-[color:var(--color-ink-2)]">{GLOSSARY_TERMS.length}</b> terms</p>
      </div>
      <!-- Hero illustration — locked card treatment: navy panel + green-bordered white card -->
      <div class="relative hidden lg:block">
        <div class="relative overflow-hidden rounded-3xl bg-[color:var(--color-bg-inverse)] p-8 ring-1 ring-inset ring-[color:var(--color-mint-400)]/40 shadow-[0_30px_60px_-30px_rgba(10,22,40,0.5)]">
          <div aria-hidden="true" class="pointer-events-none absolute -right-12 -top-12 size-48 rounded-full bg-[color:var(--color-mint-400)]/25 blur-3xl"></div>
          <div class="relative rounded-2xl border-2 border-[color:var(--color-mint-400)] bg-[#f8fafc] p-6">
            <img
              src="/images/resources/glossary-hero.png"
              alt="Illustration of a magnifying glass over an open glossary book"
              width="1204"
              height="1213"
              loading="eager"
              decoding="async"
              class="mx-auto block h-auto w-full max-w-[340px]"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sticky controls: search + category chips -->
  <div class="sticky top-[72px] z-40 border-y border-[color:var(--color-rule)] bg-[color:var(--color-bg)]/95 backdrop-blur">
    <div class="container-content py-4">
      <div class="relative">
        <input
          id="gloss-q"
          type="search"
          placeholder="Search terms — try “TCPA”, “CPL”, “match rate”…"
          autocomplete="off"
          aria-label="Search glossary terms"
          class="w-full rounded-xl border border-[color:var(--color-rule)] bg-[color:var(--color-bg-alt)] px-4 py-3 text-[15px] text-[color:var(--color-ink)] outline-none focus:border-[color:var(--color-mint-400)] focus:ring-2 focus:ring-[color:var(--color-mint-400)]/40"
        />
      </div>
      <div id="gloss-chips" class="mt-3 flex flex-wrap gap-2">
        <button class="gloss-chip is-active" data-filter="all">All <span class="opacity-60">{GLOSSARY_TERMS.length}</span></button>
        {GLOSSARY_CATEGORIES.map((c) => (
          <button class="gloss-chip" data-filter={c.key}>{c.label} <span class="opacity-60">{c.count}</span></button>
        ))}
      </div>
    </div>
  </div>

  <main class="container-content pb-8">
    <!-- A–Z jump -->
    <nav class="flex flex-wrap gap-1 py-5" aria-label="Jump to letter">
      {ALPHABET.map((L) =>
        letters.includes(L) ? (
          <a href={`#letter-${L}`} class="flex size-8 items-center justify-center rounded-lg font-display text-sm font-bold text-[color:var(--color-ink-2)] transition-colors hover:bg-[color:var(--color-brand-soft)] hover:text-[color:var(--color-brand-pressed)]">{L}</a>
        ) : (
          <span class="flex size-8 items-center justify-center rounded-lg font-display text-sm font-bold text-[color:var(--color-ink-muted)] opacity-30">{L}</span>
        )
      )}
    </nav>

    {[...byLetter.entries()].map(([L, terms]) => (
      <section class="gloss-letter scroll-mt-40 pt-8" id={`letter-${L}`} data-letter={L}>
        <div class="mb-5 flex items-center gap-4">
          <span class="font-display text-3xl font-extrabold leading-none text-[color:var(--color-brand-pressed)]">{L}</span>
          <span class="h-px flex-1 bg-[color:var(--color-rule)]"></span>
        </div>
        <div class="grid gap-4">
          {terms.map((t) => (
            <article
              class="gloss-term scroll-mt-40 rounded-2xl bg-[color:var(--color-bg-alt)] p-6 ring-1 ring-inset ring-[color:var(--color-rule)]"
              id={t.id}
              data-cat={t.category}
              data-q={`${t.term} ${t.definition}`.toLowerCase()}
            >
              <div class="mb-2.5 flex flex-wrap items-start justify-between gap-3">
                <h2 class="font-display text-xl font-bold tracking-tight text-[color:var(--color-ink)]">
                  <a href={`#${t.id}`} class="hover:text-[color:var(--color-brand-pressed)]">{t.term}</a>
                </h2>
                <Badge tone="brand" variant="soft" size="sm">{catLabel[t.category]}</Badge>
              </div>
              <p class="text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">{t.definition}</p>
              {goDeeper[t.id] && (
                <a href={goDeeper[t.id]} class="mt-3 inline-flex items-center gap-1 text-sm font-bold text-[color:var(--color-brand-pressed)] hover:text-[color:var(--color-ink)]">
                  Go deeper
                  <IconArrowRight size={14} stroke={2.5} />
                </a>
              )}
              {t.related.length > 0 && (
                <div class="mt-3.5 flex flex-wrap items-center gap-2">
                  <span class="text-[11px] font-bold uppercase tracking-[0.08em] text-[color:var(--color-ink-muted)]">Related</span>
                  {t.related.map((r) => (
                    <a href={`#${r.id}`} class="rounded-lg bg-[color:var(--color-brand-soft)] px-2.5 py-1 text-[13px] font-medium text-[color:var(--color-brand-pressed)] transition-colors hover:ring-1 hover:ring-[color:var(--color-mint-400)]/60">{r.label}</a>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </section>
    ))}

    <p id="gloss-none" class="hidden py-16 text-center text-[color:var(--color-ink-2)]">No terms match your search.</p>
  </main>
</BaseLayout>

<style>
  .gloss-chip {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-ink-2);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    padding: 7px 13px;
    cursor: pointer;
    transition: 0.15s;
  }
  .gloss-chip:hover { color: var(--color-ink); border-color: var(--color-mint-400); }
  .gloss-chip.is-active {
    color: var(--color-on-brand);
    background: var(--color-brand);
    border-color: var(--color-brand);
  }
  .gloss-term:target {
    box-shadow: 0 0 0 2px var(--color-brand), 0 14px 40px -18px rgba(0, 229, 160, 0.45);
  }
</style>

<script>
  const q = document.getElementById("gloss-q") as HTMLInputElement;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".gloss-chip"));
  const terms = Array.from(document.querySelectorAll<HTMLElement>(".gloss-term"));
  const letterSections = Array.from(document.querySelectorAll<HTMLElement>(".gloss-letter"));
  const none = document.getElementById("gloss-none");
  let cat = "all";

  function apply() {
    const needle = (q?.value || "").trim().toLowerCase();
    let shown = 0;
    terms.forEach((t) => {
      const matchCat = cat === "all" || t.dataset.cat === cat;
      const matchQ = !needle || (t.dataset.q || "").includes(needle);
      const show = matchCat && matchQ;
      t.style.display = show ? "" : "none";
      if (show) shown++;
    });
    // hide letter sections with no visible terms
    letterSections.forEach((s) => {
      const any = Array.from(s.querySelectorAll<HTMLElement>(".gloss-term")).some((t) => t.style.display !== "none");
      s.style.display = any ? "" : "none";
    });
    if (none) none.classList.toggle("hidden", shown !== 0);
  }

  q?.addEventListener("input", apply);
  chips.forEach((c) =>
    c.addEventListener("click", () => {
      cat = c.dataset.filter || "all";
      chips.forEach((x) => x.classList.toggle("is-active", x === c));
      apply();
    })
  );
</script>
