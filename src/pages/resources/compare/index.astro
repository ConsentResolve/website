---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Badge from "~/components/ui/Badge.astro";
import FinalCTA from "~/components/sections/FinalCTA.astro";
import { COMPARE_PAGES } from "~/data/compare";
import { breadcrumbSchema, itemListSchema } from "~/lib/seo";
import { IconArrowRight, IconRefresh } from "@tabler/icons-react";

const schemas = [
  breadcrumbSchema([
    { name: "Home", href: "/" },
    { name: "Resources", href: "/resources/" },
    { name: "Channel ROI", href: "/resources/compare/" },
  ]),
  itemListSchema({
    name: "Lead channels — recover more booked jobs from each",
    items: COMPARE_PAGES.map((c) => ({
      name: c.brand,
      url: `https://consentresolve.com/resources/compare/${c.slug}/`,
    })),
  }),
];
---

<BaseLayout
  title="Channel ROI — More Booked Jobs From Every Ad Source"
  description="About 98 of every 100 visitors leave without contacting you — whatever you spend on LSA, Thumbtack, Angi, or HomeAdvisor. See how recovery compares."
  schema={schemas}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/20 blur-[120px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-32 top-32 size-[420px] rounded-full bg-[color:var(--color-mint-400)]/15 blur-[120px]"></div>
    <div class="container-content section relative">
      <div class="mx-auto max-w-3xl text-center">
        <Badge tone="brand" variant="soft" size="md" uppercase>Channel ROI</Badge>
        <h1 class="display-1 mb-7 mt-7 text-[color:var(--color-ink)]">
          Same ad budget.<br/>
          <span class="text-[color:var(--color-brand-pressed)]">More booked jobs.</span>
        </h1>
        <p class="mx-auto max-w-2xl text-lg leading-relaxed text-[color:var(--color-ink-2)]">
          Whatever you're spending on Google LSA, Thumbtack, Angi, or HomeAdvisor, about 98 of every 100 visitors those channels send to your site leave without contacting you. Consent Resolve recovers the bounce — with consent — and feeds it back into the funnel you already run. Pick your channel below and see the with/without math.
        </p>
      </div>
    </div>
  </section>

  <!-- Channels grid -->
  <section class="pb-24">
    <div class="container-content">
      <div class="grid gap-6 md:grid-cols-2">
        {COMPARE_PAGES.map((c) => (
          <a
            href={`/resources/compare/${c.slug}/`}
            class="group flex h-full flex-col overflow-hidden rounded-3xl bg-[color:var(--color-bg)] ring-1 ring-inset ring-[color:var(--color-rule)] transition-all hover:-translate-y-1 hover:ring-[color:var(--color-brand)]/40 hover:shadow-[0_30px_60px_-28px_rgba(10,22,40,0.25)]"
          >
            <div class="flex items-center justify-between gap-4 p-7 pb-0">
              <div class="flex items-center gap-3">
                <div class="flex size-12 items-center justify-center rounded-xl font-display text-sm font-black text-white" style={`background:${c.brandColor}`}>
                  {c.brand.split(/\s+/).map((s) => s[0]).slice(0, 2).join("").toUpperCase()}
                </div>
                <div>
                  <p class="font-display text-lg font-black tracking-tight text-[color:var(--color-ink)]">{c.brand}</p>
                  <p class="text-xs text-[color:var(--color-ink-muted)]">{c.channelCpl}</p>
                </div>
              </div>
              <IconRefresh size={20} stroke={1.75} class="text-[color:var(--color-brand-pressed)]" />
            </div>
            <div class="flex-1 p-7 pt-5">
              <p class="text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">{c.subhead}</p>
              <span class="mt-6 inline-flex items-center gap-1.5 text-[12px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-brand-pressed)] transition-all group-hover:gap-2.5">
                See the with/without math
                <IconArrowRight size={14} stroke={2.5} />
              </span>
            </div>
          </a>
        ))}
      </div>

      <!-- Universal callout: works on any channel -->
      <div class="mt-10 rounded-2xl bg-[color:var(--color-bg-alt)] p-7 ring-1 ring-inset ring-[color:var(--color-rule)] text-center">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">It works on any traffic source</p>
        <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">
          Your own Google Ads · Meta Ads · SEO · email · partner referrals · QR codes — wherever the visitor came from, the bounce is recoverable as long as your consent banner is on the page.
        </p>
      </div>
    </div>
  </section>

  <FinalCTA />
</BaseLayout>
