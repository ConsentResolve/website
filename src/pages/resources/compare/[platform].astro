---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Button from "~/components/ui/Button.astro";
import Badge from "~/components/ui/Badge.astro";
import AEOAnswer from "~/components/sections/AEOAnswer.astro";
import FinalCTA from "~/components/sections/FinalCTA.astro";
import { COMPARE_PAGES, TRADE_CPL_BENCHMARKS, type ComparePage } from "~/data/compare";
import { breadcrumbSchema } from "~/lib/seo";
import { IconArrowRight, IconCheck, IconUserOff, IconRefresh, IconPhone } from "@tabler/icons-react";

export async function getStaticPaths() {
  return COMPARE_PAGES.map((p) => ({
    params: { platform: p.slug },
    props: { page: p },
  }));
}

interface Props { page: ComparePage }
const { page } = Astro.props as Props;

const initials = page.brand.split(/\s+/).map((s) => s[0]).slice(0, 2).join("").toUpperCase();

const schemas = [
  breadcrumbSchema([
    { name: "Home", href: "/" },
    { name: "Resources", href: "/resources/" },
    { name: "Channel ROI", href: "/resources/compare/" },
    { name: page.brand, href: `/resources/compare/${page.slug}/` },
  ]),
];

const fmtUsd = (n: number) => `$${n.toLocaleString()}`;
---

<BaseLayout
  title={page.titleTag}
  ogTitle={page.ogTitle}
  description={page.metaDescription}
  canonical={`https://consentresolve.com/resources/compare/${page.slug}/`}
  schema={schemas}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/20 blur-[120px]"></div>
    <div class="container-content section relative">
      <div class="mx-auto max-w-4xl text-center">
        <Badge tone="brand" variant="soft" size="md" uppercase>{page.eyebrow}</Badge>
        {/* Stacked logo lockup: channel + Consent Resolve layer-on-top */}
        <div class="mb-7 mt-7 inline-flex items-center gap-4">
          <div class="flex size-14 items-center justify-center rounded-xl font-display text-base font-black text-white" style={`background:${page.brandColor}`}>{initials}</div>
          <span class="font-display text-2xl font-bold text-[color:var(--color-ink-muted)]">+</span>
          <div class="flex size-14 items-center justify-center rounded-xl bg-[color:var(--color-navy-900)] font-display text-base font-black text-white">CR</div>
        </div>
        <h1 class="display-1 mb-7 text-[color:var(--color-ink)]">{page.h1}</h1>
        <p class="mx-auto max-w-3xl text-lg leading-relaxed text-[color:var(--color-ink-2)]">{page.subhead}</p>
        <p class="mx-auto mt-3 max-w-3xl text-xs text-[color:var(--color-ink-muted)]">The ~98% figure is sourced — <a href="/stats/#anonymous-traffic" class="underline decoration-dotted underline-offset-2 hover:text-[color:var(--color-brand-pressed)]">WordStream, via /stats/</a>.</p>
        <div class="mt-10 flex justify-center">
          <Button href="https://dashboard.consentresolve.com/register" variant="primary" size="lg">
            Get Started
            <IconArrowRight size={18} stroke={2.25} />
          </Button>
        </div>
      </div>
    </div>
  </section>

  {/* Funnel explanation — REQUIRED on every compare page */}
  <section class="section section-dark relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -right-32 top-1/2 size-[480px] -translate-y-1/2 rounded-full bg-[color:var(--color-mint-400)]/15 blur-[120px]"></div>
    <div class="container-content relative max-w-4xl">
      <div class="text-center">
        <Badge tone="brand" variant="soft" surface="dark" size="md" uppercase>Where it fits</Badge>
        <h2 class="display-2 mt-5 text-white">{page.funnelExplain.headline}</h2>
        <p class="mt-6 text-lg leading-relaxed text-slate-300">{page.funnelExplain.body}</p>
      </div>
    </div>
  </section>

  {/* What the channel is good at — honest setup */}
  <section class="section">
    <div class="container-content">
      <div class="grid items-start gap-12 md:grid-cols-[1fr_1fr]">
        <div>
          <Badge tone="neutral" variant="outline" size="sm" uppercase>What {page.brand} is good at</Badge>
          <h2 class="display-2 mt-5 text-[color:var(--color-ink)]">The honest part first.</h2>
          <p class="mt-4 text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">
            Keep running {page.brand}. We're not asking you to switch — we're showing where the leak is.
          </p>
        </div>
        <ul class="space-y-4">
          {page.channelGoodAt.map((item) => (
            <li class="flex items-start gap-3 rounded-xl bg-[color:var(--color-bg-alt)] p-4 ring-1 ring-inset ring-[color:var(--color-rule)]">
              <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-bg)] ring-1 ring-inset ring-[color:var(--color-rule)]">
                <IconCheck size={14} stroke={2.5} color="#475569" />
              </span>
              <span class="text-[15px] text-[color:var(--color-ink)]">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* The leak — sets up the recovery, not a hit piece */}
  <section class="section bg-[color:var(--color-bg-alt)]">
    <div class="container-content max-w-4xl">
      <div class="text-center mb-12">
        <Badge tone="warning" variant="soft" size="md" uppercase>The leak</Badge>
        <h2 class="display-2 mt-5 text-[color:var(--color-ink)]">Where the spend evaporates.</h2>
        <p class="mt-4 text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">{page.channelCpl}</p>
      </div>
      <ul class="grid gap-4 md:grid-cols-3">
        {page.channelLeaks.map((leak) => (
          <li class="rounded-2xl bg-[color:var(--color-bg)] p-6 ring-1 ring-inset ring-amber-200">
            <IconUserOff size={20} stroke={1.75} color="#b45309" />
            <p class="mt-3 text-[14px] leading-relaxed text-[color:var(--color-ink-2)]">{leak}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* Booked-job math — cost-per-booked-job framing, NOT per-lead */}
  <section class="section">
    <div class="container-content max-w-4xl">
      <div class="text-center mb-12">
        <Badge tone="brand" variant="soft" size="md" uppercase>The math</Badge>
        <h2 class="display-2 mt-5 text-[color:var(--color-ink)]">Same ad budget. More booked jobs.</h2>
      </div>

      <div class="grid gap-5 md:grid-cols-2">
        <div class="rounded-2xl bg-[color:var(--color-bg-alt)] p-7 ring-1 ring-inset ring-[color:var(--color-rule)]">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">{page.brand} alone (today)</p>
          <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">{page.bookedJobMath.setup}</p>
        </div>
        <div class="rounded-2xl bg-[color:var(--color-brand-soft)] p-7 ring-1 ring-inset ring-[color:var(--color-brand)]/40">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-brand-pressed)]">{page.brand} + Consent Resolve</p>
          <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-ink)]">{page.bookedJobMath.withCR}</p>
        </div>
      </div>

      <div class="mt-6 rounded-2xl bg-[color:var(--color-navy-900)] p-6 text-white">
        <div class="flex items-start gap-3">
          <IconRefresh size={22} stroke={1.75} color="#00E5A0" class="mt-1 shrink-0" />
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-mint-400)]">The math, plainly</p>
            <p class="mt-2 text-[15px] leading-relaxed text-slate-200">{page.bookedJobMath.breakEven}</p>
          </div>
        </div>
      </div>

      {/* Per-trade CPL anchor strip — every trade links to its landing page */}
      <div class="mt-6 rounded-2xl bg-[color:var(--color-bg-alt)] p-5 ring-1 ring-inset ring-[color:var(--color-rule)]">
        <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">Typical shared-lead cost per lead, by trade</p>
          <a href="/stats/#lead-trap" class="text-[11px] underline decoration-dotted underline-offset-2 text-[color:var(--color-ink-muted)] hover:text-[color:var(--color-brand-pressed)]">Sources · /stats/</a>
        </div>
        <ul class="flex flex-wrap gap-2.5">
          {TRADE_CPL_BENCHMARKS.map((t) => (
            <li>
              <a
                href={`/${t.slug}-leads/`}
                class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-bg)] px-3.5 py-1.5 text-xs font-semibold text-[color:var(--color-ink-2)] ring-1 ring-inset ring-[color:var(--color-rule)] transition hover:ring-[color:var(--color-brand)]/50 hover:text-[color:var(--color-brand-pressed)]"
              >
                <span class="text-[color:var(--color-ink-muted)]">{t.trade}</span>
                <span class="font-bold text-[color:var(--color-ink)]">{fmtUsd(t.low)}–{fmtUsd(t.high)}</span>
              </a>
            </li>
          ))}
          <li>
            <span class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-brand-soft)] px-3.5 py-1.5 text-xs font-semibold text-[color:var(--color-brand-pressed)] ring-1 ring-inset ring-[color:var(--color-brand)]/40">
              <span>Consent Resolve</span>
              <span class="font-bold">$7 flat</span>
            </span>
          </li>
        </ul>
        <p class="mt-4 text-[11px] leading-relaxed text-[color:var(--color-ink-muted)]">
          Ranges are what shared-lead marketplaces charge per lead — the figure belongs to the trade, not the platform, and rises with job value, metro, and how many pros the lead is split among. Cost-per-booked-job depends on your close rate and ticket size; recovered visitors are <strong class="text-[color:var(--color-ink-2)]">incremental on top</strong>, never a replacement for these. Sourced on <a href="/stats/#lead-trap" class="underline decoration-dotted underline-offset-2 hover:text-[color:var(--color-brand-pressed)]">/stats/</a>.
        </p>
      </div>
    </div>
  </section>

  {/* WITH / WITHOUT side-by-side */}
  <section class="section bg-[color:var(--color-bg-alt)]">
    <div class="container-content">
      <div class="mx-auto max-w-2xl text-center mb-12">
        <Badge tone="brand" variant="soft" size="md" uppercase>With / without</Badge>
        <h2 class="display-2 mt-5 text-[color:var(--color-ink)]">Your channel — same budget, two outcomes.</h2>
      </div>
      <div class="mx-auto max-w-4xl overflow-hidden rounded-2xl bg-[color:var(--color-bg)] ring-1 ring-inset ring-[color:var(--color-rule)] shadow-[0_18px_40px_-24px_rgba(10,22,40,0.18)]">
        <table class="w-full">
          <thead>
            <tr class="border-b border-[color:var(--color-rule)] bg-[color:var(--color-bg-alt)]">
              <th class="px-5 py-4 text-left text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]"></th>
              <th class="px-5 py-4 text-left text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">{page.brand} alone</th>
              <th class="px-5 py-4 text-left text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-brand-pressed)]">{page.brand} + Consent Resolve</th>
            </tr>
          </thead>
          <tbody>
            {page.withWithoutRows.map((row, i) => (
              <tr class={i % 2 === 1 ? "bg-[color:var(--color-bg-alt)]/40" : ""}>
                <td class="px-5 py-4 text-sm font-semibold text-[color:var(--color-ink)]">{row.feature}</td>
                <td class="px-5 py-4 text-sm text-[color:var(--color-ink-2)]">{row.without}</td>
                <td class="px-5 py-4 text-sm">
                  <span class="font-semibold text-[color:var(--color-brand-pressed)]">{row.with}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {/* Small-print: outcomes illustrative, no invented rate constants */}
      <p class="mx-auto mt-6 max-w-4xl text-center text-[11px] leading-relaxed text-[color:var(--color-ink-muted)]">
        Outcomes are illustrative — recovered visitors are incremental on the same ad budget. We don't publish recovery or close rates; set your own assumptions. The only fixed numbers are the sourced competitor cost-per-lead and the flat $7 per recovered lead. Sourced industry data lives on /stats/.
      </p>
    </div>
  </section>

  <AEOAnswer text={page.aeoAnswer} />

  {/* Final CTA */}
  <FinalCTA heading={page.finalCtaH2} body={page.finalCtaBody} />
</BaseLayout>
