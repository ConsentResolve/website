---
import BaseLayout from "~/layouts/BaseLayout.astro";
import HowItWorks from "~/components/sections/HowItWorks.astro";
import ProductTour from "~/components/sections/ProductTour.astro";
import FeatureCard from "~/components/ui/FeatureCard.astro";
import ComplianceBand from "~/components/sections/ComplianceBand.astro";
import FAQSection from "~/components/sections/FAQSection.astro";
import FinalCTA from "~/components/sections/FinalCTA.astro";
import { IconArrowRight, IconEye, IconShieldCheck, IconLock, IconStack2 as IconStack } from "@tabler/icons-react";
import { breadcrumbSchema } from "~/lib/seo";

const breadcrumbs = breadcrumbSchema([
  { name: "Home", href: "/" },
  { name: "How It Works", href: "/how-it-works/" },
]);
---

<BaseLayout
  title="How Consent Resolve Works — Guided Product Tour"
  description="From an anonymous visitor to a booked job. Walk through five product screens — install, identify, reach out, route, measure — in the order you'll actually use them."
  schema={[breadcrumbs]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/20 blur-[120px]"></div>
    <div class="container-content section relative">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow mb-7 justify-center">How it works</p>
        <h1 class="display-1 mb-7 text-[color:var(--color-ink)]">
          From an anonymous visitor to a lead you can call —<br/>
          <span class="text-[color:var(--color-brand)]">in three steps. And five screens.</span>
        </h1>
        <p class="mx-auto mb-10 max-w-2xl text-lg leading-relaxed text-[color:var(--color-ink-2)]">
          You already pay to get homeowners to your site. The 30-second flow is up top. The guided tour below walks you through every product screen in the order you'll actually use them.
        </p>
        <div class="flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
          <a
            href="/get-started/"
            class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-brand)] px-7 py-3.5 text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--color-navy-900)] shadow-[0_18px_36px_-18px_rgba(0,229,160,0.55)] transition-all hover:-translate-y-0.5 hover:bg-[color:var(--color-brand-pressed)] hover:text-white"
          >
            Start $10 Trial
            <IconArrowRight size={16} stroke={2.5} />
          </a>
          <a
            href="#product-tour"
            class="inline-flex items-center gap-2 rounded-full px-7 py-3.5 text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink)] ring-1 ring-inset ring-[color:var(--color-rule)] transition-all hover:ring-[color:var(--color-mint-400)]/60"
          >
            <IconEye size={16} stroke={2} />
            Jump to the tour
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Canonical 3-step comet (single source of truth, shared with /style-guide/how-it-works/) -->
  <HowItWorks />

  <!-- Guided product tour — five product screens with annotations -->
  <ProductTour />

  <!-- What makes it different -->
  <section class="section">
    <div class="container-content">
      <div class="mb-14 text-center">
        <p class="eyebrow mb-5 justify-center">What makes it different</p>
        <h2 class="display-2 mx-auto max-w-2xl text-[color:var(--color-ink)]">
          The three things every other lead tool gets wrong.
        </h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <FeatureCard
          variant="showcase"
          icon={IconShieldCheck}
          title="Only after consent."
          body="No shadow-tracking. A name appears only when a homeowner agrees."
        />
        <FeatureCard
          variant="showcase"
          icon={IconLock}
          title="Yours alone."
          body="One lead, one shop. Never resold, never auctioned."
        />
        <FeatureCard
          variant="showcase"
          icon={IconStack}
          title="Works with what you run now."
          body="Keep your ads, your LSA, your SEO. This catches the visitors they send who'd otherwise leave without a name."
        />
      </div>
    </div>
  </section>

  <ComplianceBand />
  <FAQSection />
  <FinalCTA />
</BaseLayout>
