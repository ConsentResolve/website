---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Badge from "~/components/ui/Badge.astro";
import HowItWorks from "~/components/sections/HowItWorks.astro";
import ProductTour from "~/components/sections/ProductTour.astro";
import IllustrationCard from "~/components/ui/IllustrationCard.astro";
import ComplianceBand from "~/components/sections/ComplianceBand.astro";
import FAQSection from "~/components/sections/FAQSection.astro";
import FinalCTA from "~/components/sections/FinalCTA.astro";
import { IconArrowRight, IconEye } from "@tabler/icons-react";
import { breadcrumbSchema, howToSchema } from "~/lib/seo";

const breadcrumbs = breadcrumbSchema([
  { name: "Home", href: "/" },
  { name: "How It Works", href: "/how-it-works/" },
]);

const howTo = howToSchema({
  name: "How Consent Resolve recovers anonymous website visitors and feeds them into the contractor's funnel",
  description:
    "A four-step ad-spend recovery flow that turns the ~98% of website visitors who would otherwise bounce into recovered records inside the contractor's existing retargeting, email/SMS, and CRM funnels — only after the homeowner consents — producing inbound calls on the same ad budget.",
  totalTime: "PT10M",
  steps: [
    { name: "Anonymous bounce", text: "A homeowner arrives from the contractor's existing paid or organic traffic (Google, LSA, Meta, SEO). Roughly 98 out of 100 visitors leave without contacting the business — that's the bounce Consent Resolve recovers." },
    { name: "They say yes",      text: "The homeowner accepts the site's consent banner. Identification is now compliant and logged with a Termageddon-signed audit trail." },
    { name: "Fed into the funnel", text: "The recovered visitor flows into the contractor's retargeting audiences, email/SMS sequences, and CRM — the marketing machine they already run. Consent Resolve is the input, not a replacement." },
    { name: "Inbound call",       text: "The homeowner re-enters the funnel on their own time and calls the contractor — a warm inbound from a visitor who would otherwise have bounced. Same ad budget, more booked jobs." },
  ],
});
---

<BaseLayout
  title="How Consent Resolve Works — Ad-Spend Recovery in Four Steps"
  description="From an anonymous bounce to an inbound call. Same ad budget, more booked jobs. Walk through the four-step funnel-insertion flow and the five product screens you'll actually use."
  schema={[breadcrumbs, howTo]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/20 blur-[120px]"></div>
    <div class="container-content section relative">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-7 flex justify-center"><Badge tone="brand" variant="soft" size="md" uppercase>How it works</Badge></div>
        <h1 class="display-1 mb-7 text-[color:var(--color-ink)]">
          From an anonymous bounce to an inbound call —<br/>
          <span class="text-[color:var(--color-brand)]">in four steps. No new ad spend.</span>
        </h1>
        <p class="mx-auto mb-10 max-w-2xl text-lg leading-relaxed text-[color:var(--color-ink-2)]">
          You already pay to drive traffic. About 98 of every 100 visitors leave without contacting you. The flow below recovers the bounce, with consent, and feeds it back into the funnel you already run.
        </p>
        <div class="flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
          <a
            href="https://dashboard.consentresolve.com/register"
            class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-brand)] px-7 py-3.5 text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--color-navy-900)] shadow-[0_18px_36px_-18px_rgba(0,229,160,0.55)] transition-all hover:-translate-y-0.5 hover:bg-[color:var(--color-brand-pressed)] hover:text-white"
          >
            Get Started
            <IconArrowRight size={16} stroke={2.5} />
          </a>
          <a
            href="#product-tour"
            class="inline-flex items-center gap-2 rounded-full px-7 py-3.5 text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink)] ring-1 ring-inset ring-[color:var(--color-rule)] transition-all hover:ring-[color:var(--color-mint-400)]/60"
          >
            <IconEye size={16} stroke={2} />
            Jump to the tour
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Canonical 4-step comet (single source of truth, shared with /style-guide/how-it-works/) -->
  <HowItWorks />

  <!-- Guided product tour — five product screens with annotations -->
  <ProductTour />

  <!-- What makes it different -->
  <section class="section">
    <div class="container-content">
      <div class="mb-14 text-center">
        <div class="mb-5 flex justify-center"><Badge tone="brand" variant="soft" size="md" uppercase>What makes it different</Badge></div>
        <h2 class="display-2 mx-auto max-w-2xl text-[color:var(--color-ink)]">
          The three things every other lead tool gets wrong.
        </h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <IllustrationCard
          illustration="/illustrations/features/02-consent-checkmark.svg"
          title="Only after consent."
          body="No shadow-tracking. A name appears only when a homeowner agrees — and every consent gets a timestamp and a signed audit ID."
          href="/features/consent-first-identification/"
        />
        <IllustrationCard
          illustration="/illustrations/style/07-lead-house-lock.svg"
          title="Yours alone."
          body="One lead, one shop. Never resold, never auctioned, never shared with three other contractors in your town."
          href="/features/exclusive-leads/"
        />
        <IllustrationCard
          illustration="/illustrations/features/03-channel-recovery.svg"
          title="Works with what you run now."
          body="Keep your ads, your LSA, your SEO. This catches the visitors they send who'd otherwise leave without a name."
          href="/features/channel-recovery/"
        />
      </div>
    </div>
  </section>

  <ComplianceBand />
  <FAQSection />
  <FinalCTA />
</BaseLayout>
