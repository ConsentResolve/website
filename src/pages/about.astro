---
import BaseLayout from "~/layouts/BaseLayout.astro";
import FinalCTA from "~/components/sections/FinalCTA.astro";
import AuthorityStrip from "~/components/sections/AuthorityStrip.tsx";
import DidYouKnow from "~/components/sections/DidYouKnow.tsx";
import TeamCard from "~/components/ui/TeamCard.astro";
import { TEAM } from "~/data/team";
import { breadcrumbSchema, personSchema } from "~/lib/seo";
import { IconArrowRight } from "@tabler/icons-react";

const schemas = [
  breadcrumbSchema([
    { name: "Home", href: "/" },
    { name: "About", href: "/about/" },
  ]),
  // Person schema per founder — exposes credentials (Capitol Hill, etc.)
  // to entity graphs and AI engines via sameAs LinkedIn.
  ...TEAM.map((m) =>
    personSchema({
      name: m.name,
      role: m.role,
      bio: m.bio,
      linkedin: m.linkedin,
      knowsAbout: m.verified,
    }),
  ),
];
---

<BaseLayout
  title="About Consent Resolve — Real People, Real Privacy Values"
  description="Capitol Hill testimony, 50+ acquisitions, 25+ years building internet companies. Meet the team behind Consent Resolve — the consent-first visitor-identification layer for home-service contractors."
  schema={schemas}
>
  <!-- SECTION 1: Hero -->
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/20 blur-[120px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-32 top-20 size-[420px] rounded-full bg-[color:var(--color-mint-400)]/15 blur-[120px]"></div>
    <div class="container-content section relative">
      <div class="mx-auto max-w-[900px] text-center">
        <p class="eyebrow mb-7 justify-center">About</p>
        <h1 class="font-display font-black tracking-tight text-[clamp(2.5rem,5.5vw,3.75rem)] leading-[1.02] text-[color:var(--color-ink)]">
          <span class="text-[color:var(--color-brand-pressed)]">Real people. Real opinions.</span><br/>
          <span>Real privacy values.</span>
        </h1>
        <p class="mx-auto mt-8 max-w-xl text-lg leading-relaxed text-[color:var(--color-ink-2)]">
          Other tools hide behind corporate speak. We share what we actually think — where you can see it yourself.
        </p>
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
          <a
            href="https://dashboard.consentresolve.com/register"
            class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-brand)] px-7 py-3.5 text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--color-navy-900)] shadow-[0_18px_36px_-18px_rgba(0,229,160,0.55)] transition-all hover:-translate-y-0.5 hover:bg-[color:var(--color-brand-pressed)] hover:text-white"
          >
            Get Started
            <IconArrowRight size={16} stroke={2.5} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: Authority strip -->
  <section class="border-y border-[color:var(--color-rule)] bg-[color:var(--color-bg)] py-14">
    <div class="container-content mb-8">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow mb-4 justify-center">Receipts, not slogans</p>
        <h2 class="font-display text-2xl font-black tracking-tight text-[color:var(--color-ink)] md:text-3xl">
          Tap any card to see the credentials.
        </h2>
      </div>
    </div>
    <AuthorityStrip client:visible />
  </section>

  <!-- SECTION 3: Team grid -->
  <section class="section bg-[color:var(--color-bg-alt)]">
    <div class="container-content">
      <div class="mx-auto mb-14 max-w-2xl text-center">
        <p class="eyebrow mb-5 justify-center">Who you're following</p>
        <h2 class="display-2 text-[color:var(--color-ink)]">Meet the people behind Consent Resolve.</h2>
      </div>
      <div class="mx-auto grid max-w-6xl gap-7 sm:grid-cols-2 lg:grid-cols-3">
        {TEAM.map((m) => <TeamCard member={m} />)}
      </div>
    </div>
  </section>

  <!-- SECTION 4: Did you know -->
  <section class="section">
    <div class="container-content">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <p class="eyebrow mb-5 justify-center">By the numbers</p>
        <h2 class="display-2 text-[color:var(--color-ink)]">A few things worth knowing.</h2>
      </div>
      <DidYouKnow client:visible />
    </div>
  </section>

  <FinalCTA />
</BaseLayout>
