---
/**
 * /v2/ — Homepage v2 (PREVIEW, NOT LIVE).
 *
 * Rebuilt on the StoryBrand SB7 spine:
 *   1. CHARACTER       — the contractor (the hero of the story)
 *   2. PROBLEM         — external (98% bounce), internal (paying twice),
 *                        philosophical (ad budget shouldn't evaporate)
 *   3. GUIDE           — Consent Resolve, with empathy + authority
 *   4. PLAN            — four simple steps (HowItWorks)
 *   5. DIRECT CTA      — "Activate your account"
 *   6. TRANSITIONAL    — "See how it works"
 *   7. AVOIDS FAILURE  — what happens if you do nothing
 *   8. ENDS IN SUCCESS — same ad budget, more inbound calls
 *
 * Voice locked to /style-guide/voice/:
 *   - Contractor is the hero. We are the guide.
 *   - 2nd person. Short, plain, active. Money is the through-line.
 *   - Lead with opportunity. Compliance is the relief at the tail.
 *   - No banned hype words (no "free", "instant", "revolutionize", etc.).
 *
 * Preview-mode:
 *   - noindex via BaseLayout prop (robots noindex,follow)
 *   - Not linked from Nav / Footer
 *   - Amber preview banner up top so it can't be mistaken for live
 *
 * To promote: copy this file's body into src/pages/index.astro and
 * remove the banner + noindex flag.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/sections/Hero.astro";
import HowItWorks from "~/components/sections/HowItWorks.astro";
import ComplianceBand from "~/components/sections/ComplianceBand.astro";
import FAQSection from "~/components/sections/FAQSection.astro";
import AEOAnswer from "~/components/sections/AEOAnswer.astro";
import FinalCTA from "~/components/sections/FinalCTA.astro";
import Badge from "~/components/ui/Badge.astro";
import Button from "~/components/ui/Button.astro";
import AnimatedStat from "~/components/ui/AnimatedStat.tsx";
import Sparkline from "~/components/ui/Sparkline.astro";

import {
  organizationSchema,
  softwareApplicationSchema,
  websiteSchema,
  faqSchema,
} from "~/lib/seo";

import {
  IconArrowRight, IconCheck, IconLock, IconUserCheck, IconBolt,
  IconUserOff, IconCoin, IconAlertTriangle, IconCash,
  IconShieldCheck, IconPlugConnected, IconClipboardCheck,
  IconRefresh, IconMessage, IconBellRinging,
  IconX, IconCircleCheck, IconEye, IconBuilding,
} from "@tabler/icons-react";

// Page-level FAQ schema (mirrors FAQSection's questions)
const homepageFaqs = [
  { question: "Is this legal?",                         answer: "Yes — because a homeowner's name shows up only after they consent. We keep your privacy policy, cookie banner, and disclosures in sync through Termageddon. The shady tools that track people in secret are the illegal ones. We're not one." },
  { question: "Do I have to change my privacy policy?", answer: "We handle it. Termageddon generates and updates the policies for you, so you stay covered without the legwork." },
  { question: "What if a homeowner doesn't consent?",   answer: "Then you get nothing on them — and that's the point. No consent, no data. That's what keeps you safe." },
  { question: "How fast does a lead reach me?",         answer: "Seconds. A Slack, text, or email fires the moment they consent, and it lands in your CRM at the same time." },
  { question: "Which CRMs do you work with?",           answer: "Jobber, Housecall Pro, ServiceTitan, HubSpot, Klaviyo, and just about anything else through a webhook." },
  { question: "Can I cancel anytime?",                  answer: "Yes. Flat $7 a lead — card required, no contract, cancel whenever you want." },
];

const schemas = [
  organizationSchema,
  websiteSchema,
  softwareApplicationSchema,
  faqSchema(homepageFaqs),
];

const aeoText =
  "Consent Resolve is a consent-first ad-spend recovery layer for home-service contractors. It identifies the 98 out of 100 website visitors who would otherwise bounce — only after they accept your consent banner — and feeds them back into the retargeting audiences, email/SMS sequences, and CRM you already run. Same ad budget, more inbound calls. Flat $7 per recovered lead, exclusive, never resold.";

// Tiny illustrative spark for the compact product peek (NOT a claim)
const peekSpark = [3, 5, 4, 7, 6, 9, 8, 11, 10, 14, 13, 17, 18];
---

<BaseLayout
  title="Recover the 98% Your Ads Already Paid For — Consent Resolve"
  description="Consent Resolve is the consent-first ad-spend recovery layer for home-service contractors. Identify the 98 out of 100 visitors who'd otherwise bounce, with consent, and feed them back into the retargeting, email, and CRM you already run. Same ad budget, more inbound calls. Flat $7 per recovered lead."
  noindex={true}
  schema={schemas}
>
  <!-- Preview banner — visible reminder this is not the live homepage -->
  <div class="border-b border-amber-200 bg-amber-50">
    <div class="container-content py-3 text-center text-xs font-bold uppercase tracking-[0.14em] text-amber-800">
      Homepage v2 — Preview only. Not indexed, not in nav.
    </div>
  </div>

  <!-- ============================================================== -->
  <!-- 1. HERO — character + one-liner + 2 CTAs                      -->
  <!--    StoryBrand: name the audience, name the problem, hint at   -->
  <!--    the win. Direct CTA + transitional CTA.                    -->
  <!-- ============================================================== -->
  <Hero
    eyebrow="For ad-buying home-service contractors"
    title="Turn Anonymous Homeowners"
    titleAccent="Into New Jobs."
    subhead="Most of the homeowners you pay for bounce without a trace. Consent Resolve recovers them — name and number, only after they consent — and feeds them straight into the retargeting, email, and CRM you already run. Same ad budget. More booked jobs. Flat $7 a lead, yours alone, never resold."
    ctaLabel="Activate your account"
    panelKind="illustration"
    panelSrc="/illustrations/hero/protagonist.svg"
    panelAlt="A friendly service pro beside a work truck, holding up a phone showing a recovered lead — beside him an anonymous gray visitor is turning sage-green, while two more anonymous figures drift off a browser window in the background."
    showTrustLine={false}
    compact={true}
  />

  <!-- ============================================================== -->
  <!-- 1.5. THE 5-SECOND PITCH — what / how / result                 -->
  <!--      Three flat cards, big icon, one promise each. Sits right -->
  <!--      under the integration strip so a service pro scanning    -->
  <!--      gets the value prop without scrolling further.           -->
  <!-- ============================================================== -->
  <section class="section py-14 md:py-20">
    <div class="container-content">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <Badge tone="brand" variant="soft" size="md" uppercase>The 5-second pitch</Badge>
        <h2 class="display-2 mt-5 text-[color:var(--color-ink)]">
          What it does. How it helps.<br/>
          <span class="text-[color:var(--color-brand-pressed)]">What you get back.</span>
        </h2>
      </div>

      <div class="mx-auto grid max-w-5xl gap-5 md:grid-cols-3">
        <!-- 1. WHAT we do -->
        <div class="relative rounded-2xl bg-[color:var(--color-bg-alt)] p-7 ring-1 ring-inset ring-[color:var(--color-rule)] transition-all hover:-translate-y-1 hover:ring-[color:var(--color-mint-400)]/60 hover:shadow-[0_30px_60px_-30px_rgba(0,229,160,0.4)]">
          <!-- Step chip -->
          <span class="absolute right-5 top-5 text-[10px] font-bold uppercase tracking-[0.16em] text-[color:var(--color-ink-muted)]">Step 1</span>
          <!-- Big iconic visual -->
          <div class="inline-flex size-14 items-center justify-center rounded-2xl bg-[color:var(--color-brand)] shadow-[0_18px_36px_-12px_rgba(0,229,160,0.5)]">
            <IconUserCheck size={26} stroke={2} color="#0A1628" />
          </div>
          <p class="mt-5 text-[11px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">What it does</p>
          <h3 class="mt-2 font-display text-2xl font-black leading-tight tracking-tight text-[color:var(--color-ink)]">
            We turn anonymous site visitors into real, consented leads.
          </h3>
          <p class="mt-3 text-[14px] leading-relaxed text-[color:var(--color-ink-2)]">
            98 out of 100 homeowners hit your site and leave. The ones who tap your consent banner — we hand you their name and email.
          </p>
        </div>

        <!-- 2. HOW we benefit them -->
        <div class="relative rounded-2xl bg-[color:var(--color-bg-alt)] p-7 ring-1 ring-inset ring-[color:var(--color-rule)] transition-all hover:-translate-y-1 hover:ring-[color:var(--color-mint-400)]/60 hover:shadow-[0_30px_60px_-30px_rgba(0,229,160,0.4)]">
          <span class="absolute right-5 top-5 text-[10px] font-bold uppercase tracking-[0.16em] text-[color:var(--color-ink-muted)]">Step 2</span>
          <div class="inline-flex size-14 items-center justify-center rounded-2xl bg-[color:var(--color-brand)] shadow-[0_18px_36px_-12px_rgba(0,229,160,0.5)]">
            <IconPlugConnected size={26} stroke={2} color="#0A1628" />
          </div>
          <p class="mt-5 text-[11px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">How it helps</p>
          <h3 class="mt-2 font-display text-2xl font-black leading-tight tracking-tight text-[color:var(--color-ink)]">
            Drops into the funnel you already run.
          </h3>
          <p class="mt-3 text-[14px] leading-relaxed text-[color:var(--color-ink-2)]">
            Recovered leads flow straight into your retargeting ads, your email list, and your CRM. No new app to learn. No workflow to change.
          </p>
        </div>

        <!-- 3. RESULT -->
        <div class="relative rounded-2xl bg-[color:var(--color-bg-alt)] p-7 ring-1 ring-inset ring-[color:var(--color-rule)] transition-all hover:-translate-y-1 hover:ring-[color:var(--color-mint-400)]/60 hover:shadow-[0_30px_60px_-30px_rgba(0,229,160,0.4)]">
          <span class="absolute right-5 top-5 text-[10px] font-bold uppercase tracking-[0.16em] text-[color:var(--color-ink-muted)]">Step 3</span>
          <div class="inline-flex size-14 items-center justify-center rounded-2xl bg-[color:var(--color-brand)] shadow-[0_18px_36px_-12px_rgba(0,229,160,0.5)]">
            <IconCash size={26} stroke={2} color="#0A1628" />
          </div>
          <p class="mt-5 text-[11px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">What you get</p>
          <h3 class="mt-2 font-display text-2xl font-black leading-tight tracking-tight text-[color:var(--color-ink)]">
            Same ad budget. More booked jobs.
          </h3>
          <p class="mt-3 text-[14px] leading-relaxed text-[color:var(--color-ink-2)]">
            Warm inbound calls from homeowners who already saw you in their inbox. Flat $7 a lead. Yours alone, never resold.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 2. THE STAKES — external / internal / philosophical problem   -->
  <!--    StoryBrand says: make the cost of the status quo visceral. -->
  <!--    Three sourced cards. Lead with money walking out the door. -->
  <!-- ============================================================== -->
  <section class="section section-dark relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/10 blur-[120px]"></div>

    <div class="container-content relative">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <Badge tone="warning" variant="soft" surface="dark" size="md" uppercase>The leak you're paying for</Badge>
        <h2 class="display-2 mt-5 text-white">
          Your ad budget hits the site.<br/>
          <span class="text-[color:var(--color-mint-400)]">Then most of it walks away.</span>
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-300">
          Every channel you run — Google, LSA, Meta, SEO — drops people on your site. Almost all of them leave without saying a word. Then you pay again to find them on Thumbtack.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        <!-- External problem: the 98% bounce -->
        <div class="rounded-2xl bg-white/[0.03] p-7 ring-1 ring-inset ring-white/10">
          <div class="mb-4 inline-flex size-10 items-center justify-center rounded-xl bg-[color:var(--color-danger)]/15">
            <IconUserOff size={20} stroke={1.75} color="#fca5a5" />
          </div>
          <AnimatedStat client:visible value={98} suffix="%" tone="danger" size="lg" />
          <p class="mt-3 text-xs font-bold uppercase tracking-[0.14em] text-slate-400">Walk away anonymous</p>
          <p class="mt-2 text-[14px] leading-relaxed text-slate-300">
            Of every 100 homeowners your ads send to your site, roughly 98 leave without contacting you. They call the next guy instead. <a href="/stats/#anonymous-traffic" class="underline-offset-2 hover:underline">Source</a>
          </p>
        </div>

        <!-- Internal problem: paying twice -->
        <div class="rounded-2xl bg-white/[0.03] p-7 ring-1 ring-inset ring-white/10">
          <div class="mb-4 inline-flex size-10 items-center justify-center rounded-xl bg-white/10">
            <IconCoin size={20} stroke={1.75} color="#cbd5e1" />
          </div>
          <div class="font-display text-4xl font-bold leading-none tracking-tight text-white md:text-5xl">~$46</div>
          <p class="mt-3 text-xs font-bold uppercase tracking-[0.14em] text-slate-400">Per Thumbtack lead</p>
          <p class="mt-2 text-[14px] leading-relaxed text-slate-300">
            You already paid Google to drive them to your site. Then you pay Thumbtack to find the same shopper — shared with 4 other shops. <a href="/stats/#lead-trap" class="underline-offset-2 hover:underline">Source</a>
          </p>
        </div>

        <!-- Philosophical problem: ad budget shouldn't evaporate -->
        <div class="rounded-2xl bg-white/[0.03] p-7 ring-1 ring-inset ring-white/10">
          <div class="mb-4 inline-flex size-10 items-center justify-center rounded-xl bg-[color:var(--color-mint-400)]/15">
            <IconAlertTriangle size={20} stroke={1.75} color="#00E5A0" />
          </div>
          <div class="font-display text-4xl font-bold leading-none tracking-tight text-[color:var(--color-mint-400)] md:text-5xl">2x</div>
          <p class="mt-3 text-xs font-bold uppercase tracking-[0.14em] text-slate-400">You pay for the same shopper</p>
          <p class="mt-2 text-[14px] leading-relaxed text-slate-300">
            Once on the ad. Once on the reseller. Ad budget isn't supposed to evaporate — and shared leads aren't a fix for the leak. They're a tax on it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 3. MEET YOUR GUIDE — empathy + authority                      -->
  <!--    StoryBrand: prove you understand them, then prove you can  -->
  <!--    help. One empathy line, four small authority chips.        -->
  <!-- ============================================================== -->
  <section class="section">
    <div class="container-content">
      <div class="mx-auto max-w-4xl">
        <div class="grid items-center gap-12 md:grid-cols-[1fr_1.2fr]">
          <div>
            <Badge tone="brand" variant="soft" size="md" uppercase>Built by people who watched this happen</Badge>
            <h2 class="display-2 mt-5 text-[color:var(--color-ink)]">
              You're not the problem.<br/>
              <span class="text-[color:var(--color-brand-pressed)]">The plumbing is.</span>
            </h2>
            <p class="mt-5 text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">
              We've watched roofers spend $4,000 a month on Google ads, then spend another $2,000 on Thumbtack to fight for the same shoppers their own ads already drove to their site. That's broken. So we built the layer that fixes it.
            </p>
            <p class="mt-4 text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">
              Consent Resolve sits on top of every channel you already run. We don't compete with your ads — we rescue the visitors they paid to send you.
            </p>
          </div>

          <!-- Authority chips, 4-up grid -->
          <ul class="grid grid-cols-2 gap-3">
            <li class="rounded-xl bg-[color:var(--color-bg-alt)] p-5 ring-1 ring-inset ring-[color:var(--color-rule)]">
              <span class="inline-flex size-9 items-center justify-center rounded-lg bg-[color:var(--color-brand-soft)]">
                <IconShieldCheck size={18} stroke={1.75} color="#0A1628" />
              </span>
              <p class="mt-3 font-display text-sm font-bold tracking-tight text-[color:var(--color-ink)]">Consent-first by design</p>
              <p class="mt-1 text-[13px] leading-relaxed text-[color:var(--color-ink-2)]">No data without a yes. Audit-logged on every reveal.</p>
            </li>
            <li class="rounded-xl bg-[color:var(--color-bg-alt)] p-5 ring-1 ring-inset ring-[color:var(--color-rule)]">
              <span class="inline-flex size-9 items-center justify-center rounded-lg bg-[color:var(--color-brand-soft)]">
                <IconClipboardCheck size={18} stroke={1.75} color="#0A1628" />
              </span>
              <p class="mt-3 font-display text-sm font-bold tracking-tight text-[color:var(--color-ink)]">17 trades supported</p>
              <p class="mt-1 text-[13px] leading-relaxed text-[color:var(--color-ink-2)]">Roofing, HVAC, plumbing, GC, electrical, and more.</p>
            </li>
            <li class="rounded-xl bg-[color:var(--color-bg-alt)] p-5 ring-1 ring-inset ring-[color:var(--color-rule)]">
              <span class="inline-flex size-9 items-center justify-center rounded-lg bg-[color:var(--color-brand-soft)]">
                <IconPlugConnected size={18} stroke={1.75} color="#0A1628" />
              </span>
              <p class="mt-3 font-display text-sm font-bold tracking-tight text-[color:var(--color-ink)]">Drops into your stack</p>
              <p class="mt-1 text-[13px] leading-relaxed text-[color:var(--color-ink-2)]">Jobber, Housecall Pro, ServiceTitan, HubSpot, Klaviyo.</p>
            </li>
            <li class="rounded-xl bg-[color:var(--color-bg-alt)] p-5 ring-1 ring-inset ring-[color:var(--color-rule)]">
              <span class="inline-flex size-9 items-center justify-center rounded-lg bg-[color:var(--color-brand-soft)]">
                <IconLock size={18} stroke={1.75} color="#0A1628" />
              </span>
              <p class="mt-3 font-display text-sm font-bold tracking-tight text-[color:var(--color-ink)]">$7 per lead, flat</p>
              <p class="mt-1 text-[13px] leading-relaxed text-[color:var(--color-ink-2)]">Exclusive. Never resold. Cancel anytime — no contract.</p>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 4. THE PLAN — HowItWorks (the four-step comet)                -->
  <!--    StoryBrand says: a clear plan beats a clever pitch.        -->
  <!-- ============================================================== -->
  <HowItWorks />

  <!-- ============================================================== -->
  <!-- 5. PRODUCT PEEK — tight, NOT a full dashboard chrome          -->
  <!--    Three glass tiles, side-by-side. Each shows one slice:     -->
  <!--    real name, live count + trend, integrations.               -->
  <!-- ============================================================== -->
  <section class="section bg-[color:var(--color-bg-alt)]">
    <div class="container-content">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <Badge tone="brand" variant="soft" size="md" uppercase>A look at what lands in your hands</Badge>
        <h2 class="display-2 mt-5 text-[color:var(--color-ink)]">
          What happens after<br/>
          <span class="text-[color:var(--color-brand-pressed)]">they say yes.</span>
        </h2>
      </div>

      <div class="mx-auto grid max-w-5xl gap-5 md:grid-cols-3">
        <!-- Tile 1: a visitor row mock -->
        <div class="rounded-2xl bg-white p-6 ring-1 ring-inset ring-[color:var(--color-rule)] shadow-[0_18px_36px_-22px_rgba(10,22,40,0.18)]">
          <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">Real name. Real number.</p>
          <div class="mt-4 flex items-center gap-3">
            <span class="inline-flex size-11 items-center justify-center rounded-full bg-[color:var(--color-brand)] font-display text-sm font-black text-[color:var(--color-navy-900)]">MR</span>
            <div class="flex-1">
              <p class="font-display text-sm font-bold tracking-tight text-[color:var(--color-ink)]">Maria R.</p>
              <p class="text-[12px] text-[color:var(--color-ink-muted)]">Roof replacement · 77584</p>
            </div>
            <span class="rounded-full bg-[color:var(--color-brand-soft)] px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-brand-pressed)]">Consented</span>
          </div>
          <div class="mt-5 grid grid-cols-2 gap-2 border-t border-[color:var(--color-rule)] pt-4 text-[12px]">
            <div class="min-w-0">
              <p class="text-[color:var(--color-ink-muted)]">Email</p>
              <p class="truncate font-mono text-[color:var(--color-ink)]">maria.r@gmail.com</p>
            </div>
            <div>
              <p class="text-[color:var(--color-ink-muted)]">Last seen</p>
              <p class="font-semibold text-[color:var(--color-ink)]">6 minutes ago</p>
            </div>
          </div>
          <p class="mt-4 text-[12px] leading-relaxed text-[color:var(--color-ink-2)]">
            Read your "Storm damage" page twice. Lingered on the financing FAQ.
          </p>
        </div>

        <!-- Tile 2: live count + tiny spark -->
        <div class="rounded-2xl bg-[color:var(--color-navy-900)] p-6 text-white ring-1 ring-inset ring-white/10 shadow-[0_18px_36px_-22px_rgba(0,0,0,0.4)]">
          <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-mint-400)]">Recovered this month</p>
          <p class="mt-4 font-display text-6xl font-black leading-none tracking-tight tabular-nums text-white">147</p>
          <p class="mt-3 text-[13px] text-slate-300">Across Google, LSA, Meta and SEO traffic.</p>
          <div class="mt-5 rounded-xl bg-white/5 p-3 ring-1 ring-inset ring-white/10">
            <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Last 14 days</p>
            <div class="mt-2 [&_svg]:!w-full [&_svg]:!h-12">
              <Sparkline data={peekSpark} width={260} height={48} tone="brand" fill={true} />
            </div>
          </div>
        </div>

        <!-- Tile 3: integrations -->
        <div class="rounded-2xl bg-white p-6 ring-1 ring-inset ring-[color:var(--color-rule)] shadow-[0_18px_36px_-22px_rgba(10,22,40,0.18)]">
          <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">Lands in the stack you run</p>
          <ul class="mt-4 space-y-2.5">
            {[
              { name: "Jobber",         status: "Pushed · 6m ago" },
              { name: "HubSpot",        status: "Pushed · 6m ago" },
              { name: "Klaviyo",        status: "Synced · 6m ago" },
              { name: "Meta ads audience", status: "Added · 6m ago" },
            ].map((row) => (
              <li class="flex items-center justify-between rounded-lg bg-[color:var(--color-bg-alt)] px-3 py-2.5 ring-1 ring-inset ring-[color:var(--color-rule)]">
                <span class="flex items-center gap-2.5">
                  <IconCircleCheck size={16} stroke={2.25} color="#00A86E" />
                  <span class="text-[13px] font-semibold text-[color:var(--color-ink)]">{row.name}</span>
                </span>
                <span class="text-[11px] text-[color:var(--color-ink-muted)]">{row.status}</span>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-[12px] leading-relaxed text-[color:var(--color-ink-2)]">
            Every recovery hits your CRM, your ad audiences, and your email tool — at the same time.
          </p>
        </div>
      </div>

      <p class="mx-auto mt-6 max-w-2xl text-center text-[12px] text-[color:var(--color-ink-muted)]">
        Names and numbers shown are illustrative — your dashboard fills with real homeowners from your traffic.
      </p>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 6. WHAT YOU GET — the 3 pillars                                -->
  <!--    StoryBrand: clear plan = clear value. Three big cards,     -->
  <!--    one promise each. Linked to the deeper feature groups.     -->
  <!-- ============================================================== -->
  <section class="section">
    <div class="container-content">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <Badge tone="brand" variant="soft" size="md" uppercase>What you get</Badge>
        <h2 class="display-2 mt-5 text-[color:var(--color-ink)]">
          Three jobs. One layer.<br/>
          <span class="text-[color:var(--color-brand-pressed)]">Same ad budget, more booked work.</span>
        </h2>
      </div>

      <div class="mx-auto grid max-w-5xl gap-5 md:grid-cols-3">
        <!-- Pillar 1: Recovery -->
        <a
          href="/features/#ad-recovery"
