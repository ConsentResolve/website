---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Button from "~/components/ui/Button.astro";
import Badge from "~/components/ui/Badge.astro";
import LeadPhone from "~/components/islands/LeadPhone.tsx";
import FinalCTA from "~/components/sections/FinalCTA.astro";
import { IconArrowRight, IconCheck } from "@tabler/icons-react";
import { breadcrumbSchema } from "~/lib/seo";

const schemas = [
  breadcrumbSchema([
    { name: "Home", href: "/" },
    { name: "Sample Lead", href: "/sample-lead/" },
  ]),
];
---

<BaseLayout
  title="See a Sample Lead — Exactly What Lands in Your Hands | Consent Resolve"
  description="When a homeowner consents, this is what shows up — name, mobile number, service area, and what they were shopping for. Yours alone. Call now, or text."
  schema={schemas}
>
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/20 blur-[120px]"></div>
    <div class="container-content section relative">
      <div class="grid items-center gap-16 lg:grid-cols-[1fr_1fr]">
        <div>
          <p class="eyebrow mb-7">Sample lead <Badge tone="neutral" variant="outline" size="sm" uppercase class="ml-2">Illustrative</Badge></p>
          <h1 class="display-1 mb-7 text-[color:var(--color-ink)]">
            Here's exactly what lands<br/>
            <span class="text-[color:var(--color-brand)]">in your hands.</span>
          </h1>
          <p class="mb-8 text-lg leading-relaxed text-[color:var(--color-ink-2)]">
            When a homeowner consents, this is the lead you get — name, mobile number, service area, and what they were shopping for. Call now, or text.
          </p>
          <ul class="mb-10 space-y-3 text-[15px] text-[color:var(--color-ink-2)]">
            <li class="flex items-center gap-2.5"><IconCheck size={18} stroke={2.5} color="#00A86E" /> First name, last name, mobile phone</li>
            <li class="flex items-center gap-2.5"><IconCheck size={18} stroke={2.5} color="#00A86E" /> What they were shopping for, captured at consent</li>
            <li class="flex items-center gap-2.5"><IconCheck size={18} stroke={2.5} color="#00A86E" /> Service-area pin so you know if it's your route</li>
            <li class="flex items-center gap-2.5"><IconCheck size={18} stroke={2.5} color="#00A86E" /> Push to your CRM (Jobber, Housecall Pro, ServiceTitan, more)</li>
            <li class="flex items-center gap-2.5"><IconCheck size={18} stroke={2.5} color="#00A86E" /> Yours alone — never resold to another shop</li>
          </ul>
          <Button href="/get-started/" variant="primary" size="lg">
            Start $10 Trial
            <IconArrowRight size={18} stroke={2.25} />
          </Button>
        </div>
        <div class="relative">
          <LeadPhone client:visible />
        </div>
      </div>
    </div>
  </section>

  <FinalCTA />
</BaseLayout>
