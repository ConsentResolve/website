---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Badge from "~/components/ui/Badge.astro";
import Button from "~/components/ui/Button.astro";
import FeatureCard from "~/components/ui/FeatureCard.astro";
import HowItWorks from "~/components/sections/HowItWorks.astro";
import ConsentFlowSlideshow from "~/components/sections/ConsentFlowSlideshow.astro";
import ComplianceBand from "~/components/sections/ComplianceBand.astro";
import FinalCTA from "~/components/sections/FinalCTA.astro";
import AEOAnswer from "~/components/sections/AEOAnswer.astro";
import FAQ from "~/components/sections/FAQ.astro";
import VisitorDetailScreen from "~/components/ui/demo/VisitorDetailScreen.astro";
import RelatedReads from "~/components/sections/RelatedReads.astro";
import { INDUSTRIES, type Industry } from "~/data/industries";
import { getBlogPostsByCluster } from "~/lib/resources";
import { breadcrumbSchema, faqSchema, industryServiceSchema } from "~/lib/seo";
import { IconArrowRight, IconEye, IconCheck,
  IconBuilding, IconTool, IconAirConditioning, IconDroplet, IconKey, IconBolt,
  IconHome, IconBrush, IconLayoutBoardSplit, IconBuildingWarehouse, IconHome2,
  IconSparkles, IconBugOff, IconBath, IconLeaf, IconCar,
  IconBellRinging, IconClipboardCheck, IconMapPin, IconRefresh,
  IconPlugConnected, IconLock, IconUserCheck, IconEyeOff, IconGhost, IconUser,
} from "@tabler/icons-react";

export async function getStaticPaths() {
  return INDUSTRIES.map((trade) => ({
    params: { slug: `${trade.slug}-leads` },
    props: { trade },
  }));
}

interface Props { trade: Industry }
const { trade } = Astro.props as Props;

// Map iconKey -> safe Tabler component
const iconMap: Record<string, any> = {
  IconBuildingCommunity: IconBuilding,
  IconTool,
  IconTrees: IconLeaf,
  IconAirConditioning,
  IconDroplet,
  IconKey,
  IconBolt,
  IconHome,
  IconPaint: IconBrush,
  IconFence: IconLayoutBoardSplit,
  IconGarage: IconBuildingWarehouse,
  IconFridge: IconHome2,
  IconSparkles,
  IconBug: IconBugOff,
  IconSpray: IconBath,
  IconPlant: IconLeaf,
  IconCar,
};
const TradeIcon = iconMap[trade.iconKey] ?? IconTool;

// Card library — the 3 cards each industry page picks from
const cardLib: Record<string, { Icon: any; title: string; body: string }> = {
  "on-phone-five":  { Icon: IconBellRinging,    title: "On your phone in five.",       body: "Slack, text, or email the second a homeowner consents — so your funnel timing is right and you're ready when the warm inbound comes." },
  "why-shopping":   { Icon: IconClipboardCheck, title: "Why they're shopping.",         body: "What they were looking for — captured the moment they consent. Your funnel re-engages already knowing the job." },
  "mapped-zip":     { Icon: IconMapPin,         title: "Mapped to your zip.",           body: "Every lead drops a pin on your service-area map. Filter by zip, route, or distance from the shop." },
  "came-back":      { Icon: IconRefresh,        title: "They came back? You'll know.",  body: "Return-visit alerts fire when a known homeowner is back on your site. Time your funnel right." },
  "crm":            { Icon: IconPlugConnected,  title: "Lands in your CRM.",            body: "Pushes straight to Jobber, Housecall Pro, ServiceTitan, GoHighLevel, HubSpot, Klaviyo — or anything else through a webhook." },
  "yours-alone":    { Icon: IconLock,           title: "Yours alone, never resold.",    body: "Not auctioned to four other shops. Not flipped next week. One consent, one contractor — you." },
  "real-numbers":   { Icon: IconUserCheck,      title: "Real names. Real emails.",      body: "A consented, deliverable email, enriched with name and location where available — the actual homeowner, not a household label, not a P.O. box." },
};
const threeCards = trade.cardKeys.map((k) => cardLib[k]).filter(Boolean);

// Common questions every ICP (owner / office manager / tech) actually asks
// about Consent Resolve — grounded in real contractor pain points (Reddit
// r/hvac, r/Contractor; shared-lead-reseller + visitor-ID compliance threads).
// Shown on every industry page beneath the 3 trade-specific FAQs.
const COMMON_FAQS = [
  { q: "How is this different from Angi or HomeAdvisor?", a: "Those are shared-lead resellers — they sell the same homeowner to four or five contractors at once, so you're bidding against everyone who bought the same name. Here, every lead is exclusive to you and never resold: a real name, a consented email, and the pages they viewed, fed into your CRM at a flat $7. It's not a marketplace." },
  { q: "Is identifying my website visitors even legal?", a: "Yes — it's built consent-first. A privacy-compliant banner asks each visitor for permission, and you only get a lead when they accept. Every lead carries a timestamped consent receipt and a 7-year audit trail, built for TCPA, CIPA, and state privacy laws." },
  { q: "Isn't this the creepy kind of tracking that emails people who never opted in?", a: "No. The gray-area tools identify people and let you contact them with no permission — that's the part that gets businesses in trouble. Nobody becomes a lead here unless they accept the consent banner first. No consent, no data." },
  { q: "Are the leads exclusive, or will my competitor get the same name?", a: "Exclusive. A lead recovered on your website is yours alone and is never resold. They were on your site looking at your services, not shopping a marketplace." },
  { q: "I get website traffic but barely any calls. Why?", a: "Most home-service sites convert only a small share of visitors; the rest read a service page and leave. This recovers the ones who consent, so a visitor already looking at your services becomes a named lead in your CRM instead of an anonymous bounce." },
  { q: "Does this replace my Google Local Service Ads?", a: "No, it complements them. LSAs bring in searchers; this recovers the visitors who land on your site and would otherwise leave anonymous. Different parts of the same funnel." },
  { q: "Am I locked into a contract or a monthly minimum?", a: "No long-term contract and no annual membership. It's flat $7 per exclusive lead — card required, cancel anytime." },
  { q: "How do the leads reach me so I can follow up fast?", a: "Recovered leads feed straight into your CRM — Jobber, Housecall Pro, ServiceTitan, HubSpot, Klaviyo, GoHighLevel — with the name, consented email, and services viewed, so you can follow up while the interest is fresh." },
  { q: "I've wasted money on marketing before. What's different here?", a: "You only pay $7 when an actual visitor on your site consents to become a lead — not for clicks, impressions, or a shared name four competitors also bought. The spend maps to a named, exclusive, consented person who was already looking at your services." },
];
// Trade-specific FAQs first, then the common set — used for both display and FAQPage schema.
const faqItems = [
  ...trade.faqs.map((f) => ({ question: f.q, answer: f.a })),
  ...COMMON_FAQS.map((f) => ({ question: f.q, answer: f.a })),
];

// SEO
const canonical = `https://consentresolve.com/${trade.slug}-leads/`;
const schemas = [
  breadcrumbSchema([
    { name: "Home", href: "/" },
    { name: "Industries", href: "/industries/" },
    { name: trade.name, href: `/${trade.slug}-leads/` },
  ]),
  industryServiceSchema({
    tradeName: trade.name,
    tradeSlug: trade.slug,
    description: trade.metaDescription,
  }),
  faqSchema(faqItems),
];

const relatedPosts = await getBlogPostsByCluster(trade.slug);

const fmtUsd = (n: number) => `$${n.toLocaleString()}`;

// Demo is the primary CTA on these paid-ad landing pages. Per-trade UTM so
// landing-page demo clicks attribute to the trade; the original ad source is
// preserved separately in the first-party cr_src cookie (set on first hit),
// so this never clobbers ad attribution. `trade` prefills the demo form.
const demoHref = (slot: string) =>
  `/demo/?utm_source=${trade.slug}-leads&utm_medium=landing_page&utm_content=${slot}&trade=${trade.slug}`;

// Canonical "booked job" math — one comparison used everywhere (demo,
// landing pages, ads). $7/lead stays the offer; this is the proof.
const bookedJobMath = {
  shared: { cost: "$575", sub: "$46 a lead · sold to ~4 others · ~1 in 12 books" },
  owned: { cost: "$140", sub: "$7 a lead · exclusive, never resold · yours alone" },
};

// Problem-section UGC video — landscape Tyler (HeyGen, "Real Tyler" group look
// "Green Hat, Matching Shirt" + voice 92071…). Shipped as a static asset under
// public/ (no R2 write creds locally). Regenerate via scripts/gen_problem_ugc.py.
const PROBLEM_VIDEO = "/video/tyler-problem.mp4";

// Per-trade two-part interactive clips (intro → pause/cue → After animates grid →
// resume). HVAC is the pilot; trades without an entry fall back to PROBLEM_VIDEO.
const TRADE_VIDEOS: Record<string, { intro: string; resume: string; poster?: string }> = {
  hvac: { intro: "/video/hvac-intro.mp4", resume: "/video/hvac-resume.mp4", poster: "/video/hvac-poster.jpg" },
};
const tradeVid = TRADE_VIDEOS[trade.slug];

// Message-match hero variants — mirror the three retargeting ad angles. The ad
// link carries ?utm_content=hook|math|reframe and the hero swaps to match what
// they clicked (biggest conversion lever for paid/cold traffic).
const HERO_ANGLES: Record<string, string> = {
  hook: "98% of your site visitors leave. Get them back.",
  math: "A $149 lead, split 5 ways. Or $7 — all yours.",
  reframe: "Stop renting your leads. Own them.",
};
---

<BaseLayout
  title={trade.titleTag}
  description={trade.metaDescription}
  canonical={canonical}
  schema={schemas}
>
  <!-- Hero — dark so the consent→click→CRM animation reads, with a subtle
       trade-icon watermark cueing which industry this page is for. -->
  <section class="section section-dark relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/20 blur-[120px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 top-1/2 -translate-y-1/2 opacity-[0.05]">
      <TradeIcon size={560} stroke={1} color="#ffffff" />
    </div>
    <div class="container-content relative">
      <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
        <div>
          <p data-pers class="mb-4 hidden text-sm font-bold uppercase tracking-[0.16em] text-[color:var(--color-mint-400)]"></p>
          <div class="mb-7"><Badge tone="brand" variant="soft" surface="dark" size="md" uppercase icon={TradeIcon}>{trade.name}</Badge></div>
          <h1 class="display-1 mb-7 text-white" data-hero-h1 data-a-hook={HERO_ANGLES.hook} data-a-math={HERO_ANGLES.math} data-a-reframe={HERO_ANGLES.reframe}>
            {trade.heroH1}
          </h1>
          <p class="mb-10 max-w-xl text-lg leading-relaxed text-slate-300">
            {trade.heroSubhead}
          </p>
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              href={demoHref("hero")}
              class="inline-flex items-center justify-center gap-2 rounded-full bg-[color:var(--color-brand)] px-7 py-3.5 text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--color-navy-900)] shadow-[0_18px_36px_-18px_rgba(0,229,160,0.55)] transition-all hover:-translate-y-0.5 hover:bg-[color:var(--color-brand-pressed)] hover:text-white"
            >
              <IconEye size={18} stroke={2} />
              Live Demo
            </a>
            <a
              href="https://dashboard.consentresolve.com/register"
              class="inline-flex items-center justify-center gap-2 rounded-full px-7 py-3.5 text-sm font-bold uppercase tracking-[0.14em] text-white ring-1 ring-inset ring-white/20 transition-all hover:bg-white/5"
            >
              Get Started
              <IconArrowRight size={18} stroke={2.25} />
            </a>
          </div>
          <!-- Trust line -->
          <ul class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-slate-300">
            <li class="flex items-center gap-1.5"><IconCheck size={16} stroke={2.5} color="#00E5A0" /> $7 per lead, never resold</li>
            <li class="flex items-center gap-1.5"><IconCheck size={16} stroke={2.5} color="#00E5A0" /> Exclusive leads</li>
            <li class="flex items-center gap-1.5"><IconCheck size={16} stroke={2.5} color="#00E5A0" /> Cancel anytime</li>
          </ul>
          <p class="mt-4 text-sm text-slate-400">~60-second live demo — the lead it sends is you. No card required.</p>
        </div>
        <!-- Hero animation: consent → click → CRM (shared with /features) -->
        <div class="relative">
          <ConsentFlowSlideshow />
        </div>
      </div>
    </div>
  </section>

  <!-- The problem — a UGC video carries the message; a Before/After toggle
       shows what changes when anonymous visitors become identified leads. -->
  <section class="section section-dark" data-ba>
    <div class="container-content">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <div class="mb-5 flex justify-center"><Badge tone="brand" variant="soft" surface="dark" size="md" uppercase>The problem</Badge></div>
        <h2 class="display-2 text-white">
          98 of 100 leave anonymous.
        </h2>
        <p class="mt-4 text-[15px] text-slate-300">{trade.problem}</p>
      </div>
      <!-- Before/After toggle, centered across the section so its midpoint sits
           over the column gap: Before reads toward the video (left), After toward
           the grid (right). Drives the cascade below. -->
      <div class="mb-10 flex flex-col items-center">
        <div class="batoggle inline-flex gap-1.5 rounded-2xl bg-white/[0.06] p-1.5 ring-1 ring-inset ring-white/10 shadow-[0_18px_40px_-18px_rgba(0,0,0,0.55)]">
          <button data-ba-tab="before" class="ba-tab is-active inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-extrabold uppercase tracking-[0.12em] transition-all">
            <IconEyeOff size={17} stroke={2.25} /> Before
          </button>
          <button data-ba-tab="after" class="ba-tab inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-extrabold uppercase tracking-[0.12em] transition-all">
            <IconUserCheck size={17} stroke={2.25} /> After
          </button>
        </div>
        <p data-cue-hint class="mt-3 hidden text-sm font-semibold text-[color:var(--color-mint-400)]">↑ Tap <strong>After</strong> to see what Tyler means — then he'll finish.</p>
      </div>

      <!-- Two columns: UGC video left (green-bordered), interactive leak grid right -->
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <!-- Left: UGC video with a mint border -->
        <div class="overflow-hidden bg-black shadow-[0_30px_60px_-30px_rgba(0,0,0,0.6)] border-[6px] border-black ring-1 ring-inset ring-white/10">
          {tradeVid ? (
            <Fragment>
              <video data-vid-intro src={tradeVid.intro} class="aspect-video h-full w-full object-cover" controls playsinline preload="metadata" poster={tradeVid.poster ?? "/og-default.png"}></video>
              <video data-vid-resume src={tradeVid.resume} class="aspect-video hidden h-full w-full object-cover" playsinline preload="metadata"></video>
            </Fragment>
          ) : (
            <video src={PROBLEM_VIDEO} class="aspect-video h-full w-full object-cover" controls playsinline preload="metadata" poster="/og-default.png"></video>
          )}
        </div>

        <!-- Anonymous (ghost) → named-account (person) cascade. Populates when the
             video plays; the 2 greens pulse when the intro ends; tapping After runs
             the staggered conversion + a dramatic finish. -->
        <div class="leakgrid mx-auto" data-leak data-state="before" aria-hidden="true">
          {Array.from({ length: 100 }).map((_, i) => (
            <span class="lc" style={`--i:${i}`}>
              <span class="lc-person"><IconUser size={20} stroke={2} /></span>
              <span class="lc-ghost"><IconGhost size={20} stroke={1.7} /></span>
              <span class="lc-check"><IconCheck size={22} stroke={2.75} /></span>
              <i class="lc-x"></i>
            </span>
          ))}
        </div>
      </div>

      <!-- Final stat — funnel filled: ~40 leads at $7. Revealed when recovery completes. -->
      <div data-stat class="mt-12 hidden text-center">
        <p class="font-display text-4xl font-extrabold text-white sm:text-5xl">≈ 40 leads <span class="text-[color:var(--color-mint-400)]">· $280</span></p>
        <p class="mt-2 text-xs text-slate-400">40 recovered leads × $7 a lead · results may vary.</p>
      </div>
    </div>
  </section>

  <!-- How it works (reused comet) -->
  <HowItWorks />

  <!-- Trade math (dark) -->
  <section class="section section-dark">
    <div class="container-content">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <div class="mb-5 flex justify-center"><Badge tone="brand" variant="soft" surface="dark" size="md" uppercase>The math</Badge></div>
        <h2 class="display-2 text-white">
          Same booked job. Less than a quarter of the cost.
        </h2>
        <p class="mt-3 text-[15px] text-slate-300">
          Shared leads get sold to four contractors at once, so most never book. Recover the traffic you already paid for instead — exclusive, at $7. Here's the same job, both ways.
        </p>
      </div>
      <!-- Booked-job math — the canonical $575 vs $140 comparison -->
      <div class="mx-auto mb-12 grid max-w-3xl gap-5 sm:grid-cols-2">
        <div class="rounded-2xl bg-white/[0.04] p-7 ring-1 ring-inset ring-white/10">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-400">Shared / bought leads</p>
          <p class="mt-2 font-display text-4xl font-extrabold text-white">{bookedJobMath.shared.cost}<span class="text-lg font-bold text-slate-400"> / booked job</span></p>
          <p class="mt-3 text-sm text-slate-300">{bookedJobMath.shared.sub}</p>
        </div>
        <div class="rounded-2xl bg-[color:var(--color-mint-400)]/10 p-7 ring-1 ring-inset ring-[color:var(--color-mint-400)]/40 shadow-[0_30px_60px_-30px_rgba(0,229,160,0.45)]">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-mint-400)]">Your own traffic — Consent Resolve</p>
          <p class="mt-2 font-display text-4xl font-extrabold text-white">{bookedJobMath.owned.cost}<span class="text-lg font-bold text-slate-400"> / booked job</span></p>
          <p class="mt-3 text-sm text-slate-300">{bookedJobMath.owned.sub}</p>
        </div>
      </div>
      <p class="mx-auto max-w-2xl text-center text-[15px] text-slate-300">
        One booked {trade.shortName.toLowerCase()} job runs about <strong class="text-white">{fmtUsd(trade.math.avgJobValue)}</strong> — that single job covers roughly <strong class="text-white">{Math.round(trade.math.avgJobValue / 7).toLocaleString()}</strong> exclusive leads at $7. Illustrative, not a promise.
      </p>
    </div>
  </section>

  <!-- Why it fits — 3 cards -->
  <section class="section bg-[color:var(--color-bg-alt)]">
    <div class="container-content">
      <div class="mx-auto mb-14 max-w-2xl text-center">
        <div class="mb-5 flex justify-center"><Badge tone="brand" variant="soft" size="md" uppercase>Why it fits {trade.name.toLowerCase()}</Badge></div>
        <h2 class="display-2 text-[color:var(--color-ink)]">
          The three things that move the needle for your trade.
        </h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {threeCards.map((c) => (
          <FeatureCard variant="showcase" icon={c.Icon} title={c.title} body={c.body} />
        ))}
      </div>
    </div>
  </section>

  <!-- Live product preview — the actual visitor record that lands in your dashboard -->
  <section class="section section-dark">
    <div class="container-content">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <div class="mb-5 flex justify-center"><Badge tone="brand" variant="soft" surface="dark" size="md" uppercase>The actual product</Badge></div>
        <h2 class="display-2 text-white">
          This is what lands in your dashboard.
        </h2>
        <p class="mt-4 text-[17px] leading-relaxed text-slate-300">
          A real name and a consented email — with the pages they viewed, what they were shopping for, and a timestamped consent receipt. Yours alone, never resold.
        </p>
      </div>
      <!-- Capped height + scroll so the full dashboard UI doesn't sprawl vertically. -->
      <div class="mx-auto max-h-[460px] max-w-5xl overflow-auto rounded-[1.25rem] ring-1 ring-inset ring-white/10">
        <div class="min-w-[900px]">
          <VisitorDetailScreen />
        </div>
      </div>
      <p class="mx-auto mt-3 max-w-5xl text-center text-xs text-slate-400">Scroll to explore the full record ↕</p>
    </div>
  </section>

  <!-- Demo CTA band — promote the live demo mid-page (light, mint-tinted) -->
  <section class="bg-[color:var(--color-brand-soft)]">
    <div class="container-content py-16">
      <div class="mx-auto flex max-w-3xl flex-col items-center gap-6 text-center">
        <h2 class="display-2 text-[color:var(--color-ink)]">See it work on yourself.</h2>
        <p class="text-[17px] leading-relaxed text-[color:var(--color-ink-2)]">
          Register, browse a sample {trade.shortName.toLowerCase()} site, accept the banner — and watch the new-lead notification land in your inbox. The lead is you. About 60 seconds, no card required.
        </p>
        <Button href={demoHref("cta-band")} variant="primary" size="lg">
          <IconEye size={18} stroke={2} />
          Try the live demo
        </Button>
      </div>
    </div>
  </section>

  <ComplianceBand />

  <!-- Trade FAQ + common questions about Consent Resolve -->
  <FAQ
    headline={`What ${trade.name.toLowerCase()} ask before they start.`}
    items={faqItems}
  />

  <!-- From the blog (reciprocal cluster links) -->
  <RelatedReads
    posts={relatedPosts}
    heading={`More for ${trade.name.toLowerCase()} pros`}
  />

  <AEOAnswer text={trade.aeoAnswer} />
  <FinalCTA heading={trade.finalCtaH2} />
</BaseLayout>

<!-- Message match + Instantly named personalization. Reads the ad/email link params:
       ?utm_content=hook|math|reframe  → swap the hero headline to the angle clicked
       ?fn=&co=&city=                  → personalized greeting + carried to the demo
     Only low-sensitivity fields (no email/phone) ride in the URL. -->
<script is:inline>
  (function () {
    var p = new URLSearchParams(location.search);
    var angle = (p.get("utm_content") || p.get("angle") || "").toLowerCase();
    var h1 = document.querySelector("[data-hero-h1]");
    if (h1 && angle) { var alt = h1.getAttribute("data-a-" + angle); if (alt) h1.textContent = alt; }
    var fn = (p.get("fn") || "").trim();
    if (fn) {
      var co = (p.get("co") || "").trim(), city = (p.get("city") || "").trim();
      var g = document.querySelector("[data-pers]");
      if (g) { g.textContent = (city ? city + " · " : "") + "Built for " + fn + (co ? " at " + co : ""); g.classList.remove("hidden"); }
    }
    // carry personalization to the demo so the form pre-fills (name/company)
    var carry = [];
    ["fn", "co", "city"].forEach(function (k) { var v = p.get(k); if (v) carry.push(k + "=" + encodeURIComponent(v)); });
    if (carry.length) {
      var q = carry.join("&");
      document.querySelectorAll('a[href*="/demo"]').forEach(function (a) { a.href += (a.href.indexOf("?") > -1 ? "&" : "?") + q; });
    }
  })();
</script>

<!-- Infographic player: the grid is the story, narrated by Tyler and kept in
     beat with the video. Intro drives the LEAK (100 land → 98 ghosts + 2 forms);
     After plays the resume clip, which drives the RECOVERY (ghosts → named leads),
     ending on a glow flourish. Falls back to a self-playing story if not played. -->
<script is:inline>
  document.querySelectorAll("[data-ba]").forEach(function (root) {
    var tabs = root.querySelectorAll("[data-ba-tab]");
    var grid = root.querySelector("[data-leak]");
    var intro = root.querySelector("[data-vid-intro]");
    var resume = root.querySelector("[data-vid-resume]");
    var hint = root.querySelector("[data-cue-hint]");
    var stat = root.querySelector("[data-stat]");
    var afterBtn = root.querySelector('[data-ba-tab="after"]');
    var cells = grid ? Array.prototype.slice.call(grid.querySelectorAll(".lc")) : [];
    var RECOVER = 38; // cells 0,1 = form-fills; 2..39 recoverable; 40..99 leave for good
    var vanished = false, recovered = 0;

    function clear(c) { c.classList.remove("is-ghost", "is-vanishing", "is-gone", "is-person", "is-lead"); }
    function ghost(c) { if (c.classList.contains("is-ghost") || c.classList.contains("is-gone") || c.classList.contains("is-vanishing")) return; clear(c); c.classList.add("is-ghost"); }
    function leadCheck(c) { clear(c); c.classList.add("is-lead"); }
    function leadPerson(c) {            // person pops in (big→small), then becomes a ✓
      if (c.classList.contains("is-lead")) return;
      clear(c); c.classList.add("is-person");
      setTimeout(function () { if (c.classList.contains("is-person")) { c.classList.remove("is-person"); c.classList.add("is-lead"); } }, 450);
    }
    function setActive(v) { tabs.forEach(function (t) { t.classList.toggle("is-active", t.getAttribute("data-ba-tab") === v); }); }

    function applyLeak(p) {             // 100 people → 2 forms (✓) + 98 ghosts
      if (!cells.length) return;
      if (p > 0.04) { leadCheck(cells[0]); leadCheck(cells[1]); }
      var n = Math.floor(Math.max(0, (p - 0.1) / 0.4) * 98);
      for (var i = 2; i < 2 + n && i < 100; i++) ghost(cells[i]);
    }
    function doVanish() {               // X out the ghosts and make them disappear (~10s beat)
      if (vanished) return; vanished = true;
      for (var i = 2; i < 100; i++) (function (c, k) { setTimeout(function () {
        if (c.classList.contains("is-lead")) return;
        c.classList.add("is-vanishing");
        setTimeout(function () { if (!c.classList.contains("is-lead")) c.classList.add("is-gone"); }, 800);
      }, k * 12); })(cells[i], i - 2);
    }
    function applyRecover(p) {          // empty slots fill back up with leads, in beat
      if (!cells.length) return;
      var target = Math.floor(Math.min(1, p / 0.8) * RECOVER);
      for (; recovered < target; recovered++) leadPerson(cells[2 + recovered]);
    }
    function finishRecover() {
      for (; recovered < RECOVER; recovered++) leadPerson(cells[2 + recovered]);
      if (grid) grid.classList.add("recovered");
      if (stat) setTimeout(function () { stat.classList.remove("hidden"); }, 650);
    }
    function problemState() { if (cells.length) { leadCheck(cells[0]); leadCheck(cells[1]); for (var i = 2; i < 100; i++) ghost(cells[i]); } }
    function cueAfter() { if (afterBtn) afterBtn.classList.add("cue"); if (hint) hint.classList.remove("hidden"); if (grid) grid.classList.add("pulse-greens"); }

    var populated = false;
    function populate() { if (!populated && grid) { populated = true; grid.classList.add("populate"); } }

    tabs.forEach(function (btn) {
      btn.addEventListener("click", function () {
        var v = btn.getAttribute("data-ba-tab"); setActive(v);
        if (v === "after") {
          if (afterBtn) afterBtn.classList.remove("cue");
          if (hint) hint.classList.add("hidden");
          if (grid) grid.classList.remove("pulse-greens");
          doVanish();
          if (intro && resume) {
            intro.pause(); intro.classList.add("hidden"); resume.classList.remove("hidden");
            var pr = resume.play(); if (pr && pr.catch) pr.catch(function () {});
          } else { setTimeout(finishRecover, 700); }
        } else {                        // "before" → back to the leak (98 ghosts visible)
          if (grid) { grid.classList.remove("recovered"); }
          if (stat) stat.classList.add("hidden");
          vanished = false; recovered = 0; problemState();
          if (resume && intro) { resume.pause(); resume.classList.add("hidden"); intro.classList.remove("hidden"); }
        }
      });
    });

    if (intro) {
      intro.addEventListener("play", populate);
      intro.addEventListener("timeupdate", function () {
        if (!intro.duration) return;
        var p = intro.currentTime / intro.duration;
        applyLeak(p);
        if (p > 0.52) doVanish();       // ~10s: X out the ghosts
      });
      intro.addEventListener("ended", function () { doVanish(); leadCheck(cells[0]); leadCheck(cells[1]); cueAfter(); });
    }
    if (resume) {
      resume.addEventListener("timeupdate", function () { if (resume.duration) applyRecover(resume.currentTime / resume.duration); });
      resume.addEventListener("ended", finishRecover);
    }

    // Fallback: self-play leak → vanish → cue if the video isn't played (never blank).
    if (grid && "IntersectionObserver" in window) {
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) {
          if (!e.isIntersecting) return;
          io.disconnect(); populate();
          if (!(intro && !intro.paused)) {
            var t0 = Date.now();
            var iv = setInterval(function () {
              if (intro && !intro.paused) { clearInterval(iv); return; }
              var p = Math.min(1, (Date.now() - t0) / 3200);
              applyLeak(p);
              if (p >= 1) { clearInterval(iv); doVanish(); setTimeout(cueAfter, 1400); }
            }, 60);
          }
        });
      }, { threshold: 0.35 });
      io.observe(grid);
    }
    setTimeout(populate, 4500);
  });
</script>

<style>
  /* Dramatic Before/After toggle (rides on a navy chip; active = mint). */
  .ba-tab { color: #94a3b8; }
  .ba-tab :global(svg) { opacity: 0.8; }
  .ba-tab:not(.is-active):hover { color: #fff; }
  .ba-tab.is-active { background: var(--color-brand); color: var(--color-navy-900); box-shadow: 0 10px 24px -10px rgba(0, 229, 160, 0.6); }
  .ba-tab.is-active :global(svg) { opacity: 1; }
  .ba-tab.cue { background: var(--color-brand); color: var(--color-navy-900); animation: cuePulse 1.25s ease-in-out infinite; }
  @keyframes cuePulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(0, 229, 160, 0.55); } 50% { box-shadow: 0 0 0 9px rgba(0, 229, 160, 0); } }

  /* Infographic grid (on dark) — the funnel story, per cell:
     neutral person (a visitor) → ghost (left anonymous) → X'd out + vanishes (gone)
     → [After] person pops in BIG then settles → ✓ (captured lead). Beat-matched to video. */
  .leakgrid { display: grid; grid-template-columns: repeat(10, 1fr); gap: 0.5rem; width: 100%; max-width: 360px; margin-inline: auto; border-radius: 18px; transition: box-shadow 0.5s ease, transform 0.4s ease; }
  .lc { position: relative; aspect-ratio: 1; opacity: 0; transform: scale(0.55); }
  .lc-person, .lc-ghost, .lc-check, .lc-x { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; line-height: 0; opacity: 0; transition: opacity 0.35s ease; }
  /* neutral (default): light person; others hidden */
  .lc-person { color: rgba(255, 255, 255, 0.5); opacity: 1; }
  .lc-ghost { color: rgba(255, 255, 255, 0.42); }
  .lc-check { color: var(--color-brand); }
  /* CSS X — two crossed red bars struck over a ghost as it's removed */
  .lc-x::before, .lc-x::after { content: ""; position: absolute; top: 50%; left: 50%; width: 80%; height: 3px; border-radius: 2px; background: #ff5a5a; }
  .lc-x::before { transform: translate(-50%, -50%) rotate(45deg); }
  .lc-x::after { transform: translate(-50%, -50%) rotate(-45deg); }
  /* ghost: faded, gently floating */
  .lc.is-ghost .lc-person { opacity: 0; }
  .lc.is-ghost .lc-ghost { opacity: 1; animation: ghostFloat 3s ease-in-out infinite; }
  /* vanishing: keep ghost, strike an X, then shrink + fade away */
  .lc.is-vanishing .lc-person { opacity: 0; }
  .lc.is-vanishing .lc-ghost { opacity: 1; }
  .lc.is-vanishing .lc-x { opacity: 1; animation: xPop 0.28s ease both; }
  .lc.is-vanishing { animation: vanishOut 0.55s ease 0.25s forwards; }
  .lc.is-gone { opacity: 0 !important; }
  /* recovery step 1: person pops in BIG then settles smaller (funnel fills) */
  .lc.is-person { opacity: 1; }
  .lc.is-person .lc-ghost, .lc.is-person .lc-x, .lc.is-person .lc-check { opacity: 0; }
  .lc.is-person .lc-person { color: var(--color-brand); animation: bigPop 0.55s cubic-bezier(0.2, 0.9, 0.3, 1.5) both; }
  /* recovery step 2: ✓ replaces the person (captured lead) */
  .lc.is-lead { opacity: 1; }
  .lc.is-lead .lc-person, .lc.is-lead .lc-ghost, .lc.is-lead .lc-x { opacity: 0; }
  .lc.is-lead .lc-check { opacity: 1; animation: checkPop 0.4s cubic-bezier(0.2, 0.9, 0.3, 1.5) both; }
  /* populate: staggered fade/pop in (the 100 land) */
  .leakgrid.populate .lc { animation: cellIn 0.45s ease forwards; animation-delay: calc(var(--i) * 7ms); }
  /* the 2 form-fills pulse when the intro ends, before recovery */
  .leakgrid.pulse-greens .lc.is-lead .lc-check { animation: greenPulse 1.1s ease-in-out infinite; }
  /* dramatic finish: mint glow ring + grid pop */
  .leakgrid.recovered { box-shadow: 0 0 0 3px rgba(0, 229, 160, 0.55), 0 0 70px rgba(0, 229, 160, 0.5); animation: gridPop 0.7s ease; }
  @keyframes cellIn { to { opacity: 1; transform: scale(1); } }
  @keyframes ghostFloat { 0%, 100% { transform: translateY(0); opacity: 0.8; } 50% { transform: translateY(-3px); opacity: 1; } }
  @keyframes bigPop { 0% { transform: scale(0); opacity: 0; } 55% { transform: scale(1.7); opacity: 1; } 100% { transform: scale(1); opacity: 1; } }
  @keyframes checkPop { 0% { transform: scale(0.2); } 60% { transform: scale(1.3); } 100% { transform: scale(1); } }
  @keyframes xPop { 0% { transform: scale(0); } 60% { transform: scale(1.25); } 100% { transform: scale(1); } }
  @keyframes vanishOut { to { opacity: 0; transform: scale(0.25) rotate(-8deg); } }
  @keyframes greenPulse { 0%, 100% { transform: scale(1); filter: none; } 50% { transform: scale(1.45); filter: drop-shadow(0 0 8px rgba(0, 229, 160, 0.95)); } }
  @keyframes gridPop { 0% { transform: scale(1); } 35% { transform: scale(1.05); } 100% { transform: scale(1); } }
  /* final stat reveal */
  [data-stat]:not(.hidden) { animation: statIn 0.7s cubic-bezier(0.2, 0.9, 0.3, 1.3) both; }
  @keyframes statIn { 0% { opacity: 0; transform: translateY(14px) scale(0.92); } 100% { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .lc { opacity: 1; transform: none; }
    .lc-person, .lc-ghost, .lc-check, .lc-x { transition: none; }
    .leakgrid.populate .lc, .lc.is-person .lc-person, .lc.is-lead .lc-check, .lc.is-ghost .lc-ghost, .lc.is-vanishing, .lc.is-vanishing .lc-x, .leakgrid.pulse-greens .lc.is-lead .lc-check, .leakgrid.recovered, [data-stat]:not(.hidden) { animation: none; }
    .ba-tab.cue { animation: none; }
  }
</style>
