  .lc-ghost, .lc-person { display: flex; line-height: 0; }
  /* anonymous = grey ghost; identified = mint person (the 2 form-fills start as people) */
  .lc-ghost { color: rgba(10, 22, 40, 0.4); }
  .lc-person { color: var(--color-brand); display: none; }
