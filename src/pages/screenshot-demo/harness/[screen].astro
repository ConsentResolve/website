---
// Bare capture harness for the anonymized product-demo replicas — no site chrome
// (no Nav/Footer/cookie-consent/chat/GA), just fonts + the component, full-bleed.
// Already excluded from indexing: robots.txt disallows /screenshot-demo/ site-wide.
// Static route (this site builds with output:"static", so a ?query= param can't
// select the component at request time) — one pre-rendered page per screen key.
// Usage: /screenshot-demo/harness/dashboard/ (see SCREENS below for all keys).
import "~/styles/global.css";
import DashboardScreen from "~/components/ui/demo/DashboardScreen.astro";
import VisitorsScreen from "~/components/ui/demo/VisitorsScreen.astro";
import VisitorDetailScreen from "~/components/ui/demo/VisitorDetailScreen.astro";
import IntegrationsScreen from "~/components/ui/demo/IntegrationsScreen.astro";
import ConsentScreen from "~/components/ui/demo/ConsentScreen.astro";
import BillingScreen from "~/components/ui/demo/BillingScreen.astro";
import CrmPushScreen from "~/components/ui/demo/CrmPushScreen.astro";

export function getStaticPaths() {
  return ["dashboard", "visitors", "detail", "integrations", "consent", "billing", "crmpush"].map(
    (screen) => ({ params: { screen } })
  );
}

const SCREENS: Record<string, any> = {
  dashboard: DashboardScreen,
  visitors: VisitorsScreen,
  detail: VisitorDetailScreen,
  integrations: IntegrationsScreen,
  consent: ConsentScreen,
  billing: BillingScreen,
  crmpush: CrmPushScreen,
};

const { screen } = Astro.params;
const Screen = SCREENS[screen as string] || DashboardScreen;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Screenshot harness — {screen}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Hanken+Grotesk:wght@300..800&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
  </head>
  <body>
    <div id="harness-root">
      <div id="harness-content">
        <Screen />
      </div>
    </div>
    <script>
      // Some screens (Dashboard, Visitors, Visitor Detail) render taller than the
      // 800px capture viewport once their full data set is laid out — scale the
      // whole thing down to fit instead of cropping or scrolling, so every shot
      // shows the complete "as-is" replica at an exact 1280x800 frame.
      function fitToFrame() {
        const content = document.getElementById("harness-content");
        if (!content) return;
        content.style.transform = "none";
        const naturalW = content.scrollWidth;
        const naturalH = content.scrollHeight;
        const scale = Math.min(1280 / naturalW, 800 / naturalH, 1);
        content.style.transformOrigin = "top left";
        content.style.transform = `scale(${scale})`;
        const scaledW = naturalW * scale;
        content.style.left = `${Math.max(0, (1280 - scaledW) / 2)}px`;
      }
      window.addEventListener("load", () => requestAnimationFrame(fitToFrame));
    </script>
  </body>
</html>

<style is:global>
  html, body { margin: 0; padding: 0; background: #051221; }
  #harness-root {
    width: 1280px;
    height: 800px;
    overflow: hidden;
    position: relative;
    background: #051221;
  }
  #harness-content {
    position: absolute;
    top: 0;
    left: 0;
    width: 1280px;
  }
  /* The demo components render their own .demo-chrome grid — stretch it to fill
     this full-bleed harness instead of the constrained style-guide content column. */
  #harness-content :global(.demo-chrome) {
    border-radius: 0;
    min-height: 800px;
  }
</style>
