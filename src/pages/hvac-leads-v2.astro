<!-- Message match + Instantly named personalization. Reads the ad/email link params:
       ?utm_content=hook|math|reframe  → swap the hero headline to the angle clicked
       ?fn=&co=&city=                  → personalized greeting + carried to the demo
     Only low-sensitivity fields (no email/phone) ride in the URL. -->
<script is:inline>
  (function () {
    var p = new URLSearchParams(location.search);
    var angle = (p.get("utm_content") || p.get("angle") || "").toLowerCase();
    var fn = (p.get("fn") || "").trim();
    var co = (p.get("co") || "").trim();
    var city = (p.get("city") || "").trim();
    var coPos = co ? co + "’s" : "your"; // "Acme Air’s" or "your"
    var MINT = "var(--color-mint-400)";
    // token -> {value, highlight?} ; the existing word in the markup is the fallback
    var vals = {
      coPos: { v: coPos, on: !!co },
      co: { v: co || "your business", on: !!co },
      city: { v: city || "your area", on: !!city },
      fn: { v: fn || "there", on: !!fn },
    };

    // Hero headline: take the clicked angle (or the per-trade default), then fill the
    // {coPos} token with a highlighted company name (graceful "your" fallback).
    var h1 = document.querySelector("[data-hero-h1]");
    if (h1) {
      var base = (angle && h1.getAttribute("data-a-" + angle)) || h1.textContent;
      if (base.indexOf("{coPos}") > -1) {
        var parts = base.split("{coPos}");
        h1.textContent = "";
        h1.appendChild(document.createTextNode(parts[0]));
        var sp = document.createElement("span");
        sp.textContent = coPos;
        if (co) sp.style.color = MINT;
        h1.appendChild(sp);
        h1.appendChild(document.createTextNode(parts.slice(1).join("{coPos}")));
      } else if (angle) {
        h1.textContent = base;
      }
    }

    // Fill every [data-pp] token in the copy; highlight in brand mint when we have real data.
    document.querySelectorAll("[data-pp]").forEach(function (el) {
      var slot = vals[el.getAttribute("data-pp")];
      if (!slot) return;
      el.textContent = slot.v;
      if (slot.on) el.style.color = MINT;
    });

    // Personalized greeting eyebrow (shows when we have city / name / company).
    var g = document.querySelector("[data-pers]");
    if (g && (fn || co || city)) {
      var bits = [];
      if (city) bits.push(city);
      if (fn) bits.push("Built for " + fn + (co ? " at " + co : ""));
      else if (co) bits.push("Built for " + co);
      if (bits.length) { g.textContent = bits.join(" · "); g.classList.remove("hidden"); }
    }

    // Open the demo in a new tab + carry fn/co/city so the demo form pre-fills (name/company).
    var demoLinks = document.querySelectorAll('a[href*="/demo"]');
    demoLinks.forEach(function (a) { a.target = "_blank"; a.rel = "noopener"; });
    var carry = [];
    ["fn", "co", "city"].forEach(function (k) { var v = p.get(k); if (v) carry.push(k + "=" + encodeURIComponent(v)); });
    if (carry.length) { var q = carry.join("&"); demoLinks.forEach(function (a) { a.href += (a.href.indexOf("?") > -1 ? "&" : "?") + q; }); }
  })();
</script>

<!-- Infographic player: the right-hand box is the story. It starts as 100
     anonymous ghosts (2 transition to a lead). Playing the video X's out the 98
     that leave; tapping After lights them up ghost → ✓ → person, one at a time,
     then fills the box with the result. Nothing auto-runs — it waits for Play/tap. -->
<script is:inline>
  document.querySelectorAll("[data-ba]").forEach(function (root) {
    var grid = root.querySelector("[data-leak]");
    var intro = root.querySelector("[data-vid-intro]");
    var resume = root.querySelector("[data-vid-resume]");
    var stat = root.querySelector("[data-stat]");
    var vidCta = root.querySelector("[data-vid-cta]");
    var ctaBtn = root.querySelector("[data-cta-after]");
    var vidWrap = root.querySelector("[data-vid-wrap]");
    var playBtn = root.querySelector("[data-playbtn]");
    var demoForm = root.querySelector("[data-demo-form]");  // end-of-video CTA (falls back to the $280 stat if absent)
    var cells = grid ? Array.prototype.slice.call(grid.querySelectorAll(".lc")) : [];
    var RECOVER = 40;        // cells 0..39 light up as recovered leads → $280
    var timers = [], vanished = false;

    function later(fn, ms) { timers.push(setTimeout(fn, ms)); }
    function stopTimers() { timers.forEach(clearTimeout); timers = []; }
    function clear(c) { c.classList.remove("is-check", "is-lead", "is-vanishing", "is-gone"); }
    function ghost(c) { clear(c); }                 // a bare .lc shows the ghost
    function allGhost() { for (var i = 0; i < cells.length; i++) ghost(cells[i]); }
    function hideStat() { if (stat) stat.classList.add("hidden"); }

    // ghost → ✓ → person (smooth), with an optional start delay
    function lead(c, delay) {
      later(function () {
        clear(c); c.classList.add("is-check");
        later(function () { c.classList.remove("is-check"); c.classList.add("is-lead"); }, 340);
      }, delay || 0);
    }

    // BEFORE: the 98 (cells 2..99) get X'd out and disappear; the 2 forms stay
    function doVanish() {
      if (vanished || !cells.length) return; vanished = true;
      for (var i = 2; i < 100; i++) (function (c, k) { later(function () {
        if (c.classList.contains("is-lead")) return;
        c.classList.add("is-vanishing");
        later(function () { c.classList.add("is-gone"); }, 760);
      }, k * 14); })(cells[i], i - 2);
    }

    // AFTER: ghost → ✓ → person, one at a time, then reveal the stat in the box
    function runRecover() {
      stopTimers(); hideStat(); vanished = false;
      if (grid) grid.classList.remove("recovered", "pulse-greens");
      allGhost();
      var stagger = 105;
      for (var k = 0; k < RECOVER; k++) lead(cells[k], 250 + k * stagger);
      later(function () {
        if (grid) grid.classList.add("recovered");
        if (stat && !demoForm) stat.classList.remove("hidden");  // fallback stat only when there's no end-of-video form
      }, 250 + RECOVER * stagger + 450);
    }

    function cueAfter() { if (grid) grid.classList.add("pulse-greens"); }

    // No toggle: the end-screen CTA is the only way forward. Swap to the resume
    // clip, play it, and light up the recovery (ghost → ✓ → person). The end
    // payoff (the demo form, or the $280 stat fallback) shows when the clip ends.
    function goAfter() {
      if (vidCta) vidCta.classList.add("hidden");
      if (grid) grid.classList.remove("pulse-greens");
      if (intro && resume) {
        intro.pause(); intro.classList.add("hidden"); resume.classList.remove("hidden"); resume.controls = true;
        var pr = resume.play();
        if (pr && pr.catch) pr.catch(function () {   // if the 2nd clip can't autoplay, still reveal the payoff after the recovery
          if (demoForm) later(function () { demoForm.classList.remove("hidden"); }, 6500);
        });
      }
      runRecover();
    }

    // Personalize the address bar: Instantly can pass ?domain= (the prospect's
    // real site); otherwise it stays the trade-specific default in the markup.
    var addr = root.querySelector("[data-addr]");
    var dom = new URLSearchParams(location.search).get("domain");
    if (addr && dom) {
      dom = dom.replace(/^https?:\/\//i, "").replace(/^www\./i, "").replace(/\/.*$/, "").trim();
      if (dom) addr.textContent = dom;
    }

    if (ctaBtn) ctaBtn.addEventListener("click", goAfter);

    // Video playback. Hover = muted preview from the start; clicking the play
    // button = play with sound from the start. The BEFORE climax (98 leave) and
    // the end payoff only run once it's *really* playing (clicked).
    var started = false;
    function realPlay() {
      started = true;
      if (playBtn) playBtn.classList.add("hidden");
      if (intro) { intro.muted = false; intro.controls = true; try { intro.currentTime = 0; } catch (e) {} var pr = intro.play(); if (pr && pr.catch) pr.catch(function () {}); }
    }
    if (playBtn) playBtn.addEventListener("click", realPlay);
    if (vidWrap && intro) {
      vidWrap.addEventListener("mouseenter", function () {
        if (started) return;
        intro.muted = true; try { intro.currentTime = 0; } catch (e) {}
        var pr = intro.play(); if (pr && pr.catch) pr.catch(function () {});
      });
      vidWrap.addEventListener("mouseleave", function () {
        if (started) return;
        intro.pause(); try { intro.currentTime = 0; } catch (e) {}  // back to the start
      });
    }
    if (intro) {
      intro.addEventListener("play", function () { if (vidCta) vidCta.classList.add("hidden"); });
      intro.addEventListener("timeupdate", function () {
        if (started && intro.duration && intro.currentTime / intro.duration > 0.52) doVanish();
      });
      intro.addEventListener("ended", function () {
        if (!started) return;
        doVanish(); cueAfter(); if (vidCta) vidCta.classList.remove("hidden");  // the after-CTA appears
      });
    }
    // The demo form appears when the 2nd (resume) clip finishes.
    if (resume) {
      resume.addEventListener("ended", function () { if (demoForm) demoForm.classList.remove("hidden"); });
    }

    // Initial state: 100 ghosts; 2 of them transition ghost → ✓ → person.
    if (grid && cells.length) {
      grid.classList.add("populate");
      lead(cells[0], 700); lead(cells[1], 1150);
    }
  });
</script>

<style>
  /* Infographic grid (on dark) — the story, per cell:
     ghost (anonymous visitor, default) → ✓ (consented) → person (identified lead).
     In BEFORE, the 98 ghosts get an X struck over them and vanish. */
  .leakgrid { display: grid; grid-template-columns: repeat(10, 1fr); gap: 0.55rem; width: 100%; max-width: 500px; margin-inline: auto; border-radius: 18px; transition: box-shadow 0.5s ease, transform 0.4s ease; }
  .lc { position: relative; aspect-ratio: 1; opacity: 0; transform: scale(0.55); }
  .lc-ghost, .lc-check, .lc-person, .lc-x { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; line-height: 0; opacity: 0; transition: opacity 0.4s ease; }
  /* default = ghost (anonymous), gently floating */
  .lc-ghost { color: rgba(255, 255, 255, 0.45); opacity: 1; animation: ghostFloat 3s ease-in-out infinite; }
  .lc-check { color: var(--color-brand); }
  .lc-person { color: var(--color-brand); }
  /* CSS X — two crossed red bars struck over a ghost as it leaves */
  .lc-x::before, .lc-x::after { content: ""; position: absolute; top: 50%; left: 50%; width: 80%; height: 3px; border-radius: 2px; background: #ff5a5a; }
  .lc-x::before { transform: translate(-50%, -50%) rotate(45deg); }
  .lc-x::after { transform: translate(-50%, -50%) rotate(-45deg); }
  /* ✓ — consented (intermediate) */
  .lc.is-check .lc-ghost { opacity: 0; animation: none; }
  .lc.is-check .lc-check { opacity: 1; animation: checkPop 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.5) both; }
  /* person — identified lead (final) */
  .lc.is-lead .lc-ghost, .lc.is-lead .lc-check { opacity: 0; animation: none; }
  .lc.is-lead .lc-person { opacity: 1; animation: bigPop 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.5) both; }
  /* vanishing: ghost + X, then shrink + fade away */
  .lc.is-vanishing .lc-ghost { opacity: 1; animation: none; }
  .lc.is-vanishing .lc-x { opacity: 1; animation: xPop 0.28s ease both; }
  .lc.is-vanishing { animation: vanishOut 0.55s ease 0.22s forwards; }
  .lc.is-gone { opacity: 0 !important; }
  /* populate: staggered fade/scale in (the 100 ghosts land) */
  .leakgrid.populate .lc { animation: cellIn 0.45s ease forwards; animation-delay: calc(var(--i) * 6ms); }
  /* the 2 leads pulse when the intro ends */
  .leakgrid.pulse-greens .lc.is-lead .lc-person { animation: greenPulse 1.1s ease-in-out infinite; }
  /* finish: mint glow ring + grid pop */
  .leakgrid.recovered { box-shadow: 0 0 0 3px rgba(0, 229, 160, 0.5), 0 0 70px rgba(0, 229, 160, 0.45); animation: gridPop 0.7s ease; }
  @keyframes cellIn { to { opacity: 1; transform: scale(1); } }
  @keyframes ghostFloat { 0%, 100% { transform: translateY(0); opacity: 0.85; } 50% { transform: translateY(-3px); opacity: 1; } }
  @keyframes bigPop { 0% { transform: scale(0); } 55% { transform: scale(1.55); } 100% { transform: scale(1); } }
  @keyframes checkPop { 0% { transform: scale(0.2); } 60% { transform: scale(1.3); } 100% { transform: scale(1); } }
  @keyframes xPop { 0% { transform: scale(0); } 60% { transform: scale(1.25); } 100% { transform: scale(1); } }
  @keyframes vanishOut { to { opacity: 0; transform: scale(0.25) rotate(-8deg); } }
  @keyframes greenPulse { 0%, 100% { transform: scale(1); filter: none; } 50% { transform: scale(1.4); filter: drop-shadow(0 0 8px rgba(0, 229, 160, 0.95)); } }
  @keyframes gridPop { 0% { transform: scale(1); } 35% { transform: scale(1.05); } 100% { transform: scale(1); } }
  /* final stat reveal — fills the right-hand box */
  [data-stat]:not(.hidden) { display: flex; animation: statIn 0.7s cubic-bezier(0.2, 0.9, 0.3, 1.3) both; }
  /* end-of-intro CTA overlay on the video */
  [data-vid-cta]:not(.hidden) { display: flex; animation: statIn 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.3) both; }
  @keyframes statIn { 0% { opacity: 0; transform: translateY(10px) scale(0.94); } 100% { opacity: 1; transform: none; } }

  /* Embedded end-of-video demo form — DARK + compact, only Trade + Name + Email.
     The only readability bug in the dark section is the inputs' hardcoded
     bg-white (white text on white); everything else is already light via
     section-dark, so we just re-skin the inputs dark and hide two fields. */
  [data-demo-form] :global(.cr-demo-card) { background: rgba(255, 255, 255, 0.04); border-color: rgba(255, 255, 255, 0.12); padding: 0.9rem 1rem; border-radius: 0.85rem; }
  [data-demo-form] :global(.cr-demo-card h3) { font-size: 1.1rem; }
  [data-demo-form] :global(.cr-demo-card > p) { font-size: 0.74rem; line-height: 1.35; margin-top: 0.25rem; }
  [data-demo-form] :global(.cr-demo-form) { margin-top: 0.7rem; }
  [data-demo-form] :global(.cr-demo-form > * + *) { margin-top: 0.6rem !important; }
  [data-demo-form] :global(.cr-demo-form label > span) { font-size: 0.72rem; margin-bottom: 0.15rem; }
  [data-demo-form] :global(.cr-demo-form input), [data-demo-form] :global(.cr-demo-form select) {
    background: rgba(255, 255, 255, 0.06) !important; color: #fff !important;
    border-color: rgba(255, 255, 255, 0.16) !important; padding: 0.45rem 0.6rem !important; font-size: 0.82rem;
  }
  [data-demo-form] :global(.cr-demo-form input::placeholder) { color: rgba(255, 255, 255, 0.4); }
  [data-demo-form] :global(.cr-demo-form select option) { color: #0a1628; }
  [data-demo-form] :global(.cr-demo-form .grid) { grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  /* keep only Name (1) + Email (2); hide Business name (3) + Phone (4) */
  [data-demo-form] :global(.cr-demo-form .grid > label:nth-child(3)),
  [data-demo-form] :global(.cr-demo-form .grid > label:nth-child(4)) { display: none; }
  [data-demo-form] :global(.cr-demo-form label.flex) { font-size: 0.7rem; }
  [data-demo-form] :global(.cr-demo-form .cf-turnstile) { display: none; }  /* hide the bulky light Turnstile box in the compact dark embed */
  [data-demo-form] :global(.cr-demo-form button[type="submit"]) { padding: 0.55rem 1rem !important; font-size: 0.82rem; }
  [data-demo-form] :global(.cr-demo-form > p:last-child) { display: none; }  /* drop the fine print in the compact embed */

  @media (prefers-reduced-motion: reduce) {
    .lc { opacity: 1; transform: none; }
    .lc-ghost, .lc-check, .lc-person, .lc-x { transition: none; }
    .leakgrid.populate .lc, .lc-ghost, .lc.is-check .lc-check, .lc.is-lead .lc-person, .lc.is-vanishing, .lc.is-vanishing .lc-x, .leakgrid.pulse-greens .lc.is-lead .lc-person, .leakgrid.recovered, [data-stat]:not(.hidden), [data-vid-cta]:not(.hidden) { animation: none; }
  }
</style>
