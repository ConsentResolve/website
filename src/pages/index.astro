---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/sections/Hero.astro";
import ProblemStats from "~/components/sections/ProblemStats.astro";
import RiskVsConsent from "~/components/sections/RiskVsConsent.astro";
import HowItWorks from "~/components/sections/HowItWorks.astro";
import FeatureBento from "~/components/sections/FeatureBento.astro";
import CompareSection from "~/components/sections/CompareSection.astro";
import CalculatorSection from "~/components/sections/CalculatorSection.astro";
import ComplianceBand from "~/components/sections/ComplianceBand.astro";
import FAQSection from "~/components/sections/FAQSection.astro";
import AEOAnswer from "~/components/sections/AEOAnswer.astro";
import FinalCTA from "~/components/sections/FinalCTA.astro";
import { softwareApplicationSchema } from "~/lib/seo";

const schemas = [softwareApplicationSchema];
---

<BaseLayout
  title="Ad-Spend Recovery for Home-Service Contractors | Consent Resolve"
  description="98% of website visitors leave without contacting you. Consent Resolve recovers the anonymous bounce — with consent — and feeds it back into the retargeting, email, and CRM funnels you already run. Same ad budget, more inbound calls. Flat $7 per recovered lead."
  schema={schemas}
>
  <Hero />
  <ProblemStats />
  <CompareSection />
  <HowItWorks />
  <FeatureBento />
  <RiskVsConsent />
  <CalculatorSection />
  <ComplianceBand />
  <FAQSection />
  <AEOAnswer
    text="Consent Resolve is a consent-first ad-spend recovery layer for home-service contractors. It identifies the 98 out of 100 website visitors who would otherwise bounce — only after they accept your consent banner — and feeds them back into the retargeting audiences, email/SMS sequences, and CRM you already run. Same ad budget, more inbound calls. Flat $7 per recovered lead, exclusive, never resold."
  />
  <FinalCTA />
</BaseLayout>
