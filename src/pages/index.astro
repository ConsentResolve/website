---
/**
 * / — Live homepage (StoryBrand SB7).
 *
 * Spine:
 *   1. CHARACTER       — the reader's business (the hero of the story)
 *   2. PROBLEM         — external (98% bounce), internal (paying twice),
 *                        philosophical (ad budget shouldn't evaporate)
 *   3. GUIDE           — Consent Resolve, with empathy + authority
 *   4. PLAN            — five illustrated steps (HowItWorks)
 *   5. DIRECT CTA      — "Activate your account"
 *   6. TRANSITIONAL    — "See how it works"
 *   7. AVOIDS FAILURE  — what happens if you do nothing
 *   8. ENDS IN SUCCESS — same ad budget, more inbound calls
 *
 * Voice locked to /style-guide/voice/.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/sections/Hero.astro";
import HowItWorks from "~/components/sections/HowItWorks.astro";
import PrivacyChallenge from "~/components/sections/PrivacyChallenge.astro";
import FAQSection from "~/components/sections/FAQSection.astro";
import AEOAnswer from "~/components/sections/AEOAnswer.astro";
import FinalCTA from "~/components/sections/FinalCTA.astro";
import Badge from "~/components/ui/Badge.astro";
import Button from "~/components/ui/Button.astro";
import Sparkline from "~/components/ui/Sparkline.astro";
import StakeCard from "~/components/ui/StakeCard.astro";
import PillarCard from "~/components/ui/PillarCard.astro";

import {
  organizationSchema,
  softwareApplicationSchema,
  websiteSchema,
  faqSchema,
} from "~/lib/seo";

import {
  IconArrowRight, IconCheck, IconLock, IconUserCheck, IconBolt,
  IconUserOff, IconAlertTriangle,
  IconShieldCheck, IconPlugConnected, IconClipboardCheck,
  IconRefresh, IconMessage, IconBellRinging,
  IconX, IconCircleCheck, IconEye, IconBuilding,
} from "@tabler/icons-react";

// Homepage FAQ schema — single source shared with <FAQSection> so the
// rendered answers and the FAQPage JSON-LD can never drift.
import { HOMEPAGE_FAQS } from "~/data/homepageFaqs";

const schemas = [
  organizationSchema,
  websiteSchema,
  softwareApplicationSchema,
  faqSchema(HOMEPAGE_FAQS),
];

const aeoText =
  "Consent Resolve is a consent-first visitor-identification layer for any website. It identifies visitors who would otherwise bounce anonymous — only after they accept your consent banner — and feeds them back into the retargeting audiences, email sequences, and CRM you already run. Same marketing spend, more pipeline. Exclusive, never resold.";

// Tiny illustrative spark for the compact product peek (NOT a claim)
const peekSpark = [3, 5, 4, 7, 6, 9, 8, 11, 10, 14, 13, 17, 18];
---

<BaseLayout
  ogImage="/og/home.png"
  title="Consent Resolve · Identify Site Visitors, Recover Pipeline"
  ogTitle="98% of your site visitors leave without a name. Fix that."
  description="Recover the ~98% of visitors who leave your site without a name — with consent — into the retargeting, email, and CRM you already run."
  schema={schemas}
>
  <!-- ============================================================== -->
  <!-- 1. HERO — character + one-liner + 2 CTAs                      -->
  <!--    StoryBrand: name the audience, name the problem, hint at   -->
  <!--    the win. Direct CTA + transitional CTA.                    -->
  <!-- ============================================================== -->
  <Hero
    eyebrow="For teams running real traffic"
    title="Turn Anonymous Visitors"
    titleAccent="Into Real Pipeline."
    subhead="Most of the visitors you pay for bounce without a trace. Consent Resolve recovers them — name and email, only after they consent — and feeds them straight into the retargeting, email, and CRM you already run. Same spend. More pipeline. Yours alone, never resold."
    ctaLabel="Activate your account"
    panelKind="illustration"
    panelSrc="/illustrations/hero/protagonist.svg"
    panelAlt="A business professional walking beside a large phone showing a recovered contact with a checkmark."
    showTrustLine={false}
    compact={true}
  />

  <!-- ============================================================== -->
  <!-- 1.5. THE PLAN — HowItWorks (5-step illustrated StepFlow).      -->
  <!--      Single source of truth for the recovery flow — see        -->
  <!--      src/components/sections/HowItWorks.astro and              -->
  <!--      /style-guide/how-it-works/.                               -->
  <!-- ============================================================== -->
  <HowItWorks />

  <!-- ============================================================== -->
  <!-- 2. THE STAKES — external / internal / philosophical problem   -->
  <!-- ============================================================== -->
  <section class="section section-dark relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/10 blur-[120px]"></div>

    <div class="container-content relative">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <Badge tone="warning" variant="soft" surface="dark" size="md" uppercase>The leak you're paying for</Badge>
        <h2 class="display-2 mt-5 text-white">
          Your traffic costs real money.<br/>
          <span class="text-[color:var(--color-mint-400)]">Then most of it walks away.</span>
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-300">
          Every channel you run — search, social, SEO — drops visitors on your site. Almost all of them leave without saying a word, and whatever you spent to bring them is gone with them.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        <StakeCard
          Icon={IconUserOff}
          tone="danger"
          surface="dark"
          stat={98}
          statSuffix="%"
          label="Leave without a trace"
          body="Of every 100 visitors your marketing sends, roughly 98 leave without giving you any way to reach them again."
          sourceHref="/stats/#anonymous-traffic"
        />
        <StakeCard
          Icon={IconAlertTriangle}
          tone="neutral"
          surface="dark"
          stat="87"
          statSuffix="s"
          label="Average time before they leave"
          body="That's the window. Miss it, and whatever you spent to bring them is gone — no name, no email, no second chance."
          sourceHref="/stats/#anonymous-traffic"
        />
        <StakeCard
          Icon={IconRefresh}
          tone="brand"
          surface="dark"
          stat={26}
          statSuffix="%"
          label="Better with fast follow-up"
          body="Visitors who get a timely, relevant follow-up convert at dramatically higher rates than a cold first touch. The recovery has to happen fast."
          sourceHref="/stats/#recovery-works"
        />
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 3. MEET YOUR GUIDE — empathy + authority                      -->
  <!-- ============================================================== -->
  <section class="section">
    <div class="container-content">
      <div class="mx-auto max-w-4xl">
        <div class="grid items-center gap-12 md:grid-cols-[1fr_1.2fr]">
          <div>
            <Badge tone="brand" variant="soft" size="md" uppercase>Built by people who watched this happen</Badge>
            <h2 class="display-2 mt-5 text-[color:var(--color-ink)]">
              You're not the problem.<br/>
              <span class="text-[color:var(--color-brand-pressed)]">The plumbing is.</span>
            </h2>
            <p class="mt-5 text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">
              We've watched marketing teams spend on paid acquisition, then lose most of that traffic the moment it bounces anonymous — no way to follow up, retarget, or even know it happened. That's broken. So we built the layer that fixes it.
            </p>
            <p class="mt-4 text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">
              Consent Resolve sits on top of every channel you already run. We don't compete with your marketing — we rescue the visitors it already paid to send you.
            </p>
          </div>

          <ul class="grid grid-cols-2 gap-3">
            <li class="rounded-xl bg-[color:var(--color-bg-alt)] p-5 ring-1 ring-inset ring-[color:var(--color-rule)]">
              <span class="inline-flex size-9 items-center justify-center rounded-lg bg-[color:var(--color-brand-soft)]">
                <IconShieldCheck size={18} stroke={1.75} color="#0A1628" />
              </span>
              <p class="mt-3 font-display text-sm font-bold tracking-tight text-[color:var(--color-ink)]">Consent-first by design</p>
              <p class="mt-1 text-[13px] leading-relaxed text-[color:var(--color-ink-2)]">No data without a yes. Audit-logged on every reveal.</p>
            </li>
            <li class="rounded-xl bg-[color:var(--color-bg-alt)] p-5 ring-1 ring-inset ring-[color:var(--color-rule)]">
              <span class="inline-flex size-9 items-center justify-center rounded-lg bg-[color:var(--color-brand-soft)]">
                <IconClipboardCheck size={18} stroke={1.75} color="#0A1628" />
              </span>
              <p class="mt-3 font-display text-sm font-bold tracking-tight text-[color:var(--color-ink)]">Works with any traffic</p>
              <p class="mt-1 text-[13px] leading-relaxed text-[color:var(--color-ink-2)]">B2B, e-commerce, local — if you have a website, it works.</p>
            </li>
            <li class="rounded-xl bg-[color:var(--color-bg-alt)] p-5 ring-1 ring-inset ring-[color:var(--color-rule)]">
              <span class="inline-flex size-9 items-center justify-center rounded-lg bg-[color:var(--color-brand-soft)]">
                <IconPlugConnected size={18} stroke={1.75} color="#0A1628" />
              </span>
              <p class="mt-3 font-display text-sm font-bold tracking-tight text-[color:var(--color-ink)]">Drops into your stack</p>
              <p class="mt-1 text-[13px] leading-relaxed text-[color:var(--color-ink-2)]">HubSpot, Salesforce, Pipedrive, Klaviyo, or any webhook.</p>
            </li>
            <li class="rounded-xl bg-[color:var(--color-bg-alt)] p-5 ring-1 ring-inset ring-[color:var(--color-rule)]">
              <span class="inline-flex size-9 items-center justify-center rounded-lg bg-[color:var(--color-brand-soft)]">
                <IconLock size={18} stroke={1.75} color="#0A1628" />
              </span>
              <p class="mt-3 font-display text-sm font-bold tracking-tight text-[color:var(--color-ink)]">Exclusive, always</p>
              <p class="mt-1 text-[13px] leading-relaxed text-[color:var(--color-ink-2)]">Never resold. Never shared. One consent, one company — you.</p>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 5. PRODUCT PEEK — tight, NOT a full dashboard chrome          -->
  <!-- ============================================================== -->
  <section class="section bg-[color:var(--color-bg-alt)]">
    <div class="container-content">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <Badge tone="brand" variant="soft" size="md" uppercase>A look at what lands in your hands</Badge>
        <h2 class="display-2 mt-5 text-[color:var(--color-ink)]">
          What happens after<br/>
          <span class="text-[color:var(--color-brand-pressed)]">they say yes.</span>
        </h2>
      </div>

      <div class="mx-auto grid max-w-5xl gap-5 md:grid-cols-3">
        <div class="rounded-2xl bg-white p-6 ring-1 ring-inset ring-[color:var(--color-rule)] shadow-[0_18px_36px_-22px_rgba(10,22,40,0.18)]">
          <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">Real name. Real email.</p>
          <div class="mt-4 flex items-center gap-3">
            <span class="inline-flex size-11 items-center justify-center rounded-full bg-[color:var(--color-brand)] font-display text-sm font-black text-[color:var(--color-navy-900)]">JK</span>
            <div class="flex-1">
              <p class="font-display text-sm font-bold tracking-tight text-[color:var(--color-ink)]">Jordan K.</p>
              <p class="text-[12px] text-[color:var(--color-ink-muted)]">Enterprise plan inquiry · Austin, TX</p>
            </div>
            <span class="rounded-full bg-[color:var(--color-brand-soft)] px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-brand-pressed)]">Consented</span>
          </div>
          <div class="mt-5 grid grid-cols-2 gap-2 border-t border-[color:var(--color-rule)] pt-4 text-[12px]">
            <div class="min-w-0">
              <p class="text-[color:var(--color-ink-muted)]">Email</p>
              <p class="truncate font-mono text-[color:var(--color-ink)]">j****k@gmail.com</p>
            </div>
            <div>
              <p class="text-[color:var(--color-ink-muted)]">Last seen</p>
              <p class="font-semibold text-[color:var(--color-ink)]">6 minutes ago</p>
            </div>
          </div>
          <p class="mt-4 text-[12px] leading-relaxed text-[color:var(--color-ink-2)]">
            Read your Pricing page twice. Lingered on the FAQ.
          </p>
        </div>

        <div class="rounded-2xl bg-[color:var(--color-navy-900)] p-6 text-white ring-1 ring-inset ring-white/10 shadow-[0_18px_36px_-22px_rgba(0,0,0,0.4)]">
          <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-mint-400)]">Recovered this month</p>
          <p class="mt-4 font-display text-6xl font-black leading-none tracking-tight tabular-nums text-white">147</p>
          <p class="mt-3 text-[13px] text-slate-300">Across Google, Meta, and SEO traffic.</p>
          <div class="mt-5 rounded-xl bg-white/5 p-3 ring-1 ring-inset ring-white/10">
            <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Last 14 days</p>
            <div class="mt-2 [&_svg]:!w-full [&_svg]:!h-12">
              <Sparkline data={peekSpark} width={260} height={48} tone="brand" fill={true} />
            </div>
          </div>
        </div>

        <div class="rounded-2xl bg-white p-6 ring-1 ring-inset ring-[color:var(--color-rule)] shadow-[0_18px_36px_-22px_rgba(10,22,40,0.18)]">
          <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">Lands in the stack you run</p>
          <ul class="mt-4 space-y-2.5">
            {[
              { name: "Salesforce",     status: "Pushed · 6m ago" },
              { name: "HubSpot",        status: "Pushed · 6m ago" },
              { name: "Klaviyo",        status: "Synced · 6m ago" },
              { name: "Meta ads audience", status: "Added · 6m ago" },
            ].map((row) => (
              <li class="flex items-center justify-between rounded-lg bg-[color:var(--color-bg-alt)] px-3 py-2.5 ring-1 ring-inset ring-[color:var(--color-rule)]">
                <span class="flex items-center gap-2.5">
                  <IconCircleCheck size={16} stroke={2.25} color="#00A86E" />
                  <span class="text-[13px] font-semibold text-[color:var(--color-ink)]">{row.name}</span>
                </span>
                <span class="text-[11px] text-[color:var(--color-ink-muted)]">{row.status}</span>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-[12px] leading-relaxed text-[color:var(--color-ink-2)]">
            Every recovery hits your CRM, your ad audiences, and your email tool — at the same time.
          </p>
        </div>
      </div>

      <p class="mx-auto mt-6 max-w-2xl text-center text-[12px] text-[color:var(--color-ink-muted)]">
        Names and emails shown are illustrative — your dashboard fills with real visitors from your traffic.
      </p>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 6. WHAT YOU GET — the 3 pillars                                -->
  <!-- ============================================================== -->
  <section class="section">
    <div class="container-content">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <Badge tone="brand" variant="soft" size="md" uppercase>What you get</Badge>
        <h2 class="display-2 mt-5 text-[color:var(--color-ink)]">
          Three jobs. One layer.<br/>
          <span class="text-[color:var(--color-brand-pressed)]">Same spend, more pipeline.</span>
        </h2>
      </div>

      <div class="mx-auto grid max-w-5xl gap-5 md:grid-cols-3">
        <PillarCard
          Icon={IconRefresh}
          eyebrow="Recovery"
          title="Recover the 98% that bounce."
          body="The traffic you already paid for — Google, Meta, SEO, and more. We identify the consented visitors who'd otherwise leave with no trace."
          href="/features/#ad-recovery"
          cta="See the recovery features"
        />
        <PillarCard
          Icon={IconMessage}
          eyebrow="Into your funnel"
          title="Drop into the funnel you already run."
          body="Recovered visitors flow into your retargeting audiences, email sequences, and CRM. No new app to babysit."
          href="/features/#funnel-insertion"
          cta="See the funnel features"
        />
        <PillarCard
          Icon={IconBellRinging}
          eyebrow="Warm inbound"
          title="Turn the bounce into a warm inbound."
          body="The recovered visitor comes back on their own time — through your funnel — and reaches out warm. Not a cold outbound."
          href="/features/#inbound-call"
          cta="See the inbound features"
        />
      </div>

      <div class="mt-10 text-center">
        <a
          href="/features/"
          class="inline-flex items-center gap-2 text-[12px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-brand-pressed)] hover:text-[color:var(--color-ink)]"
        >
          See every feature
          <IconArrowRight size={12} stroke={2.5} />
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 7. AVOID FAILURE — what happens if you do nothing             -->
  <!-- ============================================================== -->
  <section class="section section-dark relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -right-32 -bottom-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/12 blur-[120px]"></div>

    <div class="container-content relative">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <Badge tone="brand" variant="soft" surface="dark" size="md" uppercase>What happens next</Badge>
        <h2 class="display-2 mt-5 text-white">
          The next 30 days, two ways.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-300">
          Pick the column you'd rather live in.
        </p>
      </div>

      <div class="mx-auto grid max-w-4xl gap-5 md:grid-cols-2">
        <div class="rounded-2xl bg-white/[0.03] p-7 ring-1 ring-inset ring-white/10">
          <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-red-300/80">Without Consent Resolve</p>
          <h3 class="mt-3 font-display text-xl font-bold tracking-tight text-white">Same leak, more bills.</h3>
          <ul class="mt-5 space-y-3 text-[14px] text-slate-300">
            <li class="flex items-start gap-2.5"><IconX size={18} stroke={2.5} color="#fca5a5" class="mt-0.5 shrink-0" /> 98 out of every 100 visitors still walk off anonymous.</li>
            <li class="flex items-start gap-2.5"><IconX size={18} stroke={2.5} color="#fca5a5" class="mt-0.5 shrink-0" /> Your CAC keeps climbing while conversion stays flat.</li>
            <li class="flex items-start gap-2.5"><IconX size={18} stroke={2.5} color="#fca5a5" class="mt-0.5 shrink-0" /> Your retargeting audiences sit underfed.</li>
            <li class="flex items-start gap-2.5"><IconX size={18} stroke={2.5} color="#fca5a5" class="mt-0.5 shrink-0" /> You have no idea who almost converted and left.</li>
          </ul>
        </div>

        <div class="rounded-2xl bg-[color:var(--color-brand-soft)]/10 p-7 ring-1 ring-inset ring-[color:var(--color-brand)]/40">
          <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-mint-400)]">With Consent Resolve</p>
          <h3 class="mt-3 font-display text-xl font-bold tracking-tight text-white">More pipeline, same spend.</h3>
          <ul class="mt-5 space-y-3 text-[14px] text-slate-200">
            <li class="flex items-start gap-2.5"><IconCircleCheck size={18} stroke={2.25} color="#00E5A0" class="mt-0.5 shrink-0" /> Recovered visitors flow into the funnel you already run.</li>
            <li class="flex items-start gap-2.5"><IconCircleCheck size={18} stroke={2.25} color="#00E5A0" class="mt-0.5 shrink-0" /> Exclusive, always — never resold, never shared.</li>
            <li class="flex items-start gap-2.5"><IconCircleCheck size={18} stroke={2.25} color="#00E5A0" class="mt-0.5 shrink-0" /> Retargeting audiences and email lists stay fed.</li>
            <li class="flex items-start gap-2.5"><IconCircleCheck size={18} stroke={2.25} color="#00E5A0" class="mt-0.5 shrink-0" /> Warm inbound instead of cold outbound chases.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 8. SUCCESS — the headline payoff                              -->
  <!-- ============================================================== -->
  <section class="section">
    <div class="container-content">
      <div class="mx-auto max-w-3xl text-center">
        <Badge tone="brand" variant="soft" size="md" uppercase>What success looks like</Badge>
        <h2 class="mx-auto mt-6 max-w-3xl font-display text-4xl font-black leading-[1.05] tracking-tight text-[color:var(--color-ink)] md:text-6xl">
          Same spend.<br/>
          <span class="text-[color:var(--color-brand-pressed)]">More pipeline.</span>
        </h2>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-[color:var(--color-ink-2)]">
          You stop losing the traffic you already paid for. You stop guessing who almost converted. You spend your time on warm inbound — people who already saw you in their inbox and on their feed.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 9. ACTIVATE — pricing + the direct CTA                         -->
  <!-- ============================================================== -->
  <section class="section section-dark relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/15 blur-[120px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-32 -bottom-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/10 blur-[120px]"></div>

    <div class="container-content relative">
      <div class="mx-auto max-w-4xl">
        <div class="rounded-3xl bg-white/[0.04] p-8 ring-1 ring-inset ring-white/10 backdrop-blur-sm md:p-12">
          <div class="grid items-center gap-10 md:grid-cols-[1.1fr_1fr]">
            <div>
              <Badge tone="brand" variant="soft" surface="dark" size="md" uppercase>Activate today</Badge>
              <h2 class="display-2 mt-5 text-white">
                Custom pricing.<br/>
                <span class="text-[color:var(--color-mint-400)]">Yours alone. Never resold.</span>
              </h2>
              <p class="mt-5 text-[15px] leading-relaxed text-slate-300">
                No contract, built around your traffic. Paste one line of code. Live in about 10 minutes.
              </p>

              <ul class="mt-6 space-y-2.5 text-[14px] text-slate-200">
                <li class="flex items-start gap-2.5"><IconCheck size={18} stroke={2.5} color="#00E5A0" class="mt-0.5 shrink-0" /> Exclusive — one consent, one company.</li>
                <li class="flex items-start gap-2.5"><IconCheck size={18} stroke={2.5} color="#00E5A0" class="mt-0.5 shrink-0" /> Lands in HubSpot, Salesforce, Pipedrive, Klaviyo, or any webhook.</li>
                <li class="flex items-start gap-2.5"><IconCheck size={18} stroke={2.5} color="#00E5A0" class="mt-0.5 shrink-0" /> Consent-first by design — your privacy policy stays handled.</li>
              </ul>
            </div>

            <div class="rounded-2xl bg-[color:var(--color-navy-900)] p-7 ring-1 ring-inset ring-white/10 shadow-[0_30px_60px_-30px_rgba(0,0,0,0.6)]">
              <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-mint-400)]">Priced around your traffic</p>
              <p class="mt-4 text-[15px] leading-relaxed text-slate-200">
                No public per-unit rate — pricing scales with your traffic and needs.
              </p>
              <p class="mt-3 text-[13px] leading-relaxed text-slate-300">
                Only billed when a consented visitor becomes a real, identified record in your funnel.
              </p>

              <Button
                href="https://dashboard.consentresolve.com/register"
                variant="primary"
                size="lg"
                class="mt-6 !w-full !justify-center"
              >
                <IconBolt size={18} stroke={2.25} />
                Activate your account
                <IconArrowRight size={18} stroke={2.25} />
              </Button>

              <a
                href="/how-it-works/"
                class="mt-3 inline-flex w-full items-center justify-center gap-1.5 text-[12px] font-bold uppercase tracking-[0.14em] text-slate-400 hover:text-white"
              >
                <IconEye size={12} stroke={2} />
                Or see how it works first
              </a>

