---
/**
 * /index-v1/ — Homepage v1 BACKUP (the original homepage layout
 * promoted-from version).
 *
 * Kept here as a safety net after the StoryBrand-driven v2 became the
 * primary homepage. To restore v1 as the live homepage:
 *   1. Copy this file's body into src/pages/index.astro
 *   2. Remove the noindex banner + flag
 *   3. Delete src/pages/index-v1.astro (or shuffle file names)
 *
 * Served at /index-v1/ with `noindex,follow` so it stays accessible
 * for restore but never gets indexed alongside the live `/`.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/sections/Hero.astro";
import ProblemStats from "~/components/sections/ProblemStats.astro";
import RiskVsConsent from "~/components/sections/RiskVsConsent.astro";
import HowItWorks from "~/components/sections/HowItWorks.astro";
import FeatureBento from "~/components/sections/FeatureBento.astro";
import CompareSection from "~/components/sections/CompareSection.astro";
import ProductShowcase from "~/components/sections/ProductShowcase.astro";
import ComplianceBand from "~/components/sections/ComplianceBand.astro";
import FAQSection from "~/components/sections/FAQSection.astro";
import AEOAnswer from "~/components/sections/AEOAnswer.astro";
import FinalCTA from "~/components/sections/FinalCTA.astro";
import { softwareApplicationSchema } from "~/lib/seo";

const schemas = [softwareApplicationSchema];
---

<BaseLayout
  title="Ad-Spend Recovery for Home-Service Contractors | Consent Resolve"
  description="98% of website visitors leave without contacting you. Consent Resolve recovers the anonymous bounce — with consent — and feeds it back into the retargeting, email, and CRM funnels you already run. Same ad budget, more inbound calls. Flat $7 per recovered lead."
  noindex={true}
  schema={schemas}
>
  <!-- Backup banner — visible reminder this is the archived v1, not live -->
  <div class="border-b border-amber-200 bg-amber-50">
    <div class="container-content py-3 text-center text-xs font-bold uppercase tracking-[0.14em] text-amber-800">
      Homepage v1 — Archived backup. Not indexed. Live homepage is at <a href="/" class="underline">/</a>.
    </div>
  </div>

  <Hero />
  <ProblemStats />
  <CompareSection />
  <HowItWorks />
  <FeatureBento />
  <RiskVsConsent />
  <ProductShowcase />
  <ComplianceBand />
  <FAQSection />
  <AEOAnswer
    text="Consent Resolve is a consent-first ad-spend recovery layer for home-service contractors. It identifies the 98 out of 100 website visitors who would otherwise bounce — only after they accept your consent banner — and feeds them back into the retargeting audiences, email/SMS sequences, and CRM you already run. Same ad budget, more inbound calls. Flat $7 per recovered lead, exclusive, never resold."
  />
  <FinalCTA />
</BaseLayout>
