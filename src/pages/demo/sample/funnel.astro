---
// Standalone "Feed your funnel" page (Step 4 of the guided tour). The consented
// lead flows into the contractor's existing marketing — CRM, retargeting, their
// own email/SMS — so the homeowner comes back and calls. Warm inbound, never
// outbound. Sample-site shell for cohesion. noindex.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>How your funnel works — Summit Home Services</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <style is:global>
      :root { --brand:#1d4ed8; --ink:#0f172a; --ink-2:#475569; --line:#e2e8f0; --bg:#fff; --bg-soft:#f8fafc; }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body { font-family: "Inter", system-ui, sans-serif; color: var(--ink); background: var(--bg); line-height: 1.55; -webkit-font-smoothing: antialiased; min-height: 100vh; display: flex; flex-direction: column; }
      .ribbon { background: #0f172a; color: #cbd5e1; font-size: 13px; text-align: center; padding: 7px 16px; display: flex; gap: 10px; align-items: center; justify-content: center; flex-wrap: wrap; }
      .ribbon strong { color: #fff; }
      .ribbon .stepchip { background: #1e293b; color: #7dd3fc; border-radius: 999px; padding: 2px 9px; font-size: 11px; font-weight: 700; }
      .wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
      header.site { display: flex; align-items: center; justify-content: space-between; padding: 16px 0; border-bottom: 1px solid var(--line); }
      .logo { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 19px; }
      .logo .mark { width: 34px; height: 34px; border-radius: 9px; background: var(--brand); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; }
      .nav { display: flex; gap: 22px; align-items: center; font-size: 15px; color: var(--ink-2); }
      .nav a { color: var(--ink-2); text-decoration: none; white-space: nowrap; }
      .nav .links { display: inline-flex; gap: 22px; align-items: center; }
      .nav .call { background: var(--brand); color: #fff; padding: 9px 16px; border-radius: 8px; font-weight: 700; }
      @media (max-width: 720px) { .nav .links { display: none; } }
      .qhero { background: linear-gradient(180deg, var(--bg-soft), #fff); padding: 22px 0; flex: 1; display: flex; align-items: center; }
      .qhero .wrap { text-align: center; }
      .tag { display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--brand); background: #eff6ff; padding: 5px 11px; border-radius: 999px; }
      .qhero h1 { font-size: 27px; font-weight: 800; margin: 10px 0 6px; }
      .qhero .lede { font-size: 15px; color: var(--ink-2); max-width: 56ch; margin: 0 auto 16px; }
      .btn { padding: 12px 22px; border-radius: 9px; font-weight: 700; font-size: 15px; text-decoration: none; display: inline-block; cursor: pointer; border: none; }
      .btn-primary { background: var(--brand); color: #fff; }
      .btn-ghost { background: #fff; color: var(--ink); border: 1px solid var(--line); }

      .funnelviz { max-width: 540px; margin: 0 auto; }
      .fv-node { border: 1px solid var(--line); border-radius: 12px; padding: 9px 14px; text-align: center; font-weight: 700; font-size: 13.5px; background: #fff; line-height: 1.25; opacity: 0; transform: translateY(8px); animation: fv-in .5s ease forwards; animation-delay: var(--d, 0s); }
      .fv-node small { display: block; font-weight: 500; color: var(--ink-2); font-size: 12px; margin-top: 3px; }
      .fv-source { background: #0a1628; color: #fff; border-color: #0a1628; }
      .fv-source small { color: #9fb0c4; }
      .fv-result { background: #ecfdf5; border-color: #6ee7b7; color: #065f46; }
      .fv-result small { color: #047857; }
      .fv-fan { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
      @media (max-width: 560px) { .fv-fan { grid-template-columns: 1fr; } }
      .fv-arrow { width: 2px; height: 14px; margin: 4px auto; background: #cbd5e1; position: relative; opacity: 0; animation: fv-in .4s ease forwards; animation-delay: var(--d, 0s); }
      .fv-arrow::after { content: "▼"; position: absolute; left: 50%; bottom: -7px; transform: translateX(-50%); color: #cbd5e1; font-size: 11px; }
      .fv-cap { text-align: center; font-size: 12px; color: var(--ink-2); margin: 2px 0; opacity: 0; animation: fv-in .4s ease forwards; animation-delay: var(--d, 0s); }
      @keyframes fv-in { to { opacity: 1; transform: none; } }
      .aha { margin: 14px auto 0; max-width: 540px; padding: 11px 14px; border-left: 4px solid #16a34a; background: #f0fdf4; border-radius: 8px; font-size: 13px; line-height: 1.5; text-align: left; }
      .actions { margin-top: 16px; display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
      footer.site { border-top: 1px solid var(--line); padding: 16px 0; color: var(--ink-2); font-size: 13px; }
    </style>
  </head>
  <body>
    <div class="ribbon">
      <span>👀 Behind the scenes — what happens after a visitor consents.</span>
      <span class="stepchip">Guided demo · Step 4 of 5</span>
    </div>

    <div class="wrap">
      <header class="site">
        <div class="logo"><span class="mark" data-mark>S</span> <span data-biz>Summit Home Services</span></div>
        <nav class="nav">
          <span class="links">
            <a data-link="/demo/sample/" href="/demo/sample/">Home</a>
            <a data-link="/demo/sample/#services" href="/demo/sample/#services">Services</a>
            <a data-link="/demo/sample/#reviews" href="/demo/sample/#reviews">Reviews</a>
            <a data-link="/demo/sample/quote/" href="/demo/sample/quote/">Free Quote</a>
          </span>
          <a class="call" data-phone href="#">Call now</a>
        </nav>
      </header>
    </div>

    <section class="qhero">
      <div class="wrap">
        <span class="tag">Feed your funnel</span>
        <h1>Now that lead goes to work.</h1>
        <p class="lede">It doesn't just sit in an inbox. The consented record flows into the marketing you already run — so the homeowner comes back on their own time and calls you.</p>

        <div class="funnelviz">
          <div class="fv-node fv-source" style="--d:0s">📥 Consented lead<small data-source>your visitor · yours alone, never resold</small></div>
          <div class="fv-arrow" style="--d:.4s"></div>
          <div class="fv-cap" style="--d:.5s">flows straight into your stack</div>
          <div class="fv-fan">
            <div class="fv-node" style="--d:.7s">🗂️ Your CRM<small>Jobber · Housecall Pro · ServiceTitan · HubSpot</small></div>
            <div class="fv-node" style="--d:.9s">🎯 Retargeting<small>your Google &amp; Meta audiences</small></div>
            <div class="fv-node" style="--d:1.1s">✉️ Email / SMS<small>your follow-up sequence</small></div>
          </div>
          <div class="fv-arrow" style="--d:1.35s"></div>
          <div class="fv-node fv-result" style="--d:1.5s">📞 They come back — and call you<small>warm inbound, on their time</small></div>
        </div>

        <div class="aha">Same consented contact, feeding the channels that already work for <span data-biz>your shop</span>. You don't cold-call anyone — they reach out to you, ready to book.</div>

        <div class="actions">
          <a class="btn btn-primary" id="continue-tour" href="/demo/sample/">Continue the tour →</a>
          <a class="btn btn-ghost" data-link="/demo/sample/" href="/demo/sample/">Replay the demo</a>
        </div>
      </div>
    </section>

    <footer class="site">
      <div class="wrap">
        <span data-biz>Summit Home Services</span> · Licensed &amp; insured · <span data-phone-text>(555) 010-0100</span>
        <div style="margin-top:6px;font-size:12px;color:#94a3b8">Fictional business for the Consent Resolve live demo.</div>
      </div>
    </footer>

    <script>
      const dt = new URLSearchParams(location.search).get("dt") || "";
      const $ = (s: string) => document.querySelector(s);
      const $all = (s: string) => Array.from(document.querySelectorAll(s));
      let lead: any = {};
      try { lead = JSON.parse(sessionStorage.getItem("cr_lead") || "{}") || {}; } catch {}

      $all("[data-link]").forEach((a) => {
        const base = (a as HTMLElement).getAttribute("data-link") || "";
        const i = base.indexOf("#");
        const path = i >= 0 ? base.slice(0, i) : base;
        const frag = i >= 0 ? base.slice(i) : "";
        (a as HTMLAnchorElement).href = path + (dt ? (path.indexOf("?") >= 0 ? "&" : "?") + "dt=" + encodeURIComponent(dt) : "") + frag;
      });
      const cont = $("#continue-tour") as HTMLAnchorElement;
      if (cont) cont.href = "/demo/sample/?dt=" + encodeURIComponent(dt) + "&resume=5";

      (async function theme() {
        try {
          const res = await fetch("/api/visit", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ dt }) });
          const data = await res.json();
          const p = data.profile || {};
          $all("[data-biz]").forEach((el) => (el.textContent = p.biz || "Summit Home Services"));
          const mk = $("[data-mark]"); if (mk) mk.textContent = (p.biz || "S").trim().charAt(0).toUpperCase();
          $all("[data-phone]").forEach((el) => ((el as HTMLAnchorElement).href = "tel:" + String(p.phone || "").replace(/[^0-9+]/g, "")));
          const pt = $("[data-phone-text]"); if (pt) pt.textContent = p.phone || "";
          const nm = lead.name || data.name;
          const src = $("[data-source]"); if (src && nm) src.textContent = nm + " · yours alone, never resold";
          document.title = `How your funnel works — ${p.biz || "Summit Home Services"}`;
        } catch {}
      })();
    </script>
  </body>
</html>
