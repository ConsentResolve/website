---
// Standalone "The math" page (Step 4 of the guided tour). Reworked to embed the
// /lead-math calculator (LeadMathStory) so the demo's proof matches the calculator
// exactly: shared leads vs Consent Resolve, head-to-head, on cost per booked job.
// Sample-site shell for cohesion. noindex.
import LeadMathStory from "~/components/ui/LeadMathStory.tsx";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>How your funnel works — Summit Home Services</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" />
    <style is:global>
      :root {
        --brand:#1d4ed8; --brand-soft:#eff6ff; --navy:#0a1628; --ink:#0f172a;
        --ink-2:#475569; --ink-3:#94a3b8; --line:#e2e8f0; --bg:#fff; --bg-soft:#f8fafc;
        --green:#16a34a; --green-soft:#ecfdf5; --green-ink:#065f46; --amber:#b45309;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body { font-family: "Inter", system-ui, sans-serif; color: var(--ink); background: var(--bg); line-height: 1.55; -webkit-font-smoothing: antialiased; min-height: 100vh; display: flex; flex-direction: column; }
            .ribbon { background: #0a1628; padding: 11px 0; border-bottom: 1px solid rgba(255,255,255,0.08); }
      .ribbon-inner { max-width: 1080px; margin: 0 auto; padding: 0 20px; display: flex; align-items: center; justify-content: space-between; gap: 14px; }
      .ribbon-brand { display: inline-flex; align-items: center; }
      .ribbon-brand img { height: 28px; width: auto; display: block; }
      .ribbon-note { color: #9fb0c4; font-size: 13px; font-weight: 600; }
      .ribbon-btn { display: inline-flex; align-items: center; gap: 6px; background: #00e5a0; color: #0a1628; font-weight: 800; font-size: 13px; padding: 9px 15px; border-radius: 8px; text-decoration: none; white-space: nowrap; }
      .ribbon-btn:hover { background: #34edb1; }
      @media (max-width: 600px) { .ribbon-note { display: none; } .ribbon-brand img { height: 23px; } .ribbon-btn { padding: 8px 12px; font-size: 12px; } }
      .wrap { max-width: 1040px; margin: 0 auto; padding: 0 20px; width: 100%; }
      header.site { display: flex; align-items: center; justify-content: space-between; padding: 16px 0; border-bottom: 1px solid var(--line); }
      .logo { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 19px; }
      .logo .mark { width: 34px; height: 34px; border-radius: 9px; background: var(--brand); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; }
      .nav { display: flex; gap: 22px; align-items: center; font-size: 15px; color: var(--ink-2); }
      .nav a { color: var(--ink-2); text-decoration: none; white-space: nowrap; }
      .nav .links { display: inline-flex; gap: 22px; align-items: center; }
      .nav .call { background: var(--brand); color: #fff; padding: 9px 16px; border-radius: 8px; font-weight: 700; text-decoration: none; }
      @media (max-width: 760px) { .nav .links { display: none; } }
      .btn { padding: 12px 22px; border-radius: 9px; font-weight: 700; font-size: 15px; text-decoration: none; display: inline-block; cursor: pointer; border: none; }
      .btn-primary { background: var(--brand); color: #fff; }
      .btn-ghost { background: #fff; color: var(--ink); border: 1px solid var(--line); }
      footer.site { border-top: 1px solid var(--line); padding: 16px 0; color: var(--ink-2); font-size: 13px; }

      /* ---------- infographic ---------- */
      .ig { padding: 30px 0 40px; }
      .ig-head { text-align: center; max-width: 60ch; margin: 0 auto 26px; }
      .tag { display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--brand); background: var(--brand-soft); padding: 5px 11px; border-radius: 999px; }
      .ig h1 { font-size: 30px; font-weight: 900; letter-spacing: -0.02em; margin: 12px 0 8px; line-height: 1.12; }
      .ig .lede { font-size: 15.5px; color: var(--ink-2); margin: 0 auto; }
      @media (max-width: 560px) { .ig h1 { font-size: 24px; } }

      /* reveal-on-scroll */
      .rv { opacity: 0; transform: translateY(14px); transition: opacity .55s ease, transform .55s ease; }
      .rv.in { opacity: 1; transform: none; }

      /* the leak: 3 problem stats */
      .leak { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin: 0 auto 8px; max-width: 760px; }
      @media (max-width: 620px) { .leak { grid-template-columns: 1fr; } }
      .stat { background: var(--bg-soft); border: 1px solid var(--line); border-radius: 14px; padding: 18px 16px; text-align: center; }
      .stat .num { font-size: 40px; font-weight: 900; letter-spacing: -0.03em; line-height: 1; color: var(--navy); font-variant-numeric: tabular-nums; }
      .stat .num.amber { color: var(--amber); }
      .stat .lab { margin-top: 7px; font-size: 13px; color: var(--ink-2); font-weight: 600; }
      .stat .src { display: inline-block; margin-top: 6px; font-size: 10.5px; color: var(--ink-3); text-decoration: none; }
      .stat .src:hover { color: var(--brand); text-decoration: underline; }
      .leak-cap { text-align: center; font-size: 13px; color: var(--ink-2); margin: 6px auto 30px; max-width: 56ch; }
      .leak-cap strong { color: var(--ink); }

      /* the pipeline */
      .flow { position: relative; max-width: 880px; margin: 0 auto; }
      .pnode { position: relative; z-index: 2; border-radius: 14px; padding: 14px 18px; text-align: center; background: #fff; border: 1px solid var(--line); box-shadow: 0 8px 20px -14px rgba(8,15,30,.25); }
      .pnode .t { font-weight: 800; font-size: 15px; }
      .pnode .s { font-size: 12.5px; color: var(--ink-2); margin-top: 3px; }
      .pnode.source { background: var(--navy); color: #fff; border-color: var(--navy); max-width: 360px; margin: 0 auto; }
      .pnode.source .s { color: #9fb0c4; }
      .pnode.source .chip { display: inline-block; margin-top: 8px; font-size: 11px; font-weight: 800; letter-spacing: .04em; background: rgba(255,255,255,.12); color: #bfe3ff; border-radius: 999px; padding: 3px 10px; }
      .pnode.result { background: var(--green-soft); border-color: #6ee7b7; color: var(--green-ink); max-width: 460px; margin: 0 auto; }
      .pnode.result .t { font-size: 17px; }
      .pnode.result .s { color: var(--green); }

      .spine { width: 3px; background: linear-gradient(#cbd5e1, #cbd5e1); margin: 0 auto; position: relative; }
      .spine.short { height: 26px; }
      /* travelling lead packet */
      .packet { position: absolute; left: 50%; top: 0; width: 14px; height: 14px; margin-left: -7px; border-radius: 50%; background: var(--brand); box-shadow: 0 0 0 5px rgba(29,78,216,.18); }
      .flow.go .packet.run { animation: travel 1.5s ease-in-out infinite; }
      @keyframes travel { 0% { top: -4px; opacity: 0; } 12% { opacity: 1; } 88% { opacity: 1; } 100% { top: calc(100% + 4px); opacity: 0; } }

      .lanes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin: 10px 0; }
      @media (max-width: 720px) { .lanes { grid-template-columns: 1fr; } }
      .lane { border: 1px solid var(--line); border-radius: 14px; background: #fff; padding: 16px; box-shadow: 0 8px 20px -16px rgba(8,15,30,.22); }
      .lane .ico { width: 38px; height: 38px; border-radius: 10px; background: var(--brand-soft); display: flex; align-items: center; justify-content: center; font-size: 19px; margin-bottom: 10px; }
      .lane h3 { margin: 0; font-size: 15px; font-weight: 800; }
      .lane .tools { font-size: 12px; color: var(--ink-3); margin-top: 3px; font-weight: 600; }
      .lane .metric { margin-top: 12px; padding-top: 12px; border-top: 1px dashed var(--line); }
      .lane .metric .mnum { font-size: 26px; font-weight: 900; color: var(--brand); letter-spacing: -0.02em; line-height: 1; font-variant-numeric: tabular-nums; }
      .lane .metric .mlab { font-size: 12px; color: var(--ink-2); margin-top: 4px; line-height: 1.4; }
      .lane .metric .src { font-size: 10.5px; color: var(--ink-3); text-decoration: none; }
      .lane .metric .src:hover { color: var(--brand); text-decoration: underline; }

      .converge { text-align: center; font-size: 12px; color: var(--ink-2); margin: 2px 0 8px; }

      /* additive cost line */
      .cost { margin: 26px auto 0; max-width: 700px; background: var(--navy); color: #e2e8f0; border-radius: 16px; padding: 20px 22px; display: flex; gap: 18px; align-items: center; flex-wrap: wrap; justify-content: center; text-align: center; }
      .cost .big { font-size: 34px; font-weight: 900; color: #fff; letter-spacing: -0.02em; }
      .cost .big small { font-size: 14px; font-weight: 700; color: #9fb0c4; }
      .cost p { margin: 0; font-size: 13.5px; max-width: 42ch; text-align: left; }
      .cost p strong { color: #fff; }
      @media (max-width: 520px) { .cost p { text-align: center; } }

      .sources { text-align: center; font-size: 11px; color: var(--ink-3); margin: 18px auto 0; max-width: 70ch; }
      .sources a { color: var(--ink-2); text-decoration: underline; text-underline-offset: 2px; }

      .actions { margin-top: 22px; display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }

      @media (prefers-reduced-motion: reduce) {
        .rv { opacity: 1; transform: none; transition: none; }
        .flow.go .packet.run { animation: none; }
        .packet { display: none; }
      }
    </style>
  </head>
  <body>
    <div class="ribbon">
      <div class="ribbon-inner">
        <a class="ribbon-brand" href="https://consentresolve.com/" aria-label="Consent Resolve home"><img src="/crnewlogo.svg" alt="Consent Resolve" width="184" height="28" /></a>
        <span class="ribbon-note">You’re viewing a live interactive demo</span>
        <a class="ribbon-btn" href="https://consentresolve.com/">← Return to consentresolve.com</a>
      </div>
    </div>

    <div class="wrap site-wrap">
      <header class="site">
        <div class="logo"><span class="mark" data-mark>S</span> <span data-biz>Summit Home Services</span></div>
        <nav class="nav">
          <span class="links">
            <a data-link="/demo/sample/" href="/demo/sample/">Home</a>
            <a data-link="/demo/sample/#services" href="/demo/sample/#services">Services</a>
            <a data-link="/demo/sample/#reviews" href="/demo/sample/#reviews">Reviews</a>
            <a data-link="/demo/sample/quote/" href="/demo/sample/quote/">Free Quote</a>
          </span>
        </nav>
      </header>
    </div>

    <section class="ig">
      <div class="wrap">
        <div class="ig-head rv">
          <span class="tag">Step 4 · The math</span>
          <h1>So what does a lead actually cost you?</h1>
          <p class="lede">Shared leads get sold to four contractors at once, so most never book. Recover the traffic you already have instead — exclusive, at $7. Here's the same job, both ways.</p>
        </div>

        <!-- The calculator (same as /lead-math): shared vs Consent, cost per booked job -->
        <div style="margin-top:10px">
          <LeadMathStory client:visible showCta={false} />
        </div>

        <p class="sources rv">
          Lead costs are researched per-trade averages; close rates are typical estimates; revenue is gross, before labor &amp; materials. Only the $7 is fixed. Sourced figures: <a href="https://consentresolve.com/stats/" target="_blank" rel="noopener">consentresolve.com/stats</a>.
        </p>

        <div class="actions rv">
          <a class="btn btn-primary" id="continue-tour" href="/demo/sample/">Continue the tour →</a>
          <a class="btn btn-ghost" data-link="/demo/sample/" href="/demo/sample/">Replay the demo</a>
        </div>
      </div>
    </section>

    <footer class="site">
      <div class="wrap">
        <span data-biz>Summit Home Services</span> · Licensed &amp; insured · <span data-phone-text>(555) 010-0100</span>
        <div style="margin-top:6px;font-size:12px;color:#94a3b8">Fictional business for the Consent Resolve live demo.</div>
      </div>
    </footer>

    <script>
      const dt = new URLSearchParams(location.search).get("dt") || "";
      const $ = (s: string) => document.querySelector(s);
      const $all = (s: string) => Array.from(document.querySelectorAll(s));
      let lead: any = {};
      try { lead = JSON.parse(sessionStorage.getItem("cr_lead") || "{}") || {}; } catch {}

      // Preserve the dt token across sample-site links; continue → resume step 5.
      $all("[data-link]").forEach((a) => {
        const base = (a as HTMLElement).getAttribute("data-link") || "";
        const i = base.indexOf("#");
        const path = i >= 0 ? base.slice(0, i) : base;
        const frag = i >= 0 ? base.slice(i) : "";
        (a as HTMLAnchorElement).href = path + (dt ? (path.indexOf("?") >= 0 ? "&" : "?") + "dt=" + encodeURIComponent(dt) : "") + frag;
      });
      const cont = $("#continue-tour") as HTMLAnchorElement;
      if (cont) cont.href = "/demo/sample/?dt=" + encodeURIComponent(dt) + "&resume=5";

      // ---- count-up ----
      function countUp(el: HTMLElement) {
        const target = parseFloat(el.getAttribute("data-count") || "0");
        const suffix = el.getAttribute("data-suffix") || "";
        const dur = 1100;
        const start = performance.now();
        function frame(now: number) {
          const p = Math.min(1, (now - start) / dur);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(target * eased) + suffix;
          if (p < 1) requestAnimationFrame(frame);
          else el.textContent = target + suffix;
        }
        requestAnimationFrame(frame);
      }

      // ---- reveal + trigger animations on scroll ----
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const counted = new WeakSet<HTMLElement>();

      function finishCounts(scope: HTMLElement, instant: boolean) {
        $all(".num[data-count], .mnum[data-count]").forEach((n) => {
          const node = n as HTMLElement;
          if (!scope.contains(node) || counted.has(node)) return;
          counted.add(node);
          if (instant || reduce) node.textContent = (node.getAttribute("data-count") || "") + (node.getAttribute("data-suffix") || "");
          else countUp(node);
        });
      }
      function reveal(el: HTMLElement, instant: boolean) {
        if (el.classList.contains("in")) return;
        el.classList.add("in");
        if (el.id === "flow") el.classList.add("go"); // start the pipeline packet
        finishCounts(el, instant);
      }

      const targets = $all(".rv") as HTMLElement[];
      const flow = $("#flow") as HTMLElement | null; if (flow) targets.push(flow);

      if (!("IntersectionObserver" in window) || reduce) {
        // No IO / reduced motion → just show everything at final values.
        targets.forEach((el) => reveal(el, true));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { reveal(e.target as HTMLElement, false); io.unobserve(e.target); }
          });
        }, { threshold: 0.25 });
        targets.forEach((el) => io.observe(el));
        // Failsafe: a tab that loads hidden/backgrounded suspends IO + rAF, which
        // would leave opacity:0 content stuck invisible. Force the final state so
        // nothing is ever permanently hidden; visible tabs animate normally first.
        setTimeout(() => { if (document.hidden) targets.forEach((el) => reveal(el, true)); }, 2000);
      }

      // ---- theme to the participant's trade ----
      (async function theme() {
        try {
          const res = await fetch("/api/visit", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ dt }) });
          const data = await res.json();
          const p = data.profile || {};
          $all("[data-biz]").forEach((el) => (el.textContent = p.biz || "Summit Home Services"));
          const mk = $("[data-mark]"); if (mk) mk.textContent = (p.biz || "S").trim().charAt(0).toUpperCase();
          $all("[data-phone]").forEach((el) => ((el as HTMLAnchorElement).href = "tel:" + String(p.phone || "").replace(/[^0-9+]/g, "")));
          const pt = $("[data-phone-text]"); if (pt) pt.textContent = p.phone || "";
          const nm = lead.name || data.name;
          const src = $("[data-source]"); if (src && nm) src.textContent = nm + " · yours alone, never resold";
          document.title = `How your funnel works — ${p.biz || "Summit Home Services"}`;
        } catch {}
      })();
    </script>
  </body>
</html>
