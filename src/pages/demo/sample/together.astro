---
// Standalone "It all comes together" finale page (Step 5 of the guided tour).
// Recaps the whole play end-to-end and lands the flat-$7 CTA. Sample-site shell
// for cohesion. This is the end of the tour (no 'continue'). noindex.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>It all comes together — Summit Home Services</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <style is:global>
      :root { --brand:#1d4ed8; --ink:#0f172a; --ink-2:#475569; --line:#e2e8f0; --bg:#fff; --bg-soft:#f8fafc; }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body { font-family: "Inter", system-ui, sans-serif; color: var(--ink); background: var(--bg); line-height: 1.55; -webkit-font-smoothing: antialiased; min-height: 100vh; display: flex; flex-direction: column; }
      .ribbon { background: #0f172a; color: #cbd5e1; font-size: 13px; text-align: center; padding: 7px 16px; display: flex; gap: 10px; align-items: center; justify-content: center; flex-wrap: wrap; }
      .ribbon strong { color: #fff; }
      .ribbon .stepchip { background: #1e293b; color: #7dd3fc; border-radius: 999px; padding: 2px 9px; font-size: 11px; font-weight: 700; }
      .wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
      header.site { display: flex; align-items: center; justify-content: space-between; padding: 16px 0; border-bottom: 1px solid var(--line); }
      .logo { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 19px; }
      .logo .mark { width: 34px; height: 34px; border-radius: 9px; background: var(--brand); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; }
      .nav { display: flex; gap: 22px; align-items: center; font-size: 15px; color: var(--ink-2); }
      .nav a { color: var(--ink-2); text-decoration: none; }
      .nav .call { background: var(--brand); color: #fff; padding: 9px 16px; border-radius: 8px; font-weight: 700; }
      @media (max-width: 720px) { .nav .links { display: none; } }
      .qhero { background: linear-gradient(180deg, var(--bg-soft), #fff); padding: 22px 0; flex: 1; display: flex; align-items: center; }
      .qhero .wrap { text-align: center; }
      .fgrid { display: grid; grid-template-columns: 0.9fr 1fr; gap: 36px; align-items: center; width: 100%; }
      @media (max-width: 860px) { .fgrid { grid-template-columns: 1fr; gap: 24px; } }
      .fcol-left { text-align: center; }
      .fcol-right { text-align: left; }
      .tag { display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--brand); background: #eff6ff; padding: 5px 11px; border-radius: 999px; }
      .qhero h1 { font-size: 26px; font-weight: 800; margin: 10px 0 6px; }
      .qhero .lede { font-size: 15px; color: var(--ink-2); max-width: 60ch; margin: 0 auto 16px; }
      .btn { padding: 12px 22px; border-radius: 9px; font-weight: 700; font-size: 15px; text-decoration: none; display: inline-block; cursor: pointer; border: none; }
      .btn-primary { background: var(--brand); color: #fff; }
      .btn-ghost { background: #fff; color: var(--ink); border: 1px solid var(--line); }

      .finale { max-width: 100%; }
      .fin-step { display: flex; gap: 12px; align-items: flex-start; padding: 8px 0; border-bottom: 1px dashed var(--line); font-size: 14px; font-weight: 700; opacity: 0; transform: translateY(6px); animation: fv-in .5s ease forwards; animation-delay: var(--d, 0s); }
      .fin-step:last-child { border-bottom: none; }
      .fin-step small { display: block; font-weight: 500; color: var(--ink-2); font-size: 12.5px; margin-top: 2px; }
      .fin-step .fc { flex: none; width: 26px; height: 26px; border-radius: 999px; background: var(--brand); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 800; }
      @keyframes fv-in { to { opacity: 1; transform: none; } }
      .payoff { margin: 13px 0 0; max-width: 100%; padding: 12px 16px; border-radius: 10px; background: #ecfdf5; border: 1px solid #6ee7b7; color: #065f46; font-size: 14px; font-weight: 600; opacity: 0; animation: fv-in .5s ease forwards; animation-delay: var(--d, 0s); }
      .payoff strong { color: #065f46; }
      .actions { margin-top: 16px; display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-start; opacity: 0; animation: fv-in .5s ease forwards; animation-delay: 2.2s; }
      /* Before/after impact: two 100-icon grids */
      .ba { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; max-width: 100%; margin: 0; }
      @media (max-width: 560px) { .ba { grid-template-columns: 1fr; } }
      .ba-col { border: 1px solid var(--line); border-radius: 14px; padding: 12px; background: #fff; }
      .ba-after { border-color: #6ee7b7; background: #f6fffb; }
      .ba-h { font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; color: var(--ink-2); margin-bottom: 8px; }
      .ba-after .ba-h { color: #047857; }
      .dotgrid { display: grid; grid-template-columns: repeat(10, 1fr); gap: 3px; max-width: 230px; margin: 0 auto; }
      .pdot { width: 100%; aspect-ratio: 1; display: block; fill: #e2e8f0; transition: fill .25s ease; }
      .pdot.on-before { fill: #1d4ed8; }
      .pdot.on-after { fill: #16a34a; }
      .ba-stat { margin-top: 8px; font-size: 13px; color: var(--ink-2); font-weight: 600; }
      .ba-num { font-size: 24px; font-weight: 800; color: var(--ink); }
      .ba-after .ba-num { color: #047857; }
      .ba-cap { margin-top: 3px; font-size: 12px; color: var(--ink-2); }
      .ba-note { font-size: 12px; color: #94a3b8; margin: 10px auto 0; max-width: 600px; }
      footer.site { border-top: 1px solid var(--line); padding: 16px 0; color: var(--ink-2); font-size: 13px; }
    </style>
  </head>
  <body>
    <div class="ribbon">
      <span>✅ The whole play, end to end.</span>
      <span class="stepchip">Guided demo · Step 5 of 5</span>
    </div>

    <div class="wrap">
      <header class="site">
        <div class="logo"><span class="mark" data-mark>S</span> <span data-biz>Summit Home Services</span></div>
        <nav class="nav">
          <span class="links">
            <a data-link="/demo/sample/" href="/demo/sample/">Home</a>
            <a data-link="/demo/sample/quote/" href="/demo/sample/quote/">Free Quote</a>
          </span>
          <a class="call" data-phone href="#">Call now</a>
        </nav>
      </header>
    </div>

    <section class="qhero">
      <div class="wrap fgrid">
        <div class="fcol-left">
          <div class="ba">
            <div class="ba-col">
              <div class="ba-h">Just a form on your site</div>
              <div class="dotgrid" data-grid="before"></div>
              <div class="ba-stat"><span class="ba-num" data-num-before>0</span>% become leads</div>
              <div class="ba-cap">~2 of 100 visitors fill out a form</div>
            </div>
            <div class="ba-col ba-after">
              <div class="ba-h">With Consent Resolve</div>
              <div class="dotgrid" data-grid="after"></div>
              <div class="ba-stat"><span class="ba-num" data-num-after>0</span>% resolved</div>
              <div class="ba-cap">~35 of 100 identified after they consent</div>
            </div>
          </div>
          <div class="ba-note">Illustrative — actual rates vary by traffic and trade.</div>
        </div>

        <div class="fcol-right">
          <span class="tag">It all comes together</span>
          <h1>Here's the whole play, working together.</h1>
          <p class="lede">One consented visitor, every piece firing at once — from anonymous browser to booked job.</p>
          <div class="finale">
            <div class="fin-step" style="--d:.15s"><span class="fc">1</span><div>A homeowner browses <span data-biz>your shop</span><small>traffic you already paid to bring in</small></div></div>
            <div class="fin-step" style="--d:.45s"><span class="fc">2</span><div>They consent<small>now they're identifiable — real name + email</small></div></div>
            <div class="fin-step" style="--d:.75s"><span class="fc">3</span><div>Their half-finished quote is recovered<small>email backfilled — no dead form</small></div></div>
            <div class="fin-step" style="--d:1.05s"><span class="fc">4</span><div>They drop into your funnel<small>CRM + retargeting + your own follow-up</small></div></div>
            <div class="fin-step" style="--d:1.35s"><span class="fc">5</span><div>They come back and call you<small>warm inbound, ready to book</small></div></div>
          </div>
          <div class="payoff" style="--d:1.8s">More booked jobs from traffic you already have — at a flat <strong>$7 a lead</strong>, yours alone, never resold.</div>
          <div class="actions">
            <a class="btn btn-primary" href="https://consentresolve.com/pricing/">Start getting real leads — flat $7 a lead →</a>
            <a class="btn btn-ghost" data-link="/demo/sample/" href="/demo/sample/">Replay the demo</a>
          </div>
        </div>
      </div>
    </section>

    <footer class="site">
      <div class="wrap">
        <span data-biz>Summit Home Services</span> · Licensed &amp; insured · <span data-phone-text>(555) 010-0100</span>
        <div style="margin-top:6px;font-size:12px;color:#94a3b8">Fictional business for the Consent Resolve live demo.</div>
      </div>
    </footer>

    <script>
      const dt = new URLSearchParams(location.search).get("dt") || "";
      const $ = (s: string) => document.querySelector(s);
      const $all = (s: string) => Array.from(document.querySelectorAll(s));

      $all("[data-link]").forEach((a) => {
        const base = (a as HTMLElement).getAttribute("data-link") || "";
        (a as HTMLAnchorElement).href = base + (dt ? "?dt=" + encodeURIComponent(dt) : "");
      });

      (async function theme() {
        try {
          const res = await fetch("/api/visit", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ dt }) });
          const data = await res.json();
          const p = data.profile || {};
          $all("[data-biz]").forEach((el) => (el.textContent = p.biz || "Summit Home Services"));
          const mk = $("[data-mark]"); if (mk) mk.textContent = (p.biz || "S").trim().charAt(0).toUpperCase();
          $all("[data-phone]").forEach((el) => ((el as HTMLAnchorElement).href = "tel:" + String(p.phone || "").replace(/[^0-9+]/g, "")));
          const pt = $("[data-phone-text]"); if (pt) pt.textContent = p.phone || "";
          document.title = `It all comes together — ${p.biz || "Summit Home Services"}`;
        } catch {}
      })();

      // ---- Before/after impact animation: two 100-icon grids ----
      const PERSON = '<svg class="pdot" viewBox="0 0 24 24"><path d="M12 12a5 5 0 100-10 5 5 0 000 10zm0 2c-5 0-9 2.5-9 6v2h18v-2c0-3.5-4-6-9-6z"/></svg>';

      function fillGrid(sel: string) {
        const g = $(sel) as HTMLElement | null;
        if (g) g.innerHTML = PERSON.repeat(100);
        return $all(sel + " .pdot") as HTMLElement[];
      }

      function lightUp(dots: HTMLElement[], count: number, cls: string, perDelay: number, startDelay: number) {
        for (let k = 0; k < count; k++) {
          const idx = (k * 37) % 100; // bijective scatter across the 10x10 grid
          window.setTimeout(() => dots[idx] && dots[idx].classList.add(cls), startDelay + k * perDelay);
        }
      }

      function countUp(sel: string, target: number, ms: number, startDelay: number) {
        const el = $(sel) as HTMLElement | null;
        if (!el) return;
        window.setTimeout(() => {
          let t0 = 0;
          const step = (now: number) => {
            if (!t0) t0 = now;
            const p = Math.min(1, (now - t0) / ms);
            el.textContent = String(Math.round(p * target));
            if (p < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }, startDelay);
      }

      function runImpact() {
        const before = fillGrid('[data-grid="before"]');
        const after = fillGrid('[data-grid="after"]');
        lightUp(before, 2, "on-before", 220, 500);
        countUp("[data-num-before]", 2, 700, 500);
        lightUp(after, 35, "on-after", 45, 1100);
        countUp("[data-num-after]", 35, 2000, 1100);
      }

      // Run once the grids scroll into view (or immediately if already visible).
      const baEl = $(".ba");
      if (baEl && "IntersectionObserver" in window) {
        const io = new IntersectionObserver((entries, obs) => {
          if (entries[0].isIntersecting) { runImpact(); obs.disconnect(); }
        }, { threshold: 0.3 });
        io.observe(baEl);
      } else {
        window.setTimeout(runImpact, 400);
      }
    </script>
  </body>
</html>
