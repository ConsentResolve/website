---
// Standalone "It all comes together" finale page (Step 5 of the guided tour).
// Recaps the whole play end-to-end and lands the flat-$7 CTA. Sample-site shell
// for cohesion. This is the end of the tour (no 'continue'). noindex.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>It all comes together — Summit Home Services</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <style is:global>
      :root { --brand:#1d4ed8; --ink:#0f172a; --ink-2:#475569; --line:#e2e8f0; --bg:#fff; --bg-soft:#f8fafc; }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body { font-family: "Inter", system-ui, sans-serif; color: var(--ink); background: var(--bg); line-height: 1.55; -webkit-font-smoothing: antialiased; }
      .ribbon { background: #0f172a; color: #cbd5e1; font-size: 13px; text-align: center; padding: 7px 16px; display: flex; gap: 10px; align-items: center; justify-content: center; flex-wrap: wrap; }
      .ribbon strong { color: #fff; }
      .ribbon .stepchip { background: #1e293b; color: #7dd3fc; border-radius: 999px; padding: 2px 9px; font-size: 11px; font-weight: 700; }
      .wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
      header.site { display: flex; align-items: center; justify-content: space-between; padding: 16px 0; border-bottom: 1px solid var(--line); }
      .logo { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 19px; }
      .logo .mark { width: 34px; height: 34px; border-radius: 9px; background: var(--brand); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; }
      .nav { display: flex; gap: 22px; align-items: center; font-size: 15px; color: var(--ink-2); }
      .nav a { color: var(--ink-2); text-decoration: none; }
      .nav .call { background: var(--brand); color: #fff; padding: 9px 16px; border-radius: 8px; font-weight: 700; }
      @media (max-width: 720px) { .nav .links { display: none; } }
      .qhero { background: linear-gradient(180deg, var(--bg-soft), #fff); padding: 48px 0 60px; }
      .tag { display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--brand); background: #eff6ff; padding: 5px 11px; border-radius: 999px; }
      .qhero h1 { font-size: 34px; font-weight: 800; margin: 14px 0 8px; }
      .qhero .lede { font-size: 17px; color: var(--ink-2); max-width: 58ch; margin: 0 0 24px; }
      .btn { padding: 12px 22px; border-radius: 9px; font-weight: 700; font-size: 15px; text-decoration: none; display: inline-block; cursor: pointer; border: none; }
      .btn-primary { background: var(--brand); color: #fff; }
      .btn-ghost { background: #fff; color: var(--ink); border: 1px solid var(--line); }

      .finale { max-width: 620px; }
      .fin-step { display: flex; gap: 12px; align-items: flex-start; padding: 12px 0; border-bottom: 1px dashed var(--line); font-size: 15px; font-weight: 700; opacity: 0; transform: translateY(6px); animation: fv-in .5s ease forwards; animation-delay: var(--d, 0s); }
      .fin-step:last-child { border-bottom: none; }
      .fin-step small { display: block; font-weight: 500; color: var(--ink-2); font-size: 12.5px; margin-top: 2px; }
      .fin-step .fc { flex: none; width: 26px; height: 26px; border-radius: 999px; background: var(--brand); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 800; }
      @keyframes fv-in { to { opacity: 1; transform: none; } }
      .payoff { margin-top: 18px; max-width: 620px; padding: 16px 18px; border-radius: 10px; background: #ecfdf5; border: 1px solid #6ee7b7; color: #065f46; font-size: 15px; font-weight: 600; opacity: 0; animation: fv-in .5s ease forwards; animation-delay: var(--d, 0s); }
      .payoff strong { color: #065f46; }
      .actions { margin-top: 22px; display: flex; gap: 10px; flex-wrap: wrap; opacity: 0; animation: fv-in .5s ease forwards; animation-delay: 2.2s; }
      footer.site { border-top: 1px solid var(--line); padding: 28px 0; color: var(--ink-2); font-size: 14px; }
    </style>
  </head>
  <body>
    <div class="ribbon">
      <span>✅ The whole play, end to end.</span>
      <span class="stepchip">Guided demo · Step 5 of 5</span>
    </div>

    <div class="wrap">
      <header class="site">
        <div class="logo"><span class="mark" data-mark>S</span> <span data-biz>Summit Home Services</span></div>
        <nav class="nav">
          <span class="links">
            <a data-link="/demo/sample/" href="/demo/sample/">Home</a>
            <a data-link="/demo/sample/quote/" href="/demo/sample/quote/">Free Quote</a>
          </span>
          <a class="call" data-phone href="#">Call now</a>
        </nav>
      </header>
    </div>

    <section class="qhero">
      <div class="wrap">
        <span class="tag">It all comes together</span>
        <h1>Here's the whole play, working together.</h1>
        <p class="lede">One consented visitor, every piece firing at once — from anonymous browser to booked job.</p>

        <div class="finale">
          <div class="fin-step" style="--d:.15s"><span class="fc">1</span><div>A homeowner browses <span data-biz>your shop</span><small>traffic you already paid to bring in</small></div></div>
          <div class="fin-step" style="--d:.45s"><span class="fc">2</span><div>They consent<small>now they're identifiable — real name + email</small></div></div>
          <div class="fin-step" style="--d:.75s"><span class="fc">3</span><div>Their half-finished quote is recovered<small>email backfilled — no dead form</small></div></div>
          <div class="fin-step" style="--d:1.05s"><span class="fc">4</span><div>They drop into your funnel<small>CRM + retargeting + your own follow-up</small></div></div>
          <div class="fin-step" style="--d:1.35s"><span class="fc">5</span><div>They come back and call you<small>warm inbound, ready to book</small></div></div>
        </div>

        <div class="payoff" style="--d:1.8s">More booked jobs from traffic you already have — at a flat <strong>$7 a lead</strong>, yours alone, never resold.</div>

        <div class="actions">
          <a class="btn btn-primary" href="https://consentresolve.com/pricing/">Start getting real leads — flat $7 a lead →</a>
          <a class="btn btn-ghost" href="/demo/">Replay the demo</a>
        </div>
      </div>
    </section>

    <footer class="site">
      <div class="wrap">
        <span data-biz>Summit Home Services</span> · Licensed &amp; insured · <span data-phone-text>(555) 010-0100</span>
        <div style="margin-top:6px;font-size:12px;color:#94a3b8">Fictional business for the Consent Resolve live demo.</div>
      </div>
    </footer>

    <script>
      const dt = new URLSearchParams(location.search).get("dt") || "";
      const $ = (s: string) => document.querySelector(s);
      const $all = (s: string) => Array.from(document.querySelectorAll(s));

      $all("[data-link]").forEach((a) => {
        const base = (a as HTMLElement).getAttribute("data-link") || "";
        (a as HTMLAnchorElement).href = base + (dt ? "?dt=" + encodeURIComponent(dt) : "");
      });

      (async function theme() {
        try {
          const res = await fetch("/api/visit", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ dt }) });
          const data = await res.json();
          const p = data.profile || {};
          $all("[data-biz]").forEach((el) => (el.textContent = p.biz || "Summit Home Services"));
          const mk = $("[data-mark]"); if (mk) mk.textContent = (p.biz || "S").trim().charAt(0).toUpperCase();
          $all("[data-phone]").forEach((el) => ((el as HTMLAnchorElement).href = "tel:" + String(p.phone || "").replace(/[^0-9+]/g, "")));
          const pt = $("[data-phone-text]"); if (pt) pt.textContent = p.phone || "";
          document.title = `It all comes together — ${p.biz || "Summit Home Services"}`;
        } catch {}
      })();
    </script>
  </body>
</html>
