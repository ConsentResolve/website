---
// Sample trades website for the live demo. Deliberately NOT using BaseLayout:
// it must look like a real, separate local business — no Consent Resolve nav,
// footer, or visitor-ID tag. Themed client-side from /api/visit by trade.
//
// Guided journey overlaid on top, in the sample site's own look (we never
// switch to Consent Resolve branding):
//   Step 1 — intro modal: "this is a site like yours; the journey starts with
//            consent" → points to the consent banner.
//   Step 2 — after Accept: still framed as the same site, show the exact email
//            that just landed in the owner's inbox.
// noindex,nofollow — fictional business, must never be indexed.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Summit Home Services — Licensed, Insured, Local</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <style is:global>
      :root {
        --brand: #1d4ed8;
        --brand-dark: #1e3a8a;
        --ink: #0f172a;
        --ink-2: #475569;
        --line: #e2e8f0;
        --bg: #ffffff;
        --bg-soft: #f8fafc;
        --star: #f59e0b;
        --go: #16a34a;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        font-family: "Inter", system-ui, sans-serif;
        color: var(--ink);
        background: var(--bg);
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      .ribbon {
        background: #0f172a;
        color: #cbd5e1;
        font-size: 13px;
        text-align: center;
        padding: 7px 16px;
        letter-spacing: 0.01em;
        display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap;
      }
      .ribbon strong { color: #fff; }
      .ribbon .stepchip {
        background: #1e293b; color: #7dd3fc; border-radius: 999px;
        padding: 2px 9px; font-size: 11px; font-weight: 700; letter-spacing: .06em;
      }
      .wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
      header.site {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 0;
        border-bottom: 1px solid var(--line);
      }
      .logo { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 19px; }
      .logo .mark {
        width: 34px; height: 34px; border-radius: 9px;
        background: var(--brand); color: #fff;
        display: flex; align-items: center; justify-content: center; font-weight: 800;
      }
      .nav { display: flex; gap: 22px; align-items: center; font-size: 15px; color: var(--ink-2); }
      .nav a { color: var(--ink-2); text-decoration: none; }
      .nav .call {
        background: var(--brand); color: #fff; padding: 9px 16px; border-radius: 8px;
        font-weight: 700; text-decoration: none;
      }
      @media (max-width: 720px) { .nav .links { display: none; } }
      .hero { background: linear-gradient(180deg, var(--bg-soft), #fff); padding: 56px 0 48px; }
      .hero .eyebrow { color: var(--brand); font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: 0.06em; }
      .hero h1 { font-size: 42px; line-height: 1.1; margin: 12px 0 14px; font-weight: 800; max-width: 16ch; }
      .hero p { font-size: 18px; color: var(--ink-2); max-width: 52ch; margin: 0 0 26px; }
      .cta-row { display: flex; gap: 12px; flex-wrap: wrap; }
      .btn { padding: 13px 22px; border-radius: 9px; font-weight: 700; font-size: 15px; text-decoration: none; display: inline-block; cursor: pointer; border: none; }
      .btn-primary { background: var(--brand); color: #fff; }
      .btn-ghost { background: #fff; color: var(--ink); border: 1px solid var(--line); }
      .trust { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 26px; color: var(--ink-2); font-size: 14px; }
      .trust span { display: inline-flex; align-items: center; gap: 6px; }
      section.block { padding: 52px 0; }
      h2.section-title { font-size: 28px; font-weight: 800; margin: 0 0 6px; }
      .section-sub { color: var(--ink-2); margin: 0 0 28px; }
      .services { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px; }
      .card { border: 1px solid var(--line); border-radius: 14px; padding: 22px; background: #fff; }
      .card h3 { margin: 0 0 6px; font-size: 17px; }
      .card p { margin: 0; color: var(--ink-2); font-size: 14px; }
      .card .ic { width: 40px; height: 40px; border-radius: 10px; background: #eff6ff; color: var(--brand); display: flex; align-items: center; justify-content: center; font-size: 20px; margin-bottom: 14px; }
      .reviews { background: var(--bg-soft); }
      .review-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; }
      .stars { color: var(--star); letter-spacing: 2px; }
      .review .name { font-weight: 700; margin-top: 10px; }
      footer.site { border-top: 1px solid var(--line); padding: 28px 0; color: var(--ink-2); font-size: 14px; }

      /* Consent banner */
      .consent {
        position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
        background: #0f172a; color: #e2e8f0;
        padding: 18px 20px;
        box-shadow: 0 -8px 30px rgba(0,0,0,0.25);
        transform: translateY(110%);
        transition: transform 0.35s ease, box-shadow 0.3s ease;
      }
      .consent.show { transform: translateY(0); }
      .consent.highlight { box-shadow: 0 -10px 40px rgba(34,197,94,0.35), inset 0 0 0 2px #22c55e; }
      .consent .inner { max-width: 1080px; margin: 0 auto; display: flex; gap: 18px; align-items: center; justify-content: space-between; flex-wrap: wrap; }
      .consent p { margin: 0; font-size: 14px; max-width: 64ch; }
      .consent a { color: #7dd3fc; }
      .consent .actions { display: flex; gap: 10px; align-items: center; }
      .consent .accept { background: #22c55e; color: #052e16; }
      .consent .accept.pulse { animation: cr-pulse 1.5s infinite; }
      @keyframes cr-pulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(34,197,94,0.55); }
        50% { box-shadow: 0 0 0 9px rgba(34,197,94,0); }
      }
      .consent .decline { background: transparent; color: #cbd5e1; border: 1px solid #334155; }
      .consent .accept[disabled] { opacity: 0.6; cursor: progress; }
      .consent .hint { width: 100%; margin-top: 10px; font-size: 13px; color: #86efac; font-weight: 600; }

      /* Coachmark pointing at the banner (Step 1) */
      .coach {
        position: fixed; left: 50%; transform: translateX(-50%);
        bottom: 96px; z-index: 55;
        background: #fff; color: var(--ink); border: 1px solid var(--line);
        padding: 10px 16px; border-radius: 999px; font-weight: 700; font-size: 14px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.18);
        display: none; align-items: center; gap: 8px;
        animation: cr-bob 1.6s ease-in-out infinite;
      }
      .coach.show { display: inline-flex; }
      @keyframes cr-bob { 0%,100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(5px); } }

      /* Guided-journey modal (sample-site look, not CR branding) */
      .journey {
        position: fixed; inset: 0; z-index: 100;
        display: none; align-items: center; justify-content: center; padding: 20px;
        background: rgba(8,15,30,0.55);
      }
      .journey.show { display: flex; }
      .journey-card {
        background: #fff; border-radius: 18px; max-width: 540px; width: 100%;
        padding: 30px; box-shadow: 0 30px 70px rgba(0,0,0,0.35);
        animation: cr-pop 0.28s ease; max-height: 92vh; overflow-y: auto;
      }
      @keyframes cr-pop { from { transform: translateY(12px) scale(0.98); opacity: 0; } to { transform: none; opacity: 1; } }
      .journey-tag {
        display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase;
        color: var(--brand); background: #eff6ff; padding: 5px 11px; border-radius: 999px;
      }
      .journey-card h2 { font-size: 25px; font-weight: 800; margin: 14px 0 10px; line-height: 1.15; }
      .journey-card p { color: var(--ink-2); font-size: 15px; margin: 0 0 14px; }
      .journey-card .em { color: var(--ink); font-weight: 700; }
      .journey-actions { margin-top: 20px; display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
      .journey-note { font-size: 13px; color: var(--ink-2); margin-top: 12px; }
      .point-row {
        display: flex; gap: 12px; align-items: flex-start; margin: 14px 0;
        background: var(--bg-soft); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px;
      }
      .point-row .num {
        flex: none; width: 26px; height: 26px; border-radius: 999px; background: var(--brand); color: #fff;
        display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 14px;
      }
      .point-row div { font-size: 14px; }
      .point-row strong { color: var(--ink); }

      /* The reveal-email preview (this DOES look like the real CR notification) */
      .emailcard { border: 1px solid var(--line); border-radius: 12px; overflow: hidden; margin: 6px 0 4px; }
      .emailcard .eh { background: #0a1628; padding: 15px 18px; }
      .emailcard .eh .tag { color: #00e5a0; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 800; }
      .emailcard .eh .subj { color: #fff; font-size: 16px; font-weight: 700; margin-top: 4px; }
      .emailcard .eb { padding: 14px 18px; }
      .emailcard table { width: 100%; border-collapse: collapse; font-size: 14px; }
      .emailcard td.k { color: #64748b; width: 118px; padding: 6px 0; vertical-align: top; }
      .emailcard td.v { color: #0a1628; font-weight: 600; padding: 6px 0; }
      .emailcard td.v a { color: #0369a1; }
      .aha {
        margin-top: 12px; padding: 12px 14px; border-left: 4px solid #00e5a0;
        background: #f0fdf9; border-radius: 8px; font-size: 13.5px; line-height: 1.5; color: var(--ink);
      }

      /* Step 3 — funnel visualization (staggered fade-in on open) */
      .funnelviz { margin: 10px 0 4px; }
      .fv-node {
        border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; text-align: center;
        font-weight: 700; font-size: 14px; background: #fff; line-height: 1.25;
        opacity: 0; transform: translateY(8px); animation: fv-in 0.5s ease forwards; animation-delay: var(--d, 0s);
      }
      .fv-node small { display: block; font-weight: 500; color: var(--ink-2); font-size: 12px; margin-top: 4px; }
      .fv-source { background: #0a1628; color: #fff; border-color: #0a1628; }
      .fv-source small { color: #9fb0c4; }
      .fv-result { background: #ecfdf5; border-color: #6ee7b7; color: #065f46; }
      .fv-result small { color: #047857; }
      .fv-fan { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
      @media (max-width: 520px) { .fv-fan { grid-template-columns: 1fr; } }
      .fv-arrow {
        width: 2px; height: 22px; margin: 7px auto; background: #cbd5e1; position: relative;
        opacity: 0; animation: fv-in 0.4s ease forwards; animation-delay: var(--d, 0s);
      }
      .fv-arrow::after { content: "▼"; position: absolute; left: 50%; bottom: -7px; transform: translateX(-50%); color: #cbd5e1; font-size: 11px; }
      .fv-cap { text-align: center; font-size: 12px; color: var(--ink-2); margin: 4px 0 2px; opacity: 0; animation: fv-in .4s ease forwards; animation-delay: var(--d, 0s); }
      @keyframes fv-in { to { opacity: 1; transform: none; } }

      /* Step 4 — abandoned-quote recovery (form backfill) */
      .qform { border: 1px solid var(--line); border-radius: 14px; padding: 16px; background: var(--bg-soft); margin: 10px 0 4px; }
      .qf-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 14px; font-weight: 800; font-size: 15px; flex-wrap: wrap; }
      .qf-status { font-size: 10.5px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; padding: 3px 9px; border-radius: 999px; transition: all 0.3s ease; }
      .qf-status.abandoned { color: #9f1239; background: #ffe4e6; }
      .qf-status.recovered { color: #065f46; background: #d1fae5; }
      .qf-field { display: grid; grid-template-columns: 120px 1fr; gap: 10px; align-items: center; margin-bottom: 9px; }
      @media (max-width: 460px) { .qf-field { grid-template-columns: 1fr; gap: 3px; } }
      .qf-field > label { font-size: 13px; color: var(--ink-2); font-weight: 600; }
      .qf-val {
        background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: 9px 11px;
        font-size: 14px; font-weight: 600; min-height: 38px; display: flex; align-items: center; gap: 8px;
        transition: background 0.4s ease, border-color 0.4s ease, color 0.4s ease;
      }
      .qf-val.empty { color: #cbd5e1; font-weight: 500; border-style: dashed; }
      .qf-val.backfill { border-color: #16a34a; background: #f0fdf4; color: #065f46; }
      .qf-badge { font-size: 11px; font-weight: 800; color: #16a34a; opacity: 0; transition: opacity 0.4s ease; white-space: nowrap; }
      .qf-badge.show { opacity: 1; }
      .qf-submit { margin-top: 8px; width: 100%; padding: 11px; border-radius: 8px; border: none; background: #cbd5e1; color: #fff; font-weight: 700; font-size: 14px; transition: background 0.4s ease; }
      .qf-submit.go { background: var(--brand); }
      .fade-seq { opacity: 0; transition: opacity 0.5s ease; }
      .fade-seq.show { opacity: 1; }

      /* Sample quote form (lands here from the nurture email's CTA) */
      section.quote { background: var(--bg-soft); }
      .quote-card { max-width: 640px; margin: 0 auto; background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 26px; transition: box-shadow 0.4s ease, border-color 0.4s ease; scroll-margin-top: 80px; }
      .quote-card.spot { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(29,78,216,0.30), 0 18px 40px rgba(29,78,216,0.15); }
      .quote-card h2 { margin: 0 0 4px; font-size: 26px; font-weight: 800; }
      .quote-card .qsub { color: var(--ink-2); margin: 0 0 18px; }
      .qgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
      @media (max-width: 560px) { .qgrid { grid-template-columns: 1fr; } }
      .qfield { display: flex; flex-direction: column; gap: 5px; }
      .qfield.full { grid-column: 1 / -1; }
      .qfield label { font-size: 13px; font-weight: 600; color: var(--ink); }
      .qfield input, .qfield textarea { border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; font: inherit; font-size: 14px; }
      .qfield input:focus, .qfield textarea:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px rgba(29,78,216,0.12); }
      .quote-submit { margin-top: 16px; width: 100%; background: var(--brand); color: #fff; border: none; border-radius: 9px; padding: 13px; font-weight: 700; font-size: 15px; cursor: pointer; }
      .quote-done { text-align: center; padding: 26px 10px; }
      .quote-done .big { font-size: 42px; }

      /* Inline guided tour (Steps 2–5) — injected INTO the page flow as a band
         between sections (not a popup; pushes content, scrolls with the page). */
      .tour { display: none; background: #eef4ff; border-top: 1px solid #dbeafe; border-bottom: 1px solid #dbeafe; padding: 26px 20px; scroll-margin-top: 14px; }
      .tour.show { display: block; animation: tour-in 0.3s ease; }
      @keyframes tour-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
      .tour-card { max-width: 640px; margin: 0 auto; background: #fff; border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 8px 24px rgba(8,15,30,0.10); display: flex; flex-direction: column; overflow: hidden; }
      .tour-head { display: flex; align-items: center; gap: 10px; padding: 13px 16px; border-bottom: 1px solid var(--line); }
      .tour-chip { font-size: 11px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--brand); background: #eff6ff; padding: 5px 10px; border-radius: 999px; }
      .tour-progress { display: flex; gap: 5px; margin-left: auto; }
      .tdot { width: 7px; height: 7px; border-radius: 999px; background: var(--line); }
      .tdot.on { background: var(--brand); }
      .tour-x { background: none; border: none; font-size: 15px; color: var(--ink-muted); cursor: pointer; line-height: 1; padding: 2px 4px; }
      .tour-body { padding: 18px; overflow-y: auto; }
      .tour-body h2 { font-size: 21px; font-weight: 800; margin: 0 0 8px; line-height: 1.18; }
      .tour-body p { color: var(--ink-2); font-size: 14px; margin: 0 0 12px; line-height: 1.5; }
      .tour-body .em { color: var(--ink); font-weight: 700; }
      .tour-nav { display: flex; justify-content: space-between; gap: 10px; padding: 12px 16px; border-top: 1px solid var(--line); }
      .tour-btn { padding: 9px 16px; border-radius: 8px; font-weight: 700; font-size: 14px; cursor: pointer; }
      .tour-btn.back { background: #fff; border: 1px solid var(--line); color: var(--ink); }
      .tour-btn.next { background: var(--brand); border: none; color: #fff; }
      .tour-body { max-height: none; }
      .tour-target-hl { outline: 3px solid rgba(29,78,216,0.55); outline-offset: 4px; border-radius: 10px; transition: outline 0.25s ease; }

      /* Step 5 — finale (staggered checklist + payoff) */
      .finale { margin: 6px 0 2px; }
      .fin-step { display: flex; gap: 10px; align-items: flex-start; padding: 10px 0; border-bottom: 1px dashed var(--line); font-size: 14px; font-weight: 700; opacity: 0; transform: translateY(6px); animation: fv-in 0.5s ease forwards; animation-delay: var(--d, 0s); }
      .fin-step:last-child { border-bottom: none; }
      .fin-step small { display: block; font-weight: 500; color: var(--ink-2); font-size: 12px; margin-top: 2px; }
      .fin-step .fc { flex: none; width: 24px; height: 24px; border-radius: 999px; background: var(--brand); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 800; }
      .payoff { margin-top: 13px; padding: 14px 16px; border-radius: 10px; background: #ecfdf5; border: 1px solid #6ee7b7; color: #065f46; font-size: 14px; font-weight: 600; opacity: 0; animation: fv-in 0.5s ease forwards; animation-delay: var(--d, 0s); }
      .payoff strong { color: #065f46; }
    </style>
  </head>
  <body>
    <div class="ribbon">
      <span>👀 You're browsing as a <strong>visitor</strong> — a sample service-pro site.</span>
      <span class="stepchip" id="stepchip">Guided demo · Step 1 of 5</span>
    </div>

    <div class="wrap">
      <header class="site">
        <div class="logo"><span class="mark" data-mark>S</span> <span data-biz>Summit Home Services</span></div>
        <nav class="nav">
          <span class="links">
            <a href="#services">Services</a>
            <a href="#reviews">Reviews</a>
            <a data-quote-link href="/demo/sample/quote/">Free Quote</a>
          </span>
          <a class="call" data-phone href="#">Call now</a>
        </nav>
      </header>
    </div>

    <section class="hero">
      <div class="wrap">
        <div class="eyebrow" data-eyebrow>Licensed · Insured · Locally owned</div>
        <h1 data-headline>Honest home repair, done right the first time</h1>
        <p data-sub>Same-week appointments. Up-front pricing. A crew your neighbors already trust.</p>
        <div class="cta-row">
          <a class="btn btn-primary" data-phone href="#">Call for a free quote</a>
          <a class="btn btn-ghost" href="#services">See our services</a>
        </div>
        <div class="trust">
          <span>⭐ 4.9 average rating</span>
          <span>🛡️ Licensed &amp; insured</span>
          <span>⏱️ Same-week service</span>
        </div>
      </div>
    </section>

    <section class="block" id="services">
      <div class="wrap">
        <h2 class="section-title">What we do</h2>
        <p class="section-sub" data-services-sub>Straightforward work, fair prices, no surprises.</p>
        <div class="services" data-services></div>
      </div>
    </section>

    <section class="block reviews" id="reviews">
      <div class="wrap">
        <h2 class="section-title">What neighbors say</h2>
        <p class="section-sub">Real talk from folks down the street.</p>
        <div class="review-grid" data-reviews></div>
      </div>
    </section>

    <footer class="site">
      <div class="wrap">
        <span data-biz>Summit Home Services</span> · Licensed &amp; insured · <span data-phone-text>(555) 010-0100</span>
        <div style="margin-top:6px;font-size:12px;color:#94a3b8">Fictional business for the Consent Resolve live demo.</div>
      </div>
    </footer>

    <!-- Coachmark for Step 1 -->
    <div class="coach" id="coach">👇 Step 1 — accept the consent banner, like your customer would</div>

    <!-- Consent banner (not pre-checked; consent is the explicit Accept click) -->
    <div class="consent" id="consent" role="dialog" aria-live="polite" aria-label="Cookie consent">
      <div class="inner">
        <p>
          We use cookies and a consent-first identification tool to recognize returning visitors and improve your experience. Nothing is identified until you accept.
          <a href="https://consentresolve.com/why-consent-first/" target="_blank" rel="noopener">Our cookie &amp; consent policy</a>.
        </p>
        <div class="actions">
          <button class="btn decline" id="cr-decline" type="button">Decline</button>
          <button class="btn accept" id="cr-accept" type="button">Accept</button>
        </div>
      </div>
    </div>

    <!-- Step 1 only: intro modal -->
    <div class="journey" id="journey" role="dialog" aria-modal="true" aria-label="Guided demo">
      <div class="journey-card" id="journey-card"></div>
    </div>

    <!-- Steps 2–5: on-page docked guided tour (non-blocking) -->
    <div class="tour" id="tour" aria-live="polite" aria-label="Guided tour">
      <div class="tour-card">
        <div class="tour-head">
          <span class="tour-chip" id="tour-chip">Step 2 of 5</span>
          <div class="tour-progress" id="tour-progress"></div>
          <button class="tour-x" id="tour-close" type="button" aria-label="Close tour">✕</button>
        </div>
        <div class="tour-body" id="tour-body"></div>
        <div class="tour-nav">
          <button class="tour-btn back" id="tour-back" type="button">← Back</button>
          <button class="tour-btn next" id="tour-next" type="button">Next →</button>
        </div>
      </div>
    </div>

    <script>
      const dt = new URLSearchParams(location.search).get("dt");
      const $ = (sel: string) => document.querySelector(sel);
      const $all = (sel: string) => Array.from(document.querySelectorAll(sel));
      let PROFILE: any = null;

      function esc(s: string) {
        return String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] as string));
      }

      function applyProfile(p: any) {
        if (!p) return;
        PROFILE = p;
        $all("[data-biz]").forEach((el) => (el.textContent = p.biz));
        const mark = $("[data-mark]");
        if (mark) mark.textContent = (p.biz || "S").trim().charAt(0).toUpperCase();
        if (p.hero) {
          const eb = $("[data-eyebrow]"); if (eb) eb.textContent = p.hero.eyebrow;
          const hl = $("[data-headline]"); if (hl) hl.textContent = p.hero.headline;
          const sb = $("[data-sub]"); if (sb) sb.textContent = p.hero.sub;
        }
        $all("[data-phone]").forEach((el) => ((el as HTMLAnchorElement).href = "tel:" + (p.phone || "").replace(/[^0-9+]/g, "")));
        const pt = $("[data-phone-text]"); if (pt) pt.textContent = p.phone;
        const qs = $("[data-quote-svc]"); if (qs && p.label) (qs as HTMLInputElement).value = p.label.charAt(0).toUpperCase() + p.label.slice(1);
        document.title = `${p.biz} — Licensed, Insured, Local`;

        const svc = $("[data-services]");
        if (svc && Array.isArray(p.services)) {
          svc.innerHTML = p.services
            .map((s: any) => `<div class="card"><div class="ic">★</div><h3>${esc(s.title)}</h3><p>${esc(s.desc)}</p></div>`)
            .join("");
        }
        const rev = $("[data-reviews]");
        if (rev && Array.isArray(p.reviews)) {
          rev.innerHTML = p.reviews
            .map((r: any) => `<div class="card review"><div class="stars">${"★".repeat(r.stars || 5)}</div><p>"${esc(r.text)}"</p><div class="name">${esc(r.name)}</div></div>`)
            .join("");
        }
      }

      function setStep(n: number) {
        const chip = $("#stepchip");
        if (chip) chip.textContent = `Guided demo · Step ${n} of 5`;
      }

      function openModal(html: string) {
        const card = $("#journey-card") as HTMLElement;
        card.innerHTML = html;
        ($("#journey") as HTMLElement).classList.add("show");
      }
      function closeModal() {
        ($("#journey") as HTMLElement).classList.remove("show");
      }

      // ---- Step 1: intro ----
      function step1() {
        setStep(1);
        const biz = (PROFILE && PROFILE.biz) || "this business";
        const label = (PROFILE && PROFILE.label) || "home services";
        openModal(`
          <span class="journey-tag">Step 1 of 5 · Consent</span>
          <h2>This is a website like yours.</h2>
          <p>Say hello to <span class="em">${esc(biz)}</span> — a ${esc(label)} site, same as yours. A real homeowner just landed here from an ad, a Google search, or a shared link.</p>
          <div class="point-row">
            <div class="num">1</div>
            <div>Their journey starts with one thing: <strong>consent</strong>. See the banner at the bottom? That's the cookie &amp; consent notice your customers see. <strong>Nothing about them is identified until they accept it.</strong></div>
          </div>
          <p>Go ahead and accept it — exactly like your customer would. That single click is where every real lead begins.</p>
          <div class="journey-actions">
            <button class="btn btn-primary" id="j1-go" type="button">Show me the consent banner →</button>
          </div>
          <div class="journey-note">Consent-first, by design. This is a demo — the only person we'll identify is you.</div>
        `);
        ($("#j1-go") as HTMLElement)?.addEventListener("click", () => {
          closeModal();
          revealBanner();
        });
      }

      function revealBanner() {
        const consent = $("#consent") as HTMLElement;
        consent.classList.add("show", "highlight");
        ($("#cr-accept") as HTMLElement)?.classList.add("pulse");
        ($("#coach") as HTMLElement)?.classList.add("show");
      }

      // ---- Step 2: the lead that just landed ----
      function leadCard(lead: any) {
        const page = lead.sample_page || "/demo/sample/";
        return `
          <div class="emailcard">
            <div class="eh">
              <div class="tag">Consent Resolve</div>
              <div class="subj">🎯 New identified lead</div>
            </div>
            <div class="eb">
              <table>
                <tr><td class="k">Name</td><td class="v">${esc(lead.name)}</td></tr>
                <tr><td class="k">Email</td><td class="v"><a href="mailto:${esc(lead.email)}">${esc(lead.email)}</a></td></tr>
                ${lead.business_name ? `<tr><td class="k">Business</td><td class="v">${esc(lead.business_name)}</td></tr>` : ""}
                <tr><td class="k">Shopping for</td><td class="v">${esc(lead.trade_label || "home services")}</td></tr>
                <tr><td class="k">Page viewed</td><td class="v">${esc(page)}</td></tr>
                <tr><td class="k">Consent captured</td><td class="v">${esc(lead.consented_at)}</td></tr>
              </table>
            </div>
          </div>`;
      }

      // ===== On-page guided tour (Steps 2–5), rendered into the docked panel =====
      let LEAD: any = null;
      let EMAILED = false;
      let TOURI = 0;

      // ---- Step 2: the lead that just landed ----
      function content2() {
        const lead = LEAD || {};
        return `
          <h2>That consent just became a lead.</h2>
          <p>The moment they accepted — a real name and a consented email is <span class="em">revealed</span>, yours alone.</p>
          ${leadCard(lead)}
          <div class="aha">For the purposes of this demo you are seeing yourself as a customer. ${EMAILED ? "We also just sent you an email (as a customer) with nudges to call or get a free quote." : "Your customer would also get an email with nudges to call or get a free quote."}</div>
        `;
      }

      // ---- Step 3: opens the dedicated animated quote page ----
      function content3() {
        return `
          <h2>They started a quote — then vanished.</h2>
          <p>Someone began your estimate form and never hit submit. Open your <span class="em">quote page</span> to watch that dead form turn back into a real lead.</p>
          <div class="journey-actions">
            <button class="btn btn-primary" id="j3-open" type="button">Open your quote page →</button>
          </div>
        `;
      }

      function wireQuoteOpen() {
        ($("#j3-open") as HTMLElement)?.addEventListener("click", () => {
          window.location.assign("/demo/sample/quote/?dt=" + encodeURIComponent(dt || ""));
        });
      }

      // ---- Step 4: feed your funnel ----
      function content4() {
        const lead = LEAD || {};
        const biz = (PROFILE && PROFILE.biz) || "your shop";
        return `
          <h2>Now that lead goes to work.</h2>
          <p>It flows into the marketing <span class="em">you already run</span> — so the homeowner comes back on their own time and calls you.</p>
          <div class="funnelviz">
            <div class="fv-node fv-source" style="--d:0s">📥 Consented lead<small>${esc(lead.name || "your visitor")} · yours alone, never resold</small></div>
            <div class="fv-arrow" style="--d:.35s"></div>
            <div class="fv-cap" style="--d:.4s">flows straight into your stack</div>
            <div class="fv-fan">
              <div class="fv-node" style="--d:.55s">🗂️ Your CRM<small>Jobber · Housecall Pro · ServiceTitan · HubSpot</small></div>
              <div class="fv-node" style="--d:.7s">🎯 Retargeting<small>your Google &amp; Meta audiences</small></div>
              <div class="fv-node" style="--d:.85s">✉️ Email / SMS<small>your follow-up sequence</small></div>
            </div>
            <div class="fv-arrow" style="--d:1.05s"></div>
            <div class="fv-node fv-result" style="--d:1.2s">📞 They come back — and call you<small>warm inbound, on their time</small></div>
          </div>
          <div class="aha">Same consented contact, feeding the channels that already work for ${esc(biz)}. You don't cold-call anyone — they reach out to you, ready to book.</div>
        `;
      }

      // ---- Step 5: it all comes together ----
      function content5() {
        const biz = (PROFILE && PROFILE.biz) || "your shop";
        return `
          <h2>Here's the whole play, working together.</h2>
          <p>One consented visitor, every piece firing at once — from anonymous browser to booked job.</p>
          <div class="finale">
            <div class="fin-step" style="--d:.1s"><span class="fc">1</span><div>A homeowner browses ${esc(biz)}<small>traffic you already paid to bring in</small></div></div>
            <div class="fin-step" style="--d:.4s"><span class="fc">2</span><div>They consent<small>now they're identifiable — real name + email</small></div></div>
            <div class="fin-step" style="--d:.7s"><span class="fc">3</span><div>Their half-finished quote is recovered<small>email backfilled — no dead form</small></div></div>
            <div class="fin-step" style="--d:1s"><span class="fc">4</span><div>They drop into your funnel<small>CRM + retargeting + your own follow-up</small></div></div>
            <div class="fin-step" style="--d:1.3s"><span class="fc">5</span><div>They come back and call you<small>warm inbound, ready to book</small></div></div>
          </div>
          <div class="payoff" style="--d:1.7s">More booked jobs from traffic you already have — at a flat <strong>$7 a lead</strong>, yours alone, never resold.</div>
          <div class="journey-actions" style="margin-top:16px">
            <a class="btn btn-primary" href="https://consentresolve.com/pricing/">Start getting real leads — flat $7 a lead →</a>
            <a class="btn btn-ghost" href="/demo/">Replay the demo</a>
          </div>
        `;
      }

      const TOUR = [
        { chip: "Step 2 of 5 · The lead lands", render: content2, anchor: "#services", pos: "before" },
        { chip: "Step 3 of 5 · Quote recovery", render: content3, onShow: wireQuoteOpen, anchor: "#reviews", pos: "before" },
        { chip: "Step 4 of 5 · Feed your funnel", render: content4, anchor: "#reviews", pos: "after" },
        { chip: "Step 5 of 5 · It all comes together", render: content5, anchor: "footer.site", pos: "before" },
      ];

      function renderDots() {
        const prog = $("#tour-progress") as HTMLElement;
        if (prog) prog.innerHTML = TOUR.map((_, i) => `<span class="tdot ${i === TOURI ? "on" : ""}"></span>`).join("");
      }

      function clearHighlight() {
        $all(".tour-target-hl").forEach((e) => e.classList.remove("tour-target-hl"));
      }

      // Move the tour band INTO the page flow at the step's anchor (before/after
      // a real section), so it reads as part of the site rather than a popup.
      function relocate(step: any) {
        const tour = $("#tour") as HTMLElement;
        const a = step.anchor ? document.querySelector(step.anchor) : null;
        if (a && a.parentNode) {
          if (step.pos === "after") a.parentNode.insertBefore(tour, a.nextSibling);
          else a.parentNode.insertBefore(tour, a);
        }
      }

      function gotoTour(i: number) {
        TOURI = Math.max(0, Math.min(TOUR.length - 1, i));
        const step = TOUR[TOURI] as any;
        ($("#tour-chip") as HTMLElement).textContent = step.chip;
        ($("#tour-body") as HTMLElement).innerHTML = step.render();
        renderDots();
        setStep(TOURI + 2);
        ($("#tour-back") as HTMLElement).style.visibility = TOURI === 0 ? "hidden" : "visible";
        ($("#tour-next") as HTMLElement).style.display = TOURI === TOUR.length - 1 ? "none" : "";
        clearHighlight();
        relocate(step);
        ($("#tour") as HTMLElement).classList.add("show");
        if (step.spot) document.querySelector(step.spot)?.classList.add("tour-target-hl");
        window.setTimeout(() => ($("#tour") as HTMLElement).scrollIntoView({ behavior: "smooth", block: "start" }), 30);
        step.onShow && step.onShow();
      }

      function startTour(lead: any, emailed: boolean) {
        LEAD = lead; EMAILED = emailed; TOURI = 0;
        gotoTour(0);
      }

      function endTour() {
        ($("#tour") as HTMLElement).classList.remove("show");
        clearHighlight();
      }

      $("#tour-back")?.addEventListener("click", () => gotoTour(TOURI - 1));
      $("#tour-next")?.addEventListener("click", () => gotoTour(TOURI + 1));
      $("#tour-close")?.addEventListener("click", endTour);

      // ---- wire the banner ----
      $("#cr-decline")?.addEventListener("click", () => {
        const p = $("#consent .inner p") as HTMLElement;
        if (p && !$("#consent .hint")) {
          const hint = document.createElement("div");
          hint.className = "hint";
          hint.textContent = "That's consent-first in action — decline and nothing happens. Accept to see step 2.";
          ($("#consent .inner") as HTMLElement).appendChild(hint);
        }
      });

      $("#cr-accept")?.addEventListener("click", async () => {
        const btn = $("#cr-accept") as HTMLButtonElement;
        if (!dt || dt === "bot") { window.location.assign("/demo/"); return; }
        btn.disabled = true;
        btn.classList.remove("pulse");
        btn.textContent = "Identifying…";
        ($("#coach") as HTMLElement)?.classList.remove("show");
        try {
          const res = await fetch("/api/consent", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ dt }),
          });
          const data = await res.json();
          ($("#consent") as HTMLElement).classList.remove("show");
          if (data && data.lead) {
            // Stash so the lead survives the hop to the quote page and back.
            try { sessionStorage.setItem("cr_lead", JSON.stringify(data.lead)); sessionStorage.setItem("cr_emailed", data.emailed ? "1" : ""); } catch {}
            startTour(data.lead, !!data.emailed); return;
          }
        } catch {}
        // Fallback: send them to the standalone confirmation page.
        window.location.assign(`/demo/done/?dt=${encodeURIComponent(dt)}`);
      });

      async function init() {
        try {
          const res = await fetch("/api/visit", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ dt }),
          });
          const data = await res.json();
          applyProfile(data.profile);
        } catch {}
        const ql = $("[data-quote-link]") as HTMLAnchorElement | null;
        if (ql) ql.href = "/demo/sample/quote/?dt=" + encodeURIComponent(dt || "");

        const params = new URLSearchParams(location.search);
        // Returning from the quote page → resume the tour at the given step.
        const resume = params.get("resume");
        if (resume) {
          let lead: any = null, emailed = false;
          try { lead = JSON.parse(sessionStorage.getItem("cr_lead") || "null"); emailed = sessionStorage.getItem("cr_emailed") === "1"; } catch {}
          if (lead) { LEAD = lead; EMAILED = emailed; gotoTour(Math.max(0, parseInt(resume, 10) - 2)); return; }
        }
        // Otherwise kick off the guided journey once the page has themed.
        setTimeout(step1, 700);
      }

      init();
    </script>
  </body>
</html>
