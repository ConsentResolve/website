---
import BaseLayout from "~/layouts/BaseLayout.astro";
import BookMeeting from "~/components/BookMeeting.astro";
import LeakVisual from "~/components/ui/demo/LeakVisual.astro";

// Book-a-meeting landing. Intake captures the lead + fires the "Book appointment"
// conversion on-page, then reveals the Google Calendar scheduler + the ungated live demo.
---

<BaseLayout
  ogImage="/og/demo.png"
  title="Book a Walkthrough — Consent Resolve"
  description="Book a 15-minute walkthrough and we'll show you the leads your website is already leaving on the table. Or try the 60-second live demo right now."
  noindex
>
  <section class="bg-[color:var(--color-bg-inverse)]">
    <div class="mx-auto max-w-6xl px-6 py-16 lg:py-24">
      <div class="grid items-start gap-12 lg:grid-cols-2">
        <div class="text-[color:var(--color-on-inverse)]">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[color:var(--color-brand)]">Book a walkthrough · 15 min</p>
          <h1 class="mt-3 font-display text-4xl font-bold leading-[1.05] tracking-tight md:text-5xl">
            See the leads your site is already leaving on the table.
          </h1>
          <p class="mt-5 max-w-md text-lg leading-relaxed text-[color:var(--color-on-inverse-muted)]">
            About 98% of the people who visit your website leave without ever filling out the form. On a quick call we'll show you — on your own site — how Consent Resolve recovers them as <strong>exclusive</strong> leads at a flat <strong>$7</strong>.
          </p>

          <ul class="mt-8 space-y-3">
            {[
              "A look at your own site's leak — not a generic pitch",
              "Exclusive leads, never resold. Flat $7, cancel anytime",
              "Consent-first: every lead carries a signed audit trail",
            ].map((t) => (
              <li class="flex gap-3 text-[color:var(--color-on-inverse)]">
                <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-brand)] text-xs font-bold text-[color:var(--color-on-brand)]">✓</span>
                <span>{t}</span>
              </li>
            ))}
          </ul>

          <p class="mt-8 text-sm text-[color:var(--color-on-inverse-muted)]">
            In a hurry? Skip the call and <a href="/demo/sample/" class="font-semibold text-[color:var(--color-brand)] underline underline-offset-2">try the 60-second live demo</a> — the lead is you.
          </p>
        </div>

        <div id="book">
          <BookMeeting />
        </div>
      </div>

      <div class="mt-14 max-w-3xl">
        <LeakVisual />
      </div>
    </div>
  </section>
</BaseLayout>
