---
import BaseLayout from "~/layouts/BaseLayout.astro";
import ClaimForm from "~/components/ClaimForm.astro";
import HowItWorks from "~/components/sections/HowItWorks.astro";
import FAQ from "~/components/sections/FAQ.astro";

const incl = [
  ["Exclusive leads", "yours alone at $7 — never resold"],
  ["We install it for you", "on the call — about 10 minutes"],
  ["Pay-as-you-go", "flat $7 a lead, no contract"],
];
const compare = [
  { tag: "Angi · Thumbtack · HomeAdvisor", head: "Someone else's list", tone: "them", items: ["Same homeowner sold to 4–5 shops", "You race to the bottom on price", "They never visited your site", "Pay whether it's your trade or not", "Contracts and monthly minimums"] },
  { tag: "Consent Resolve", head: "Your own traffic, with a name on it", tone: "us", items: ["One consent, one contractor — you", "They were already on your site", "They said yes before anyone was identified", "Only billed for real, consented contacts", "Flat $7, pay-as-you-go, no contract"] },
  { tag: "Doing nothing", head: "The quiet option", tone: "none", items: ["You keep paying for the same clicks", "98 of every 100 leave with no name", "The homeowner books whoever called first", "You never find out what you lost", "Your cost per booked job keeps climbing"] },
];
const offer = [
  ["Exclusive $7 leads", "Consented homeowners — real name, real email, and the job they were shopping for — land in your pipeline. Yours alone, never resold. A flat $7 a lead, pay-as-you-go.", "$7 / lead", true],
  ["We install it for you", "One line of code, pasted by us on the call. WordPress, Wix, Squarespace, ServiceTitan and most others. Live in about 10 minutes.", "Setup included", false],
  ["You only pay for real leads", "You're billed only for a consented, deliverable contact — ad-blocked, non-consenting, and bounced records are never billed. The system won't send the same lead twice; if a duplicate ever slips through, it's a 100% refund.", "Standing policy", false],
];
const faqs = [
  { question: "How does pricing work?", answer: "A flat $7 per resolved lead, pay-as-you-go. You buy leads in prepaid batches (the smallest is 14 for $98) with optional auto-renew, and each resolved lead draws one from your balance. No setup fee, no monthly minimum, no contract, and you can set a monthly spend cap so you're never surprised." },
  { question: "What if a lead is bad?", answer: "You're only ever billed for a real, consented, deliverable contact — ad-blocked, non-consenting, and hard-bounced records are never billed in the first place. And the system won't deliver the same lead twice; if a duplicate ever slips through, that's a 100% refund." },
  { question: "Will you sell my leads to the shop down the road?", answer: "No. Every lead is yours alone — never resold, never auctioned, never shared. One consent, one contractor." },
  { question: "Do I get phone numbers?", answer: "No, and that's deliberate. You get a name and a consented email plus what they were shopping for. They come back through your funnel and call you — no cold calls, no cold texts. That's what keeps it clean." },
  { question: "Is this legal?", answer: "Nobody is identified until the homeowner accepts your consent banner. Every reveal is timestamped and signed, and your policies stay current through our Termageddon partnership. Built to the GDPR standard, so the U.S. state patchwork is covered by design." },
  { question: "Do I have to drop my Google Ads or LSA?", answer: "Keep every channel that's working. This sits on top and catches the homeowners those channels already sent you — the ones about to walk out with no name." },
];
---

<BaseLayout
  ogImage="/og/demo.png"
  title="See It Live — Exclusive $7 Leads — Consent Resolve"
  description="Real homeowners who visited your site and said yes — name, email, and the job they were shopping for. A flat $7 a lead, pay-as-you-go, never resold. Live in about 10 minutes."
  noindex
  demoWidget={false}
>
  <!-- HERO — offer left, form right -->
  <section class="bg-[color:var(--color-bg-inverse)]">
    <div class="mx-auto max-w-6xl px-6 py-14 lg:py-20">
      <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_.95fr]">
        <div class="text-[color:var(--color-on-inverse)]">
          <p class="font-mono text-xs font-medium uppercase tracking-[0.16em] text-[color:var(--color-brand)]">For plumbers, roofers, HVAC &amp; electricians</p>
          <h1 class="mt-3 font-display text-4xl font-extrabold leading-[1.04] tracking-tight md:text-5xl">The homeowners already on your site — <span class="text-[color:var(--color-brand)]">with a name on them.</span></h1>
          <p class="mt-5 max-w-md text-lg leading-relaxed text-[color:var(--color-on-inverse-muted)]">Real homeowners who visited <em>your</em> site and said yes — name, email, and the job they were shopping for. <strong class="text-[color:var(--color-on-inverse)]">A flat $7 a lead, pay-as-you-go.</strong> Yours alone, never resold to the shop down the road.</p>
          <ul class="mt-7 space-y-2.5">
            {incl.map(([b, s]) => (
              <li class="flex items-start gap-3 text-[15px] text-[color:var(--color-on-inverse)]"><span class="mt-0.5 text-[color:var(--color-brand)]">✓</span><span><strong>{b}</strong> <span class="text-[color:var(--color-on-inverse-muted)]">{s}</span></span></li>
            ))}
          </ul>
        </div>

        <div id="claim" class="scroll-mt-24"><ClaimForm /></div>
      </div>
    </div>
  </section>

  <!-- TRUST STRIP -->
  <section class="border-b border-[color:var(--color-rule)] bg-[color:var(--color-bg)]">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-8 gap-y-3 px-6 py-5 text-sm text-[color:var(--color-ink-2)]">
      <span><strong class="text-[color:var(--color-ink)]">17 trades</strong> supported</span>
      <span>Yours alone, <strong class="text-[color:var(--color-ink)]">never resold</strong></span>
      <span>Policies current via <strong class="text-[color:var(--color-ink)]">Termageddon</strong></span>
      <span>Drops into <strong class="text-[color:var(--color-ink)]">Jobber, Housecall Pro, ServiceTitan</strong></span>
    </div>
  </section>

  <!-- ANIMATED, SELF-EXPLANATORY: the site's how-it-works StepFlow -->
  <HowItWorks />

  <!-- THIS ISN'T ANGI -->
  <section class="border-t border-[color:var(--color-rule)] bg-[color:var(--color-bg-alt)]">
    <div class="mx-auto max-w-6xl px-6 py-16 lg:py-20">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-bold tracking-tight text-[color:var(--color-ink)] md:text-4xl">You've bought "leads" before. This isn't that.</h2>
        <p class="mt-3 text-lg text-[color:var(--color-ink-2)]">If the word <em>leads</em> made you flinch, good. Here's the difference, laid out flat.</p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {compare.map((c) => (
          <div class={`rounded-2xl border p-6 ${c.tone === "us" ? "border-transparent bg-[color:var(--color-bg-inverse)] text-[color:var(--color-on-inverse)] shadow-lg" : "border-[color:var(--color-rule)] bg-[color:var(--color-bg)]"}`}>
            <p class={`font-mono text-[11px] uppercase tracking-[0.13em] ${c.tone === "us" ? "text-[color:var(--color-brand)]" : c.tone === "them" ? "text-[color:var(--color-danger)]" : "text-[color:var(--color-ink-muted)]"}`}>{c.tag}</p>
            <h3 class={`mt-3 font-display text-lg font-bold ${c.tone === "us" ? "text-[color:var(--color-on-inverse)]" : "text-[color:var(--color-ink)]"}`}>{c.head}</h3>
            <ul class="mt-4 space-y-2.5">
              {c.items.map((it) => (
                <li class={`flex gap-2.5 text-[15px] leading-snug ${c.tone === "us" ? "text-[color:var(--color-on-inverse-muted)]" : "text-[color:var(--color-ink-2)]"}`}><span class={c.tone === "us" ? "text-[color:var(--color-brand)]" : "text-[color:var(--color-danger)]"}>{c.tone === "us" ? "✓" : "✕"}</span>{it}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- OFFER STACK -->
  <section class="bg-[color:var(--color-bg)]">
    <div class="mx-auto max-w-6xl px-6 py-16 lg:py-20">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-bold tracking-tight text-[color:var(--color-ink)] md:text-4xl">What you walk away with — whether you stay or not.</h2>
        <p class="mt-3 text-lg text-[color:var(--color-ink-2)]">No slide deck. We open your Analytics, run your numbers, and install it while you watch.</p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {offer.map(([t, d, px, hero]) => (
          <div class={`rounded-2xl border p-6 ${hero ? "border-transparent bg-[color:var(--color-bg-inverse)] text-[color:var(--color-on-inverse)] shadow-lg md:col-span-2" : "border-[color:var(--color-rule)] bg-[color:var(--color-bg-alt)]"}`}>
            <h3 class={`font-display text-lg font-bold ${hero ? "text-[color:var(--color-on-inverse)]" : "text-[color:var(--color-ink)]"}`}>{t}</h3>
            <p class={`mt-2 text-[15px] leading-relaxed ${hero ? "text-[color:var(--color-on-inverse-muted)]" : "text-[color:var(--color-ink-2)]"}`}>{d}</p>
            <span class={`mt-3 inline-block rounded-md border border-dashed px-2.5 py-1 font-mono text-[11px] ${hero ? "border-[color:var(--color-brand)] text-[color:var(--color-brand)]" : "border-[color:var(--color-rule)] text-[color:var(--color-brand-pressed)]"}`}>{px}</span>
          </div>
        ))}
      </div>
      <p class="mt-8 text-center text-lg text-[color:var(--color-ink-2)]">You walk away with <strong class="font-display text-[color:var(--color-ink)]">$350+ in leads and setup</strong> — for 15 minutes.</p>
    </div>
  </section>

  <FAQ eyebrow="Before you claim" headline="The questions we get every day." items={faqs} />

  <!-- FINAL CTA -->
  <section class="bg-[color:var(--color-bg-inverse)]">
    <div class="mx-auto max-w-3xl px-6 py-16 text-center lg:py-20">
      <h2 class="font-display text-3xl font-bold tracking-tight text-[color:var(--color-on-inverse)] md:text-4xl">Every week you wait, another few hundred homeowners walk.</h2>
      <p class="mx-auto mt-3 max-w-lg text-[color:var(--color-on-inverse-muted)]">Worst case: 15 minutes, your real numbers, a working consent banner, and your real recovery numbers.</p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a href="#claim" class="inline-flex items-center justify-center rounded-lg bg-[color:var(--color-brand)] px-7 py-3.5 text-base font-bold text-[color:var(--color-on-brand)] transition-colors hover:bg-[color:var(--color-brand-pressed)]">See it live →</a>
        <a href="tel:+17279999846" class="inline-flex items-center justify-center rounded-lg border border-[color:var(--color-on-inverse-muted)] px-7 py-3.5 text-base font-bold text-[color:var(--color-on-inverse)] transition-colors hover:bg-white/5">Or call (727) 999-9846</a>
      </div>
    </div>
  </section>
</BaseLayout>
