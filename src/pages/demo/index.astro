---
import BaseLayout from "~/layouts/BaseLayout.astro";
import DemoForm from "~/components/DemoForm.astro";
import LeakVisual from "~/components/ui/demo/LeakVisual.astro";
import RecoveryCalculator from "~/components/ui/RecoveryCalculator.tsx";

// Direct-traffic landing for the live demo. Primary registration can also be
// embedded elsewhere via <DemoForm />. noindex — this is a tool, not content.
---

<BaseLayout
  title="Live Demo — See Consent Resolve work on yourself · Consent Resolve"
  description="Register, browse a sample trades site, consent on the banner, and get emailed the exact lead notification a business owner would receive — except the lead is you. About 60 seconds."
  noindex
>
  <section class="bg-[color:var(--color-bg-inverse)]">
    <div class="mx-auto max-w-6xl px-6 py-16 lg:py-24">
      <div class="grid items-start gap-12 lg:grid-cols-2">
        <div class="text-[color:var(--color-on-inverse)]">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[color:var(--color-brand)]">Live demo · ~60 seconds</p>
          <h1 class="mt-3 font-display text-4xl font-bold leading-[1.05] tracking-tight md:text-5xl">
            See it work on yourself.
          </h1>
          <p class="mt-5 max-w-md text-lg leading-relaxed text-[color:var(--color-on-inverse-muted)]">
            You play both roles. As the homeowner, accept the consent banner on a sample trades site. As the contractor, check your inbox — the new-lead notification is <em>you</em>.
          </p>

          <ol class="mt-8 space-y-4">
            {[
              ["Register", "We capture a consented email — just like a real homeowner."],
              ["Browse & consent", "Land on a sample trades site and accept the banner."],
              ["Get the lead", "Seconds later the lead hits your inbox — it's you. Then watch an abandoned quote come back."],
            ].map(([t, d], i) => (
              <li class="flex gap-4">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-brand)] text-sm font-bold text-[color:var(--color-on-brand)]">{i + 1}</span>
                <div>
                  <div class="font-semibold text-[color:var(--color-on-inverse)]">{t}</div>
                  <div class="text-sm text-[color:var(--color-on-inverse-muted)]">{d}</div>
                </div>
              </li>
            ))}
          </ol>

          <p class="mt-8 text-sm text-[color:var(--color-on-inverse-muted)]">
            Consent-first by design: nothing is identified until you say yes. Flat $7 a lead — yours alone, never resold.
          </p>
        </div>

        <div id="demo-register">
          <DemoForm />
        </div>
      </div>

      <div class="mt-14 max-w-3xl">
        <LeakVisual />
      </div>

      <!-- Motivation for direct /demo traffic: the same ripoff math, CTA scrolls
           back up to the registration form (the demo IS the conversion here). -->
      <div class="mt-16">
        <div class="mx-auto max-w-4xl text-center text-[color:var(--color-on-inverse)]">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[color:var(--color-brand)]">The lead-site math</p>
          <h2 class="mt-2 font-display text-2xl font-bold md:text-3xl">While you're here — what are your leads actually costing you?</h2>
        </div>
        <div class="mx-auto mt-6 max-w-4xl rounded-3xl bg-white/[0.03] p-3 ring-1 ring-inset ring-white/10 sm:p-4">
          <RecoveryCalculator
            client:visible
            variant="dark"
            mode="ripoff"
            title="What your leads really cost"
            blurb="Your numbers. The only fixed figure is the flat $7."
            ctaHref="#demo-register"
            ctaLabel="Register above to try it ↑"
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
