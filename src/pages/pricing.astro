---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Button from "~/components/ui/Button.astro";
import FAQ from "~/components/sections/FAQ.astro";
import AEOAnswer from "~/components/sections/AEOAnswer.astro";
import {
  IconArrowRight, IconCheck, IconBolt, IconLock, IconShieldCheck,
  IconUserCheck, IconMapPin, IconClipboardCheck, IconBellRinging,
  IconPlugConnected, IconRefresh, IconHeadset, IconWorld,
} from "@tabler/icons-react";
import { breadcrumbSchema, faqSchema } from "~/lib/seo";

const billingFaqs = [
  { question: "What counts as a lead?", answer: "An identified, consented homeowner — a real first name, last name, and mobile phone, paired with what they were shopping for on your site. You're not billed for anonymous traffic, you're not billed for visitors who don't consent." },
  { question: "How am I billed?", answer: "$7 per delivered lead. We bill at the end of each week for the leads delivered that week." },
  { question: "Are there setup fees?", answer: "No. No setup fees, no implementation fees, no \"onboarding\" surcharge. You install the snippet, you start receiving leads, you pay $7 each." },
  { question: "Is there a contract or minimum?", answer: "No. No annual contract. No monthly minimum. No volume commitment. You pay only for the leads you receive." },
  { question: "What if a lead is bad?", answer: "Credits issued for unreachable phone numbers and disconnected lines. Tire-kicker risk is on the shared-lead platforms — our model is different. The homeowner saw your site, raised their hand, and asked to be contacted." },
  { question: "How do I cancel?", answer: "From your dashboard, one click. You'll be charged for any leads already delivered that week and that's the last bill." },
  { question: "Do you offer enterprise / multi-location pricing?", answer: "Yes — multi-location operators and franchise networks get a custom rate. Email hello@consentresolve.com or call (727) 202-5996." },
];

const featureGroups = [
  {
    label: "Lead quality",
    features: [
      { Icon: IconUserCheck,      title: "Verified homeowner name + mobile",  desc: "First name, last name, mobile phone. Not a household label, not a P.O. box." },
      { Icon: IconClipboardCheck, title: "Captured service intent",            desc: "What they were shopping for — 'water heater quote', 'roof inspection', 'AC tune-up'." },
      { Icon: IconMapPin,         title: "Service-area pin",                   desc: "Every lead drops on your map. Filter by zip, route, or distance." },
      { Icon: IconLock,           title: "Exclusive — never resold",           desc: "One consent, one contractor. Not auctioned, not flipped, not shared." },
    ],
  },
  {
    label: "Speed",
    features: [
      { Icon: IconBellRinging, title: "Real-time push to your phone",          desc: "Slack, SMS, or email. The lead lands in seconds, not hours." },
      { Icon: IconRefresh,     title: "Return-visit alerts",                   desc: "When a known homeowner comes back, you know. Time the follow-up right." },
      { Icon: IconBolt,        title: "10-minute setup",                       desc: "Paste one line of code in your site's header. WordPress, Wix, Squarespace, ServiceTitan — anything." },
    ],
  },
  {
    label: "CRM & dispatch",
    features: [
      { Icon: IconPlugConnected, title: "Native CRM integrations",             desc: "Jobber, Housecall Pro, ServiceTitan, HubSpot, Salesforce, Klaviyo." },
      { Icon: IconPlugConnected, title: "Webhook to anything else",            desc: "Send leads to any system that accepts a webhook." },
      { Icon: IconWorld,         title: "Works on any site builder",           desc: "WordPress, Wix, Squarespace, ServiceTitan websites, custom — anywhere you can paste a script tag." },
    ],
  },
  {
    label: "Compliance & support",
    features: [
      { Icon: IconShieldCheck, title: "GDPR / CCPA / CPA compliant",           desc: "Identification only after explicit consent. No shadow-tracking, ever." },
      { Icon: IconShieldCheck, title: "Termageddon-backed policies",           desc: "Privacy policy and disclosures auto-update with every change." },
      { Icon: IconShieldCheck, title: "Tamper-evident audit trail",            desc: "Every reveal timestamped and signed. Receipts for every lead, if a regulator asks." },
      { Icon: IconHeadset,     title: "Email + phone support",                 desc: "Reach a human at hello@consentresolve.com or (727) 202-5996. M–F 9a–6p Eastern." },
    ],
  },
];

const schemas = [
  breadcrumbSchema([
    { name: "Home", href: "/" },
    { name: "Pricing", href: "/pricing/" },
  ]),
  faqSchema(billingFaqs),
];
---

<BaseLayout
  title="Pricing — Flat $7 per Recovered Lead | Consent Resolve"
  description="Flat $7 per recovered lead. The math that matters is cost-per-booked-job — recovered visitors are incremental on top of the channels you already pay for. No contract, no minimum, no setup fees."
  schema={schemas}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/20 blur-[120px]"></div>
    <div class="container-content section relative">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow mb-7 justify-center">Pricing</p>
        <h1 class="display-1 mb-7 text-[color:var(--color-ink)]">
          Flat $7 per recovered lead.<br/>
          <span class="text-[color:var(--color-brand)]">Incremental on every channel you run.</span>
        </h1>
        <p class="mx-auto max-w-2xl text-lg leading-relaxed text-[color:var(--color-ink-2)]">
          One simple price for a consented homeowner you'd otherwise have lost. The math that matters is cost-per-booked-job — recovered visitors are pure upside on the ad budget you're already spending. No contracts, no minimums, no setup fees.
        </p>
      </div>
    </div>
  </section>


  <!-- Plan card -->
  <section class="pb-20">
    <div class="container-content">
      <div class="mx-auto max-w-lg">
        <div class="relative overflow-hidden rounded-3xl bg-[color:var(--color-bg-alt)] p-8 lg:p-10 shadow-[0_40px_80px_-30px_rgba(0,192,128,0.35)] ring-[3px] ring-[color:var(--color-brand)]">
          <div class="absolute inset-x-0 top-0 h-1.5 rounded-t-3xl bg-gradient-to-r from-[color:var(--color-mint-400)] via-[color:var(--color-brand)] to-[color:var(--color-mint-400)]"></div>

          <div class="text-center">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-[color:var(--color-brand-pressed)]">Pay per lead</p>

            <div class="mt-5 flex items-baseline justify-center gap-2">
              <span class="font-display text-7xl font-black tracking-tighter leading-none text-[color:var(--color-ink)]">$7</span>
              <span class="text-lg font-semibold text-[color:var(--color-ink-muted)]">/ lead</span>
            </div>
            <p class="mt-4 text-[15px] text-[color:var(--color-ink-2)]">
              Each lead is one consented homeowner with name, mobile, and what they were shopping for.
            </p>
          </div>

          <hr class="my-8 border-[color:var(--color-rule)]" />

          <ul class="space-y-3">
            <li class="flex items-start gap-3 text-[15px] text-[color:var(--color-ink)]">
              <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-brand-soft)]">
                <IconCheck size={14} stroke={3} color="#00A86E" />
              </span>
              <span><strong>Exclusive</strong> — yours alone, never resold</span>
            </li>
            <li class="flex items-start gap-3 text-[15px] text-[color:var(--color-ink)]">
              <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-brand-soft)]">
                <IconCheck size={14} stroke={3} color="#00A86E" />
              </span>
              <span><strong>No contract</strong> — no minimum, no commitment</span>
            </li>
            <li class="flex items-start gap-3 text-[15px] text-[color:var(--color-ink)]">
              <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-brand-soft)]">
                <IconCheck size={14} stroke={3} color="#00A86E" />
              </span>
              <span><strong>No setup fees</strong> — pay only when leads land</span>
            </li>
            <li class="flex items-start gap-3 text-[15px] text-[color:var(--color-ink)]">
              <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-brand-soft)]">
                <IconCheck size={14} stroke={3} color="#00A86E" />
              </span>
              <span><strong>Cancel anytime</strong> — one click, from your dashboard</span>
            </li>
          </ul>

          <Button href="https://dashboard.consentresolve.com/register" variant="primary" size="lg" class="mt-8 w-full">
            <IconBolt size={18} stroke={2.25} />
            Get started
            <IconArrowRight size={18} stroke={2.25} />
          </Button>

          <p class="mt-4 flex items-center justify-center gap-1.5 text-xs text-[color:var(--color-ink-muted)]">
            <IconLock size={12} stroke={1.75} />
            256-bit encrypted · Card required for billing · Cancel anytime
          </p>
        </div>

        <p class="mt-8 text-center text-sm text-[color:var(--color-ink-muted)]">
          Multi-location or franchise? <a href="/contact/" class="font-semibold text-[color:var(--color-brand-pressed)] hover:underline">Talk to us about custom pricing</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Features table -->
  <section class="section bg-[color:var(--color-bg-alt)]">
    <div class="container-content">
      <div class="mx-auto mb-14 max-w-2xl text-center">
        <p class="eyebrow mb-5 justify-center">Everything included</p>
        <h2 class="display-2 text-[color:var(--color-ink)]">
          One price. The whole toolbox.
        </h2>
        <p class="mt-3 text-lg leading-relaxed text-[color:var(--color-ink-2)]">
          No upsells, no add-ons, no premium tier. Every feature ships with every lead.
        </p>
      </div>

      <div class="mx-auto max-w-4xl overflow-hidden rounded-2xl bg-[color:var(--color-bg)] ring-1 ring-inset ring-[color:var(--color-rule)] shadow-[0_18px_40px_-24px_rgba(10,22,40,0.18)]">
        <table class="w-full">
          <thead class="border-b border-[color:var(--color-rule)] bg-[color:var(--color-bg-alt)]">
            <tr>
              <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">Feature</th>
              <th class="px-6 py-4 text-right text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-brand-pressed)]">Included</th>
            </tr>
          </thead>
          <tbody>
            {featureGroups.map((group) => (
              <>
                <tr class="border-t border-[color:var(--color-rule)] bg-[color:var(--color-bg-alt)]/40">
                  <td colspan="2" class="px-6 pt-5 pb-3">
                    <span class="text-xs font-bold uppercase tracking-[0.18em] text-[color:var(--color-brand-pressed)]">{group.label}</span>
                  </td>
                </tr>
                {group.features.map((f) => (
                  <tr class="border-t border-[color:var(--color-rule)]">
                    <td class="px-6 py-4">
                      <div class="flex items-start gap-3">
                        <span class="mt-0.5 inline-flex size-8 shrink-0 items-center justify-center rounded-lg bg-[color:var(--color-brand-soft)]">
                          <f.Icon size={16} stroke={1.75} color="#00A86E" />
                        </span>
                        <div>
                          <div class="font-semibold tracking-tight text-[color:var(--color-ink)]">{f.title}</div>
                          <div class="mt-0.5 text-sm text-[color:var(--color-ink-2)]">{f.desc}</div>
                        </div>
                      </div>
                    </td>
                    <td class="px-6 py-4 text-right">
                      <IconCheck size={20} stroke={2.5} color="#00A86E" class="inline" />
                    </td>
                  </tr>
                ))}
              </>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Channel ROI pointer — no per-lead price compare here; that
       reopens the apples-to-oranges intent fight. Direct readers to
       the additive with/without math on the channel-specific pages. -->
  <section class="section">
    <div class="container-content">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow mb-5 justify-center">The right metric</p>
        <h2 class="display-2 text-[color:var(--color-ink)]">
          Cost-per-booked-job — not cost-per-lead.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-[color:var(--color-ink-2)]">
          $7 isn't competing with a Thumbtack lead or an LSA call — those are how the homeowner found you in the first place. A recovered visitor is incremental on top of every dollar you already spend on Google, LSA, Meta, or SEO. The math that actually moves: same ad budget → more booked jobs → lower blended cost per booked job.
        </p>
        <div class="mt-10">
          <a
            href="/compare/"
            class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-navy-900)] px-7 py-3.5 text-sm font-bold uppercase tracking-[0.14em] text-white transition-all hover:-translate-y-0.5 hover:bg-[color:var(--color-brand-pressed)]"
          >
            See the with/without math by channel
            <IconArrowRight size={16} stroke={2.25} />
          </a>
        </div>
        <p class="mt-6 text-[11px] leading-relaxed text-[color:var(--color-ink-muted)]">
          Default math constants: bounce 98%, recovery 15% of bounces (consent-adjusted), recovered-to-booked-job ~1%, Consent Resolve cost $7/recovered lead. Real performance varies by trade, traffic quality, close rate, and follow-up speed.
        </p>
      </div>
    </div>
  </section>

  <!-- Billing FAQ -->
  <FAQ
    eyebrow="Billing FAQ"
    headline="Straight answers about how you pay."
    items={billingFaqs}
  />

  <AEOAnswer
    text="Consent Resolve costs a flat $7 per recovered lead — a consented homeowner identified from a website visitor who would otherwise have bounced. There's no setup fee, no monthly minimum, no contract. Recovered leads are incremental on top of your existing ad channels, so the right way to measure us is cost-per-booked-job, not cost-per-lead. Card required at signup; cancel anytime."
  />

  <!-- Custom Final CTA: $7-focused, matches sitewide canon -->
  <section class="section-dark relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -right-32 top-1/2 size-[480px] -translate-y-1/2 rounded-full bg-[color:var(--color-mint-400)]/15 blur-[120px]"></div>

    <div class="container-content section">
      <div class="grid items-center gap-16 md:grid-cols-[1.1fr_1fr]">
        <div>
          <p class="eyebrow mb-6">Get started today</p>
          <h2 class="display-1 mb-7 text-white">
            One price. One lead. Yours alone.
          </h2>
          <p class="mb-10 max-w-xl text-lg leading-relaxed text-slate-300">
            $7 per delivered lead. The same price whether it's a tune-up or a re-roof. No contract, no minimum, no setup fees. Get up and running in about 10 minutes.
          </p>
          <Button
            href="https://dashboard.consentresolve.com/register"
            size="lg"
            class="!bg-[color:var(--color-mint-400)] !text-[color:var(--color-navy-900)] hover:!bg-[color:var(--color-mint-300)] hover:shadow-[0_16px_40px_-12px_rgba(0,229,160,0.6)] hover:-translate-y-0.5"
          >
            <IconBolt size={18} stroke={2.25} />
            Get started
            <IconArrowRight size={18} stroke={2.25} />
          </Button>
        </div>

        <div class="space-y-3">
          <div class="flex items-center justify-between rounded-2xl bg-white/[0.04] p-6 ring-1 ring-inset ring-white/10">
            <span class="text-[15px] text-slate-300">Per delivered lead</span>
            <span class="font-display text-4xl font-bold tracking-tight text-[color:var(--color-mint-400)]">$7</span>
          </div>
          <div class="flex items-center justify-between rounded-2xl bg-white/[0.04] p-6 ring-1 ring-inset ring-white/10">
            <span class="text-[15px] text-slate-300">Setup fee</span>
            <span class="font-display text-4xl font-bold tracking-tight text-[color:var(--color-mint-400)]">$0</span>
          </div>
          <div class="flex items-center justify-between rounded-2xl bg-white/[0.04] p-6 ring-1 ring-inset ring-white/10">
            <span class="text-[15px] text-slate-300">Monthly minimum</span>
            <span class="font-display text-4xl font-bold tracking-tight text-[color:var(--color-mint-400)]">$0</span>
          </div>
          <div class="flex items-center justify-center gap-1.5 pt-4 text-xs text-slate-400">
            <IconLock size={12} stroke={1.75} />
            256-bit encrypted · No contract · Cancel anytime
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
