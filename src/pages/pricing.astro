---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Badge from "~/components/ui/Badge.astro";
import Button from "~/components/ui/Button.astro";
import FAQ from "~/components/sections/FAQ.astro";
import AEOAnswer from "~/components/sections/AEOAnswer.astro";
import PricingFeatureTable from "~/components/ui/PricingFeatureTable.astro";
import MetricRow from "~/components/ui/MetricRow.astro";
import {
  IconArrowRight, IconCheck, IconBolt, IconLock, IconShieldCheck,
  IconUserCheck, IconMapPin, IconClipboardCheck, IconBellRinging,
  IconPlugConnected, IconRefresh, IconHeadset, IconWorld,
  IconEye, IconAddressBook, IconChartHistogram, IconStar, IconCode,
  IconCircleCheck, IconMessage,
} from "@tabler/icons-react";
import { breadcrumbSchema, faqSchema } from "~/lib/seo";

const billingFaqs = [
  { question: "What counts as a lead?", answer: "An identified, consented contact — a verified email tied to a real person, with what they were shopping for, enriched with name and location where available. You're never billed for anonymous traffic, non-consenting visitors, or ad-blocked records." },
  { question: "How am I billed?", answer: "Custom pricing, built around your traffic. You're only ever billed for a real, consented, deliverable lead — no monthly fee, no platform fee, no setup fee." },
  { question: "Are there setup fees?", answer: "No. No setup fees, no implementation fees, no \"onboarding\" surcharge, and no monthly platform fee. You install the snippet and pay only for real, consented leads — that's it." },
  { question: "Is there a contract or minimum?", answer: "No annual contract, no monthly minimum, no volume commitment. You only pay for the leads you actually get, at the same rate every time." },
  { question: "Do you bill for ad-blocked records?", answer: "No. Ad-blocked or zero-engagement records are never billed. You only pay for a consented, deliverable contact." },
  { question: "What if a lead is bad?", answer: "Sales are final — we don't refund a lead you simply didn't close — and you're only ever billed for a consented, deliverable contact in the first place: ad-blocked, non-consenting, and hard-bounced or invalid records are never billed. The one exception is a duplicate: our backend won't deliver the same lead twice, but in the rare event one slips through, that's a 100% refund." },
  { question: "How do I cancel?", answer: "There's nothing to cancel — no contract. Stop whenever you want and you're only ever charged for the real, consented leads you already received." },
  { question: "Do you offer enterprise / multi-location pricing?", answer: "Yes — high-volume and multi-location operators get a custom rate. Email hello@consentresolve.com or call (727) 999-9846." },
];

// Mirrors the /features/ page — same capabilities, same groups, so the
// "everything included" table never drifts from the feature catalog.
const featureGroups = [
  {
    label: "See the leads",
    features: [
      { Icon: IconEye,            title: "Visitor Identification",   desc: "See the real visitors behind your traffic — name and email, only after they consent." },
      { Icon: IconBolt,           title: "Instant Retarget",         desc: "Tag every consented ad click and track it all the way to closed revenue." },
      { Icon: IconRefresh,        title: "Return-Visit Alerts",      desc: "Know when a recovered visitor is back on your site, so your funnel timing is right." },
      { Icon: IconAddressBook,    title: "Formless Contact Capture", desc: "Catch the 98% who never fill a form — a consented email, with name and location where available." },
    ],
  },
  {
    label: "Sort the serious",
    features: [
      { Icon: IconChartHistogram, title: "Browse History",           desc: "Every lead arrives with what they viewed, in what order, and for how long." },
      { Icon: IconStar,           title: "Lead Sorting",             desc: "Leads ranked hot, warm, or just browsing — work the hot ones first." },
      { Icon: IconChartHistogram, title: "Most Viewed Pages",        desc: "See which pages real, identified visitors look at most." },
    ],
  },
  {
    label: "Close the deal",
    features: [
      { Icon: IconRefresh,        title: "Ad Retargeting Audiences", desc: "Push identified visitors into Facebook and Google as ready-made audiences." },
      { Icon: IconPlugConnected,  title: "Integrations",             desc: "HubSpot, Salesforce, Pipedrive, Klaviyo, and more." },
      { Icon: IconCode,           title: "API & Webhooks",           desc: "Send recovered records anywhere your business needs them." },
    ],
  },
  {
    label: "Stay legal",
    features: [
      { Icon: IconUserCheck,      title: "Cookie Consent Banner",    desc: "A clean, compliant banner — and what unlocks every lead." },
      { Icon: IconCircleCheck,    title: "Consent Records",          desc: "Every lead carries proof they said yes — date, time, and source." },
      { Icon: IconShieldCheck,    title: "Privacy-Law Compliance",   desc: "Built for TCPA, CIPA, and state privacy laws like the Texas TDPSA." },
      { Icon: IconMessage,        title: "Law-Change Alerts",        desc: "When a law changes that affects you, we email it in plain English." },
      { Icon: IconClipboardCheck, title: "Audit-Ready Records",      desc: "Records organized and ready to export if anyone ever asks." },
    ],
  },
];

const schemas = [
  breadcrumbSchema([
    { name: "Home", href: "/" },
    { name: "Pricing", href: "/pricing/" },
  ]),
  faqSchema(billingFaqs),
];
---

<BaseLayout
  ogImage="/og/pricing.png"
  title="Pricing — Exclusive Leads, Yours Alone · Consent Resolve"
  ogTitle="Custom pricing per lead. Exclusive. No contract."
  description="Custom pricing per recovered lead — no contract, no minimum, no setup fees. The math that matters is cost-per-deal, and recovered visitors are incremental."
  schema={schemas}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/20 blur-[120px]"></div>
    <div class="container-content section relative">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-7 flex justify-center"><Badge tone="brand" variant="soft" size="md" uppercase>Pricing</Badge></div>
        <h1 class="display-1 mb-7 text-[color:var(--color-ink)]">
          One Price Turns an Anonymous Visitor <span class="text-[color:var(--color-brand)]">Into Your Next Deal.</span>
        </h1>
        <p class="mx-auto max-w-2xl text-lg leading-relaxed text-[color:var(--color-ink-2)]">
          One custom price for a consented visitor you'd otherwise have lost — on top of every channel you already run. The math that matters is cost-per-deal. No contracts, no minimums, no setup fees.
        </p>
      </div>
    </div>
  </section>


  <!-- Plan card -->
  <section class="pb-20">
    <div class="container-content">
      <div class="mx-auto max-w-lg">
        <div class="relative overflow-hidden rounded-3xl bg-[color:var(--color-bg-alt)] p-8 lg:p-10 shadow-[0_40px_80px_-30px_rgba(0,192,128,0.35)] ring-[3px] ring-[color:var(--color-brand)]">
          <div class="absolute inset-x-0 top-0 h-1.5 rounded-t-3xl bg-gradient-to-r from-[color:var(--color-mint-400)] via-[color:var(--color-brand)] to-[color:var(--color-mint-400)]"></div>

          <div class="text-center">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-[color:var(--color-brand-pressed)]">Pay per lead</p>

            <div class="mt-5 flex items-baseline justify-center gap-2">
              <span class="font-display text-5xl font-black tracking-tighter leading-none text-[color:var(--color-ink)]">Custom</span>
              <span class="text-lg font-semibold text-[color:var(--color-ink-muted)]">/ lead</span>
            </div>
            <p class="mt-4 text-[15px] text-[color:var(--color-ink-2)]">
              Built around your traffic and needs. Each lead is one consented visitor — a deliverable email, name and location where available, and what they were shopping for.
            </p>
          </div>

          <hr class="my-8 border-[color:var(--color-rule)]" />

          <ul class="space-y-3">
            <li class="flex items-start gap-3 text-[15px] text-[color:var(--color-ink)]">
              <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-brand-soft)]">
                <IconCheck size={14} stroke={3} color="#00A86E" />
              </span>
              <span><strong>Exclusive</strong> — yours alone, never resold</span>
            </li>
            <li class="flex items-start gap-3 text-[15px] text-[color:var(--color-ink)]">
              <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-brand-soft)]">
                <IconCheck size={14} stroke={3} color="#00A86E" />
              </span>
              <span><strong>No contract</strong> — no minimum, no commitment</span>
            </li>
            <li class="flex items-start gap-3 text-[15px] text-[color:var(--color-ink)]">
              <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-brand-soft)]">
                <IconCheck size={14} stroke={3} color="#00A86E" />
              </span>
              <span><strong>No setup fees</strong> — pay only when leads land</span>
            </li>
            <li class="flex items-start gap-3 text-[15px] text-[color:var(--color-ink)]">
              <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-brand-soft)]">
                <IconCheck size={14} stroke={3} color="#00A86E" />
              </span>
              <span><strong>No contract</strong> — stop anytime, one click from your dashboard</span>
            </li>
          </ul>

          <Button href="https://dashboard.consentresolve.com/register" variant="primary" size="lg" class="mt-8 w-full">
            <IconBolt size={18} stroke={2.25} />
            Get started
            <IconArrowRight size={18} stroke={2.25} />
          </Button>

          <p class="mt-4 flex items-center justify-center gap-1.5 text-xs text-[color:var(--color-ink-muted)]">
            <IconLock size={12} stroke={1.75} />
            Encrypted in transit and at rest · Card required to buy leads · Pay-as-you-go, no contract
          </p>
        </div>

        <p class="mt-8 text-center text-sm text-[color:var(--color-ink-muted)]">
          Multi-location or franchise? <a href="/contact/" class="font-semibold text-[color:var(--color-brand-pressed)] hover:underline">Talk to us about custom pricing</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Features table -->
  <section class="section bg-[color:var(--color-bg-alt)]">
    <div class="container-content">
      <div class="mx-auto mb-14 max-w-2xl text-center">
        <div class="mb-5 flex justify-center"><Badge tone="brand" variant="soft" size="md" uppercase>Everything included</Badge></div>
        <h2 class="display-2 text-[color:var(--color-ink)]">
          One price. The whole toolbox.
        </h2>
        <p class="mt-3 text-lg leading-relaxed text-[color:var(--color-ink-2)]">
          No upsells, no add-ons, no premium tier. Every feature ships with every lead.
        </p>
      </div>

      <PricingFeatureTable groups={featureGroups} />
    </div>
  </section>

  <!-- The right metric — no per-lead price compare here; that reopens
       the apples-to-oranges intent fight against named competitors,
       a category this site no longer positions against. -->
  <section class="section">
    <div class="container-content">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-5 flex justify-center"><Badge tone="brand" variant="soft" size="md" uppercase>The right metric</Badge></div>
        <h2 class="display-2 text-[color:var(--color-ink)]">
          Cost-per-deal — not cost-per-lead.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-[color:var(--color-ink-2)]">
          A recovered lead isn't competing with the channel that brought the visitor to you in the first place — that's how they found you. It's incremental on top of every dollar you already spend on search, social, or SEO. The math that actually moves: same marketing spend → more deals → lower blended cost per deal.
        </p>
        <p class="mt-6 text-[11px] leading-relaxed text-[color:var(--color-ink-muted)]">
          A typical site resolves about 16–19% of its visitors to an identified lead (~160–185 per 1,000/month) — roughly 75% accept the consent banner and we identify about a quarter of those. Close rates are your own — set your assumptions in the calculator. Sourced industry data lives on /stats/.
        </p>
      </div>
    </div>
  </section>

  <!-- Billing FAQ -->
  <FAQ
    eyebrow="Billing FAQ"
    headline="Straight answers about how you pay."
    items={billingFaqs}
  />

  <AEOAnswer
    text="Consent Resolve costs a custom price per recovered lead — a consented visitor identified from a website visit that would otherwise have bounced. There's no setup fee, no monthly minimum, no contract — you're simply billed for each real, consented lead at your agreed rate. A typical site resolves about 16–19% of its visitors to a lead (~160–185 per 1,000/month). Recovered leads are incremental on top of your existing marketing channels, so the right way to measure us is cost-per-deal, not cost-per-lead. Sales are final — the only refund is a duplicate lead, which the system prevents and refunds 100% if one ever slips through."
  />

  <!-- Custom Final CTA: $7-focused, matches sitewide canon -->
  <section class="section-dark relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -right-32 top-1/2 size-[480px] -translate-y-1/2 rounded-full bg-[color:var(--color-mint-400)]/15 blur-[120px]"></div>

    <div class="container-content section">
      <div class="grid items-center gap-16 md:grid-cols-[1.1fr_1fr]">
        <div>
          <div class="mb-6"><Badge tone="brand" variant="soft" surface="dark" size="md" uppercase>Get started today</Badge></div>
          <h2 class="display-1 mb-7 text-white">
            One price. One lead. Yours alone.
          </h2>
          <p class="mb-10 max-w-xl text-lg leading-relaxed text-slate-300">
            One custom price per delivered lead, whatever the deal size. No contract, no minimum, no setup fees. Get up and running in about 10 minutes.
          </p>
          <Button
            href="https://dashboard.consentresolve.com/register"
            size="lg"
            class="!bg-[color:var(--color-mint-400)] !text-[color:var(--color-navy-900)] hover:!bg-[color:var(--color-mint-300)] hover:shadow-[0_16px_40px_-12px_rgba(0,229,160,0.6)] hover:-translate-y-0.5"
          >
            <IconBolt size={18} stroke={2.25} />
            Get started
            <IconArrowRight size={18} stroke={2.25} />
          </Button>
        </div>

        <div class="space-y-3">
          <MetricRow label="Per delivered lead" value="Custom" surface="dark" tone="brand" />
          <MetricRow label="Setup fee"          value="$0" surface="dark" tone="brand" />
          <MetricRow label="Monthly minimum"    value="$0" surface="dark" tone="brand" />
          <div class="flex items-center justify-center gap-1.5 pt-4 text-xs text-slate-400">
            <IconLock size={12} stroke={1.75} />
            Encrypted in transit and at rest · No contract · Pay-as-you-go
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
