---
/**
 * /agency-partners/ — the agency & consultant reseller landing page.
 *
 * UNLINKED BY DESIGN: not in PRIMARY_NAV / FOOTER_NAV, excluded from the sitemap
 * (see astro.config.mjs filter), and noindexed. Reachable only by direct URL —
 * a page to hand to agency prospects, not a public SEO surface.
 *
 * Built on BaseLayout so it carries the real nav, footer, fonts (Bricolage +
 * Hanken), and CMP. Styles are scoped under `.ap` and recolored from the
 * standalone mockup to the site palette (navy/mint/paper). Voice: /style-guide/
 * voice/ — 98%, $7 flat, exclusive, never resold, consent-first; audience is the
 * agency owner, not the contractor.
 *
 * PLACEHOLDER ECONOMICS: the margin calculator's wholesale/margin numbers are
 * illustrative — Aaron/Jason ratify wholesale price + suggested retail before this
 * goes to partners.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";

const APPLY =
  "mailto:hello@consentresolve.com?subject=Founding%20Partner%20Application";
---

<BaseLayout
  noindex
  title="Agency Partners — Consent Resolve"
  description="Sell your clients the consent-first lead layer you wish existed: exclusive $7 leads, wholesale margin for you, and a written pledge that we'll never touch your clients."
>
  <div class="ap">
    <!-- ================= HERO ================= -->
    <header class="hero">
      <div class="wrap hero-grid">
        <div>
          <span class="eyebrow">For agencies &amp; consultants</span>
          <h1>Your clients' sites leak leads. <span class="hl">Sell them the fix.</span></h1>
          <p class="sub">98 of 100 visitors your campaigns send to a client's site leave without a name. Consent Resolve recovers them as consented, exclusive leads — under your brand, at your margin. Same ad spend. Better numbers on your next report.</p>
          <div class="hero-ctas">
            <a class="btn btn-primary" href="#offer">Apply for a founding seat →</a>
            <a class="btn btn-ghost" href="#calc">Run your margin math</a>
          </div>
          <p class="hero-note">Application-based. We cap partners per trade so your clients get exclusivity — and so do you.</p>
        </div>
        <!-- Right panel: multi-client agency dashboard mock -->
        <div class="panel" aria-label="Agency dashboard preview">
          <div class="panel-head">Agency view · <span>All clients</span><span>This week</span></div>
          <div class="client-row">
            <div><div class="client-name">Summit Roofing Co.</div><div class="client-trade">Roofing · Tyler, TX</div></div>
            <span class="pill pill-mint">14 recovered</span>
          </div>
          <div class="client-row">
            <div><div class="client-name">Bayline Plumbing</div><div class="client-trade">Plumbing · Clearwater, FL</div></div>
            <span class="pill pill-mint">9 recovered</span>
          </div>
          <div class="client-row">
            <div><div class="client-name">TrueAir Heating &amp; Cooling</div><div class="client-trade">HVAC · Conroe, TX</div></div>
            <span class="pill pill-mint">17 recovered</span>
          </div>
          <div class="panel-foot">40 consented leads · every one exclusive to its contractor</div>
        </div>
      </div>
    </header>

    <!-- ================= PROBLEM STATS (dark) ================= -->
    <section class="dband">
      <div class="wrap">
        <span class="eyebrow">The leak in your reporting</span>
        <h2 class="sec">You built the funnel. The site drops the ball.</h2>
        <p class="kicker">You win the click, the visit, even the quote-page view. Then the homeowner leaves without a name — and your report shows spend with nothing to point at.</p>
        <div class="stakes">
          <div class="stake red">
            <div class="big">98%</div>
            <div class="lbl">of visitors leave anonymous</div>
            <p>Traffic you already earned for the client walks out the door with no email, no record, no credit to your campaign.</p>
          </div>
          <div class="stake red">
            <div class="big">1.2×</div>
            <div class="lbl">is a firing-call ROAS</div>
            <p>When the numbers look thin, the client blames the agency — not the leaky site. You know how that call ends.</p>
          </div>
          <div class="stake">
            <div class="big">$7</div>
            <div class="lbl">turns the leak into your line item</div>
            <p>Every recovered visitor becomes a consented, exclusive lead in the client's CRM — attributable to the funnel you run.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= THE PLEDGE (signature element) ================= -->
    <section>
      <div class="wrap pledge-wrap">
        <div>
          <span class="eyebrow">The part nobody else will sign</span>
          <h2 class="sec">Your clients stay yours. In writing.</h2>
          <p class="kicker" style="margin-bottom:18px">You've watched software vendors buy agencies, launch "marketing pro" add-ons, and go direct to your clients. We built Consent Resolve to be the layer under your work — never a competitor to it.</p>
          <p class="kicker">So we put the promise in the partner agreement, not just on this page. If a vendor can't sign these three lines, ask why.</p>
        </div>
        <div class="contract" role="img" aria-label="The Partner Pledge, a signed three-point agreement">
          <div class="doc-title">The Partner Pledge</div>
          <ol>
            <li><strong>We will never sell marketing services.</strong> Not ads, not SEO, not websites. That's your business, and we stay out of it.</li>
            <li><strong>We will never go direct to your clients.</strong> Accounts you bring stay billed, branded, and owned by you.</li>
            <li><strong>Your data stays yours.</strong> Client lists, lead records, and reporting are never used to sell around you.</li>
          </ol>
          <div class="sig-line">
            <span class="sig">Consent Resolve</span>
            <span>Signed with every partner agreement</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= PILLARS ================= -->
    <section style="padding-top:0">
      <div class="wrap">
        <div class="pillars">
          <div class="pillar">
            <div class="tile">📈</div>
            <h3>Your reports get better</h3>
            <p>Recovered leads flow from the traffic you already run. Same spend, more names in the CRM — and your retainer call gets a lot easier.</p>
          </div>
          <div class="pillar">
            <div class="tile">💵</div>
            <h3>You keep the margin</h3>
            <p>Buy at wholesale, bill it your way — line item, bundle, or managed service. Recurring revenue on every client site you manage.</p>
          </div>
          <div class="pillar">
            <div class="tile">🛡️</div>
            <h3>You carry less risk</h3>
            <p>Every reveal happens after the homeowner consents — timestamped and signed. No fingerprinting scripts on client sites with your agency's name on the install.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= CALCULATOR ================= -->
    <section id="calc" style="padding-top:0">
      <div class="wrap">
        <span class="eyebrow">Margin math</span>
        <h2 class="sec">What's this worth to your shop?</h2>
        <p class="kicker">Drag the sliders. Numbers update as you go.</p>
        <div class="calc">
          <div>
            <label for="clients">Client sites you manage: <span class="val" id="clientsVal">12</span></label>
            <input type="range" id="clients" min="1" max="150" value="12">
            <label for="leads">Recovered leads per site / month: <span class="val" id="leadsVal">25</span></label>
            <input type="range" id="leads" min="5" max="100" value="25" step="5">
            <label for="margin">Your margin per lead: $<span class="val" id="marginVal">3</span></label>
            <input type="range" id="margin" min="1" max="10" value="3">
            <p class="calc-note">Illustrative. Wholesale partner pricing is set in your agreement — placeholder math shown here.</p>
          </div>
          <div class="metric-rows">
            <div class="metric-row"><span class="m-lbl">Leads recovered / month</span><span class="m-val" id="outLeads">300</span></div>
            <div class="metric-row"><span class="m-lbl">New client value delivered</span><span class="m-val" id="outValue">$2,100</span></div>
            <div class="metric-row hero-metric"><span class="m-lbl">Your new monthly margin</span><span class="m-val" id="outMargin">$900/mo</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= RISK VS CONSENT ================= -->
    <section class="dband">
      <div class="wrap">
        <span class="eyebrow">The switch pitch</span>
        <h2 class="sec">Half your market runs visitor-ID that asks nobody.</h2>
        <p class="kicker">Plenty of agencies already resell identity pixels. Most of those tools never ask the homeowner a thing — and the agency that installed them sits closest to the problem. Here's the pitch that wins those accounts.</p>
        <div class="moat">
          <div class="moat-col moat-red">
            <h3>Scrape-and-spray pixels</h3>
            <ul>
              <li>Identifies visitors who never agreed to anything</li>
              <li>Fingerprinting and probabilistic matching</li>
              <li>Wiretap-style claims are landing on exactly these tools — with the installer in the conversation</li>
              <li>Leads the client can't defend if a lawyer asks</li>
            </ul>
          </div>
          <div class="moat-col moat-mint">
            <h3>Consent Resolve</h3>
            <ul>
              <li>Identification only after the homeowner says yes</li>
              <li>Deterministic match — never fingerprinting</li>
              <li>Every reveal timestamped and signed. Receipts, on file</li>
              <li>Built to the strictest standard (GDPR), so the U.S. patchwork — TCPA, CIPA, Texas TDPSA — is covered by design</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= HOW IT WORKS FOR PARTNERS ================= -->
    <section>
      <div class="wrap">
        <span class="eyebrow">The plan</span>
        <h2 class="sec">Live on your first client site this week.</h2>
        <div class="steps">
          <div class="step"><div class="num">1</div><h3>Apply</h3><p>15-minute call. We check trade fit and confirm your seat's open.</p></div>
          <div class="step"><div class="num">2</div><h3>Get wholesale access</h3><p>Partner dashboard, wholesale pricing, and white-label reporting under your brand.</p></div>
          <div class="step"><div class="num">3</div><h3>Add one line per site</h3><p>Drop the snippet on a client site. Live in about 10 minutes. Works on WordPress, Wix, Squarespace, most builders.</p></div>
          <div class="step"><div class="num">4</div><h3>Bill it your way</h3><p>Consented, exclusive leads land in each client's CRM. You report the win and keep the margin.</p></div>
        </div>
      </div>
    </section>

    <!-- ================= THE OFFER ================= -->
    <section id="offer" style="padding-top:0">
      <div class="wrap">
        <span class="eyebrow">Founding partner program</span>
        <h2 class="sec" style="text-align:center">One seat per trade. Yours, if you move first.</h2>
        <p class="kicker" style="text-align:center;margin:0 auto">You sell your clients territory exclusivity. We're offering you the same deal.</p>
        <div class="offer-card">
          <div class="offer-head">
            <h3>Founding Partner Seat</h3>
            <span class="seat-pill">Capped per trade</span>
          </div>
          <div class="offer-body">
            <ul>
              <li><strong>Founding wholesale rate, locked for life.</strong> The price you join at is the price you keep — every client, every lead, forever.</li>
              <li><strong>The Partner Pledge, signed.</strong> No marketing services, no going direct, no selling around you. In the contract.</li>
              <li><strong>Trade exclusivity.</strong> We cap founding partners per trade, so "the consent-first agency for your trade" can be you — not everyone.</li>
              <li><strong>White-label reporting.</strong> Client-facing reports carry your brand. We're the layer, you're the agency.</li>
              <li><strong>Territory protection per client.</strong> Every lead is one consent, one contractor. Never resold, never auctioned.</li>
              <li><strong>Co-marketing.</strong> A published case study and a listing in our partner directory — in front of contractors in your trade.</li>
              <li><strong>No volume commitment to start.</strong> Prove it on one client site first. No contract, cancel anytime.</li>
            </ul>
            <a class="btn btn-primary btn-block" href={APPLY}>Apply for your trade's seat →</a>
            <p class="offer-fine">Applications reviewed in order received. When a trade's founding seats fill, the door closes at founding terms — standard partner terms after that.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= FAQ (dark band, white card) ================= -->
    <section class="dband">
      <div class="wrap">
        <span class="eyebrow">Straight answers</span>
        <h2 class="sec">What agency owners ask first.</h2>
        <div class="faq-card">
          <details open>
            <summary>Who owns the client relationship?</summary>
            <div class="a">You do. You bill them, you report to them, your brand is on the dashboard they see. The Partner Pledge puts it in the agreement: we never sell marketing services and never go direct to accounts you bring.</div>
          </details>
          <details>
            <summary>How do partner economics work?</summary>
            <div class="a">You buy leads at a wholesale partner rate and bill your clients your way — as a line item, inside a bundle, or as part of a managed service. Retail is a flat $7 a lead, exclusive, never resold. Your founding wholesale rate is set in your agreement and locked for as long as you're a partner.</div>
          </details>
          <details>
            <summary>What does my client's homeowner actually experience?</summary>
            <div class="a">They visit the client's site, the consent banner asks, and they say yes — or nothing happens. After consent, the client gets their email, enriched with name and location where available, plus what they were shopping for. The record feeds retargeting and email, and the homeowner comes back and calls. Warm inbound. No phone numbers, no cold outreach, ever.</div>
          </details>
          <details>
            <summary>Which CRMs and builders does it work with?</summary>
            <div class="a">Leads land in Jobber, Housecall Pro, ServiceTitan, HubSpot, Klaviyo, or any webhook — plus Slack, SMS, and email in seconds. The snippet is one line and works on WordPress, Wix, Squarespace, ServiceTitan sites, and most builders. Live in about 10 minutes per site.</div>
          </details>
          <details>
            <summary>My clients already run a visitor-ID pixel. Why switch?</summary>
            <div class="a">Most identity pixels never ask the homeowner anything — and wiretap-style claims are being filed against exactly that kind of tracking. Consent Resolve identifies only after an explicit yes, with every reveal timestamped and signed. It's the version of this category you can defend in front of a client's lawyer — and the switch is your easiest upsell conversation this year.</div>
          </details>
          <details>
            <summary>What trades do you cover?</summary>
            <div class="a">17 home-service trades today, nationwide — it runs on each client's own website, so geography doesn't matter. If your book leans on a trade we haven't opened yet, say so in your application. Founding partners help pick what opens next.</div>
          </details>
          <details>
            <summary>Is there a minimum or a contract?</summary>
            <div class="a">No volume commitment and no contract. Start with one client site, watch the leads land, then roll it across the book. Cancel anytime.</div>
          </details>
        </div>
      </div>
    </section>

    <!-- ================= AEO ANSWER ================= -->
    <section>
      <div class="wrap">
        <div class="aeo">
          <p class="q">What is the Consent Resolve agency partner program?</p>
          <p>Consent Resolve's partner program lets marketing agencies resell consent-first visitor identification to home-service clients. Agencies buy exclusive, consented leads at wholesale, bill under their own brand with white-label reporting, and keep the margin — backed by a signed pledge that Consent Resolve never sells marketing services or contacts partner clients directly.</p>
        </div>
      </div>
    </section>

    <!-- ================= FINAL CTA ================= -->
    <section class="dband" style="padding-bottom:48px">
      <div class="wrap">
        <div class="final-grid">
          <div>
            <h2 class="sec">Your trade's seat is open. Today.</h2>
            <p class="kicker" style="margin-bottom:26px">The agencies that own "consent-first" in their trade will be the ones who moved before their competitors knew the category existed. One application, one client site, and you're that agency.</p>
            <a class="btn btn-primary" href={APPLY}>Apply for a founding seat →</a>
          </div>
          <div class="anchors">
            <div class="anchor"><span class="a-lbl">Retail price per lead</span><span class="a-val">$7 flat</span></div>
            <div class="anchor"><span class="a-lbl">Every lead</span><span class="a-val">Exclusive</span></div>
            <div class="anchor"><span class="a-lbl">Commitment</span><span class="a-val">None</span></div>
          </div>
        </div>
        <div class="comply">
          <span>✓ Consent-first by design</span>
          <span>✓ Audit trail on every lead</span>
          <span>✓ Built to GDPR-grade standards for the U.S. risk map</span>
          <span>✓ Policies kept current via Termageddon</span>
        </div>
      </div>
    </section>
  </div>

  <script>
    // Margin calculator
    const clients = document.getElementById("clients") as HTMLInputElement | null;
    const leads = document.getElementById("leads") as HTMLInputElement | null;
    const margin = document.getElementById("margin") as HTMLInputElement | null;
    const fmt = (n: number) => "$" + n.toLocaleString("en-US");
    function calc() {
      if (!clients || !leads || !margin) return;
      const c = +clients.value, l = +leads.value, m = +margin.value;
      const set = (id: string, v: string) => { const el = document.getElementById(id); if (el) el.textContent = v; };
      set("clientsVal", String(c));
      set("leadsVal", String(l));
      set("marginVal", String(m));
      const total = c * l;
      set("outLeads", total.toLocaleString("en-US"));
      set("outValue", fmt(total * 7));
      set("outMargin", fmt(total * m) + "/mo");
    }
    [clients, leads, margin].forEach((el) => el && el.addEventListener("input", calc));
    calc();
  </script>
</BaseLayout>

<style>
  /* Scoped to .ap — recolored from the mockup to the site palette (navy/mint/paper).
     Local vars map the mockup's names onto site tokens so the component CSS is unchanged. */
  .ap {
    --ink: var(--color-navy-900);       /* #0a1628 dark band + headings */
    --ink-soft: #12233c;                /* secondary dark surface */
    --paper: var(--color-paper);        /* #f8fafc page */
    --surface: #ffffff;
    --mint: var(--color-mint-400);      /* #00e5a0 */
    --mint-deep: var(--color-mint-700); /* #00a86e */
    --mint-wash: rgba(0, 229, 160, 0.11);
    --line: var(--color-rule);          /* #e2e8f0 */
    --text: #334155;
    --muted: var(--color-ink-2);        /* #475569 */
    --danger: #d0463d;
    --danger-wash: #fdeceb;
    --radius: 14px;
    --shadow: 0 10px 30px rgba(10, 22, 40, 0.08);
    --display: var(--font-display);
    --body: var(--font-sans);
    font-family: var(--body);
    color: var(--text);
    background: var(--paper);
    line-height: 1.6;
    font-size: 16.5px;
  }
  .ap * { box-sizing: border-box; }
  .ap h1, .ap h2, .ap h3 { font-family: var(--display); line-height: 1.12; letter-spacing: -0.01em; color: var(--ink); margin: 0; }
  .ap a { color: var(--mint-deep); }
  .ap p { margin: 0; }
  .ap ol, .ap ul { margin: 0; }

  .ap .wrap { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
  .ap .eyebrow { display: inline-block; font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mint-deep); background: var(--mint-wash); border: 1px solid var(--mint); border-radius: 999px; padding: 5px 14px; margin-bottom: 18px; }
  .ap section { padding: 84px 0; }
  .ap .btn { display: inline-block; font-family: var(--body); font-weight: 700; font-size: 16px; border-radius: 10px; padding: 15px 28px; text-decoration: none; transition: transform 0.12s ease, box-shadow 0.12s ease; border: 2px solid transparent; cursor: pointer; }
  .ap .btn:focus-visible { outline: 3px solid var(--mint); outline-offset: 2px; }
  .ap .btn-primary { background: var(--mint); color: var(--ink); }
  .ap .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 8px 20px rgba(0, 229, 160, 0.35); }
  .ap .btn-ghost { background: transparent; color: var(--ink); border-color: var(--line); }
  .ap .btn-block { width: 100%; text-align: center; }
  .ap .kicker { color: var(--muted); max-width: 640px; }
  .ap h2.sec { font-size: clamp(28px, 3.6vw, 40px); font-weight: 800; margin-bottom: 14px; }

  /* dark bands */
  .ap .dband { background: var(--ink); color: #cbd8d2; }
  .ap .dband h2, .ap .dband h3 { color: #fff; }
  .ap .dband .kicker { color: #93a7b6; }
  .ap .dband .eyebrow { color: var(--mint); background: rgba(0, 229, 160, 0.1); border-color: rgba(0, 229, 160, 0.4); }
  .ap .dband .btn-ghost { color: #fff; border-color: rgba(255, 255, 255, 0.25); }

  /* HERO */
  .ap .hero { padding: 72px 0 64px; background: linear-gradient(180deg, #fff 0%, var(--paper) 100%); }
  .ap .hero-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 56px; align-items: center; }
  .ap .hero h1 { font-size: clamp(38px, 5vw, 58px); font-weight: 800; margin-bottom: 20px; }
  .ap .hero h1 .hl { background: linear-gradient(transparent 62%, var(--mint) 62%); }
  .ap .hero p.sub { font-size: 19px; color: var(--muted); margin-bottom: 30px; max-width: 520px; }
  .ap .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }
  .ap .hero-note { font-size: 14px; color: var(--muted); margin-top: 14px; }
  .ap .panel { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); overflow: hidden; }
  .ap .panel-head { display: flex; justify-content: space-between; align-items: center; background: var(--ink); color: #fff; padding: 12px 18px; font-size: 13px; font-weight: 600; }
  .ap .panel-head span { color: var(--mint); }
  .ap .client-row { display: flex; justify-content: space-between; align-items: center; padding: 14px 18px; border-bottom: 1px solid var(--line); font-size: 14.5px; }
  .ap .client-row:last-child { border-bottom: none; }
  .ap .client-name { font-weight: 600; color: var(--ink); }
  .ap .client-trade { color: var(--muted); font-size: 12.5px; }
  .ap .pill { font-size: 12px; font-weight: 700; border-radius: 999px; padding: 3px 10px; }
  .ap .pill-mint { background: var(--mint-wash); color: var(--mint-deep); }
  .ap .panel-foot { background: var(--mint-wash); padding: 12px 18px; font-size: 13.5px; font-weight: 600; color: var(--mint-deep); }

  /* PROBLEM */
  .ap .stakes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 44px; }
  .ap .stake { background: var(--ink-soft); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius); padding: 28px; }
  .ap .stake .big { font-family: var(--display); font-size: 40px; font-weight: 800; color: var(--mint); }
  .ap .stake.red .big { color: var(--color-danger-bright); }
  .ap .stake .lbl { font-weight: 700; color: #fff; margin: 6px 0 8px; font-size: 15.5px; }
  .ap .stake p { font-size: 14.5px; color: #93a7b6; }

  /* PLEDGE */
  .ap .pledge-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .ap .contract { background: var(--surface); border: 1px solid var(--line); border-radius: 6px; box-shadow: var(--shadow); padding: 44px 40px; position: relative; font-size: 16px; transform: rotate(-0.6deg); }
  .ap .contract::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 6px; background: var(--mint); border-radius: 6px 6px 0 0; }
  .ap .contract .doc-title { font-family: var(--display); font-weight: 800; font-size: 22px; color: var(--ink); margin-bottom: 22px; }
  .ap .contract ol { margin: 0 0 26px 20px; }
  .ap .contract li { margin-bottom: 14px; color: var(--text); }
  .ap .contract li strong { color: var(--ink); }
  .ap .sig-line { border-top: 2px solid var(--ink); padding-top: 8px; margin-top: 34px; display: flex; justify-content: space-between; font-size: 13px; color: var(--muted); }
  .ap .sig { font-family: var(--display); font-weight: 700; font-size: 20px; color: var(--ink); font-style: italic; }

  /* PILLARS */
  .ap .pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 44px; }
