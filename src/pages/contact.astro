---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Badge from "~/components/ui/Badge.astro";
import { IconMail, IconPhone, IconClock, IconArrowRight } from "@tabler/icons-react";
import { breadcrumbSchema } from "~/lib/seo";
import { SITE } from "~/lib/site";

const schemas = [
  breadcrumbSchema([
    { name: "Home", href: "/" },
    { name: "Contact", href: "/contact/" },
  ]),
];
---

<BaseLayout
  ogImage="/og/contact.png"
  title="Contact — Talk to a Human at Consent Resolve"
  description="Questions before you start? Email or call us — no sales script, just straight answers."
  schema={schemas}
>
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/20 blur-[120px]"></div>
    <div class="container-content section relative">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-7 flex justify-center"><Badge tone="brand" variant="soft" size="md" uppercase>Contact</Badge></div>
        <h1 class="display-1 mb-7 text-[color:var(--color-ink)]">
          Talk to a human.
        </h1>
        <p class="mx-auto max-w-2xl text-lg leading-relaxed text-[color:var(--color-ink-2)]">
          Questions before you start? Email or call — no sales script, just straight answers. Or skip ahead and create your account on the dashboard.
        </p>

        <div class="mt-10 flex justify-center">
          <a
            href="https://dashboard.consentresolve.com/register"
            class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-brand)] px-7 py-3.5 text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--color-navy-900)] shadow-[0_18px_36px_-18px_rgba(0,229,160,0.55)] transition-all hover:-translate-y-0.5 hover:bg-[color:var(--color-brand-pressed)] hover:text-white"
          >
            Get Started
            <IconArrowRight size={16} stroke={2.5} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="pb-24">
    <div class="container-content max-w-3xl">
      <div class="grid gap-4 sm:grid-cols-2">
        <a
          href={`mailto:${SITE.email}`}
          class="block rounded-2xl bg-[color:var(--color-bg-alt)] p-7 ring-1 ring-inset ring-[color:var(--color-rule)] transition-all hover:-translate-y-0.5 hover:ring-[color:var(--color-brand)]/40 hover:shadow-[0_18px_36px_-18px_rgba(10,22,40,0.18)]"
        >
          <IconMail size={22} stroke={1.75} color="#00A86E" />
          <p class="mt-4 text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">Email</p>
          <p class="mt-1 font-mono text-[15px] font-semibold text-[color:var(--color-ink)]">{SITE.email}</p>
          <p class="mt-3 text-[13px] text-[color:var(--color-ink-muted)]">Best for everything that isn't on fire. Reply usually same day, always within 24h.</p>
        </a>
        <a
          href={`tel:${SITE.phoneE164}`}
          class="block rounded-2xl bg-[color:var(--color-bg-alt)] p-7 ring-1 ring-inset ring-[color:var(--color-rule)] transition-all hover:-translate-y-0.5 hover:ring-[color:var(--color-brand)]/40 hover:shadow-[0_18px_36px_-18px_rgba(10,22,40,0.18)]"
        >
          <IconPhone size={22} stroke={1.75} color="#00A86E" />
          <p class="mt-4 text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">Phone</p>
          <p class="mt-1 font-mono text-[15px] font-semibold text-[color:var(--color-ink)]">{SITE.phone}</p>
          <p class="mt-3 text-[13px] text-[color:var(--color-ink-muted)]">If you'd rather just talk. Real human picks up during business hours.</p>
        </a>
      </div>

      <div class="mt-4 rounded-2xl bg-[color:var(--color-bg-alt)] p-7 ring-1 ring-inset ring-[color:var(--color-rule)]">
        <div class="flex items-start gap-3">
          <IconClock size={22} stroke={1.75} color="#00A86E" class="mt-1 shrink-0" />
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">Hours</p>
            <p class="mt-1 text-[15px] text-[color:var(--color-ink)]">{SITE.hours}</p>
            <p class="mt-2 text-[13px] text-[color:var(--color-ink-muted)]">Outside hours? Email lands in the same inbox and gets answered first thing in the morning.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
