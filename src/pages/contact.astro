---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Button from "~/components/ui/Button.astro";
import { IconArrowRight, IconMail, IconPhone, IconClock, IconMapPin } from "@tabler/icons-react";
import { breadcrumbSchema, localBusinessSchema } from "~/lib/seo";

const schemas = [
  breadcrumbSchema([
    { name: "Home", href: "/" },
    { name: "Contact", href: "/contact/" },
  ]),
  localBusinessSchema,
];
---

<BaseLayout
  title="Contact — Talk to a Human at Consent Resolve"
  description="Questions before you start? We'll give you straight answers — no sales script."
  schema={schemas}
>
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/20 blur-[120px]"></div>
    <div class="container-content section relative">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow mb-7 justify-center">Contact</p>
        <h1 class="display-1 mb-7 text-[color:var(--color-ink)]">
          Talk to a human.
        </h1>
        <p class="mx-auto max-w-2xl text-lg leading-relaxed text-[color:var(--color-ink-2)]">
          Questions before you start? We'll give you straight answers — no sales script.
        </p>
      </div>
    </div>
  </section>

  <section class="pb-24">
    <div class="container-content max-w-5xl">
      <div class="grid items-start gap-10 md:grid-cols-[1.2fr_1fr]">
        <!-- Form — backend pending. mailto fallback so submissions reach
             hello@ until wired to a real endpoint. -->
        <form
          action="mailto:hello@consentresolve.com?subject=Contact%20-%20Consent%20Resolve"
          method="POST"
          enctype="text/plain"
          class="space-y-4 rounded-2xl bg-[color:var(--color-bg-alt)] p-8 ring-1 ring-inset ring-[color:var(--color-rule)] shadow-[0_18px_40px_-24px_rgba(10,22,40,0.18)]"
        >
          <div>
            <label for="contact-name" class="block text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)] mb-2">Name</label>
            <input id="contact-name" name="name" type="text" autocomplete="name" required class="w-full rounded-lg bg-[color:var(--color-bg)] px-4 py-3 text-[15px] text-[color:var(--color-ink)] ring-1 ring-inset ring-[color:var(--color-rule)] focus:outline-none focus:ring-2 focus:ring-[color:var(--color-brand)]" />
          </div>
          <div>
            <label for="contact-email" class="block text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)] mb-2">Email</label>
            <input id="contact-email" name="email" type="email" autocomplete="email" required class="w-full rounded-lg bg-[color:var(--color-bg)] px-4 py-3 text-[15px] text-[color:var(--color-ink)] ring-1 ring-inset ring-[color:var(--color-rule)] focus:outline-none focus:ring-2 focus:ring-[color:var(--color-brand)]" />
          </div>
          <div>
            <label for="contact-shop" class="block text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)] mb-2">Shop name</label>
            <input id="contact-shop" name="shop_name" type="text" autocomplete="organization" class="w-full rounded-lg bg-[color:var(--color-bg)] px-4 py-3 text-[15px] text-[color:var(--color-ink)] ring-1 ring-inset ring-[color:var(--color-rule)] focus:outline-none focus:ring-2 focus:ring-[color:var(--color-brand)]" />
          </div>
          <div>
            <label for="contact-message" class="block text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)] mb-2">Message</label>
            <textarea id="contact-message" name="message" rows="5" required class="w-full rounded-lg bg-[color:var(--color-bg)] px-4 py-3 text-[15px] text-[color:var(--color-ink)] ring-1 ring-inset ring-[color:var(--color-rule)] focus:outline-none focus:ring-2 focus:ring-[color:var(--color-brand)]"></textarea>
          </div>
          <Button type="submit" variant="primary" size="lg" fullWidth>
            Send message
            <IconArrowRight size={18} stroke={2.25} />
          </Button>
        </form>

        <!-- Direct lines -->
        <aside class="space-y-4">
          <div class="rounded-2xl bg-[color:var(--color-bg-alt)] p-6 ring-1 ring-inset ring-[color:var(--color-rule)]">
            <IconMail size={20} stroke={1.75} color="#00A86E" />
            <p class="mt-3 text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">Email</p>
            <a href="mailto:hello@consentresolve.com" class="mt-1 block font-mono text-[15px] font-semibold text-[color:var(--color-ink)] hover:text-[color:var(--color-brand-pressed)]">
              hello@consentresolve.com
            </a>
          </div>
          <div class="rounded-2xl bg-[color:var(--color-bg-alt)] p-6 ring-1 ring-inset ring-[color:var(--color-rule)]">
            <IconPhone size={20} stroke={1.75} color="#00A86E" />
            <p class="mt-3 text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">Phone</p>
            <a href="tel:+17272025996" class="mt-1 block font-mono text-[15px] font-semibold text-[color:var(--color-ink)] hover:text-[color:var(--color-brand-pressed)]">
              (727) 202-5996
            </a>
          </div>
          <div class="rounded-2xl bg-[color:var(--color-bg-alt)] p-6 ring-1 ring-inset ring-[color:var(--color-rule)]">
            <IconMapPin size={20} stroke={1.75} color="#00A86E" />
            <p class="mt-3 text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">Office</p>
            <address class="mt-1 text-[15px] not-italic text-[color:var(--color-ink-2)]">
              1907 Gulf Way #1<br/>
              St Pete Beach, FL 33706
            </address>
          </div>
          <div class="rounded-2xl bg-[color:var(--color-bg-alt)] p-6 ring-1 ring-inset ring-[color:var(--color-rule)]">
            <IconClock size={20} stroke={1.75} color="#00A86E" />
            <p class="mt-3 text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">Hours</p>
            <p class="mt-1 text-[15px] text-[color:var(--color-ink-2)]">M–F 9a–6p Eastern</p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
