---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Button from "~/components/ui/Button.astro";
import { IconArrowRight, IconMail, IconPhone, IconClock } from "@tabler/icons-react";
import { breadcrumbSchema } from "~/lib/seo";

const schemas = [
  breadcrumbSchema([
    { name: "Home", href: "/" },
    { name: "Contact", href: "/contact/" },
  ]),
];
---

<BaseLayout
  title="Contact — Talk to a Human at Consent Resolve"
  description="Questions before you start? We'll give you straight answers — no sales script."
  schema={schemas}
>
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/20 blur-[120px]"></div>
    <div class="container-content section relative">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow mb-7 justify-center">Contact</p>
        <h1 class="display-1 mb-7 text-[color:var(--color-ink)]">
          Talk to a human.
        </h1>
        <p class="mx-auto max-w-2xl text-lg leading-relaxed text-[color:var(--color-ink-2)]">
          Questions before you start? We'll give you straight answers — no sales script.
        </p>
      </div>
    </div>
  </section>

  <section class="pb-24">
    <div class="container-content max-w-5xl">
      <div class="grid items-start gap-10 md:grid-cols-[1.2fr_1fr]">
        <!-- Form -->
        <form class="space-y-4 rounded-2xl bg-[color:var(--color-bg-alt)] p-8 ring-1 ring-inset ring-[color:var(--color-rule)] shadow-[0_18px_40px_-24px_rgba(10,22,40,0.18)]">
          <div>
            <label class="block text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)] mb-2">Name</label>
            <input type="text" class="w-full rounded-lg bg-[color:var(--color-bg)] px-4 py-3 text-[15px] text-[color:var(--color-ink)] ring-1 ring-inset ring-[color:var(--color-rule)] focus:outline-none focus:ring-2 focus:ring-[color:var(--color-brand)]" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)] mb-2">Email</label>
            <input type="email" class="w-full rounded-lg bg-[color:var(--color-bg)] px-4 py-3 text-[15px] text-[color:var(--color-ink)] ring-1 ring-inset ring-[color:var(--color-rule)] focus:outline-none focus:ring-2 focus:ring-[color:var(--color-brand)]" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)] mb-2">Shop name</label>
            <input type="text" class="w-full rounded-lg bg-[color:var(--color-bg)] px-4 py-3 text-[15px] text-[color:var(--color-ink)] ring-1 ring-inset ring-[color:var(--color-rule)] focus:outline-none focus:ring-2 focus:ring-[color:var(--color-brand)]" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)] mb-2">Message</label>
            <textarea rows="5" class="w-full rounded-lg bg-[color:var(--color-bg)] px-4 py-3 text-[15px] text-[color:var(--color-ink)] ring-1 ring-inset ring-[color:var(--color-rule)] focus:outline-none focus:ring-2 focus:ring-[color:var(--color-brand)]"></textarea>
          </div>
          <Button variant="primary" size="lg" fullWidth>
            Send message
            <IconArrowRight size={18} stroke={2.25} />
          </Button>
        </form>

        <!-- Direct lines -->
        <aside class="space-y-4">
          <div class="rounded-2xl bg-[color:var(--color-bg-alt)] p-6 ring-1 ring-inset ring-[color:var(--color-rule)]">
            <IconMail size={20} stroke={1.75} color="#00A86E" />
            <p class="mt-3 text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">Email</p>
            <a href="mailto:hello@consentresolve.com" class="mt-1 block font-mono text-[15px] font-semibold text-[color:var(--color-ink)] hover:text-[color:var(--color-brand-pressed)]">
              hello@consentresolve.com
            </a>
          </div>
          <div class="rounded-2xl bg-[color:var(--color-bg-alt)] p-6 ring-1 ring-inset ring-[color:var(--color-rule)]">
            <IconPhone size={20} stroke={1.75} color="#00A86E" />
            <p class="mt-3 text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">Phone</p>
            <span class="mt-1 block font-mono text-[15px] font-semibold text-[color:var(--color-ink)]">[CONFIRM]</span>
          </div>
          <div class="rounded-2xl bg-[color:var(--color-bg-alt)] p-6 ring-1 ring-inset ring-[color:var(--color-rule)]">
            <IconClock size={20} stroke={1.75} color="#00A86E" />
            <p class="mt-3 text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">Hours</p>
            <p class="mt-1 text-[15px] text-[color:var(--color-ink-2)]">M–F 8a–6p Central</p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
