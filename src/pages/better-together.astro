/* ---------- CAROUSEL GALLERIES (all three identical) ---------- */
/* Full-bleed image strip with a distinctive rule top + bottom. Ready for 3:2 photos. */
.galstrip{width:100vw;margin-left:calc(50% - 50vw);background:var(--warm);
  border-top:3px solid var(--ink);border-bottom:3px solid var(--ink);padding:20px 0}
.galstrip .gal{position:relative;margin:0}
/* reward badge above each gallery — "Unlocks at N leads" */
.gal-badge-wrap{position:relative;z-index:3;text-align:center;margin:0 0 18px}
.gal-badge{display:inline-flex;align-items:center;gap:9px;padding:9px 20px 9px 16px;
  border-radius:999px;background:var(--color-navy-900);color:#fff;
  font-family:var(--font-mono);font-size:.72rem;font-weight:600;letter-spacing:.04em;
  box-shadow:0 10px 24px -12px rgba(10,22,40,.7);border:1px solid rgba(255,255,255,.08)}
.gal-badge svg{width:16px;height:16px;color:var(--color-mint-400);flex:0 0 auto}
/* on the grass band, lift the badge off the green with a mint hairline */
.galstrip.grass .gal-badge{border-color:rgba(0,229,160,.35);box-shadow:0 10px 24px -10px rgba(0,0,0,.45)}
.gal-track{display:flex;gap:14px;overflow-x:auto;
  padding:2px clamp(16px,4vw,44px) 4px;scroll-behavior:smooth;scrollbar-width:none;cursor:grab}
.gal-track::-webkit-scrollbar{display:none}
.gal-track:active{cursor:grabbing}
.gal-item{flex:0 0 auto;width:200px;scroll-snap-align:center;margin:0}
.gal-ph{position:relative;width:100%;aspect-ratio:3/2;border-radius:12px;display:grid;
  place-content:center;justify-items:center;gap:10px;color:var(--mint-deep);overflow:hidden;
  background:linear-gradient(160deg,var(--mint-soft),#fff);border:1px solid var(--mint-line);
  box-shadow:0 14px 30px -22px rgba(10,22,40,.4);transition:transform .35s ease,box-shadow .35s ease}
.gal-item:hover .gal-ph{transform:translateY(-4px);box-shadow:0 22px 44px -24px rgba(10,22,40,.5)}
.gal-ph svg{width:40px;height:auto;opacity:.85}
.gal-ph img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}
.gal-cap{font-family:var(--mono);font-size:.6rem;letter-spacing:.13em;text-transform:uppercase;opacity:.7}
.gal-nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;
  width:44px;height:44px;border-radius:50%;border:1px solid var(--rule);background:var(--paper);
  color:var(--text);font-size:1.5rem;line-height:1;display:grid;place-items:center;cursor:pointer;
  box-shadow:0 8px 24px -10px rgba(10,22,40,.35);transition:background .15s ease,transform .15s ease}
