.node::after{content:"";position:absolute;right:-14px;top:50%;width:14px;height:2px;
  background:#33496a;z-index:2}
.node:last-child::after{display:none}
.node.lit{background:#123a55;border-color:var(--mint)}
.loopback{margin-top:20px;display:flex;align-items:center;gap:14px;
  font-family:var(--mono);font-size:.76rem;letter-spacing:.12em;color:var(--mint);
  text-transform:uppercase}
.loopback::before,.loopback::after{content:"";flex:1;height:2px;
  background:linear-gradient(90deg,transparent,var(--mint),transparent)}

/* ---------- SCENE (sign → phone → site) ---------- */
.scene{margin-top:40px;background:var(--paper);border:1px solid var(--rule);
  border-radius:16px;padding:26px}
.scene svg{width:100%;height:auto;display:block}
