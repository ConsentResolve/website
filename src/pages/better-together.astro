          var a = STOPS[i-1], b = STOPS[i];
          var t = (p - a[0]) / (b[0] - a[0]);
          return a[1] + (b[1] - a[1]) * t;
        }
      }
      return 1000;
    }
    function paint(p){
      var leads = Math.round(leadsAt(p));
      elL.textContent = fmt(leads);
      elV.textContent = fmt(leads * 5);
      elF.style.width = (p * 100).toFixed(2) + '%';
      elD.style.left  = (p * 100).toFixed(2) + '%';
      rws.forEach(function(r){ r.classList.toggle('unlocked', leads >= +r.dataset.at); });
    }
    if (reduce) { paint(1); }
    else {
      var DUR = 13000, HOLD = 4000, going = false;
      function run(){
        if (going) return; going = true;
        var t0 = null;
        function frame(ts){
          if (!t0) t0 = ts;
          var p = Math.min((ts - t0) / DUR, 1);
          paint(p);
          if (p < 1) requestAnimationFrame(frame);
          else setTimeout(function(){ paint(0); going = false; run(); }, HOLD);
        }
        requestAnimationFrame(frame);
      }
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function(en, ob){
          en.forEach(function(e){ if (e.isIntersecting){ run(); ob.unobserve(e.target); } });
        }, { threshold: 0.35 }).observe(bt);
      } else { run(); }
    }
  }

  // carousel galleries: continuous auto-slide (seamless loop) + arrows + drag
  document.querySelectorAll('[data-gal]').forEach(function(g){
    var track = g.querySelector('.gal-track');
    if (!track) return;
    // Duplicate the slides so the strip can loop seamlessly (second set is decorative).
    Array.prototype.slice.call(track.children).forEach(function(c){
      var cl = c.cloneNode(true); cl.setAttribute('aria-hidden', 'true'); track.appendChild(cl);
    });
    var half = track.scrollWidth / 2;
    window.addEventListener('resize', function(){ half = track.scrollWidth / 2; });

    function step(dir){
      var item = track.querySelector('.gal-item');
      var w = item ? item.getBoundingClientRect().width + 14 : 214;
      track.scrollBy({ left: dir * w, behavior: 'smooth' });
    }
    var prev = g.querySelector('.gal-nav.prev'), next = g.querySelector('.gal-nav.next');
    if (prev) prev.addEventListener('click', function(){ step(-1); });
    if (next) next.addEventListener('click', function(){ step(1); });

    // drag to scroll
    var down = false, sx = 0, sl = 0, moved = false;
    track.addEventListener('pointerdown', function(e){ down = true; moved = false; sx = e.clientX; sl = track.scrollLeft; });
    track.addEventListener('pointermove', function(e){ if(!down) return; var dx = e.clientX - sx; if(Math.abs(dx) > 3) moved = true; track.scrollLeft = sl - dx; });
    window.addEventListener('pointerup', function(){ down = false; });
    track.addEventListener('click', function(e){ if(moved){ e.preventDefault(); e.stopPropagation(); } }, true);

    // gentle continuous slide; pauses on hover / drag; wraps at the halfway point
    var paused = false;
    g.addEventListener('pointerenter', function(){ paused = true; });
    g.addEventListener('pointerleave', function(){ paused = false; });
    function tick(){
      if (!paused && !reduce) {
        track.scrollLeft += 0.5;
        if (track.scrollLeft >= half) track.scrollLeft -= half;
      }
      requestAnimationFrame(tick);
    }
    if (!reduce) requestAnimationFrame(tick);
  });
})();</script>
</BaseLayout>
