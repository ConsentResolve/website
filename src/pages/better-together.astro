---
// "Better Together" rewards / field-kit landing. NON-PUBLIC: noindex + excluded from the
// sitemap (see astro.config) + not linked from nav/footer. Direct-URL only.
// Re-themed onto the CR design system (navy + mint, Bricolage/Hanken/JetBrains) and wrapped
// in BaseLayout so it carries the real site header, footer, chat, and demo widget.
import BaseLayout from "~/layouts/BaseLayout.astro";
---
<BaseLayout
  title="Consent Resolve · Better Together — the field kit that pays you back"
  description="Your signs bring them in. Our code gets you their name. $7 a lead, and the marketing materials just show up."
  noindex
>
  <div class="fk">
<!-- HERO — BETTER TOGETHER -->
<section class="sec sec-dark hero" style="padding:74px 0 84px">
  <div class="wrap hx">

    <!-- OFFLINE -->
    <div class="panel" id="p-sign">
      <span class="cap">Offline</span>
      <svg viewBox="0 0 200 168" role="img" aria-label="A yard sign with your shop name, phone number, and a code to scan.">
        <rect x="26" y="14" width="148" height="98" rx="7" fill="#dcfbef" stroke="#00e5a0" stroke-width="3"/>
        <rect x="42" y="30" width="76" height="10" rx="5" fill="#00a86e"/>
        <rect x="42" y="48" width="54" height="7" rx="3.5" fill="#7f93ae"/>
        <rect x="42" y="62" width="64" height="7" rx="3.5" fill="#7f93ae"/>
        <rect x="42" y="82" width="48" height="14" rx="7" fill="#00e5a0"/>
        <g fill="#00a86e">
          <rect x="126" y="60" width="34" height="34" rx="4" fill="none" stroke="#00a86e" stroke-width="3"/>
          <rect x="132" y="66" width="8" height="8"/><rect x="146" y="66" width="8" height="8"/>
          <rect x="132" y="80" width="8" height="8"/><rect x="146" y="80" width="4" height="4"/>
          <rect x="154" y="84" width="4" height="4"/>
        </g>
        <path d="M100 112 L100 148" stroke="#00e5a0" stroke-width="4" stroke-linecap="round"/>
        <path d="M56 150 Q100 140 144 150" stroke="#233248" stroke-width="4" fill="none" stroke-linecap="round"/>
      </svg>
    </div>

    <!-- MIDDLE -->
    <div class="hx-mid">
      <span class="tag badge">From Yard Sign to Lead</span>
      <h1>Better<br><em>together.</em></h1>
      <p class="say">Your signs bring them in. Our code gets you their name.</p>
      <a class="btn" href="/get-started/">Get Started →</a>
      <span class="under">Live in about 10 minutes</span>
    </div>

    <!-- ONLINE -->
    <div class="panel" id="p-lead">
      <span class="cap">Online</span>
      <div class="resolve">
        <svg viewBox="0 0 200 152" role="img" aria-label="An unknown website visitor taps yes on the consent banner and becomes a named lead.">
          <rect x="8" y="8" width="184" height="136" rx="10" fill="#0a1628" stroke="#233248" stroke-width="2"/>
          <path d="M8 32 H192" stroke="#233248" stroke-width="2"/>
          <circle cx="22" cy="20" r="3" fill="#33496a"/><circle cx="33" cy="20" r="3" fill="#33496a"/>

          <g class="ph-anon">
            <circle cx="100" cy="70" r="18" fill="none" stroke="#64748b" stroke-width="2.5" stroke-dasharray="5 5"/>
            <path d="M74 116 a26 26 0 0 1 52 0" fill="none" stroke="#64748b" stroke-width="2.5" stroke-dasharray="5 5"/>
            <text x="100" y="79" text-anchor="middle" font-family="Bricolage Grotesque, sans-serif"
                  font-size="24" font-weight="800" fill="#64748b">?</text>
          </g>

          <g class="ph-yes">
            <rect x="26" y="52" width="148" height="60" rx="10" fill="#0e1c30" stroke="#00e5a0" stroke-width="2"/>
            <rect x="40" y="66" width="82" height="6" rx="3" fill="#3a4f6f"/>
            <rect x="40" y="78" width="60" height="6" rx="3" fill="#3a4f6f"/>
            <rect x="40" y="92" width="46" height="16" rx="8" fill="#00e5a0"/>
            <text x="63" y="104" text-anchor="middle" font-family="Bricolage Grotesque, sans-serif"
                  font-size="11" font-weight="800" fill="#0a1628">YES</text>
            <rect x="94" y="92" width="40" height="16" rx="8" fill="none" stroke="#3a4f6f" stroke-width="2"/>
          </g>

          <g class="ph-named">
            <circle cx="58" cy="72" r="17" fill="#00e5a0"/>
            <circle cx="58" cy="67" r="6" fill="#0a1628"/>
            <path d="M47 84 a11 11 0 0 1 22 0" fill="#0a1628"/>
            <rect x="86" y="58" width="76" height="8" rx="4" fill="#dcfbef"/>
            <rect x="86" y="72" width="58" height="6" rx="3" fill="#64748b"/>
            <rect x="86" y="84" width="66" height="6" rx="3" fill="#64748b"/>
            <rect x="58" y="102" width="84" height="18" rx="9" fill="#00e5a0" opacity=".16"/>
            <text x="100" y="115" text-anchor="middle" font-family="JetBrains Mono, monospace"
                  font-size="9" font-weight="600" fill="#00e5a0">SIGNED · TIMESTAMPED</text>
          </g>
        </svg>
        <div class="cap-stack">
          <span class="c1">Nobody knows who this is</span>
          <span class="c2">They tap yes</span>
          <span class="c3">Now you've got a name</span>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- OFFER LADDER -->
<section class="sec">
  <div class="wrap" style="text-align:center">
    <span class="tag badge">Rewards</span>
    <h2>The more leads you get, the more we mail you.</h2>
    <p class="big" style="margin:18px auto 0">You pay $7 a lead. The rest just shows up.</p>

    <div class="ogrid">

      <!-- 25 LEADS -->
      <div class="ocard">
        <span class="obadge">25 leads</span>
        <h3>Yard Signs &amp; Stickers</h3>
        <div class="oblob">
          <svg viewBox="0 0 120 120" role="img" aria-label="Three yard signs staked in the ground.">
            <rect x="8" y="40" width="34" height="26" rx="3" fill="#7f93ae"/>
            <path d="M25 66 V92" stroke="#7f93ae" stroke-width="3" stroke-linecap="round"/>
            <rect x="78" y="42" width="34" height="26" rx="3" fill="#7f93ae"/>
            <path d="M95 68 V92" stroke="#7f93ae" stroke-width="3" stroke-linecap="round"/>
            <rect x="36" y="26" width="48" height="36" rx="4" fill="#dcfbef"/>
            <rect x="45" y="36" width="30" height="6" rx="3" fill="#00a86e"/>
            <rect x="45" y="47" width="20" height="4" rx="2" fill="#7f93ae"/>
            <rect x="69" y="45" width="8" height="8" rx="1.5" fill="#00e5a0"/>
            <path d="M60 62 V94" stroke="#00e5a0" stroke-width="4" stroke-linecap="round"/>
            <path d="M14 98 Q60 88 106 98" stroke="#3a4f6f" stroke-width="4" fill="none" stroke-linecap="round"/>
          </svg>
        </div>
      </div>

      <!-- 100 LEADS -->
      <div class="ocard">
        <span class="obadge">100 leads</span>
        <h3>Door Hangers &amp; Review Cards</h3>
        <div class="oblob">
          <svg viewBox="0 0 120 120" role="img" aria-label="A door hanger on a doorknob next to a sticker.">
            <rect x="30" y="16" width="42" height="88" rx="7" fill="#dcfbef"/>
            <path d="M46 16 H56 V32 H46 Z" fill="#0a1628"/>
            <circle cx="51" cy="36" r="12" fill="#0a1628"/>
            <circle cx="51" cy="36" r="7" fill="#00e5a0"/>
            <rect x="38" y="60" width="26" height="5" rx="2.5" fill="#00a86e"/>
            <rect x="38" y="71" width="18" height="4" rx="2" fill="#7f93ae"/>
            <rect x="38" y="80" width="22" height="4" rx="2" fill="#7f93ae"/>
            <rect x="38" y="91" width="14" height="7" rx="3.5" fill="#00e5a0"/>
            <circle cx="88" cy="74" r="22" fill="#00e5a0"/>
            <rect x="76" y="66" width="24" height="5" rx="2.5" fill="#0a1628"/>
            <rect x="76" y="76" width="16" height="4" rx="2" fill="#0a1628" opacity=".6"/>
          </svg>
        </div>
      </div>

      <!-- 250 LEADS -->
      <div class="ocard">
        <span class="obadge">250 leads</span>
        <h3>Truck Magnets</h3>
        <div class="oblob">
          <svg viewBox="0 0 120 120" role="img" aria-label="A review card with five stars and a truck door magnet.">
            <rect x="8" y="22" width="66" height="44" rx="5" fill="#dcfbef"/>
            <g fill="#f5b944">
              <path d="M18 40 l2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.5-4.8 2.5.9-5.4-3.9-3.8 5.4-.8z"/>
              <path d="M32 40 l2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.5-4.8 2.5.9-5.4-3.9-3.8 5.4-.8z"/>
              <path d="M46 40 l2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.5-4.8 2.5.9-5.4-3.9-3.8 5.4-.8z"/>
              <path d="M60 40 l2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.5-4.8 2.5.9-5.4-3.9-3.8 5.4-.8z"/>
            </g>
            <rect x="17" y="30" width="34" height="5" rx="2.5" fill="#00a86e"/>
            <ellipse cx="72" cy="82" rx="40" ry="26" fill="#00e5a0"/>
            <rect x="52" y="74" width="34" height="6" rx="3" fill="#0a1628"/>
            <rect x="52" y="86" width="24" height="5" rx="2.5" fill="#0a1628" opacity=".6"/>
          </svg>
        </div>
      </div>

      <!-- 1,000 LEADS -->
      <div class="ocard">
        <span class="obadge">1,000 leads</span>
        <h3>Truck Wrap</h3>
        <span class="onote">$1,500 credit</span>
        <div class="oblob">
          <svg viewBox="0 0 120 120" role="img" aria-label="A work truck with a wrap.">
            <rect x="10" y="38" width="62" height="40" rx="5" fill="#dcfbef"/>
            <rect x="19" y="48" width="34" height="7" rx="3.5" fill="#00a86e"/>
            <rect x="19" y="60" width="24" height="5" rx="2.5" fill="#7f93ae"/>
            <rect x="47" y="59" width="9" height="9" rx="1.5" fill="#00e5a0"/>
            <path d="M72 50 H94 L104 62 V78 H72 Z" fill="#00e5a0"/>
            <rect x="78" y="55" width="15" height="10" rx="2" fill="#0a1628"/>
            <path d="M8 78 H108" stroke="#3a4f6f" stroke-width="4" stroke-linecap="round"/>
            <circle cx="34" cy="84" r="11" fill="#0a1628" stroke="#dcfbef" stroke-width="4"/>
            <circle cx="88" cy="84" r="11" fill="#0a1628" stroke="#dcfbef" stroke-width="4"/>
          </svg>
        </div>
      </div>

    </div>
    <a class="btn" href="/get-started/" style="margin-top:44px">Get Started →</a>
    <span class="under">Live in about 10 minutes</span>
  </div>
</section>

<!-- GALLERY: YARD SIGNS (signs on wooden stakes, planted in grass) -->
<section class="galstrip grass" aria-label="Yard sign examples">
  <div class="gal-badge-wrap"><span class="gal-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 21h8M12 17v4M7 4h10v4a5 5 0 0 1-10 0V4z"/><path d="M17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3"/></svg>Unlocks at 25 leads</span></div>
  <div class="gal" data-gal>
    <button class="gal-nav prev" type="button" aria-label="Previous">&lsaquo;</button>
    <div class="gal-track">
      {Array.from({ length: 10 }).map((_, i) => {
        const n = String(i + 1).padStart(2, "0");
        return (
          <figure class="gal-item"><div class="ys">
            <img class="ys-sign" src={`/better-together/yard-signs/yard-sign-${n}.webp`} alt={`Custom Consent Resolve yard sign design ${i + 1}`} loading="lazy" width="640" height="480" />
            <svg class="ys-stake" viewBox="0 0 24 68" aria-hidden="true">
              <path d="M9 0 L15 0 L13.6 58 L12 67 L10.4 58 Z" fill="#8a5a2c"/>
              <path d="M9 0 L11 0 L10.2 58 L9.8 58 Z" fill="#a97a3a"/>
              <path d="M12.7 5 L12.1 57" stroke="#6a4620" stroke-width="0.7" opacity="0.45"/>
              <path d="M10.7 9 L10.3 52" stroke="#6a4620" stroke-width="0.5" opacity="0.3"/>
            </svg>
          </div></figure>
        );
      })}
    </div>
    <button class="gal-nav next" type="button" aria-label="Next">&rsaquo;</button>
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="sec sec-dark">
  <div class="wrap" style="text-align:center">
    <span class="tag">How it works</span>
    <h2>Four steps. Then it starts over.</h2>

    <div class="ogrid hiw" id="hiw">

      <!-- STEP 1 -->
      <div class="ocard">
        <span class="obadge obadge-mint">Step 1</span>
        <h3>They Visit</h3>
        <p class="oline">From your ad, a search, or a sign in a neighbor's yard.</p>
        <div class="oblob oblob-lite">
          <svg viewBox="0 0 120 120" role="img" aria-label="Visitors arriving on your website, one after another.">
            <rect x="8" y="20" width="104" height="80" rx="8" fill="none" stroke="#0a1628" stroke-width="4"/>
            <path d="M8 40 H112" stroke="#0a1628" stroke-width="4"/>
            <circle cx="22" cy="30" r="3.5" fill="#7f93ae"/><circle cx="34" cy="30" r="3.5" fill="#7f93ae"/>
            <g class="pop">
              <circle cx="30" cy="62" r="9" fill="#00a86e"/>
              <path d="M18 88 a12 12 0 0 1 24 0" fill="#00a86e"/>
            </g>
            <g class="pop d2">
              <circle cx="60" cy="62" r="9" fill="#00a86e"/>
              <path d="M48 88 a12 12 0 0 1 24 0" fill="#00a86e"/>
            </g>
            <g class="pop d3">
              <circle cx="90" cy="62" r="9" fill="#00a86e"/>
              <path d="M78 88 a12 12 0 0 1 24 0" fill="#00a86e"/>
            </g>
          </svg>
        </div>
      </div>

      <!-- STEP 2 -->
      <div class="ocard">
        <span class="obadge obadge-mint">Step 2</span>
        <h3>They Say Yes</h3>
        <p class="oline">Nobody gets named unless they agree to it first.</p>
        <div class="oblob oblob-lite">
          <svg viewBox="0 0 120 120" role="img" aria-label="A visitor agreeing on the consent banner.">
            <rect x="8" y="42" width="80" height="52" rx="9" fill="none" stroke="#0a1628" stroke-width="4"/>
            <rect x="20" y="56" width="42" height="6" rx="3" fill="#7f93ae"/>
            <rect x="20" y="68" width="30" height="5" rx="2.5" fill="#7f93ae"/>
            <rect x="20" y="80" width="30" height="10" rx="5" fill="#00a86e" class="pop d2"/>
            <circle cx="88" cy="42" r="23" fill="#00a86e" class="pop d2"/>
            <path d="M77 42 L85 51 L100 33" stroke="#dcfbef" stroke-width="6" fill="none"
                  stroke-linecap="round" stroke-linejoin="round" class="draw"/>
          </svg>
        </div>
      </div>

      <!-- STEP 3 -->
      <div class="ocard">
        <span class="obadge obadge-mint">Step 3</span>
        <h3>You Get a Lead</h3>
        <p class="oline">Their name and email. $7. Nobody else gets it.</p>
        <div class="oblob oblob-lite">
          <svg viewBox="0 0 120 120" role="img" aria-label="A contact card with a name, an email, and a seven dollar price.">
            <rect x="10" y="18" width="100" height="64" rx="8" fill="none" stroke="#0a1628" stroke-width="4"/>
            <circle cx="38" cy="42" r="11" fill="#00a86e"/>
            <path d="M26 62 a12 12 0 0 1 24 0" fill="#00a86e"/>
            <rect x="60" y="34" width="36" height="6" rx="3" fill="#0a1628" class="pop"/>
            <rect x="60" y="46" width="28" height="5" rx="2.5" fill="#7f93ae" class="pop d2"/>
            <rect x="60" y="57" width="32" height="5" rx="2.5" fill="#7f93ae" class="pop d3"/>
            <g class="pop d4">
              <rect x="34" y="88" width="52" height="24" rx="12" fill="#00a86e"/>
              <text x="60" y="105" text-anchor="middle" font-family="Bricolage Grotesque, sans-serif"
                    font-size="15" font-weight="800" fill="#dcfbef">$7</text>
            </g>
          </svg>
        </div>
      </div>

      <!-- STEP 4 -->
      <div class="ocard">
        <span class="obadge obadge-mint">Step 4</span>
        <h3>We Fuel The Fire</h3>
        <p class="oline">More signs out. More visits in. Back to the top.</p>
        <div class="oblob oblob-lite">
          <svg viewBox="0 0 120 120" role="img" aria-label="Growing bars with a rising arrow and a yard sign.">
            <g class="spin" opacity=".38">
              <circle cx="60" cy="60" r="52" fill="none" stroke="#7f93ae" stroke-width="4"
                      stroke-dasharray="14 12" stroke-linecap="round"/>
            </g>
            <rect x="26" y="66" width="16" height="30" rx="3" fill="#7f93ae" class="bar"/>
            <rect x="50" y="50" width="16" height="46" rx="3" fill="#00a86e" class="bar d2"/>
            <rect x="74" y="32" width="16" height="64" rx="3" fill="#00e5a0" class="bar d3"/>
            <path d="M30 44 L58 30 L86 14" stroke="#0a1628" stroke-width="5" fill="none"
                  stroke-linecap="round" stroke-linejoin="round" class="draw"/>
            <path d="M74 12 L90 10 L88 26 Z" fill="#0a1628" class="pop d3"/>
            <path d="M20 100 H100" stroke="#0a1628" stroke-width="4" stroke-linecap="round"/>
          </svg>
        </div>
      </div>

    </div>

    <svg class="cyc" viewBox="0 0 1000 62" role="img" aria-label="The cycle returns from step four back to step one.">
      <path class="cycline" d="M978 6 V32 Q978 50 960 50 H40 Q22 50 22 32 V10"
            fill="none" stroke="#00e5a0" stroke-width="3" stroke-linecap="round"/>
      <path d="M22 4 L14 20 L30 20 Z" fill="#00e5a0"/>
    </svg>
    <p class="cyclabel">and it starts over</p>

    <!-- GALLERY: DOOR HANGERS (mockups shot on a door — immersive dark band) -->
    <div class="galstrip photo" aria-label="Door hanger examples">
      <div class="gal-badge-wrap"><span class="gal-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 21h8M12 17v4M7 4h10v4a5 5 0 0 1-10 0V4z"/><path d="M17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3"/></svg>Unlocks at 100 leads</span></div>
      <div class="gal" data-gal>
        <button class="gal-nav prev" type="button" aria-label="Previous">&lsaquo;</button>
        <div class="gal-track">
          {Array.from({ length: 10 }).map((_, i) => {
            const n = String(i + 1).padStart(2, "0");
            return (
              <figure class="gal-item"><div class="gal-ph">
                <img src={`/better-together/door-hangers/door-hanger-${n}.webp`} alt={`Custom Consent Resolve door hanger design ${i + 1} on a door`} loading="lazy" width="760" height="507" />
              </div></figure>
            );
          })}
        </div>
        <button class="gal-nav next" type="button" aria-label="Next">&rsaquo;</button>
      </div>
    </div>

    <!-- BETTER TOGETHER CONSOLE -->
    <div class="bt" id="bt">
      <span class="bt-eye">Better together</span>
      <p class="bt-line">Here's the loop: you drive the visits — from your ads, your signs, your name getting around. We turn the ones who say yes into exclusive $7 leads. And as those leads stack up, you cross milestones that mail you more signs, more hangers, more magnets — which put your name in front of more people, who send more visits. Watch it run.</p>
      <p class="bt-why">Offline and online were never two budgets — they're one flywheel. Your signs work the street, our code works the site, and each one makes the other worth more. The milestone signs, hangers, and magnets ship to you at no extra charge — <strong>the only thing you ever pay for is the $7 leads.</strong></p>

      <div class="bt-nums">
        <div class="bt-num">
          <b id="btVisits">0</b>
          <span>Visits <em>you bring</em></span>
        </div>
        <div class="bt-join" aria-hidden="true">
          <svg viewBox="0 0 44 24"><path d="M2 12 H34" stroke="currentColor" stroke-width="3"
            stroke-linecap="round"/><path d="M30 5 L41 12 L30 19 Z" fill="currentColor"/></svg>
        </div>
        <div class="bt-num is-lead">
          <b id="btLeads">0</b>
          <span>Leads <em>we get you</em></span>
        </div>
      </div>

      <div class="bt-track">
        <div class="bt-fill" id="btFill"></div>
        <div class="bt-dot" id="btDot"></div>
        <i class="bt-tick" style="left:14%"></i>
        <i class="bt-tick" style="left:30%"></i>
        <i class="bt-tick" style="left:48%"></i>
        <i class="bt-tick" style="left:100%"></i>
      </div>

      <div class="bt-rewards">
        <div class="bt-rw" data-at="25">
          <div class="bt-ico">
            <svg viewBox="0 0 40 40"><rect x="7" y="8" width="26" height="18" rx="3"/><path d="M20 26 V33" stroke="currentColor" stroke-width="3" stroke-linecap="round" fill="none"/></svg>
          </div>
          <b>Yard Signs</b><span>25 leads</span>
          <svg class="bt-chk" viewBox="0 0 24 24"><path d="M5 12 L10 17 L19 7"/></svg>
        </div>
        <div class="bt-rw" data-at="100">
          <div class="bt-ico">
            <svg viewBox="0 0 40 40"><rect x="12" y="6" width="16" height="28" rx="4"/><circle cx="20" cy="13" r="4" fill="#0a1628"/></svg>
          </div>
          <b>Hangers + Stickers</b><span>100 leads</span>
          <svg class="bt-chk" viewBox="0 0 24 24"><path d="M5 12 L10 17 L19 7"/></svg>
        </div>
        <div class="bt-rw" data-at="250">
          <div class="bt-ico">
            <svg viewBox="0 0 40 40"><rect x="5" y="10" width="20" height="15" rx="2"/><ellipse cx="26" cy="27" rx="11" ry="7"/></svg>
          </div>
          <b>Cards + Magnets</b><span>250 leads</span>
          <svg class="bt-chk" viewBox="0 0 24 24"><path d="M5 12 L10 17 L19 7"/></svg>
        </div>
        <div class="bt-rw" data-at="1000">
          <div class="bt-ico">
            <svg viewBox="0 0 40 40"><rect x="4" y="13" width="21" height="14" rx="2"/><path d="M25 17 H32 L36 22 V27 H25 Z"/><circle cx="12" cy="30" r="4" fill="#0a1628"/><circle cx="30" cy="30" r="4" fill="#0a1628"/></svg>
          </div>
