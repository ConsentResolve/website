@keyframes travel{0%{opacity:0}12%{opacity:1}42%{opacity:1}56%{opacity:0}100%{opacity:0}}

/* ---------- CHOICES ---------- */
.choices{margin-top:44px;border:1px solid var(--rule);border-radius:16px;overflow:hidden}
