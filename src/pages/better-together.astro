/* ---------- 100 PEOPLE ---------- */
.crowd{display:grid;grid-template-columns:repeat(20,1fr);gap:7px;margin:38px 0 26px;max-width:640px}
.dot{aspect-ratio:1;border-radius:50%;background:var(--mint-deep);opacity:1;
  transition:background .5s ease,opacity .5s ease}
.crowd.go .dot.gone{background:var(--gray);opacity:.5}
.crowd.go .dot.stay{background:var(--mint);box-shadow:0 0 0 3px var(--mint-soft)}
.crowd-key{display:flex;flex-wrap:wrap;gap:12px 30px;font-size:.98rem;color:var(--muted)}
.crowd-key i{width:13px;height:13px;border-radius:50%;display:inline-block;margin-right:9px;
  vertical-align:-1px}
.k-stay{background:var(--mint)} .k-gone{background:var(--gray)}

/* ---------- THE LOOP ---------- */
.loop{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin-top:44px;position:relative}
.node{background:var(--ink-2);border:1px solid #233248;border-radius:14px;padding:24px 18px;
  position:relative;transition:border-color .4s ease,background .4s ease}
