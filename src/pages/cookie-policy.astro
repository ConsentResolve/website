---
import BaseLayout from "~/layouts/BaseLayout.astro";
import LegalPlaceholder from "~/components/sections/LegalPlaceholder.astro";
import { breadcrumbSchema } from "~/lib/seo";

const schemas = [
  breadcrumbSchema([
    { name: "Home", href: "/" },
    { name: "Cookie Policy", href: "/cookie-policy/" },
  ]),
];
---

<BaseLayout
  title="Cookie Policy | Consent Resolve"
  description="Which cookies Consent Resolve sets, what they do, and how to control them."
  schema={schemas}
>
  <LegalPlaceholder
    badge="Cookies"
    title="Cookie Policy"
    intro="This policy explains the cookies and similar technologies Consent Resolve sets on customer websites and on consentresolve.com itself, along with how to control them."
    highlights={[
      {
        heading: "Functional cookies",
        body: "We use a minimal set of cookies to keep you signed in to your dashboard, remember your preferences, and ensure security. These cookies are required for the site to work and cannot be disabled.",
      },
      {
        heading: "Identification cookies (on customer sites)",
        body: "When a homeowner accepts your consent banner on a site running Consent Resolve, we set a consent-anchored cookie used to identify them as a returning visitor and tie them to their consent record. Nothing is set before the visitor accepts the banner.",
      },
      {
        heading: "Analytics",
        body: "On consentresolve.com we use privacy-respecting analytics to understand traffic patterns. No personal identifiers are stored; you may opt out via your browser's Do Not Track / Global Privacy Control settings, which we honor.",
      },
      {
        heading: "How to control cookies",
        body: "Most browsers let you block or delete cookies via Settings. Blocking required cookies will prevent dashboard sign-in. Disabling identification cookies on a customer site means you cannot be identified by Consent Resolve.",
      },
    ]}
    siblings={[
      { label: "Privacy Policy", href: "/privacy-policy/" },
      { label: "Terms of Service", href: "/terms/" },
      { label: "GDPR", href: "/gdpr/" },
      { label: "CCPA", href: "/ccpa/" },
    ]}
  />
</BaseLayout>
