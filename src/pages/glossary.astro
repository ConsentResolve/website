---
import BaseLayout from "~/layouts/BaseLayout.astro";
import FinalCTA from "~/components/sections/FinalCTA.astro";
import Badge from "~/components/ui/Badge.astro";
import { breadcrumbSchema } from "~/lib/seo";

interface Term {
  term: string;
  short: string;       // one-line definition
  long: string;        // 2–4 sentence expansion
  /** Optional cross-links. */
  see?: { label: string; href: string }[];
}

const terms: Term[] = [
  {
    term: "Consent-first identification",
    short: "Identifying a website visitor only after they accept a consent banner.",
    long: "A privacy-respecting alternative to shadow-tracking. Consent-first identification means no name, mobile, or email is captured until the homeowner accepts your site's consent banner — giving you a legally clean, recordable opt-in for every lead. Required for GDPR, CCPA, and CPA compliance.",
    see: [{ label: "Consent-First Identification feature", href: "/features/consent-first-identification/" }],
  },
  {
    term: "Exclusive lead",
    short: "A lead delivered to one contractor only, never resold.",
    long: "The opposite of a shared lead. An exclusive lead is sourced from your own website traffic, identified through your consent banner, and delivered only to you — never auctioned, never blasted to four other shops. Consent Resolve treats every lead as exclusive by design.",
    see: [{ label: "Exclusive Leads feature", href: "/features/exclusive-leads/" }],
  },
  {
    term: "Shared lead (or shared-lead reseller)",
    short: "A lead sold to multiple contractors at the same time.",
    long: "The business model behind Thumbtack, Angi, and HomeAdvisor. A single homeowner inquiry is sold to 3–8 contractors at once, forcing every recipient to race the others to the phone. Loaded cost is typically $25–$120 per lead.",
    see: [{ label: "Stats & sources", href: "/stats/#lead-trap" }],
  },
  {
    term: "Channel recovery",
    short: "Recovering the website visitors your existing ads already paid for but lost.",
    long: "When a homeowner clicks an LSA, Thumbtack, or Angi ad and lands on your site without converting, that visit is already paid for — but the lead vanishes when they close the tab. Channel recovery identifies those consented visitors after the fact and hands them back as real, callable leads.",
    see: [{ label: "Channel Recovery feature", href: "/features/channel-recovery/" }],
  },
  {
    term: "Loaded cost per lead (loaded CPL)",
    short: "What a lead actually costs once dispute denials, dead numbers, and shared-with-others odds are factored in.",
    long: "A reseller's advertised price is rarely what you actually pay per usable lead. Loaded CPL counts billable dead leads, denied dispute credits, and the fact that the same lead is sold to four other shops. Industry-average loaded CPL for Thumbtack is ~$46; for Angi and HomeAdvisor, ~$50; for Google LSA, ~$53.",
    see: [{ label: "Stats & sources", href: "/stats/#lead-trap" }],
  },
  {
    term: "Consent banner",
    short: "The cookie/privacy notice that asks a visitor for permission before tracking.",
    long: "A web banner — usually at the bottom or top of a page — that asks visitors for explicit permission to be tracked or contacted. Required under GDPR, CCPA, and a growing list of state privacy laws. Consent Resolve runs alongside your existing banner; nothing happens unless the homeowner clicks Accept.",
  },
  {
    term: "Audit trail",
    short: "A timestamped, regulator-ready record of every consent given and lead delivered.",
    long: "If a regulator or homeowner ever asks how you got their information, you need proof. Consent Resolve logs every consent action with a timestamp and audit ID, signed by the privacy infrastructure (Termageddon). That record is your defense.",
    see: [{ label: "Built-In Compliance feature", href: "/features/built-in-compliance/" }],
  },
  {
    term: "Speed-to-lead",
    short: "How fast you contact a lead after they identify themselves.",
    long: "The single biggest predictor of who wins a home-service job. MIT research shows the odds of qualifying a lead are 21× higher inside 5 minutes vs after 30. Consent Resolve pushes new leads to your phone within minutes so you're the first voice the homeowner hears.",
    see: [{ label: "Instant Connect feature", href: "/features/instant-connect/" }],
  },
  {
    term: "Visitor identification",
    short: "Matching anonymous website traffic to a real name and contact details.",
    long: "An identity-resolution layer that converts an unknown browser session into a real person — name, mobile, email — using consent-graph data. Without consent, identification doesn't happen. With consent, you go from a faceless visit count to a callable prospect.",
    see: [{ label: "Visitor Identification feature", href: "/features/visitor-identification/" }],
  },
  {
    term: "Formless contact capture",
    short: "Capturing a name, phone, and email without requiring the visitor to fill out a form.",
    long: "Only about 2% of website visitors ever complete a contact form. Formless capture identifies the other 98% via consent — so you get the homeowners who showed real interest but didn't feel like typing their phone number into a box.",
    see: [{ label: "Formless Contact Capture feature", href: "/features/formless-contact-capture/" }],
  },
];

const schemas = [
  breadcrumbSchema([
    { name: "Home", href: "/" },
    { name: "Glossary", href: "/glossary/" },
  ]),
  // DefinedTermSet — AI engines love structured definition pages.
  {
    "@context": "https://schema.org",
    "@type": "DefinedTermSet",
    name: "Consent Resolve Glossary",
    hasDefinedTerm: terms.map((t) => ({
      "@type": "DefinedTerm",
      name: t.term,
      description: t.long,
    })),
  },
];
---

<BaseLayout
  title="Glossary — Consent-First Lead Generation Terms | Consent Resolve"
  description="Plain-English definitions for consent-first identification, exclusive leads, channel recovery, loaded CPL, audit trail, speed-to-lead, and more — the vocabulary of modern contractor lead generation."
  schema={schemas}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/20 blur-[120px]"></div>
    <div class="container-content section relative">
      <div class="mx-auto max-w-3xl text-center">
        <Badge tone="brand" variant="soft" size="md" uppercase>Reference</Badge>
        <h1 class="display-1 mb-7 mt-7 text-[color:var(--color-ink)]">
          Glossary —<br/>
          <span class="text-[color:var(--color-brand)]">the language of consent-first leads.</span>
        </h1>
        <p class="mx-auto max-w-2xl text-lg leading-relaxed text-[color:var(--color-ink-2)]">
          Plain-English definitions for the terms we use across the site. If you've ever wondered what "loaded CPL" actually means or why anyone would call a lead "exclusive," start here.
        </p>
      </div>
    </div>
  </section>

  <!-- Terms list -->
  <section class="section">
    <div class="container-content max-w-4xl">
      <dl class="space-y-12">
        {terms.map((t) => (
          <div id={t.term.toLowerCase().replace(/[^a-z0-9]+/g, "-")} class="scroll-mt-24 border-l-4 border-[color:var(--color-brand)] pl-6">
            <dt>
              <h2 class="font-display text-2xl font-black tracking-tight text-[color:var(--color-ink)] md:text-3xl">{t.term}</h2>
              <p class="mt-2 text-base font-semibold text-[color:var(--color-brand-pressed)]">{t.short}</p>
            </dt>
            <dd class="mt-4 text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">
              {t.long}
              {t.see && (
                <ul class="mt-4 flex flex-wrap gap-2">
                  {t.see.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        class="inline-flex items-center gap-1.5 rounded-full bg-[color:var(--color-brand-soft)] px-3 py-1 text-[11px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-brand-pressed)] hover:opacity-80"
                      >
                        {link.label} →
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <FinalCTA />
</BaseLayout>
