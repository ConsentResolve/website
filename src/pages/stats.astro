---
import BaseLayout from "~/layouts/BaseLayout.astro";
import StatCard from "~/components/ui/StatCard.astro";
import Badge from "~/components/ui/Badge.astro";
import RandomStatButton from "~/components/islands/RandomStatButton.tsx";
import FinalCTA from "~/components/sections/FinalCTA.astro";
import { HERO_STATS, STAT_SECTIONS, SOURCE_GROUPS, getAllStatsForSharing } from "~/data/stats";
import { breadcrumbSchema } from "~/lib/seo";
import { IconArrowRight, IconExternalLink, IconAlertTriangle, IconClock } from "@tabler/icons-react";

const schemas = [
  breadcrumbSchema([
    { name: "Home", href: "/" },
    { name: "Stats", href: "/stats/" },
  ]),
];

const shareable = getAllStatsForSharing();

// Callout palette by tone — used at the bottom of each section
const calloutTone = {
  danger:  "border-red-300 bg-red-50",
  warning: "border-amber-300 bg-amber-50",
  brand:   "border-[color:var(--color-brand)]/45 bg-[color:var(--color-brand-soft)]",
  info:    "border-sky-300 bg-sky-50",
  neutral: "border-[color:var(--color-rule)] bg-[color:var(--color-bg-alt)]",
} as const;
const calloutText = {
  danger:  "text-red-700",
  warning: "text-amber-700",
  brand:   "text-[color:var(--color-brand-pressed)]",
  info:    "text-sky-700",
  neutral: "text-[color:var(--color-ink-2)]",
} as const;

const lastUpdated = "June 2026";
---

<BaseLayout
  title="The Data Behind the Story — Stats & Sources | Consent Resolve"
  description="Every claim, every stat, every problem we solve — backed by research. The cost of anonymous traffic, the lead-seller trap, recovery proof, and privacy fines. Live source links."
  schema={schemas}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/20 blur-[120px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-40 top-1/3 size-[420px] rounded-full bg-[color:var(--color-mint-400)]/12 blur-[140px]"></div>
    <div class="container-content section relative">
      <div class="mx-auto max-w-3xl text-center">
        <Badge tone="brand" variant="soft" size="md" uppercase>Live dashboard</Badge>
        <h1 class="display-1 mb-7 mt-7 text-[color:var(--color-ink)]">
          The Data Behind <br/>
          <span class="text-[color:var(--color-brand)]">the Story.</span>
        </h1>
        <p class="mx-auto mb-10 max-w-2xl text-lg leading-relaxed text-[color:var(--color-ink-2)]">
          Every claim, every stat, every problem we solve — backed by research. This dashboard shows why visitor identification matters and how we solve it differently. <span class="whitespace-nowrap text-[color:var(--color-ink-muted)]">Last updated: {lastUpdated}.</span>
        </p>
      </div>

      <!-- Hero KPI strip -->
      <div class="mx-auto mt-12 grid max-w-6xl gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {HERO_STATS.map((s) => <StatCard stat={s} tone="brand" compact />)}
      </div>

      <!-- Share-a-stat -->
      <div class="mt-12 flex justify-center">
        <RandomStatButton client:visible stats={shareable} />
      </div>
    </div>
  </section>

  <!-- Sticky section nav -->
  <nav aria-label="Stat sections" class="sticky top-4 z-20 mx-auto mt-4 w-fit max-w-[calc(100%-2rem)]">
    <ul class="flex w-max items-center gap-1 overflow-x-auto rounded-full bg-[color:var(--color-bg)] p-1.5 shadow-[0_18px_40px_-20px_rgba(10,22,40,0.28)] ring-1 ring-inset ring-[color:var(--color-rule)]">
      {STAT_SECTIONS.map((s, i) => (
        <li>
          <a
            href={`#${s.slug}`}
            class="inline-flex items-center gap-2 rounded-full px-3.5 py-2 text-[11px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-2)] transition-colors hover:bg-[color:var(--color-bg-alt)] hover:text-[color:var(--color-brand-pressed)]"
          >
            <span class="font-mono text-[color:var(--color-brand-pressed)]">0{i + 1}</span>
            {s.eyebrow}
          </a>
        </li>
      ))}
      <li>
        <a
          href="#sources"
          class="inline-flex items-center gap-2 rounded-full px-3.5 py-2 text-[11px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)] transition-colors hover:bg-[color:var(--color-bg-alt)] hover:text-[color:var(--color-brand-pressed)]"
        >
          Sources
        </a>
      </li>
    </ul>
  </nav>

  <!-- Sections -->
  {STAT_SECTIONS.map((section, i) => (
    <section id={section.slug} class:list={["section scroll-mt-24", i % 2 === 1 ? "bg-[color:var(--color-bg-alt)]" : ""]}>
      <div class="container-content">
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <Badge tone={section.tone} variant="soft" size="md" uppercase>{section.eyebrow}</Badge>
          <h2 class="display-2 mt-5 text-[color:var(--color-ink)]">{section.headline}</h2>
          <p class="mt-4 text-lg leading-relaxed text-[color:var(--color-ink-2)]">{section.subhead}</p>
        </div>

        <!-- Stat grid -->
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {section.stats.map((s) => <StatCard stat={s} tone={section.tone} />)}
        </div>

        <!-- Optional inline strip (CPL by trade) -->
        {section.inline && (
          <div class="mt-8 overflow-hidden rounded-2xl bg-[color:var(--color-bg)] ring-1 ring-inset ring-[color:var(--color-rule)]">
            <div class="flex flex-wrap items-center justify-between gap-3 px-6 py-4">
              <div class="flex items-center gap-3">
                <Badge tone={section.tone} variant="soft" size="sm" uppercase>{section.inline.title}</Badge>
                <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-semibold text-[color:var(--color-ink-2)]">
                  {section.inline.items.map((item) => <li>{item}</li>)}
                </ul>
              </div>
              <a
                href={section.inline.source.url}
                target="_blank"
                rel="noreferrer noopener"
                class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)] transition-colors hover:text-[color:var(--color-brand-pressed)]"
              >
                {section.inline.source.name}
                <IconExternalLink size={11} stroke={2.25} />
              </a>
            </div>
          </div>
        )}

        <!-- Editorial caveat (legal) -->
        {section.note && (
          <div class="mt-6 flex items-start gap-3 rounded-xl bg-amber-50 px-4 py-3 ring-1 ring-inset ring-amber-200">
            <IconAlertTriangle size={16} stroke={2.25} color="#b45309" class="mt-0.5 shrink-0" />
            <p class="text-xs leading-relaxed text-amber-900">
              <strong class="font-bold">Editorial note.</strong> {section.note}
            </p>
          </div>
        )}

        <!-- Section callout -->
        <div class:list={["mt-10 rounded-3xl border-l-4 px-8 py-7", calloutTone[section.tone]]}>
          <p class:list={["mb-2 text-xs font-bold uppercase tracking-[0.16em]", calloutText[section.tone]]}>
            {section.callout.title}
          </p>
          <p class="text-[17px] leading-relaxed text-[color:var(--color-ink)]">
            {section.callout.body}
          </p>
        </div>
      </div>
    </section>
  ))}

  <!-- CTA -->
  <section class="section-dark relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -right-32 top-1/2 size-[480px] -translate-y-1/2 rounded-full bg-[color:var(--color-mint-400)]/15 blur-[120px]"></div>
    <div class="container-content section relative">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow mb-5 justify-center" style="color:var(--color-mint-400)">The Consent Resolve solution</p>
        <h2 class="display-1 mb-6 text-white">We solve both problems.</h2>
        <p class="mx-auto max-w-2xl text-lg leading-relaxed text-slate-300">
          Consent Resolve lets you identify and recover anonymous visitors — safely, legally, and affordably. You get the results without the risk.
        </p>
        <ul class="mx-auto mt-8 flex max-w-3xl flex-wrap items-center justify-center gap-2">
          <li><Badge tone="brand" variant="soft" surface="dark" size="sm" uppercase>Consent-first</Badge></li>
          <li><Badge tone="brand" variant="soft" surface="dark" size="sm" uppercase>Automated outreach</Badge></li>
          <li><Badge tone="brand" variant="soft" surface="dark" size="sm" uppercase>Pay-per-result</Badge></li>
          <li><Badge tone="brand" variant="soft" surface="dark" size="sm" uppercase>Exclusive — never shared</Badge></li>
        </ul>
        <div class="mt-10 flex justify-center">
          <a
            href="/get-started/"
            class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-brand)] px-7 py-3.5 text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--color-navy-900)] shadow-[0_18px_36px_-18px_rgba(0,229,160,0.55)] transition-all hover:-translate-y-0.5 hover:bg-[color:var(--color-brand-pressed)] hover:text-white"
          >
            Get Started
            <IconArrowRight size={16} stroke={2.5} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Sources -->
  <section id="sources" class="section scroll-mt-24">
    <div class="container-content">
      <div class="mx-auto mb-14 max-w-2xl text-center">
        <Badge tone="neutral" variant="outline" size="sm" uppercase>Citations</Badge>
        <h2 class="display-2 mt-5 text-[color:var(--color-ink)]">Complete data sources.</h2>
        <p class="mt-4 text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">
          Every stat on this page links back to the original research. The full list, grouped by category.
        </p>
      </div>

      <div class="grid gap-8 lg:grid-cols-2">
        {SOURCE_GROUPS.map((g) => (
          <div class="rounded-2xl bg-[color:var(--color-bg-alt)] p-7 ring-1 ring-inset ring-[color:var(--color-rule)]">
            <h3 class="font-display text-base font-black uppercase tracking-[0.14em] text-[color:var(--color-brand-pressed)]">{g.title}</h3>
            <ul class="mt-5 space-y-3">
              {g.sources.map((src) => (
                <li>
                  <a
                    href={src.url}
                    target="_blank"
                    rel="noreferrer noopener"
                    class="group flex items-start gap-2 text-[14px] leading-relaxed text-[color:var(--color-ink)] transition-colors hover:text-[color:var(--color-brand-pressed)]"
                  >
                    <span class="mt-1.5 inline-block size-1.5 shrink-0 rounded-full bg-[color:var(--color-brand)]"></span>
                    <span>
                      <span class="font-semibold">{src.name}</span>
                      {src.note && <span class="text-[color:var(--color-ink-2)]"> — {src.note}</span>}
                      <IconExternalLink size={11} stroke={2.25} class="ml-1 inline-block translate-y-[-1px] opacity-50 transition-opacity group-hover:opacity-100" />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- Methodology -->
      <div class="mx-auto mt-14 max-w-4xl rounded-2xl bg-[color:var(--color-bg-alt)] p-8 ring-1 ring-inset ring-[color:var(--color-rule)]">
        <div class="flex items-start gap-3">
          <IconClock size={20} stroke={1.75} color="#0A1628" class="mt-0.5 shrink-0" />
          <div>
            <p class="font-display text-sm font-black uppercase tracking-[0.14em] text-[color:var(--color-brand-pressed)]">Methodology & transparency</p>
            <p class="mt-3 text-[14px] leading-relaxed text-[color:var(--color-ink-2)]">
              All statistics presented are sourced from published research, regulatory documentation, or verified industry benchmarks. Performance metrics (conversion rates, cost-per-lead, book rates, ROI) represent typical results documented in industry research; individual results vary based on implementation, industry, traffic quality, and follow-up strategy. Lead-platform cost figures vary by trade, market, and season, and are stated as published ranges. Regulatory penalties are stated at the statutory maximum and vary by jurisdiction, violation severity, and compliance history. Last updated: {lastUpdated}.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FinalCTA />
</BaseLayout>
