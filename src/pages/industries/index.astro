---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Badge from "~/components/ui/Badge.astro";
import IllustrationCard from "~/components/ui/IllustrationCard.astro";
import FinalCTA from "~/components/sections/FinalCTA.astro";
import { INDUSTRIES } from "~/data/industries";
import { breadcrumbSchema } from "~/lib/seo";
import { IconArrowRight } from "@tabler/icons-react";

const schemas = [
  breadcrumbSchema([
    { name: "Home", href: "/" },
    { name: "Industries", href: "/industries/" },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Lead Generation by Trade",
    url: "https://consentresolve.com/industries/",
    description: "Exclusive, consent-based leads built for your trade — 17 home-service trades supported.",
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Consent Resolve Industries",
    itemListElement: INDUSTRIES.map((i, idx) => ({
      "@type": "ListItem",
      position: idx + 1,
      url: `https://consentresolve.com/${i.slug}-leads/`,
      name: i.name,
    })),
  },
];
---

<BaseLayout
  title="Turn Anonymous Shoppers Into Jobs, by Trade | Consent Resolve"
  description="Turn anonymous homeowners into booked jobs — recovery built for your trade: plumbers, roofers, HVAC, electricians, and 13 more. Recover the 98% of visitors who bounce, feed them back into your existing funnel, and book more jobs on the same ad budget. Flat $7 per recovered lead."
  schema={schemas}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/20 blur-[120px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-32 top-32 size-[420px] rounded-full bg-[color:var(--color-mint-400)]/15 blur-[120px]"></div>
    <div class="container-content section relative">
      <div class="mx-auto max-w-3xl text-center">
        <Badge tone="brand" variant="soft" size="md" uppercase>Built for your trade</Badge>
        <h1 class="display-1 mb-7 mt-7 text-[color:var(--color-ink)]">
          Turn Your Trade's Anonymous Shoppers <span class="text-[color:var(--color-brand-pressed)]">Into Booked Jobs.</span>
        </h1>
        <p class="mx-auto max-w-2xl text-lg leading-relaxed text-[color:var(--color-ink-2)]">
          Same ad budget — recovery built for the way your trade actually wins work. The homeowner pricing a re-pipe doesn't shop like the one pricing a new roof. Pick your trade and see how Consent Resolve drops into the funnel you already run.
        </p>
        <div class="mt-10">
          <a
            href="https://dashboard.consentresolve.com/register"
            class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-brand)] px-7 py-3.5 text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--color-navy-900)] shadow-[0_18px_36px_-18px_rgba(0,229,160,0.55)] transition-all hover:-translate-y-0.5 hover:bg-[color:var(--color-brand-pressed)] hover:text-white"
          >
            Get Started
            <IconArrowRight size={16} stroke={2.5} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trade grid -->
  <section class="section pt-0">
    <div class="container-content">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {INDUSTRIES.map((i) => (
          <IllustrationCard
            illustration={i.illustration}
            title={i.name}
            body={i.cardCopy}
            href={`/${i.slug}-leads/`}
          />
        ))}
      </div>
    </div>
  </section>

  <FinalCTA />
</BaseLayout>
