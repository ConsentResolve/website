---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Badge from "~/components/ui/Badge.astro";
import Button from "~/components/ui/Button.astro";
import FeatureCard from "~/components/ui/FeatureCard.astro";
import HowItWorks from "~/components/sections/HowItWorks.astro";
import ComplianceBand from "~/components/sections/ComplianceBand.astro";
import FAQ from "~/components/sections/FAQ.astro";
import FinalCTA from "~/components/sections/FinalCTA.astro";
import VisitorDetailScreen from "~/components/ui/demo/VisitorDetailScreen.astro";
import { INDUSTRIES } from "~/data/industries";
import { breadcrumbSchema, faqSchema } from "~/lib/seo";
import {
  IconArrowRight, IconEye, IconUsers, IconCash, IconShieldCheck, IconClock,
  IconBuilding, IconTool, IconLeaf, IconAirConditioning, IconDroplet, IconKey,
  IconBolt, IconHome, IconBrush, IconLayoutBoardSplit, IconBuildingWarehouse,
  IconHome2, IconSparkles, IconBugOff, IconBath, IconCar,
} from "@tabler/icons-react";

// iconKey -> Tabler component (mirrors the per-trade landing pages) for the trade selector.
const iconMap: Record<string, any> = {
  IconBuildingCommunity: IconBuilding, IconTool, IconTrees: IconLeaf,
  IconAirConditioning, IconDroplet, IconKey, IconBolt, IconHome,
  IconPaint: IconBrush, IconFence: IconLayoutBoardSplit, IconGarage: IconBuildingWarehouse,
  IconFridge: IconHome2, IconSparkles, IconBug: IconBugOff, IconSpray: IconBath,
  IconPlant: IconLeaf, IconCar,
};

// SEO — preserve breadcrumb + CollectionPage + ItemList, add FAQPage.
const HUB_FAQS = [
  { q: "How is this different from Angi or HomeAdvisor?", a: "Those are shared-lead resellers — they sell the same homeowner to four or five contractors at once, so you're bidding against everyone who bought the same name. Here, every lead is exclusive to you and never resold: a real name, a consented email, and the pages they viewed, fed into your CRM at a flat $7. It's not a marketplace." },
  { q: "Is identifying my website visitors even legal?", a: "Yes — it's built consent-first. A privacy-compliant banner asks each visitor for permission, and you only get a lead when they accept. Every lead carries a timestamped consent receipt and a 7-year audit trail, built for TCPA, CIPA, and state privacy laws." },
  { q: "Isn't this the creepy kind of tracking that emails people who never opted in?", a: "No. Nobody becomes a lead here unless they accept the consent banner first. No consent, no data. You get a name and a consented email to follow up by email — not a number to cold-call and not a name that was scraped." },
  { q: "Are the leads exclusive, or will my competitor get the same name?", a: "Exclusive. A lead recovered on your website is yours alone and is never resold. They were on your site looking at your services, not shopping a marketplace." },
  { q: "I get website traffic but barely any calls. Why?", a: "Most home-service sites convert only a small share of visitors; the rest read a service page and leave. This recovers the ones who consent, so a visitor already looking at your services becomes a named lead in your CRM instead of an anonymous bounce." },
  { q: "Am I locked into a contract or a monthly minimum?", a: "No long-term contract and no annual membership. It's flat $7 per exclusive lead — card required, cancel anytime." },
  { q: "How do the leads reach me so I can follow up?", a: "Recovered leads feed straight into your CRM — Jobber, Housecall Pro, ServiceTitan, HubSpot, Klaviyo, GoHighLevel — with the name, consented email, and services viewed, so you can follow up by email while the interest is fresh." },
];
const faqItems = HUB_FAQS.map((f) => ({ question: f.q, answer: f.a }));

const schemas = [
  breadcrumbSchema([
    { name: "Home", href: "/" },
    { name: "Industries", href: "/industries/" },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Lead Generation by Trade",
    url: "https://consentresolve.com/industries/",
    description: "Exclusive, consent-based leads built for your trade — 17 home-service trades supported.",
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Consent Resolve Industries",
    itemListElement: INDUSTRIES.map((i, idx) => ({
      "@type": "ListItem",
      position: idx + 1,
      url: `https://consentresolve.com/${i.slug}-leads/`,
      name: i.name,
    })),
  },
  faqSchema(faqItems),
];

// "Why it works" cards — built from the ad-campaign angles.
const whyCards = [
  {
    Icon: IconUsers,
    title: "Get back the 98% who leave.",
    body: "For every homeowner who calls, dozens read a service page and leave without a trace. Recover the ones who consent instead of paying for traffic that bounces.",
  },
  {
    Icon: IconCash,
    title: "One booked job pays for a lot of leads.",
    body: "At a flat $7 a lead, a single job you book covers a stack of exclusive leads. The spend maps to a named, consented homeowner — not clicks or impressions.",
  },
  {
    Icon: IconShieldCheck,
    title: "Leads that opted in — not scraped.",
    body: "A privacy-compliant banner asks first, and you only get a lead when they accept. Every record carries a timestamped consent receipt. No yes, no data.",
  },
  {
    Icon: IconClock,
    title: "Reach them while they're still deciding.",
    body: "The lead lands in your CRM with the pages they viewed, so you can follow up by email while they're still comparing options — not weeks later.",
  },
];

// Canonical shared-vs-exclusive math (on-canon: shared ~$46/lead sold to ~4 others; $7 flat exclusive).
const compare = {
  shared: { cost: "$575", sub: "$46 a lead · sold to ~4 others · ~1 in 12 books" },
  owned: { cost: "$140", sub: "$7 a lead · exclusive, never resold · yours alone" },
};

// Live product preview — generic home-service record for the hub page.
const demoSvc = "water heater replacement";
const demoSlug = "water-heater-replacement";
---

<BaseLayout
  ogImage="/og/industries.png"
  title="Find Your Trade — Exclusive Leads Built for the Work You Do"
  ogTitle="Pick your trade — exclusive, consent-first leads for 17 home-service trades."
  description="You run the trade. This is built for it. Pick your trade and turn the homeowners who leave your site into exclusive, consent-first leads — $7 each, yours alone, never resold."
  schema={schemas}
>
  <!-- HERO (dark, mirrors the trade landing pages) -->
  <section class="section section-dark relative overflow-hidden" style="padding-top:20px">
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/20 blur-[120px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-32 top-24 size-[420px] rounded-full bg-[color:var(--color-mint-400)]/15 blur-[120px]"></div>
    <div class="container-content relative">
      <!-- TOP ROW: TL;DR heading (contained to the left column) + "Tap your trade" button
           (right column, bottom-aligned so it sits directly above the trade list). -->
      <div class="grid items-end gap-12 lg:grid-cols-2">
        <div>
          <div class="mb-4"><Badge tone="brand" variant="soft" surface="dark" size="md" uppercase>Built for your trade</Badge></div>
          <h1 class="display-1 text-white">
            Your website visitors are <span class="text-[color:var(--color-brand)]">your next booked jobs.</span>
          </h1>
          <p class="mt-5 text-lg leading-relaxed text-slate-300">
            The short version: most homeowners who visit your site leave without a trace. We hand the ones who opt in back to you as exclusive, consent-first leads — a real name and email, $7 each, never resold. Pick your trade to see it on your own work.
          </p>
        </div>
        <div class="flex">
          <a
            id="tradeNudge"
            href="#tradeGrid"
            class="cr-slam inline-flex items-center gap-2.5 rounded-lg bg-[color:var(--color-brand)] px-6 py-3.5 text-[15px] font-extrabold uppercase tracking-wide text-[color:var(--color-navy-900)] no-underline shadow-[0_16px_40px_-10px_rgba(0,229,160,0.7)]"
          >
            Tap your trade
            <svg class="cr-nudge-arrow" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
        </div>
      </div>

      <!-- MAIN ROW: video (left) + trade list (right), tops aligned. -->
      <div class="mt-8 grid items-start gap-12 lg:grid-cols-2">
        <div class="w-full" data-hero-video>
          <div class="relative overflow-hidden rounded-2xl bg-black shadow-[0_30px_70px_-30px_rgba(0,0,0,0.8)] ring-1 ring-white/15">
            <video
              data-tyler
              autoplay
              muted
              loop
              playsinline
              preload="auto"
              poster="/team/tyler-spurlock.jpg"
              src="https://pub-27fc71b9070247178d8756a59bef0b33.r2.dev/social/sprint/hub-next-wide.mp4"
              class="block aspect-video h-full w-full object-cover"
            >
              <track kind="captions" src="/captions/hub-next-wide.vtt" srclang="en" label="English" default />
            </video>
            <button
              type="button"
              data-unmute
              aria-label="Tap for sound"
              class="absolute bottom-3 right-3 z-30 inline-flex items-center gap-2 rounded-full bg-[color:var(--color-navy-900)]/85 px-4 py-2.5 text-sm font-bold text-white ring-1 ring-inset ring-white/30 backdrop-blur transition-all hover:bg-[color:var(--color-navy-900)] hover:ring-[color:var(--color-mint-400)]"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z"></path><path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path><path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path></svg>
              Tap for sound
            </button>
          </div>
        </div>

        <!-- RIGHT: the trade selector — top aligns with the video (items-start). -->
        <div class="relative">
          <div id="tradeGrid" class="grid scroll-mt-24 grid-cols-2 gap-2 sm:grid-cols-3">
            {INDUSTRIES.map((i) => {
              const TI = iconMap[i.iconKey] ?? IconTool;
              return (
                <a
                  href={`/${i.slug}-leads/`}
                  class="trade-card group flex items-center gap-2 rounded-lg border border-white/10 bg-white/[0.03] px-2.5 py-2 transition-all duration-200 hover:-translate-y-0.5 hover:border-[color:var(--color-brand)] hover:bg-white/[0.06] hover:shadow-[0_14px_30px_-16px_rgba(0,229,160,0.55)]"
                >
                  <span class="grid size-8 shrink-0 place-items-center rounded-md bg-[color:var(--color-mint-400)]/15 text-[color:var(--color-mint-400)] transition-colors group-hover:bg-[color:var(--color-mint-400)] group-hover:text-[color:var(--color-navy-900)]">
                    <TI size={18} stroke={1.9} />
                  </span>
                  <span class="text-[12px] font-bold leading-tight text-white/85 group-hover:text-white">{i.shortName}</span>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works (shared five-step section) -->
  <HowItWorks>
    <Button href="/demo/" variant="primary" size="lg">
      <IconEye size={18} stroke={2} />
      Try the live demo
    </Button>
  </HowItWorks>

  <!-- Why it works — FeatureCard grid built from the ad angles -->
  <section class="section bg-[color:var(--color-bg-alt)]">
    <div class="container-content">
      <div class="mx-auto mb-14 max-w-2xl text-center">
        <div class="mb-5 flex justify-center"><Badge tone="brand" variant="soft" size="md" uppercase>Why it works</Badge></div>
        <h2 class="display-2 text-[color:var(--color-ink)]">
          You already paid for the traffic. Put it to work.
        </h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {whyCards.map((c) => (
          <FeatureCard variant="lift" icon={c.Icon} title={c.title} body={c.body} />
        ))}
      </div>
    </div>
  </section>

  <!-- Shared vs. exclusive — the canonical math -->
  <section class="section section-dark">
    <div class="container-content">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <div class="mb-5 flex justify-center"><Badge tone="brand" variant="soft" surface="dark" size="md" uppercase>The math</Badge></div>
        <h2 class="display-2 text-white">
          Same booked job. Less than a quarter of the cost.
        </h2>
        <p class="mt-3 text-[15px] text-slate-300">
          Shared-lead resellers sell the same homeowner to four or five pros at once, so most never book. Recover your own traffic instead — exclusive, at a flat $7. Here's the same job, both ways.
        </p>
      </div>
      <div class="mx-auto mb-8 grid max-w-3xl gap-5 sm:grid-cols-2">
        <div class="rounded-2xl bg-white/[0.04] p-7 ring-1 ring-inset ring-white/10">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-400">Shared / bought leads</p>
          <p class="mt-2 font-display text-4xl font-extrabold text-white">{compare.shared.cost}<span class="text-lg font-bold text-slate-400"> / booked job</span></p>
          <p class="mt-3 text-sm text-slate-300">{compare.shared.sub}</p>
        </div>
        <div class="rounded-2xl bg-[color:var(--color-mint-400)]/10 p-7 ring-1 ring-inset ring-[color:var(--color-mint-400)]/40 shadow-[0_30px_60px_-30px_rgba(0,229,160,0.45)]">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-mint-400)]">Your own traffic — Consent Resolve</p>
          <p class="mt-2 font-display text-4xl font-extrabold text-white">{compare.owned.cost}<span class="text-lg font-bold text-slate-400"> / booked job</span></p>
          <p class="mt-3 text-sm text-slate-300">{compare.owned.sub}</p>
        </div>
      </div>
      <p class="mx-auto max-w-2xl text-center text-[15px] text-slate-300">
        A shared lead from a marketplace like Thumbtack can run ~$100 and still land in four other inboxes. Here it's a flat <strong class="text-white">$7</strong>, exclusive, never resold. Illustrative, not a promise.
      </p>
    </div>
  </section>

  <!-- Live product preview — the actual visitor record -->
  <section class="section section-dark">
    <div class="container-content">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <div class="mb-5 flex justify-center"><Badge tone="brand" variant="soft" surface="dark" size="md" uppercase>The actual product</Badge></div>
        <h2 class="display-2 text-white">This is what lands in your dashboard.</h2>
        <p class="mt-4 text-[17px] leading-relaxed text-slate-300">
          A real name and a consented email — with the pages they viewed, what they were shopping for, and a timestamped consent receipt. Yours alone, never resold.
        </p>
      </div>
      <div class="mx-auto max-h-[460px] max-w-5xl overflow-auto rounded-[1.25rem] ring-1 ring-inset ring-white/10">
        <div class="min-w-[900px]">
          <VisitorDetailScreen
            service={demoSvc}
            serviceSlug={demoSlug}
            query="water heater replacement near me"
            tag="water-heater-replacement-quote"
            intent="Water heater replacement quote"
          />
        </div>
      </div>
      <p class="mx-auto mt-3 max-w-5xl text-center text-xs text-slate-400">Scroll to explore the full record ↕</p>
    </div>
  </section>

  <ComplianceBand />

  <!-- Demo CTA band -->
  <section class="bg-[color:var(--color-brand-soft)]">
    <div class="container-content py-16">
      <div class="mx-auto flex max-w-3xl flex-col items-center gap-6 text-center">
        <h2 class="display-2 text-[color:var(--color-ink)]">See it work on yourself.</h2>
        <p class="text-[17px] leading-relaxed text-[color:var(--color-ink-2)]">
          Register, browse a sample site, accept the banner — and watch the new-lead notification land in your inbox. The lead is you. About 60 seconds, no card required.
        </p>
        <Button href="/demo/" variant="primary" size="lg">
          <IconEye size={18} stroke={2} />
          Try the live demo
        </Button>
      </div>
    </div>
  </section>

  <!-- Common questions -->
  <FAQ
    headline="What contractors ask before they start."
    items={faqItems}
  />

  <FinalCTA />
</BaseLayout>

<script>
  // Hero video: autoplays muted + looping (set in markup). "Tap for sound" is a user
  // gesture, so we can restart from the beginning with audio + native controls and stop
  // looping. When that sound pass ends, re-arm the muted loop preview + the sound button.
  (function () {
    const wrap = document.querySelector<HTMLElement>("[data-hero-video]");
    if (!wrap) return;
    const vid = wrap.querySelector<HTMLVideoElement>("[data-tyler]");
    const btn = wrap.querySelector<HTMLButtonElement>("[data-unmute]");
    if (!vid || !btn) return;
    // Closed captions: force the track visible so they show during the muted autoplay
    // (browsers otherwise hide captions unless the OS caption preference is on).
    const showCaptions = () => { const tt = vid.textTracks && vid.textTracks[0]; if (tt) tt.mode = "showing"; };
    showCaptions();
    vid.addEventListener("loadedmetadata", showCaptions);
    try { vid.textTracks.addEventListener("addtrack", showCaptions); } catch {}
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      vid.muted = false;
      vid.loop = false;
      vid.controls = true;
      try { vid.currentTime = 0; } catch {}
      const p = vid.play(); if (p && p.catch) p.catch(() => {});
      btn.style.display = "none";
    });
    vid.addEventListener("ended", () => {
      if (vid.loop) return; // still in muted-loop mode
      vid.muted = true;
      vid.loop = true;
      vid.controls = false;
      try { vid.currentTime = 0; } catch {}
      const p = vid.play(); if (p && p.catch) p.catch(() => {});
      btn.style.display = "";
    });
  })();

  // "Next step" nudge: pops in ~2.6s after load and plays a soft pop. Browser autoplay
  // policy blocks audio until a user gesture, so we unlock the AudioContext on first
  // interaction and play the pop then if the nudge already appeared silently.
  (function () {
    const nudge = document.getElementById("tradeNudge");
    if (!nudge) return;
    let actx: any = null, shown = false, popped = false;
    function pop() {
      if (!actx || actx.state !== "running") return;
      const t = actx.currentTime;
      // low "thud" — punchy sine that drops in pitch
      const o1 = actx.createOscillator(), g1 = actx.createGain();
      o1.type = "sine";
      o1.frequency.setValueAtTime(190, t);
      o1.frequency.exponentialRampToValueAtTime(58, t + 0.18);
      g1.gain.setValueAtTime(0.0001, t);
      g1.gain.exponentialRampToValueAtTime(0.34, t + 0.02);
      g1.gain.exponentialRampToValueAtTime(0.0001, t + 0.26);
      o1.connect(g1); g1.connect(actx.destination); o1.start(t); o1.stop(t + 0.28);
      // quick "whoosh" — descending sweep layered on top
      const o2 = actx.createOscillator(), g2 = actx.createGain();
      o2.type = "sawtooth";
      o2.frequency.setValueAtTime(1500, t);
      o2.frequency.exponentialRampToValueAtTime(280, t + 0.16);
      g2.gain.setValueAtTime(0.0001, t);
      g2.gain.exponentialRampToValueAtTime(0.09, t + 0.02);
      g2.gain.exponentialRampToValueAtTime(0.0001, t + 0.18);
      o2.connect(g2); g2.connect(actx.destination); o2.start(t); o2.stop(t + 0.2);
      popped = true;
    }
    function unlock() {
      if (!actx) { try { actx = new (window.AudioContext || (window as any).webkitAudioContext)(); } catch {} }
      if (actx && actx.state === "suspended") actx.resume();
      if (shown && !popped) pop();
    }
    ["pointerdown", "keydown", "touchstart", "scroll"].forEach((ev) =>
      window.addEventListener(ev, unlock, { passive: true }));
    setTimeout(() => { nudge.classList.add("show"); shown = true; pop(); }, 2600);
  })();
</script>

<style>
  /* Big flashing arrow that "slams in" over the trade selector, then keeps flashing. */
  .cr-slam { opacity: 0; transform: translateY(-44px) scale(0.7); }
  .cr-slam.show {
    animation: crSlam 0.55s cubic-bezier(0.15, 1.45, 0.4, 1) forwards,
               crFlash 1.1s ease-in-out 0.55s infinite;
  }
  @keyframes crSlam {
    0% { opacity: 0; transform: translateY(-44px) scale(0.7); }
    60% { opacity: 1; transform: translateY(7px) scale(1.14); }
    80% { transform: translateY(-3px) scale(0.97); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes crFlash {
    0%, 100% { box-shadow: 0 16px 40px -10px rgba(0, 229, 160, 0.7); }
    50% { box-shadow: 0 18px 54px -6px rgba(0, 229, 160, 1); filter: brightness(1.14); }
  }
  .cr-nudge-arrow { animation: crBob 0.9s ease-in-out infinite; }
  @keyframes crBob { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(5px); } }
  @media (prefers-reduced-motion: reduce) {
    .cr-slam, .cr-slam.show { opacity: 1; transform: none; animation: none; }
    .cr-nudge-arrow { animation: none; }
  }
</style>
