---
import StyleGuideLayout from "~/layouts/StyleGuideLayout.astro";
import RiskVsConsent from "~/components/sections/RiskVsConsent.astro";
---

<StyleGuideLayout
  slug="risk-vs-consent"
  title="Risk vs Consent"
  description="Two-column comparison section: scrape-and-spray tracking on the left (red icon, what's wrong) vs Consent Resolve's consent-first model on the right (mint icon, what's right). The moat section — proves we're not the shady kind of identity tool."
>
  <section class="sg-section">
    <h2>Default</h2>
    <div class="sg-preview" style="padding:0">
      <RiskVsConsent />
    </div>
  </section>

  <section class="sg-section">
    <h2>Usage</h2>
    <p class="sg-lede">No props — content is hard-coded so the moat framing stays identical across the site. Used on / and /how-it-works/.</p>
    <div class="sg-preview">
      <pre class="overflow-x-auto rounded-lg bg-[color:var(--color-navy-900)] p-4 text-[12.5px] leading-relaxed text-slate-200"><code>{`---
import RiskVsConsent from "~/components/sections/RiskVsConsent.astro";
---

<RiskVsConsent />`}</code></pre>
    </div>
  </section>
</StyleGuideLayout>
