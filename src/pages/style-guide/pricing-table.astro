---
import StyleGuideLayout from "~/layouts/StyleGuideLayout.astro";
import PricingTable from "~/components/ui/PricingTable.astro";

// Real Consent Resolve pricing is a single $7/lead plan. This page
// shows the PricingTable primitive at three densities so the component
// stays drop-in ready for any future plan structure. Examples are
// labelled HYPOTHETICAL where they don't match production.

const singleTier = [
  {
    name: "Consent Resolve",
    price: "$7",
    period: "per lead",
    blurb: "Flat per-lead pricing. Exclusive, never resold.",
    features: [
      { label: "Real name, mobile, and email", included: true },
      { label: "Slack, SMS, & email alerts", included: true },
      { label: "Termageddon-backed privacy policy", included: true },
      { label: "CRM sync (Jobber, HCP, ServiceTitan)", included: true },
      { label: "Return-visit alerts", included: true },
      { label: "Cancel anytime", included: true },
    ],
    cta: { label: "Get Started", href: "https://dashboard.consentresolve.com/register" },
    featured: true,
    badge: "Live pricing",
  },
];

const featureMatrix = [
  {
    name: "Pay-per-lead",
    price: "$7",
    period: "per lead",
    blurb: "What you pay today.",
    features: [
      { label: "Exclusive leads, never resold", included: true },
      { label: "Real name + mobile + email", included: true },
      { label: "Push alert to your phone", included: true },
      { label: "CRM sync included", included: true },
      { label: "Cancel anytime", included: true },
    ],
    cta: { label: "Get Started", href: "https://dashboard.consentresolve.com/register" },
    featured: true,
    badge: "Live",
  },
  {
    name: "Shared-lead reseller",
    price: "~$46",
    period: "per lead",
    blurb: "What the other guys charge.",
    features: [
      { label: "Sold to 4–5 other contractors", included: false },
      { label: "Billed even for 'no thanks' replies", included: false },
      { label: "Dispute denial up to 50%", included: false },
      { label: "Auto-renew contracts", included: false },
      { label: "Cancel anytime", included: false },
    ],
    cta: { label: "Compare in detail", href: "/resources/compare/thumbtack/" },
  },
];
---

<StyleGuideLayout slug="pricing-table" title="Pricing Table" description="Tiered pricing card primitive. Production uses a single $7/lead plan; the component supports 1, 2, or 3 columns for future flexibility.">
  <section class="sg-section">
    <h2>Live pricing (one tier — $7/lead)</h2>
    <p class="sg-lede">What's actually on <code class="font-mono text-sm text-[color:var(--color-brand-pressed)]">/pricing/</code> in production. Single-tier renders centered.</p>
    <div class="sg-preview">
      <PricingTable tiers={singleTier} />
    </div>
  </section>

  <section class="sg-section">
    <h2>Side-by-side comparison (us vs. shared-lead reseller)</h2>
    <p class="sg-lede">Two-tier layout used implicitly by the /resources/compare/ page tables. Shows the primitive can carry a head-to-head price comparison.</p>
    <div class="sg-preview">
      <PricingTable tiers={featureMatrix} />
    </div>
  </section>
</StyleGuideLayout>
