---
import StyleGuideLayout from "~/layouts/StyleGuideLayout.astro";
import Blockquote from "~/components/ui/Blockquote.astro";
---

<StyleGuideLayout slug="blockquote" title="Blockquote" description="Pull quotes for editorial copy and testimonials inline with body content.">
  <section class="sg-section">
    <h2>Default (left rule)</h2>
    <div class="sg-preview">
      <Blockquote cite="Carlos M." source="Plumbing contractor · Phoenix, AZ">
        We turned off Thumbtack within 90 days. Same monthly spend, three times the booked jobs.
      </Blockquote>
    </div>
  </section>

  <section class="sg-section">
    <h2>Bordered</h2>
    <div class="sg-preview">
      <Blockquote variant="bordered" cite="Tina R." source="Roofing GC · Tampa, FL">
        First contractor on the phone wins. Consent Resolve gets us on the phone in two minutes.
      </Blockquote>
    </div>
  </section>

  <section class="sg-section">
    <h2>Card (dark)</h2>
    <div class="sg-preview" style="background:transparent;box-shadow:none;padding:0">
      <Blockquote variant="card" cite="Devon P." source="HVAC owner · Austin, TX">
        Best $10 I ever spent. Three weeks in we had to upgrade because we couldn't keep up with the call volume.
      </Blockquote>
    </div>
  </section>
</StyleGuideLayout>
