---
import StyleGuideLayout from "~/layouts/StyleGuideLayout.astro";
import Blockquote from "~/components/ui/Blockquote.astro";
---

<StyleGuideLayout slug="blockquote" title="Blockquote" description="Pull quotes for editorial copy inline with body content.">
  <section class="sg-section">
    <h2>Default (left rule)</h2>
    <div class="sg-preview">
      <Blockquote cite="Consent Resolve" source="Positioning">
        Keep running the ads and channels that work. We don't replace your traffic — we reveal the homeowners those channels send to your site who'd otherwise leave without a name.
      </Blockquote>
    </div>
  </section>

  <section class="sg-section">
    <h2>Bordered</h2>
    <div class="sg-preview">
      <Blockquote variant="bordered" cite="Consent Resolve" source="How it works">
        Identification happens only after explicit consent — a real name and a consented email, yours alone, never resold.
      </Blockquote>
    </div>
  </section>

  <section class="sg-section">
    <h2>Card (dark)</h2>
    <div class="sg-preview" style="background:transparent;box-shadow:none;padding:0">
      <Blockquote variant="card" cite="Consent Resolve" source="Pricing">
        Flat $7 per recovered lead. No contract, no shared leads, pay-as-you-go.
      </Blockquote>
    </div>
  </section>
</StyleGuideLayout>
