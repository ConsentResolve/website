---
import StyleGuideLayout from "~/layouts/StyleGuideLayout.astro";
import ProductTour from "~/components/sections/ProductTour.astro";
---

<StyleGuideLayout
  slug="product-tour"
  title="Product Tour"
  description="Multi-step walkthrough of the dashboard. Steps left, screen-mock right; clicking a step swaps the mock. Used on /how-it-works/ to give a tangible sense of what the product actually looks like in use."
>
  <section class="sg-section">
    <h2>Default</h2>
    <div class="sg-preview" style="padding:0">
      <ProductTour />
    </div>
  </section>

  <section class="sg-section">
    <h2>Usage</h2>
    <p class="sg-lede">No props — composes <a href="/style-guide/product-demo/" class="text-[color:var(--color-brand-pressed)] underline-offset-2 hover:underline">Product Demo Screens</a> for each step.</p>
    <div class="sg-preview">
      <pre class="overflow-x-auto rounded-lg bg-[color:var(--color-navy-900)] p-4 text-[12.5px] leading-relaxed text-slate-200"><code>{`---
import ProductTour from "~/components/sections/ProductTour.astro";
---

<ProductTour />`}</code></pre>
    </div>
  </section>
</StyleGuideLayout>
