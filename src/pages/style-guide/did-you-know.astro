---
import StyleGuideLayout from "~/layouts/StyleGuideLayout.astro";
import DidYouKnow from "~/components/sections/DidYouKnow.tsx";
---

<StyleGuideLayout
  slug="did-you-know"
  title="Did You Know"
  description="Animated fact carousel used on /about/. Rotates through interesting numbers / receipts to make the team's bona fides feel alive instead of static. React island."
>
  <section class="sg-section">
    <h2>Default</h2>
    <p class="sg-lede">React island — hydrate with <code class="font-mono text-sm text-[color:var(--color-brand-pressed)]">client:visible</code>.</p>
    <div class="sg-preview" style="padding:0">
      <DidYouKnow client:visible />
    </div>
  </section>

  <section class="sg-section">
    <h2>Usage</h2>
    <div class="sg-preview">
      <pre class="overflow-x-auto rounded-lg bg-[color:var(--color-navy-900)] p-4 text-[12.5px] leading-relaxed text-slate-200"><code>{`---
import DidYouKnow from "~/components/sections/DidYouKnow.tsx";
---

<DidYouKnow client:visible />`}</code></pre>
    </div>
  </section>
</StyleGuideLayout>
