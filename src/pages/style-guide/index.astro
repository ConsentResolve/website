---
import StyleGuideLayout from "~/layouts/StyleGuideLayout.astro";
import { STYLE_GUIDE } from "~/lib/styleGuide";
import { IconArrowRight } from "@tabler/icons-react";
---

<StyleGuideLayout
  title="Style Guide"
  description="A live preview of every reusable UI component used across consentresolve.com. Pick a category from the sidebar to see all variants in context."
>
  <section class="sg-section">
    <h2>Library</h2>
    <p class="sg-lede">{STYLE_GUIDE.length} component categories. Each one is built from primitives in <code class="font-mono text-sm text-[color:var(--color-brand-pressed)]">src/components/ui/</code> and is drop-in ready for any marketing page.</p>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {STYLE_GUIDE.map((e) => (
        <a
          href={`/style-guide/${e.slug}/`}
          class="group block rounded-2xl bg-[color:var(--color-bg-alt)] p-6 ring-1 ring-inset ring-[color:var(--color-rule)] transition-all hover:-translate-y-0.5 hover:ring-[color:var(--color-brand)]/40 hover:shadow-[0_16px_40px_-20px_rgba(10,22,40,0.18)]"
        >
          <div class="flex items-start justify-between gap-2">
            <h3 class="font-semibold tracking-tight text-[color:var(--color-ink)]">{e.title}</h3>
            <IconArrowRight size={18} stroke={1.75} className="text-[color:var(--color-ink-muted)] transition-all group-hover:translate-x-0.5 group-hover:text-[color:var(--color-brand)]" />
          </div>
          <p class="mt-2 text-sm leading-relaxed text-[color:var(--color-ink-2)]">{e.description}</p>
        </a>
      ))}
    </div>
  </section>
</StyleGuideLayout>
