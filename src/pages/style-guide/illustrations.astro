---
import StyleGuideLayout from "~/layouts/StyleGuideLayout.astro";

interface IllustrationEntry {
  n: string;
  slug: string;
  caption: string;
  feature: string;
  subject: string;
}

const illustrations: IllustrationEntry[] = [
  { n: "01", slug: "contact-card",    feature: "Real names, real numbers",     caption: "Contact card + phone",          subject: "a contact card showing a person icon above a phone handset" },
  { n: "02", slug: "map-pin",         feature: "Mapped to your zip",           caption: "Pin on grid",                   subject: "a single map pin dropping onto a small neighborhood grid" },
  { n: "03", slug: "speech-wrench",   feature: "Why they're shopping",         caption: "Speech bubble + wrench",        subject: "a speech bubble containing a wrench" },
  { n: "04", slug: "phone-alert",     feature: "On your phone in five",        caption: "Phone + motion + arrow",        subject: "a phone handset with three short motion lines and a small upward arrow" },
  { n: "05", slug: "crm-inbox",       feature: "Lands in your CRM",            caption: "Card → inbox tray",             subject: "a card sliding on an arrow into an open labeled inbox tray" },
  { n: "06", slug: "bell-return",     feature: "Return-visit alerts",          caption: "Bell + return loop",            subject: "a notification bell with a small circular return-arrow loop around it" },
  { n: "07", slug: "lead-house-lock", feature: "Yours alone, never resold",    caption: "Card → padlock → house",        subject: "one lead card linked by a single line to ONE house, sealed with a small padlock" },
  { n: "08", slug: "shield-doc",      feature: "Audit-ready by default",       caption: "Shield + document + seal",      subject: "a rounded shield bearing a checkmark, overlapping a document with a wax-style seal in the corner" },
  { n: "09", slug: "code-clock",      feature: "Set up in ten minutes",        caption: "</> bracket + clock",           subject: "a code-tag </> bracket shape next to a small clock" },
];

const styleLock = `Minimalist hand-drawn vector illustration of a single subject, centered with
generous negative space, on a fully transparent background (NOT black, NOT a
colored fill). Hand-inked marker style: thick, slightly rough, organic outlines
of even medium-heavy weight in near-black forest green (#14271C), with the
occasional doubled "ghost" outline stroke for a sketched feel. Flat color fills
from a tight palette only — primary sage green (#5FB98C), pale mint/celadon
(#BCE3CB), deep forest green (#1B3A2A), and pure white reserved for inner
highlights and small curved "shine" strokes. Each major shape casts ONE flat,
hard-edged offset drop shadow (no blur, no gradient) in a darker green, offset
slightly down and to the right. Rounded, friendly, organic forms with soft
corners. Completely flat shading: no gradients, no directional lighting, no
texture, no 3D. Straight-on 2D perspective. Square 1:1 composition. Friendly,
trustworthy, approachable tone.

Negative: no black or colored background, no photorealism, no gradients, no
ambient occlusion, no neon, no colors outside the green palette plus white,
no lettering or numbers, no eyes / surveillance-camera / spying imagery.`;

const palette = [
  { hex: "#14271C", role: "Outline (near-black forest)" },
  { hex: "#5FB98C", role: "Primary sage" },
  { hex: "#BCE3CB", role: "Pale mint / celadon" },
  { hex: "#1B3A2A", role: "Deep forest (shadows)" },
  { hex: "#FFFFFF", role: "Shine highlights" },
];
---

<StyleGuideLayout
  slug="illustrations"
  title="Illustrations"
  description="The locked illustration system for consentresolve.com. Hand-drawn marker style in a tight sage-green palette, one subject per icon, flat hard-edged drop shadow. The 9 below map directly to the 9 feature cards on the homepage. Placeholders ship in /public/illustrations/style/; regenerate via the OpenAI script when you want production-grade output."
>
  <!-- 3x3 grid -->
  <section class="sg-section">
    <h2>The 9 — 3 per row</h2>
    <p class="sg-lede">Each illustration is locked to the same style; only the subject changes. Click any tile to open the full image.</p>
    <div class="sg-preview">
      <div class="ilg-grid">
        {illustrations.map((ill) => (
          <figure class="ilg-tile">
            <a href={`/illustrations/style/${ill.n}-${ill.slug}.png`} target="_blank" rel="noopener" class="ilg-img-wrap">
              <img
                src={`/illustrations/style/${ill.n}-${ill.slug}.png`}
                alt={`${ill.feature} — ${ill.caption}`}
                loading="lazy"
                decoding="async"
              />
            </a>
            <figcaption class="ilg-meta">
              <span class="ilg-n">{ill.n}</span>
              <div>
                <div class="ilg-feature">{ill.feature}</div>
                <div class="ilg-caption">{ill.caption}</div>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Palette -->
  <section class="sg-section">
    <h2>Locked palette</h2>
    <p class="sg-lede">Five values. Never introduce a sixth. If you ever add a warm accent for a money/results illustration, document it here first.</p>
    <div class="sg-preview">
      <div class="ilg-palette">
        {palette.map((p) => (
          <div class="ilg-swatch">
            <span class="ilg-chip" style={`background:${p.hex}`}></span>
            <code>{p.hex}</code>
            <span class="ilg-role">{p.role}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Style Lock -->
  <section class="sg-section">
    <h2>Block A — Style lock (paste verbatim)</h2>
    <p class="sg-lede">Send this with every image generation. Never edit it. Variations come only from Block B.</p>
    <pre class="ilg-code"><code>{styleLock}</code></pre>
  </section>

  <!-- Subject library -->
  <section class="sg-section">
    <h2>Block B — Subject library</h2>
    <p class="sg-lede">Append exactly one line to Block A. One concrete object, one simple action.</p>
    <div class="sg-preview">
      <ol class="ilg-subjects">
        {illustrations.map((ill) => (
          <li>
            <div class="ilg-subject-head">
              <span class="ilg-n">{ill.n}</span>
              <span class="ilg-feature">{ill.feature}</span>
            </div>
            <code class="ilg-subject-prompt">Subject: {ill.subject}, arranged center-frame.</code>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- OpenAI generation -->
  <section class="sg-section">
    <h2>Regenerate via OpenAI</h2>
    <p class="sg-lede">Two scripts ship — pick whichever you have a runtime for. Both call <code>gpt-image-1</code> with the locked Block A prompt and write transparent PNGs to <code>/public/illustrations/style/</code>.</p>
    <div class="sg-preview">
      <pre class="ilg-code"><code>{`# Python (no install needed — uses stdlib)
#   put your key at ~/.config/openai/key (chmod 600)
python3 scripts/generate-illustrations.py             # all 9
python3 scripts/generate-illustrations.py --only=03,07
python3 scripts/generate-illustrations.py --dry-run   # show prompts only

# Node (needs Node 22+)
export OPENAI_API_KEY=sk-...
node scripts/generate-illustrations.mjs               # all 9
node scripts/generate-illustrations.mjs --only=03,07`}</code></pre>
    </div>
  </section>

  <!-- Strategic notes -->
  <section class="sg-section">
    <h2>Rules of the road</h2>
    <div class="sg-preview">
      <ul class="ilg-rules">
        <li><strong>No surveillance imagery.</strong> No eyes, no magnifying glass aimed at a person, no spy-camera glyphs. Our value prop is consent-first; watching imagery contradicts it.</li>
        <li><strong>One idea per icon.</strong> Don't cram. The page already has charts and tables — illustrations are anchors, not data.</li>
        <li><strong>Green only.</strong> Don't introduce orange/yellow accents without documenting here first.</li>
        <li><strong>Hold the style, vary the subject.</strong> If you regenerate one, re-run Block A untouched. The set stops reading as a set the moment line weight drifts.</li>
        <li><strong>Decorative <code>aria-hidden="true"</code>; meaningful → real <code>alt</code>.</strong></li>
      </ul>
    </div>
  </section>
</StyleGuideLayout>

<style>
  .ilg-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 720px) {
    .ilg-grid { grid-template-columns: 1fr; }
  }
  .ilg-tile {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .ilg-img-wrap {
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: 1rem;
    background:
      linear-gradient(135deg, #f7fbf8 0%, #ecf6f0 100%);
    box-shadow: 0 1px 0 rgba(10,22,40,0.04), 0 0 0 1px rgba(20,39,28,0.08);
    overflow: hidden;
    position: relative;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .ilg-img-wrap:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 36px -18px rgba(20,39,28,0.25), 0 0 0 1px rgba(95,185,140,0.4);
  }
  .ilg-img-wrap img {
    position: absolute;
    inset: 10%;
    width: 80%;
    height: 80%;
    object-fit: contain;
  }
  .ilg-meta {
    display: flex;
    gap: 0.625rem;
    align-items: flex-start;
  }
  .ilg-n {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 800;
    color: #5FB98C;
    background: rgba(95,185,140,0.12);
    padding: 2px 6px;
    border-radius: 4px;
    flex-shrink: 0;
  }
  .ilg-feature {
    font-weight: 700;
    color: var(--color-ink);
    font-size: 0.875rem;
    line-height: 1.2;
  }
  .ilg-caption {
    color: var(--color-ink-muted);
    font-size: 0.75rem;
    margin-top: 1px;
  }

  /* Palette */
  .ilg-palette {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
  }
  .ilg-swatch {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem;
    border-radius: 0.5rem;
    background: var(--color-bg);
  }
  .ilg-chip {
    width: 36px; height: 36px;
    border-radius: 8px;
    box-shadow: inset 0 0 0 1px rgba(20,39,28,0.15);
    flex-shrink: 0;
  }
  .ilg-swatch code {
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-ink);
  }
  .ilg-role {
    color: var(--color-ink-muted);
    font-size: 0.75rem;
  }

  /* Code block */
  .ilg-code {
    background: #0a1628;
    color: #cbd5e1;
    padding: 1rem 1.25rem;
    border-radius: 0.625rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.78rem;
    line-height: 1.6;
    overflow-x: auto;
    white-space: pre-wrap;
  }
  .ilg-code code { font-family: inherit; }

  /* Subject library */
  .ilg-subjects {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .ilg-subjects li {
    border-top: 1px solid var(--color-rule);
    padding-top: 0.625rem;
  }
  .ilg-subjects li:first-child { border-top: 0; padding-top: 0; }
  .ilg-subject-head {
    display: flex; align-items: center; gap: 0.5rem;
    margin-bottom: 0.375rem;
  }
  .ilg-subject-prompt {
    display: block;
    font-family: var(--font-mono, monospace);
    font-size: 0.78rem;
    color: var(--color-ink-2);
    background: var(--color-bg);
    padding: 0.625rem 0.75rem;
    border-radius: 0.5rem;
    line-height: 1.55;
  }

  /* Rules */
  .ilg-rules {
    margin: 0; padding: 0; list-style: none;
    display: flex; flex-direction: column; gap: 0.625rem;
  }
  .ilg-rules li {
    color: var(--color-ink-2);
    font-size: 0.9rem;
    line-height: 1.6;
    padding-left: 1.25rem;
    position: relative;
  }
  .ilg-rules li::before {
    content: "";
    position: absolute;
    left: 0; top: 0.55em;
    width: 6px; height: 6px;
    border-radius: 9999px;
    background: #5FB98C;
  }
</style>
