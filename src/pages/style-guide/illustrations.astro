---
import StyleGuideLayout from "~/layouts/StyleGuideLayout.astro";

interface IllustrationEntry {
  n: string;
  slug: string;
  caption: string;
  feature: string;
  subject: string;
}

const illustrations: IllustrationEntry[] = [
  { n: "01", slug: "contact-card",    feature: "Real names, real emails",      caption: "Contact card",                  subject: "a contact card showing a person icon above a phone handset" },
  { n: "02", slug: "map-pin",         feature: "Mapped to your zip",           caption: "Pin on grid",                   subject: "a single map pin dropping onto a small neighborhood grid" },
  { n: "03", slug: "speech-wrench",   feature: "Why they're shopping",         caption: "Speech bubble + wrench",        subject: "a speech bubble containing a wrench" },
  { n: "04", slug: "phone-alert",     feature: "On your phone in five",        caption: "Phone + motion + arrow",        subject: "a phone handset with three short motion lines and a small upward arrow" },
  { n: "05", slug: "crm-inbox",       feature: "Lands in your CRM",            caption: "Card → inbox tray",             subject: "a card sliding on an arrow into an open labeled inbox tray" },
  { n: "06", slug: "bell-return",     feature: "Return-visit alerts",          caption: "Bell + return loop",            subject: "a notification bell with a small circular return-arrow loop around it" },
  { n: "07", slug: "lead-house-lock", feature: "Yours alone, never resold",    caption: "Card → padlock → house",        subject: "one lead card linked by a single line to ONE house, sealed with a small padlock" },
  { n: "08", slug: "shield-doc",      feature: "Audit-ready by default",       caption: "Shield + document + seal",      subject: "a rounded shield bearing a checkmark, overlapping a document with a wax-style seal in the corner" },
  { n: "09", slug: "code-clock",      feature: "Set up in ten minutes",        caption: "</> bracket + clock",           subject: "a code-tag </> bracket shape next to a small clock" },
];

const styleLock = `Minimalist hand-drawn vector illustration of a single subject, centered with
generous negative space, on a fully transparent background (NOT black, NOT a
colored fill). Hand-inked marker style: thick, slightly rough, organic outlines
of even medium-heavy weight in DEEP NAVY BLUE (#0A1628 — a very dark navy
blue, not black, not green), with the occasional doubled "ghost" outline
stroke for a sketched feel.

STRICT FOUR-COLOR PALETTE — use ONLY these four values, nothing else:

  1. OUTLINE: #0A1628 — deep navy blue (very dark cool blue, not black,
     not green-tinted)
  2. PRIMARY FILL: #00E5A0 — vibrant electric mint/cyan, a bright punchy
     aqua-green (like Spotify green but more cyan-leaning; absolutely NOT
     sage, NOT olive, NOT forest, NOT teal, NOT emerald, NOT dark green,
     NOT muted, NOT desaturated — it MUST be a vivid, saturated,
     cyan-leaning bright green that almost glows)
  3. SHADOW: #1E293B — slate navy, slightly lighter than the outline,
     a cool blue-gray; use for ONE flat, hard-edged offset drop shadow per
     major shape, offset slightly down and to the right
  4. HIGHLIGHT: #F8FAFC — almost-white, reserved for inner shine strokes
     and small curved gleam lines

The mint/cyan #00E5A0 must look ELECTRIC and SATURATED. If it could be
mistaken for sage, olive, forest, or any muted/dusty green, it is wrong.

Each major shape casts ONE flat, hard-edged offset drop shadow (no blur, no
gradient). Rounded, friendly, organic forms with soft corners. Completely
flat shading: no gradients, no directional lighting, no texture, no 3D.
Straight-on 2D perspective. Square 1:1 composition. Modern, confident,
trustworthy tone.

Negative: no black or colored background, no photorealism, no gradients,
no ambient occlusion, no neon glow effect, NO SAGE GREEN, no olive, no
forest green, no teal, no emerald, no lime, no muted greens, no dusty
greens, no warm tones, no oranges, no yellows, no purples, no reds, no
pinks, no colors outside the strict four-color palette above, no lettering
or numbers, no eyes / surveillance-camera / spying imagery.`;

const palette = [
  { hex: "#0A1628", role: "Outline (deep navy)" },
  { hex: "#00E5A0", role: "Primary brand mint/cyan" },
  { hex: "#1E293B", role: "Card navy (shadows)" },
  { hex: "#F8FAFC", role: "Foreground / shine highlights" },
];
---

<StyleGuideLayout
  slug="illustrations"
  title="Illustrations"
  description="The locked illustration system for consentresolve.com. Hand-drawn vector style in the strict brand palette (navy outline + brand mint fill + almost-white highlights). The 9 below map directly to the 9 feature cards on the homepage. Generated via Recraft using a custom Brand Style (locked palette) and post-processed with HSL-bucket recolor to snap every value to exact brand hex."
>
  <!-- 3x3 grid -->
  <section class="sg-section">
    <h2>The 9 — 3 per row</h2>
    <p class="sg-lede">Each illustration is locked to the same style; only the subject changes. Click any tile to open the full image.</p>
    <div class="sg-preview">
      <div class="ilg-grid">
        {illustrations.map((ill) => (
          <figure class="ilg-tile">
            <a href={`/illustrations/style/${ill.n}-${ill.slug}.svg`} target="_blank" rel="noopener" class="ilg-img-wrap">
              <img
                src={`/illustrations/style/${ill.n}-${ill.slug}.svg`}
                alt={`${ill.feature} — ${ill.caption}`}
                loading="lazy"
                decoding="async"
              />
            </a>
            <figcaption class="ilg-meta">
              <span class="ilg-n">{ill.n}</span>
              <div>
                <div class="ilg-feature">{ill.feature}</div>
                <div class="ilg-caption">{ill.caption}</div>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Palette -->
  <section class="sg-section">
    <h2>Locked palette</h2>
    <p class="sg-lede">Four values. Never introduce a fifth. If you ever add a warm accent for a money/results illustration, document it here first.</p>
    <div class="sg-preview">
      <div class="ilg-palette">
        {palette.map((p) => (
          <div class="ilg-swatch">
            <span class="ilg-chip" style={`background:${p.hex}`}></span>
            <code>{p.hex}</code>
            <span class="ilg-role">{p.role}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Style Lock -->
  <section class="sg-section">
    <h2>Block A — Style lock (paste verbatim)</h2>
    <p class="sg-lede">Send this with every image generation. Never edit it. Variations come only from Block B.</p>
    <pre class="ilg-code"><code>{styleLock}</code></pre>
  </section>

  <!-- Subject library -->
  <section class="sg-section">
    <h2>Block B — Subject library</h2>
    <p class="sg-lede">Append exactly one line to Block A. One concrete object, one simple action.</p>
    <div class="sg-preview">
      <ol class="ilg-subjects">
        {illustrations.map((ill) => (
          <li>
            <div class="ilg-subject-head">
              <span class="ilg-n">{ill.n}</span>
              <span class="ilg-feature">{ill.feature}</span>
            </div>
            <code class="ilg-subject-prompt">Subject: {ill.subject}, arranged center-frame.</code>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Recraft generation -->
  <section class="sg-section">
    <h2>Regenerate via Recraft</h2>
    <p class="sg-lede">Production pipeline: Recraft custom Brand Style → SVG → HSL-bucket recolor to exact brand hex. Two-step, ~20 seconds end-to-end per illustration.</p>
    <div class="sg-preview">
      <pre class="ilg-code"><code>{`# Put your Recraft key at ~/.config/recraft/key (chmod 600), then:

# 1. Generate SVGs via the locked Brand Style
python3 scripts/generate-recraft.py \\
    --style-id=214dccd1-dca3-43e6-b005-c664e1b33338     # all 9
python3 scripts/generate-recraft.py \\
    --style-id=214dccd1-dca3-43e6-b005-c664e1b33338 --only=03,07

# 2. Snap every color to exact brand hex
python3 scripts/recolor-illustrations.py               # all 9
python3 scripts/recolor-illustrations.py --only=03,07

# Legacy: OpenAI script (still works, lower color fidelity)
python3 scripts/generate-illustrations.py --only=03,07`}</code></pre>
    </div>
  </section>

  <!-- Strategic notes -->
  <section class="sg-section">
    <h2>Rules of the road</h2>
    <div class="sg-preview">
      <ul class="ilg-rules">
        <li><strong>No surveillance imagery.</strong> No eyes, no magnifying glass aimed at a person, no spy-camera glyphs. Our value prop is consent-first; watching imagery contradicts it.</li>
        <li><strong>One idea per icon.</strong> Don't cram. The page already has charts and tables — illustrations are anchors, not data.</li>
        <li><strong>Green only.</strong> Don't introduce orange/yellow accents without documenting here first.</li>
        <li><strong>Hold the style, vary the subject.</strong> If you regenerate one, re-run Block A untouched. The set stops reading as a set the moment line weight drifts.</li>
        <li><strong>Decorative <code>aria-hidden="true"</code>; meaningful → real <code>alt</code>.</strong></li>
      </ul>
    </div>
  </section>
</StyleGuideLayout>

<style>
  .ilg-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 720px) {
    .ilg-grid { grid-template-columns: 1fr; }
  }
  .ilg-tile {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .ilg-img-wrap {
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: 1rem;
    background:
      linear-gradient(135deg, #f7fbf8 0%, #ecf6f0 100%);
    box-shadow: 0 1px 0 rgba(10,22,40,0.04), 0 0 0 1px rgba(20,39,28,0.08);
    overflow: hidden;
    position: relative;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .ilg-img-wrap:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 36px -18px rgba(20,39,28,0.25), 0 0 0 1px rgba(95,185,140,0.4);
  }
  .ilg-img-wrap img {
    position: absolute;
    inset: 10%;
    width: 80%;
    height: 80%;
    object-fit: contain;
  }
  .ilg-meta {
    display: flex;
    gap: 0.625rem;
    align-items: flex-start;
  }
  .ilg-n {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 800;
    color: #5FB98C;
    background: rgba(95,185,140,0.12);
    padding: 2px 6px;
    border-radius: 4px;
    flex-shrink: 0;
  }
  .ilg-feature {
    font-weight: 700;
    color: var(--color-ink);
    font-size: 0.875rem;
    line-height: 1.2;
  }
  .ilg-caption {
    color: var(--color-ink-muted);
    font-size: 0.75rem;
    margin-top: 1px;
  }

  /* Palette */
  .ilg-palette {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
  }
  .ilg-swatch {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem;
    border-radius: 0.5rem;
    background: var(--color-bg);
  }
  .ilg-chip {
    width: 36px; height: 36px;
    border-radius: 8px;
    box-shadow: inset 0 0 0 1px rgba(20,39,28,0.15);
    flex-shrink: 0;
  }
  .ilg-swatch code {
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-ink);
  }
  .ilg-role {
    color: var(--color-ink-muted);
    font-size: 0.75rem;
  }

  /* Code block */
  .ilg-code {
    background: #0a1628;
    color: #cbd5e1;
    padding: 1rem 1.25rem;
    border-radius: 0.625rem;
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.78rem;
    line-height: 1.6;
    overflow-x: auto;
    white-space: pre-wrap;
  }
  .ilg-code code { font-family: inherit; }

  /* Subject library */
  .ilg-subjects {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .ilg-subjects li {
    border-top: 1px solid var(--color-rule);
    padding-top: 0.625rem;
  }
  .ilg-subjects li:first-child { border-top: 0; padding-top: 0; }
  .ilg-subject-head {
    display: flex; align-items: center; gap: 0.5rem;
    margin-bottom: 0.375rem;
  }
  .ilg-subject-prompt {
    display: block;
    font-family: var(--font-mono, monospace);
    font-size: 0.78rem;
    color: var(--color-ink-2);
    background: var(--color-bg);
    padding: 0.625rem 0.75rem;
    border-radius: 0.5rem;
    line-height: 1.55;
  }

  /* Rules */
  .ilg-rules {
    margin: 0; padding: 0; list-style: none;
    display: flex; flex-direction: column; gap: 0.625rem;
  }
  .ilg-rules li {
    color: var(--color-ink-2);
    font-size: 0.9rem;
    line-height: 1.6;
    padding-left: 1.25rem;
    position: relative;
  }
  .ilg-rules li::before {
    content: "";
    position: absolute;
    left: 0; top: 0.55em;
    width: 6px; height: 6px;
    border-radius: 9999px;
    background: #5FB98C;
  }
</style>
