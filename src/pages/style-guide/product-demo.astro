---
import StyleGuideLayout from "~/layouts/StyleGuideLayout.astro";
import DashboardScreen from "~/components/ui/demo/DashboardScreen.astro";
import VisitorsScreen from "~/components/ui/demo/VisitorsScreen.astro";
import VisitorDetailScreen from "~/components/ui/demo/VisitorDetailScreen.astro";
import IntegrationsScreen from "~/components/ui/demo/IntegrationsScreen.astro";
import ConsentScreen from "~/components/ui/demo/ConsentScreen.astro";
import BillingScreen from "~/components/ui/demo/BillingScreen.astro";
import CrmPushScreen from "~/components/ui/demo/CrmPushScreen.astro";
---

<StyleGuideLayout
  slug="product-demo"
  title="Product Demo Screens"
  description="Pure HTML/CSS/JS replicas of the Consent Resolve dashboard for use in landing-page hero shots, comparison pages, and marketing collateral. All data anonymized — no real names, emails, or keys. Numbers animate in on scroll."
>
  <section class="sg-section">
    <h2>Dashboard</h2>
    <p class="sg-lede">Live metrics, time-range selector, animated trend chart (line draws on entry), and a real-time visitor feed that staggers in.</p>
    <div class="sg-preview demo-frame" id="shot-dashboard">
      <DashboardScreen />
    </div>
  </section>

  <section class="sg-section">
    <h2>Visitors list</h2>
    <p class="sg-lede">Searchable, filterable visitor intelligence with device, timezone, visit/view counts, and pagination. Identifiers are obfuscated patterns like <code>k7****l@example.com</code>.</p>
    <div class="sg-preview demo-frame" id="shot-visitors">
      <VisitorsScreen />
    </div>
  </section>

  <section class="sg-section">
    <h2>Single visitor detail</h2>
    <p class="sg-lede">Drill-down view from the visitors list. Hero with action buttons (Push to funnel, Email sequence, Add to retargeting), animated lead-score and engagement counters, contact + enrichment cards, a signed, timestamped consent record with audit ID, and an activity timeline that draws its connecting line and staggers events in on mount.</p>
    <div class="sg-preview demo-frame" id="shot-detail">
      <VisitorDetailScreen />
    </div>
  </section>

  <section class="sg-section">
    <h2>Integrations</h2>
    <p class="sg-lede">CRM &amp; marketing-automation connectors with status pills, configure links, and a request-integration CTA.</p>
    <div class="sg-preview demo-frame" id="shot-integrations">
      <IntegrationsScreen />
    </div>
  </section>

  <section class="sg-section">
    <h2>Consent / Installation</h2>
    <p class="sg-lede">Installation snippet, copy button, Termageddon configuration with a fake but valid-looking Settings ID.</p>
    <div class="sg-preview demo-frame" id="shot-consent">
      <ConsentScreen />
    </div>
  </section>

  <section class="sg-section">
    <h2>Billing</h2>
    <p class="sg-lede">Current-month usage-based summary, daily lead-volume chart, payment method on file, recent invoices. No contract language anywhere — pay per consented lead.</p>
    <div class="sg-preview demo-frame" id="shot-billing">
      <BillingScreen />
    </div>
  </section>

  <section class="sg-section">
    <h2>Lead delivered → CRM</h2>
    <p class="sg-lede">The handoff moment: a resolved, consented visitor pushed automatically into the CRM, tagged and ready to work.</p>
    <div class="sg-preview demo-frame" id="shot-crmpush">
      <CrmPushScreen />
    </div>
  </section>

  <section class="sg-section">
    <h2>Where to use these</h2>
    <p class="sg-lede">Embed in landing pages, blog posts, comparison pages, and email screenshots. Add a <code>scale-75</code> or <code>scale-50</code> wrapper for thumbnail use cases.</p>
  </section>
</StyleGuideLayout>

<style>
  .demo-frame {
    padding: 0;
    overflow: hidden;
    background: transparent;
    box-shadow: 0 0 0 1px rgba(10,22,40,0.06), 0 30px 60px -30px rgba(10,22,40,0.25);
  }
</style>
