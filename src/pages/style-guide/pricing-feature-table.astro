---
import StyleGuideLayout from "~/layouts/StyleGuideLayout.astro";
import PricingFeatureTable from "~/components/ui/PricingFeatureTable.astro";
import { IconUserCheck, IconClipboardCheck, IconMapPin, IconLock, IconBellRinging, IconRefresh, IconBolt, IconPlugConnected } from "@tabler/icons-react";

const groups = [
  {
    label: "Lead quality",
    features: [
      { Icon: IconUserCheck,      title: "Verified homeowner name + mobile",  desc: "First name, last name, mobile phone. Not a household label." },
      { Icon: IconClipboardCheck, title: "Captured service intent",            desc: "What they were shopping for — water heater quote, roof inspection." },
      { Icon: IconMapPin,         title: "Service-area pin",                   desc: "Every lead drops on your map. Filter by zip or route." },
      { Icon: IconLock,           title: "Exclusive — never resold",           desc: "One consent, one contractor. Not auctioned, not flipped." },
    ],
  },
  {
    label: "Speed",
    features: [
      { Icon: IconBellRinging, title: "Real-time push to your phone",          desc: "Slack, SMS, or email. The lead lands in seconds." },
      { Icon: IconRefresh,     title: "Return-visit alerts",                   desc: "When a known homeowner comes back, you know." },
      { Icon: IconBolt,        title: "10-minute setup",                       desc: "Paste one line of code. Any site builder." },
    ],
  },
  {
    label: "CRM & dispatch",
    features: [
      { Icon: IconPlugConnected, title: "Native CRM integrations", desc: "Jobber, Housecall Pro, ServiceTitan, HubSpot, Klaviyo." },
    ],
  },
];
---

<StyleGuideLayout
  slug="pricing-feature-table"
  title="Pricing Feature Table"
  description="Grouped 'everything included' feature table for /pricing/. Group label rows + alternating feature rows with an icon-tile, title, and description; right column is a Check. Designed for the 'one flat price, one toolbox' framing."
>
  <section class="sg-section">
    <h2>Default</h2>
    <div class="sg-preview">
      <PricingFeatureTable groups={groups} />
    </div>
  </section>

  <section class="sg-section">
    <h2>Custom column headers</h2>
    <p class="sg-lede">Override left + right column headers when the meaning isn't "Feature / Included."</p>
    <div class="sg-preview">
      <PricingFeatureTable
        groups={[groups[0]]}
        leftHeader="What you get"
        rightHeader="On every plan"
      />
    </div>
  </section>

  <section class="sg-section">
    <h2>Usage</h2>
    <div class="sg-preview">
      <pre class="overflow-x-auto rounded-lg bg-[color:var(--color-navy-900)] p-4 text-[12.5px] leading-relaxed text-slate-200"><code>{`---
import PricingFeatureTable from "~/components/ui/PricingFeatureTable.astro";
import { IconUserCheck, IconLock } from "@tabler/icons-react";

const groups = [
  {
    label: "Lead quality",
    features: [
      { Icon: IconUserCheck, title: "Verified name + mobile", desc: "…" },
      { Icon: IconLock,      title: "Exclusive — never resold", desc: "…" },
    ],
  },
];
---

<PricingFeatureTable groups={groups} />`}</code></pre>
    </div>
  </section>
</StyleGuideLayout>
