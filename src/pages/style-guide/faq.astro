---
import StyleGuideLayout from "~/layouts/StyleGuideLayout.astro";
import Badge from "~/components/ui/Badge.astro";
import FAQ from "~/components/sections/FAQ.astro";
import FAQPreview from "~/components/sections/FAQPreview.astro";

const standardItems = [
  { question: "Is this legal?", answer: "Yes — because a homeowner's name shows up only after they consent. We keep your privacy policy, cookie banner, and disclosures in sync through Termageddon. The shady tools that track people in secret are the illegal ones. We're not one." },
  { question: "What if a homeowner doesn't consent?", answer: "Then you get nothing on them — and that's the point. No consent, no data. That's what keeps you safe." },
  { question: "How fast does a lead reach me?", answer: "Seconds. A Slack, text, or email fires the moment they consent, and it lands in your CRM at the same time." },
  { question: "Can I cancel anytime?", answer: "Yes. Flat $7 a lead — card required, no contract, cancel whenever you want." },
];

const tradeItems = [
  { question: "How do plumbers get exclusive leads?", answer: "You identify homeowners already pricing a job on your site. When they consent, you get their name and number — yours alone, never shared." },
  { question: "Will I know what they're calling about?", answer: "Yes. You see what they were shopping for, so you walk into the call already knowing it's a water-heater quote or a re-pipe." },
  { question: "How much does it cost?", answer: "Flat $7 per exclusive plumber lead. Card required, cancel anytime." },
];
---

<StyleGuideLayout
  slug="faq"
  title="FAQ Section"
  description="The site-wide FAQ block. The 3-step canonical version is in production; a larger preview variant with per-row borders is staged below for review."
>
  <section class="sg-section">
    <div class="flex items-center gap-3 flex-wrap">
      <h2 class="!mb-0">Large preview</h2>
      <Badge tone="warning" variant="soft" size="sm" uppercase>Review only — not deployed</Badge>
    </div>
    <p class="sg-lede">Roughly 1.75× the canonical type and padding. Each Q&amp;A row is its own rounded bordered card on a soft inner panel, container grows to <code class="font-mono text-sm text-[color:var(--color-brand-pressed)]">max-w-4xl</code>. Question text bumps to <code class="font-mono text-sm text-[color:var(--color-brand-pressed)]">display-font 22px bold</code>, answer to <code class="font-mono text-sm text-[color:var(--color-brand-pressed)]">17px / 1.6</code>, chevron lives in a 40px chip that mint-shifts on open. <strong class="text-[color:var(--color-ink)]">Sitewide swap is gated on review.</strong></p>
    <div class="sg-preview" style="padding:0;background:transparent;box-shadow:none;overflow:hidden;border-radius:1rem">
      <FAQPreview headline="What pros ask before they start." items={standardItems} />
    </div>
  </section>

  <section class="sg-section">
    <div class="flex items-center gap-3 flex-wrap">
      <h2 class="!mb-0">Large preview — with custom eyebrow</h2>
      <Badge tone="warning" variant="soft" size="sm" uppercase>Review only</Badge>
    </div>
    <p class="sg-lede">Trade / feature / billing variants pass an <code class="font-mono text-sm text-[color:var(--color-brand-pressed)]">eyebrow</code> override.</p>
    <div class="sg-preview" style="padding:0;background:transparent;box-shadow:none;overflow:hidden;border-radius:1rem">
      <FAQPreview
        eyebrow="Plumber FAQ"
        headline="What plumbers ask before they start."
        items={tradeItems}
      />
    </div>
  </section>

  <section class="sg-section">
    <div class="flex items-center gap-3 flex-wrap">
      <h2 class="!mb-0">Canonical (3-step)</h2>
      <Badge tone="success" variant="soft" size="sm" uppercase>In production</Badge>
    </div>
    <p class="sg-lede">What's currently live on every FAQ surface: homepage, <code class="font-mono">/how-it-works/</code>, <code class="font-mono">/faq/</code>, <code class="font-mono">/pricing/</code>, every <code class="font-mono">/&lt;trade&gt;-leads/</code> page, every <code class="font-mono">/features/&lt;slug&gt;/</code> page.</p>
    <div class="sg-preview" style="padding:0;background:transparent;box-shadow:none;overflow:hidden;border-radius:1rem">
      <FAQ headline="What pros ask before they start." items={standardItems} />
    </div>
  </section>

  <section class="sg-section">
    <h2>Side-by-side spec deltas</h2>
    <div class="sg-preview">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div>
          <p class="sg-label">Canonical</p>
          <dl class="grid grid-cols-1 gap-y-2 font-mono text-sm">
            <div><dt class="inline font-semibold text-[color:var(--color-ink)]">Container:</dt> <dd class="inline text-[color:var(--color-ink-2)]"><code>max-w-3xl</code></dd></div>
            <div><dt class="inline font-semibold text-[color:var(--color-ink)]">Card bg:</dt> <dd class="inline text-[color:var(--color-ink-2)]">white, <code>rounded-2xl</code>, <code>p-2</code></dd></div>
            <div><dt class="inline font-semibold text-[color:var(--color-ink)]">Row separator:</dt> <dd class="inline text-[color:var(--color-ink-2)]"><code>divide-y</code> between rows</dd></div>
            <div><dt class="inline font-semibold text-[color:var(--color-ink)]">Question type:</dt> <dd class="inline text-[color:var(--color-ink-2)]"><code>font-semibold</code> · ~14px</dd></div>
            <div><dt class="inline font-semibold text-[color:var(--color-ink)]">Answer type:</dt> <dd class="inline text-[color:var(--color-ink-2)]"><code>text-[14px]</code> · <code>leading-relaxed</code></dd></div>
            <div><dt class="inline font-semibold text-[color:var(--color-ink)]">Row padding:</dt> <dd class="inline text-[color:var(--color-ink-2)]"><code>py-4</code></dd></div>
            <div><dt class="inline font-semibold text-[color:var(--color-ink)]">Chevron:</dt> <dd class="inline text-[color:var(--color-ink-2)]"><code>18px</code>, bare icon</dd></div>
          </dl>
        </div>
        <div>
          <p class="sg-label">Large preview (≈ 1.75×)</p>
          <dl class="grid grid-cols-1 gap-y-2 font-mono text-sm">
            <div><dt class="inline font-semibold text-[color:var(--color-ink)]">Container:</dt> <dd class="inline text-[color:var(--color-ink-2)]"><code>max-w-4xl</code></dd></div>
            <div><dt class="inline font-semibold text-[color:var(--color-ink)]">Outer card:</dt> <dd class="inline text-[color:var(--color-ink-2)]"><code>bg-alt</code>, <code>rounded-3xl</code>, <code>p-5</code></dd></div>
            <div><dt class="inline font-semibold text-[color:var(--color-ink)]">Row treatment:</dt> <dd class="inline text-[color:var(--color-ink-2)]">each row is its own <code>rounded-2xl</code> white card with <code>ring-1</code> border</dd></div>
            <div><dt class="inline font-semibold text-[color:var(--color-ink)]">Question type:</dt> <dd class="inline text-[color:var(--color-ink-2)]"><code>display-font</code> · <code>text-xl/22px</code> · <code>font-bold</code></dd></div>
            <div><dt class="inline font-semibold text-[color:var(--color-ink)]">Answer type:</dt> <dd class="inline text-[color:var(--color-ink-2)]"><code>text-[17px]</code> · <code>leading-relaxed</code></dd></div>
            <div><dt class="inline font-semibold text-[color:var(--color-ink)]">Row padding:</dt> <dd class="inline text-[color:var(--color-ink-2)]"><code>px-8 py-7</code></dd></div>
            <div><dt class="inline font-semibold text-[color:var(--color-ink)]">Chevron:</dt> <dd class="inline text-[color:var(--color-ink-2)]"><code>22px</code> inside a <code>40px</code> chip; mint-shifts on open</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="sg-section">
    <h2>Promotion checklist</h2>
    <p class="sg-lede">When the large variant is approved, swap is two replacements + one file delete.</p>
    <div class="sg-preview">
      <ol class="list-decimal pl-5 space-y-2 text-sm text-[color:var(--color-ink-2)]">
        <li>Replace the body of <code class="font-mono text-[color:var(--color-brand-pressed)]">src/components/sections/FAQ.astro</code> with the body of <code class="font-mono text-[color:var(--color-brand-pressed)]">FAQPreview.astro</code>.</li>
        <li>Replace <code class="font-mono">~/components/ui/Accordion.tsx</code> usage inside FAQ with <code class="font-mono">~/components/ui/AccordionLarge.tsx</code> — OR rename AccordionLarge to Accordion and delete the old one if no other consumers remain (style-guide/accordion still uses the smaller Accordion; verify before deleting).</li>
        <li>Delete <code class="font-mono">FAQPreview.astro</code> and remove the preview sections from this page.</li>
        <li>Run <code class="font-mono">pre-publish-checklist</code> skill to confirm no regressions before push.</li>
      </ol>
    </div>
  </section>

  <section class="sg-section">
    <h2>Used in (every FAQ surface flips together)</h2>
    <div class="sg-preview">
      <ul class="grid grid-cols-1 gap-2 font-mono text-sm text-[color:var(--color-ink-2)]">
        <li><strong class="text-[color:var(--color-ink)]">/</strong> homepage · via <code>FAQSection.astro</code> wrapper</li>
        <li><strong class="text-[color:var(--color-ink)]">/how-it-works/</strong></li>
        <li><strong class="text-[color:var(--color-ink)]">/faq/</strong> — master FAQ list</li>
        <li><strong class="text-[color:var(--color-ink)]">/pricing/</strong> — Billing FAQ</li>
        <li><strong class="text-[color:var(--color-ink)]">/&lt;trade&gt;-leads/</strong> (17 pages)</li>
        <li><strong class="text-[color:var(--color-ink)]">/features/&lt;slug&gt;/</strong> (17 pages)</li>
      </ul>
    </div>
  </section>
</StyleGuideLayout>
