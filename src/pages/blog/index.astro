---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Badge from "~/components/ui/Badge.astro";
import FinalCTA from "~/components/sections/FinalCTA.astro";
import { breadcrumbSchema } from "~/lib/seo";
import { SITE } from "~/lib/site";
import { IconArrowRight, IconRss, IconBook } from "@tabler/icons-react";

const schemas = [
  breadcrumbSchema([
    { name: "Home", href: "/" },
    { name: "Blog", href: "/blog/" },
  ]),
];

// Editorial schedule — what's coming. Replace with real posts as they land.
const upcoming = [
  {
    title: "Consent-first lead generation: what it means and why contractors care",
    summary:
      "Why \"consent-first\" isn't a marketing buzzword — it's the legal standard for contacting strangers in 2026.",
    series: "Definition",
  },
  {
    title: "Why your $46 Thumbtack lead actually costs $200",
    summary:
      "Walk through the loaded-cost math: dead numbers, denied disputes, shared-with-4-pros odds, and what it does to your booked-job-per-dollar.",
    series: "Lead-platform economics",
  },
  {
    title: "Anonymous website visitor identification: is it legal in 2026?",
    summary:
      "What GDPR, CCPA, CPA, and the new state laws actually require — and how consent-first works around them by design.",
    series: "Compliance",
  },
  {
    title: "The 17×$7: a roofer's first month with Consent Resolve",
    summary:
      "What real install + setup looks like, how many leads landed, what closed, and what the per-job cost worked out to.",
    series: "Case study",
  },
];
---

<BaseLayout
  title="Blog | Consent Resolve"
  description="Honest writing on lead-platform economics, consent-first identification, and what actually works for home-service contractors in 2026."
  schema={schemas}
>
  <section class="container-content section max-w-4xl">
    <Badge tone="brand" variant="soft" size="md" uppercase>Blog</Badge>
    <h1 class="display-1 mb-7 mt-7 text-[color:var(--color-ink)]">
      Honest writing,<br/>
      <span class="text-[color:var(--color-brand)]">no marketing fluff.</span>
    </h1>
    <p class="max-w-2xl text-lg leading-relaxed text-[color:var(--color-ink-2)]">
      Posts in the pipeline. Drop your email if you want the first ones to land in your inbox.
    </p>

    <div class="mt-16 grid gap-5 sm:grid-cols-2">
      {upcoming.map((post) => (
        <article class="rounded-2xl bg-[color:var(--color-bg-alt)] p-7 ring-1 ring-inset ring-[color:var(--color-rule)]">
          <Badge tone="neutral" variant="outline" size="sm" uppercase>{post.series}</Badge>
          <h2 class="mt-4 font-display text-xl font-bold leading-snug tracking-tight text-[color:var(--color-ink)]">
            {post.title}
          </h2>
          <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">{post.summary}</p>
          <p class="mt-5 inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)]">
            <IconBook size={12} stroke={2.25} /> Coming soon
          </p>
        </article>
      ))}
    </div>

    <div class="mt-16 rounded-3xl bg-[color:var(--color-bg-alt)] p-10 ring-1 ring-inset ring-[color:var(--color-rule)] text-center">
      <IconRss size={28} stroke={1.75} color="var(--color-brand-pressed)" class="mx-auto" />
      <h2 class="mt-4 font-display text-2xl font-black tracking-tight text-[color:var(--color-ink)]">
        Get the first post in your inbox.
      </h2>
      <p class="mt-3 text-[15px] text-[color:var(--color-ink-2)]">
        Email us at <a href={`mailto:${SITE.email}?subject=Subscribe%20to%20Consent%20Resolve%20Blog`} class="font-bold text-[color:var(--color-brand-pressed)] underline-offset-2 hover:underline">{SITE.email}</a> with the word "subscribe" and we'll add you. (Real form coming with the first post.)
      </p>
      <a
        href={`mailto:${SITE.email}?subject=Subscribe%20to%20Consent%20Resolve%20Blog`}
        class="mt-6 inline-flex items-center gap-2 rounded-full bg-[color:var(--color-brand)] px-7 py-3.5 text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--color-navy-900)] shadow-[0_18px_36px_-18px_rgba(0,229,160,0.55)] transition-all hover:-translate-y-0.5 hover:bg-[color:var(--color-brand-pressed)] hover:text-white"
      >
        Subscribe
        <IconArrowRight size={16} stroke={2.5} />
      </a>
    </div>
  </section>

  <FinalCTA />
</BaseLayout>
