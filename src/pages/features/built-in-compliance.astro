---
/**
 * /features/built-in-compliance/ — the hero feature page.
 *
 * Custom page (not generated by the [slug].astro dynamic route) so it
 * can ship the extra sections the mockup calls for that don't fit the
 * standard Feature schema:
 *   - regulatory-fine stat triple ($20M / $100K / $50K+)
 *   - Without / With Consent Documentation comparison
 *   - "Get 35% with zero legal risk" mid-CTA card
 *   - 6-card "What you get" grid
 *   - "Track first vs ask first" choice block
 *   - "Here's the math" 10,000-visitor walkthrough
 *
 * [slug].astro skips built-in-compliance in its getStaticPaths, so
 * editing the data spine still updates pairsWith chips, the /features/
 * hub card, and the FAQPage schema below — but the page chrome lives
 * here.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import Badge from "~/components/ui/Badge.astro";
import StakeCard from "~/components/ui/StakeCard.astro";
import StepFlow from "~/components/ui/StepFlow.astro";
import PillarCard from "~/components/ui/PillarCard.astro";
import FinalCTA from "~/components/sections/FinalCTA.astro";
import AEOAnswer from "~/components/sections/AEOAnswer.astro";
import ComplianceBand from "~/components/sections/ComplianceBand.astro";
import FAQ from "~/components/sections/FAQ.astro";
import { getFeature, getFeatureGroupOf } from "~/data/features";
import { breadcrumbSchema, faqSchema } from "~/lib/seo";
import {
  IconArrowRight, IconCheck, IconEye, IconShieldCheck, IconShield,
  IconAlertTriangle, IconShield, IconClipboardCheck, IconClipboardCheck,
  IconLock, IconCircleCheck, IconX, IconRefresh, IconCash,
} from "@tabler/icons-react";

const feature = getFeature("built-in-compliance")!;
const group = getFeatureGroupOf("built-in-compliance")!;

const canonical = "https://consentresolve.com/features/built-in-compliance/";
const schemas = [
  breadcrumbSchema([
    { name: "Home", href: "/" },
    { name: "Features", href: "/features/" },
    { name: feature.name, href: `/features/${feature.slug}/` },
  ]),
  faqSchema(feature.faq.items.map((f) => ({ question: f.q, answer: f.a }))),
];
---

<BaseLayout
  title="Built-In Compliance — It All Starts with Consent | Consent Resolve"
  description="Other tools track first and ask never. Consent Resolve documents every consent decision with a 7-year audit trail that stands up to GDPR, CCPA, HIPAA, and GLBA audits — so one violation never destroys the business."
  canonical={canonical}
  schema={schemas}
>
  <!-- ============================================================== -->
  <!-- 1. HERO                                                         -->
  <!-- ============================================================== -->
  <section class="section section-dark relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/20 blur-[120px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-32 -bottom-32 size-[420px] rounded-full bg-[color:var(--color-mint-400)]/12 blur-[120px]"></div>

    <div class="container-content relative">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-7 flex justify-center"><Badge tone="brand" variant="soft" surface="dark" size="md" uppercase>{group.eyebrow}</Badge></div>
        <h1 class="display-1 mb-7 text-white">
          Stop gambling with<br/>
          <span class="text-[color:var(--color-mint-400)]">million-dollar fines.</span>
        </h1>
        <p class="mx-auto mb-10 max-w-2xl text-lg leading-relaxed text-slate-300">
          {feature.subhead}
        </p>
        <div class="flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
          <a
            href="https://dashboard.consentresolve.com/register"
            class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-brand)] px-7 py-3.5 text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--color-navy-900)] shadow-[0_18px_36px_-18px_rgba(0,229,160,0.55)] transition-all hover:-translate-y-0.5 hover:bg-[color:var(--color-brand-pressed)] hover:text-white"
          >
            Get Started
            <IconArrowRight size={16} stroke={2.5} />
          </a>
          <a
            href="/how-it-works/"
            class="inline-flex items-center gap-2 rounded-full px-7 py-3.5 text-sm font-bold uppercase tracking-[0.14em] text-white ring-1 ring-inset ring-white/20 transition-all hover:bg-white/5"
          >
            <IconEye size={16} stroke={2} />
            How it works
          </a>
        </div>
        <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-slate-300">
          <li class="flex items-center gap-1.5"><IconCheck size={16} stroke={2.5} color="#00E5A0" /> 100% documented consent</li>
          <li class="flex items-center gap-1.5"><IconCheck size={16} stroke={2.5} color="#00E5A0" /> 7-year audit trail</li>
          <li class="flex items-center gap-1.5"><IconCheck size={16} stroke={2.5} color="#00E5A0" /> Zero legal risk</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 2. REGULATORY MINEFIELD — fine stat triple                     -->
  <!-- ============================================================== -->
  <section class="section section-dark">
    <div class="container-content">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="display-2 text-white">Visitor tracking without consent is a legal minefield.</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-300">
          Higher match rates mean nothing if one violation destroys your business.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        <StakeCard
          Icon={IconAlertTriangle}
          tone="danger"
          surface="dark"
          stat="$20M"
          label="Maximum GDPR fine"
          body="Per violation for non-consensual tracking."
        />
        <StakeCard
          Icon={IconShield}
          tone="danger"
          surface="dark"
          stat="$100K"
          label="GLBA maximum fine"
          body="Per violation for institutions handling consumer financial data."
        />
        <StakeCard
          Icon={IconShield}
          tone="danger"
          surface="dark"
          stat="$50K+"
          label="Per HIPAA incident"
          body="Healthcare-tracking violations stack fast across affected records."
        />
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 3. PIPELINE ON QUICKSAND — without / with comparison           -->
  <!-- ============================================================== -->
  <section class="section section-dark">
    <div class="container-content">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="display-2 text-white">You're building a pipeline on quicksand.</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-300">
          Every lead in your CRM that was tracked without documented consent is potential evidence in a lawsuit. You can't prove they agreed. You can't prove anything. And when regulators or attorneys come knocking, "everyone else does it" isn't a defense.
        </p>
      </div>

      <div class="mx-auto grid max-w-4xl gap-5 md:grid-cols-2">
        <!-- Without -->
        <div class="rounded-2xl bg-white/[0.03] p-7 ring-1 ring-inset ring-red-500/30">
          <div class="mb-4 flex items-center gap-2.5">
            <span class="inline-flex size-8 items-center justify-center rounded-full bg-red-500/15"><IconX size={18} stroke={2.5} color="#fca5a5" /></span>
            <h3 class="font-display text-lg font-bold tracking-tight text-white">Without consent documentation</h3>
          </div>
          <ul class="space-y-3 text-[14px] text-slate-300">
            <li class="flex items-start gap-2.5"><IconX size={18} stroke={2} color="#fca5a5" class="mt-0.5 shrink-0" /> No proof of permission — can't demonstrate visitors agreed to be tracked</li>
            <li class="flex items-start gap-2.5"><IconX size={18} stroke={2} color="#fca5a5" class="mt-0.5 shrink-0" /> Indefensible in audits — regulators demand consent records you don't have</li>
            <li class="flex items-start gap-2.5"><IconX size={18} stroke={2} color="#fca5a5" class="mt-0.5 shrink-0" /> Lawsuit exposure — every tracked lead is a potential plaintiff's evidence</li>
            <li class="flex items-start gap-2.5"><IconX size={18} stroke={2} color="#fca5a5" class="mt-0.5 shrink-0" /> Sleepless nights — knowing your lead-gen could trigger six-figure fines</li>
          </ul>
        </div>

        <!-- With -->
        <div class="rounded-2xl bg-[color:var(--color-brand-soft)]/10 p-7 ring-1 ring-inset ring-[color:var(--color-brand)]/40">
          <div class="mb-4 flex items-center gap-2.5">
            <span class="inline-flex size-8 items-center justify-center rounded-full bg-[color:var(--color-mint-400)]/15"><IconCircleCheck size={18} stroke={2.5} color="#00E5A0" /></span>
            <h3 class="font-display text-lg font-bold tracking-tight text-white">With consent documentation</h3>
          </div>
          <ul class="space-y-3 text-[14px] text-slate-200">
            <li class="flex items-start gap-2.5"><IconCircleCheck size={18} stroke={2.25} color="#00E5A0" class="mt-0.5 shrink-0" /> Timestamped permission — 7-year audit trail of every consent decision</li>
            <li class="flex items-start gap-2.5"><IconCircleCheck size={18} stroke={2.25} color="#00E5A0" class="mt-0.5 shrink-0" /> Audit-ready records — export complete consent history on demand</li>
            <li class="flex items-start gap-2.5"><IconCircleCheck size={18} stroke={2.25} color="#00E5A0" class="mt-0.5 shrink-0" /> Legal protection — documented consent defeats regulatory claims</li>
            <li class="flex items-start gap-2.5"><IconCircleCheck size={18} stroke={2.25} color="#00E5A0" class="mt-0.5 shrink-0" /> Peace of mind — build your pipeline on solid legal ground</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 4. MID-CTA — 35% identification with zero legal risk            -->
  <!-- ============================================================== -->
  <section class="section relative overflow-hidden">
    <div aria-hidden="true" class="absolute inset-0 bg-[color:var(--color-brand)]/95"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-white/15 blur-[120px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-32 -bottom-32 size-[480px] rounded-full bg-white/10 blur-[120px]"></div>

    <div class="container-content relative">
      <div class="mx-auto max-w-4xl">
        <div class="rounded-3xl bg-white/[0.92] p-8 ring-1 ring-inset ring-white/40 shadow-[0_40px_80px_-40px_rgba(10,22,40,0.35)] backdrop-blur md:p-12">
          <div class="text-center">
            <div class="mb-5 flex justify-center"><Badge tone="brand" variant="solid" size="md" uppercase icon={IconShieldCheck}>Privacy Compliance</Badge></div>
            <h2 class="display-2 text-[color:var(--color-ink)]">
              Get 35% identification with<br/>
              <span class="text-[color:var(--color-brand-pressed)]">zero legal risk.</span>
            </h2>
            <p class="mx-auto mt-5 max-w-2xl text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">
              Our consent-first approach asks permission before tracking. Lower match rates, but every lead is defensible. No silent cookies. No backdoor tracking. No regulatory exposure.
            </p>
          </div>

          <div class="mx-auto mt-8 grid max-w-2xl gap-3 sm:grid-cols-3">
            <div class="rounded-xl bg-[color:var(--color-bg-alt)] p-5 text-center ring-1 ring-inset ring-[color:var(--color-rule)]">
              <p class="font-display text-3xl font-black text-[color:var(--color-ink)]">$20M</p>
              <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.12em] text-[color:var(--color-ink-muted)]">Maximum GDPR<br/>fine avoided</p>
            </div>
            <div class="rounded-xl bg-[color:var(--color-bg-alt)] p-5 text-center ring-1 ring-inset ring-[color:var(--color-rule)]">
              <p class="font-display text-3xl font-black text-[color:var(--color-ink)]">$100K</p>
              <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.12em] text-[color:var(--color-ink-muted)]">GLBA penalties<br/>prevented</p>
            </div>
            <div class="rounded-xl bg-[color:var(--color-bg-alt)] p-5 text-center ring-1 ring-inset ring-[color:var(--color-rule)]">
              <p class="font-display text-3xl font-black text-[color:var(--color-ink)]">$50K+</p>
              <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.12em] text-[color:var(--color-ink-muted)]">HIPAA incidents<br/>you won't face</p>
            </div>
          </div>

          <div class="mt-8 flex justify-center">
            <a
              href="https://dashboard.consentresolve.com/register"
              class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-navy-900)] px-7 py-3.5 text-sm font-bold uppercase tracking-[0.14em] text-white transition-all hover:-translate-y-0.5 hover:bg-[color:var(--color-brand-pressed)]"
            >
              Get Started
              <IconArrowRight size={16} stroke={2.5} />
            </a>
          </div>
          <p class="mt-4 text-center text-[12px] text-[color:var(--color-ink-muted)]">No credit card required to explore.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 5. HERE'S HOW IT WORKS — 3-step flow                            -->
  <!-- ============================================================== -->
  <section class="section section-dark">
    <div class="container-content">
      <div class="mx-auto mb-14 max-w-2xl text-center">
        <h2 class="display-2 text-white">Here's how it works.</h2>
        <p class="mt-3 text-[15px] leading-relaxed text-slate-300">Transparent consent collection in three simple steps.</p>
      </div>

      <ol class="mx-auto max-w-3xl space-y-4">
        {feature.howItWorks.steps.map((step, i) => (
          <li class="grid grid-cols-[auto_1fr] items-start gap-5 rounded-2xl bg-white/[0.04] p-6 ring-1 ring-inset ring-white/10">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-mint-400)] font-display text-sm font-black text-[color:var(--color-navy-900)]">{i + 1}</span>
            <div>
              <h3 class="font-display text-lg font-bold tracking-tight text-white">{step.title}</h3>
              <p class="mt-2 text-[14px] leading-relaxed text-slate-300">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 6. WHAT YOU GET — 6-card grid                                   -->
  <!-- ============================================================== -->
  <section class="section section-dark">
    <div class="container-content">
      <div class="mx-auto mb-14 max-w-2xl text-center">
        <h2 class="display-2 text-white">What you get with consent-first tracking.</h2>
        <p class="mt-3 text-[15px] leading-relaxed text-slate-300">Legal protection worth more than higher match rates.</p>
      </div>

      <div class="mx-auto grid max-w-5xl gap-5 md:grid-cols-2 lg:grid-cols-3">
        {[
          { Icon: IconClipboardCheck, title: "7-Year Audit Trail",     body: "Every consent decision timestamped and stored. Prove authorization for any visitor, anytime." },
          { Icon: IconShield,         title: "Regulatory Defense",     body: "Documentation that stands up to GDPR, CCPA, HIPAA, and GLBA audits." },
          { Icon: IconRefresh,     title: "Withdrawal Tracking",    body: "Log when visitors revoke consent, stop tracking immediately. Show compliance." },
          { Icon: IconEye,            title: "No Dark Patterns",       body: "Clear language, obvious decline button. No tricks, no manipulation." },
          { Icon: IconClipboardCheck,     title: "Exportable Records",     body: "Download complete consent history, CSV format. Ready for legal review." },
          { Icon: IconShield,          title: "Lawsuit Protection",     body: "Documented consent defeats class-action claims of unauthorized tracking." },
        ].map((c) => (
          <div class="rounded-2xl bg-white/[0.04] p-6 ring-1 ring-inset ring-white/10 transition-all hover:-translate-y-0.5 hover:ring-[color:var(--color-mint-400)]/40">
            <span class="inline-flex size-10 items-center justify-center rounded-xl bg-[color:var(--color-mint-400)]/15">
              <c.Icon size={20} stroke={1.75} color="#00E5A0" />
            </span>
            <h3 class="mt-4 font-display text-base font-bold tracking-tight text-white">{c.title}</h3>
            <p class="mt-2 text-[14px] leading-relaxed text-slate-300">{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 7. THE CHOICE — track first vs ask first                        -->
  <!-- ============================================================== -->
  <section class="section section-dark">
    <div class="container-content">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="display-2 text-white">You have a choice to make.</h2>
      </div>

      <div class="mx-auto grid max-w-4xl gap-5 md:grid-cols-2">
        <!-- Track first -->
        <div class="rounded-2xl bg-white/[0.03] p-7 ring-1 ring-inset ring-red-500/30">
          <div class="mb-4 flex items-center gap-2.5">
            <span class="inline-flex size-8 items-center justify-center rounded-full bg-red-500/15"><IconX size={18} stroke={2.5} color="#fca5a5" /></span>
            <h3 class="font-display text-lg font-bold tracking-tight text-white">Track first, ask later</h3>
          </div>
          <p class="mt-4 font-display text-4xl font-black tracking-tight text-red-300">50%</p>
          <p class="mt-1 text-[12px] font-bold uppercase tracking-[0.14em] text-slate-400">Identification rate with no consent proof</p>
          <p class="mt-4 font-display text-4xl font-black tracking-tight text-red-300">$50K</p>
          <p class="mt-1 text-[12px] font-bold uppercase tracking-[0.14em] text-slate-400">Potential fine per violation</p>
          <p class="mt-4 font-display text-4xl font-black tracking-tight text-red-300">No proof</p>
          <p class="mt-1 text-[12px] font-bold uppercase tracking-[0.14em] text-slate-400">Of visitor authorization</p>
          <ul class="mt-5 space-y-3 text-[14px] text-slate-300">
            <li class="flex items-start gap-2.5"><IconX size={16} stroke={2.25} color="#fca5a5" class="mt-0.5 shrink-0" /> More leads today, legal exposure tomorrow</li>
            <li class="flex items-start gap-2.5"><IconX size={16} stroke={2.25} color="#fca5a5" class="mt-0.5 shrink-0" /> One audit request destroys your defense</li>
            <li class="flex items-start gap-2.5"><IconX size={16} stroke={2.25} color="#fca5a5" class="mt-0.5 shrink-0" /> Every tracked visitor is a lawsuit-evidence record</li>
          </ul>
        </div>

        <!-- Ask first -->
        <div class="rounded-2xl bg-[color:var(--color-brand-soft)]/10 p-7 ring-1 ring-inset ring-[color:var(--color-brand)]/40">
          <div class="mb-4 flex items-center gap-2.5">
            <span class="inline-flex size-8 items-center justify-center rounded-full bg-[color:var(--color-mint-400)]/15"><IconCircleCheck size={18} stroke={2.5} color="#00E5A0" /></span>
            <h3 class="font-display text-lg font-bold tracking-tight text-white">Ask first, track second</h3>
          </div>
          <p class="mt-4 font-display text-4xl font-black tracking-tight text-[color:var(--color-mint-400)]">35%</p>
          <p class="mt-1 text-[12px] font-bold uppercase tracking-[0.14em] text-slate-400">Identification rate with documented consent</p>
          <p class="mt-4 font-display text-4xl font-black tracking-tight text-[color:var(--color-mint-400)]">$0</p>
          <p class="mt-1 text-[12px] font-bold uppercase tracking-[0.14em] text-slate-400">Regulatory fine or lawsuit risk</p>
          <p class="mt-4 font-display text-4xl font-black tracking-tight text-[color:var(--color-mint-400)]">7 years</p>
          <p class="mt-1 text-[12px] font-bold uppercase tracking-[0.14em] text-slate-400">Of timestamped consent records</p>
          <ul class="mt-5 space-y-3 text-[14px] text-slate-200">
            <li class="flex items-start gap-2.5"><IconCircleCheck size={16} stroke={2.25} color="#00E5A0" class="mt-0.5 shrink-0" /> Fewer leads, but every one is defensible</li>
            <li class="flex items-start gap-2.5"><IconCircleCheck size={16} stroke={2.25} color="#00E5A0" class="mt-0.5 shrink-0" /> Audit-ready documentation defeats claims</li>
            <li class="flex items-start gap-2.5"><IconCircleCheck size={16} stroke={2.25} color="#00E5A0" class="mt-0.5 shrink-0" /> Build your pipeline on solid legal ground</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 8. HERE'S THE MATH — concrete walkthrough                       -->
  <!-- ============================================================== -->
  <section class="section section-dark">
    <div class="container-content">
      <div class="mx-auto max-w-3xl rounded-2xl bg-white/[0.04] p-8 text-center ring-1 ring-inset ring-white/10 md:p-12">
        <h2 class="display-2 text-white">Here's the math.</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-200">
          With 10,000 monthly visitors: get <strong class="text-red-300">4,500 undocumented leads and hope you never face an audit</strong>, or <strong class="text-[color:var(--color-mint-400)]">3,500 legally defensible leads with complete proof of consent</strong>.
        </p>
        <p class="mt-6 text-[15px] italic leading-relaxed text-slate-400">
          One violation can cost more than a lifetime of lower conversion.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 9. FAQ                                                          -->
  <!-- ============================================================== -->
  <FAQ
    eyebrow="Common questions"
    headline={feature.faq.headline}
    items={feature.faq.items.map((f) => ({ question: f.q, answer: f.a }))}
  />

  <!-- ============================================================== -->
  <!-- 10. COMPLIANCE BAND                                             -->
  <!-- ============================================================== -->
  <ComplianceBand />

  <!-- ============================================================== -->
  <!-- 11. AEO ANSWER                                                  -->
  <!-- ============================================================== -->
  <AEOAnswer text={feature.aeoAnswer} />

  <!-- ============================================================== -->
  <!-- 12. FINAL CTA                                                   -->
  <!-- ============================================================== -->
  <FinalCTA
    heading="Choose legal protection over match-rate gambling."
    body="Get 35% identification with zero regulatory risk. Card on file, no contract, cancel anytime. 7-year audit trail on every consent."
    ctaLabel="Get Started"
  />
</BaseLayout>
