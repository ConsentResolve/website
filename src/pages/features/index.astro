---
/**
 * /features/ — Features hub (rebuilt June 2026 from the four-part
 * deck in /Users/aaronphillips/Downloads/consent-resolve-features.html).
 *
 * Voice locked to /style-guide/voice/:
 *   - Contractor is the hero; we're the guide.
 *   - 6-7th grade reading level, 2nd person, contractions.
 *   - Money is the through-line (jobs / $7 / spend / pay).
 *   - No banned hype words (no "free", no "instant", etc.).
 *
 * Structure — four sections, each with its own job:
 *   Part 1  Stop losing leads you already paid for     (4 cards, dark)
 *   Part 2  Know who's serious before you call         (3 cards, light)
 *   Part 3  Turn identified visitors into booked jobs  (3 cards, bg-alt)
 *   Part 4  Stay legal without thinking about it       (5 cards + Pay-
 *                                                       Per-Results
 *                                                       risk-reversal
 *                                                       closer, light)
 *
 * Cards that map to existing /features/<slug>/ detail pages link
 * through; the new concepts (Most Viewed Pages, Ad Retargeting
 * Audiences, API, Law Change Alerts, Audit Ready, Automatic
 * Re-Matching) are presented inline — no broken detail-page links.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import Badge from "~/components/ui/Badge.astro";
import ComplianceBand from "~/components/sections/ComplianceBand.astro";
import FinalCTA from "~/components/sections/FinalCTA.astro";
import { ALL_FEATURES } from "~/data/features";
import { breadcrumbSchema } from "~/lib/seo";
import {
  IconArrowRight, IconEye, IconBolt, IconRefresh, IconAddressBook,
  IconMessage, IconStar, IconChartHistogram, IconClipboardCheck,
  IconPlugConnected, IconCode, IconUserCheck, IconCircleCheck,
  IconShieldCheck, IconCash, IconAlertTriangle,
  type Icon,
} from "@tabler/icons-react";

interface Card {
  Icon: Icon;
  title: string;
  body: string;
  href?: string;
}

interface Part {
  slug: string;
  partLabel: string;
  badgeTone: "brand" | "warning";
  badgeSurface: "light" | "dark";
  headline: string;
  blurb: string;
  cards: Card[];
  bg: "dark" | "light" | "alt";
  gridCols: 2 | 3;
  /** Short label for the sticky chip nav (max ~14 chars). */
  navLabel: string;
}

const parts: Part[] = [
  {
    slug: "see-the-leads",
    partLabel: "Part 1 of 4",
    navLabel: "See the leads",
    badgeTone: "warning",
    badgeSurface: "dark",
    headline: "Stop losing leads you already paid for.",
    blurb: "Your website gets visitors every day. Most leave without a trace — and call the next shop instead. Here's how we catch the ones who tap your consent banner.",
    bg: "dark",
    gridCols: 2,
    cards: [
      {
        Icon: IconEye,
        title: "Visitor Identification",
        body: "Real homeowners are on your site right now, looking at your services. Most leave without calling. We hand you their name and email — so the lead you already earned doesn't walk away.",
        href: "/features/visitor-identification/",
      },
      {
        Icon: IconBolt,
        title: "Real-Time Lead Matching",
        body: "The moment a visitor accepts your cookie banner, we match them to a real person. No form to fill out. No waiting until tomorrow. The lead lands while they're still interested.",
        href: "/features/instant-connect/",
      },
      {
        Icon: IconRefresh,
        title: "Cart Recovery",
        body: "70% of shoppers abandon their cart. Most never logged in, so you have no way to email them. We identify the consented abandoners and launch an automated recovery sequence — so the carts come back.",
        href: "/features/cart-recovery/",
      },
      {
        Icon: IconAddressBook,
        title: "Formless Contact Capture",
        body: "Only about 2% of website visitors ever fill out your contact form. We capture the other 98% — name, phone, and email — without making them type a thing.",
        href: "/features/formless-contact-capture/",
      },
    ],
  },
  {
    slug: "know-whos-serious",
    partLabel: "Part 2 of 4",
    navLabel: "Sort the serious",
    badgeTone: "brand",
    badgeSurface: "light",
    headline: "Know who's serious before you pick up the phone.",
    blurb: "Your time is worth money. Spend it on the homeowners ready to buy — not the tire-kickers.",
    bg: "light",
    gridCols: 3,
    cards: [
      {
        Icon: IconChartHistogram,
        title: "Browse History",
        body: "Every lead arrives with a trail of what they looked at, in what order, and for how long. The homeowner who went from \"roof replacement\" to \"financing\" is ready for a call today.",
        href: "/features/behavior-and-job-type-insights/",
      },
      {
        Icon: IconStar,
        title: "Lead Sorting",
        body: "Leads are sorted automatically by how serious they look — hot, warm, or just browsing. Work the hot ones first. Stop burning afternoons on tire-kickers.",
        href: "/features/lead-scoring/",
      },
      {
        Icon: IconChartHistogram,
        title: "Most Viewed Pages",
        body: "See which pages on your site real, identified homeowners look at most. Now you know what's bringing in jobs — and what's getting ignored.",
      },
    ],
  },
  {
    slug: "into-booked-jobs",
    partLabel: "Part 3 of 4",
    navLabel: "Book the job",
    badgeTone: "brand",
    badgeSurface: "light",
    headline: "Turn identified visitors into booked jobs.",
    blurb: "Follow-up shouldn't mean more work. Every recovered lead drops straight into the tools you already use.",
    bg: "alt",
    gridCols: 3,
    cards: [
      {
        Icon: IconRefresh,
        title: "Ad Retargeting Audiences",
        body: "Send your identified visitors straight into Facebook and Google as ready-made audiences. Ads shown to homeowners who already visited your site cost less and book more.",
      },
      {
        Icon: IconPlugConnected,
        title: "Integrations",
        body: "Pushes leads into Jobber, Housecall Pro, ServiceTitan, HubSpot, Klaviyo, and GoHighLevel in a few clicks. No developer. No new system to learn.",
        href: "/features/crm-delivery/",
      },
      {
        Icon: IconCode,
        title: "API & Webhooks",
        body: "Need your leads to flow somewhere custom? Our webhook + API lets your developer send visitor records anywhere your business needs them.",
      },
    ],
  },
  {
    slug: "stay-legal",
    partLabel: "Part 4 of 4",
    navLabel: "Stay legal",
    badgeTone: "brand",
    badgeSurface: "light",
    headline: "Stay legal without thinking about it.",
    blurb: "Privacy laws change all the time. Getting it wrong costs real money. We handle it so you don't have to.",
    bg: "light",
    gridCols: 3,
    cards: [
      {
        Icon: IconUserCheck,
        title: "Cookie Consent Banner",
        body: "A clean, compliant cookie banner for your site. It keeps you on the right side of the law — and it's what unlocks every lead.",
        href: "/features/built-in-compliance/",
      },
      {
        Icon: IconCircleCheck,
        title: "Consent Records",
        body: "Every lead arrives with proof they said yes — date, time, and source. If anyone ever asks how you got their info, the answer takes one click.",
        href: "/features/consent-first-identification/",
      },
      {
        Icon: IconShieldCheck,
        title: "Privacy-Law Compliance",
        body: "Privacy laws are different in every state and change all the time. We track every one of them and keep you covered automatically. You run your shop — we'll watch the laws.",
        href: "/features/built-in-compliance/",
      },
      {
        Icon: IconMessage,
        title: "Law-Change Alerts",
        body: "When a law changes that affects you, we email you what it means in plain English. No legal jargon. No surprises.",
      },
      {
        Icon: IconClipboardCheck,
        title: "Audit-Ready Records",
        body: "If a regulator, lawyer, or ad platform ever questions a lead, your records are already organized and ready to export. You'll never scramble.",
      },
      // The Pay-Per-Results closer is rendered separately below so it can
      // get the inverted navy treatment.
    ],
  },
];

// Schemas — keep the ItemList payload pointing to the real feature
// detail pages we still ship.
const schemas = [
  breadcrumbSchema([
    { name: "Home", href: "/" },
    { name: "Features", href: "/features/" },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Consent Resolve Features",
    itemListElement: ALL_FEATURES.map((f, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: f.name,
      url: `https://consentresolve.com/features/${f.slug}/`,
    })),
  },
];

// Surface tokens per section bg
const sectionBg = (bg: Part["bg"]) =>
  bg === "dark" ? "section section-dark"
  : bg === "alt" ? "section bg-[color:var(--color-bg-alt)]"
  : "section";

const cardSurface = (bg: Part["bg"]) =>
  bg === "dark"
    ? "bg-white/[0.04] text-white ring-1 ring-inset ring-white/10 hover:ring-[color:var(--color-mint-400)]/60"
    : "bg-white text-[color:var(--color-ink)] ring-1 ring-inset ring-[color:var(--color-rule)] hover:ring-[color:var(--color-mint-400)]/60";

const cardBody = (bg: Part["bg"]) =>
  bg === "dark" ? "text-slate-300" : "text-[color:var(--color-ink-2)]";

const cardIconBg = (bg: Part["bg"]) =>
  bg === "dark"
    ? "bg-[color:var(--color-mint-400)]/15 text-[color:var(--color-mint-400)]"
    : "bg-[color:var(--color-brand-soft)] text-[color:var(--color-brand-pressed)]";
---

<BaseLayout
  title="Features | Consent Resolve — See Every Lead Your Website Hides"
  description="Visitor identification, consent records, ad-audience push, and automatic privacy compliance — built for home-service contractors. Flat $7 per recovered lead. Yours alone, never resold."
  schema={schemas}
>
  <!-- ============================================================== -->
  <!-- HERO — leads with the consent foundation feature.              -->
  <!--   Frames the whole feature deck around the 'it all starts      -->
  <!--   with consent' message before the four-part breakdown.        -->
  <!--   Deep dive lives at /features/built-in-compliance/.            -->
  <!-- ============================================================== -->
  <section class="section section-dark relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/20 blur-[120px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-32 -bottom-32 size-[420px] rounded-full bg-[color:var(--color-mint-400)]/12 blur-[120px]"></div>

    <div class="container-content relative">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-7 flex justify-center"><Badge tone="brand" variant="soft" surface="dark" size="md" uppercase icon={IconShieldCheck}>It all starts with consent</Badge></div>
        <h1 class="display-1 mb-7 text-white">
          Stop gambling with<br/>
          <span class="text-[color:var(--color-mint-400)]">million-dollar fines.</span>
        </h1>
        <p class="mx-auto max-w-2xl text-lg leading-relaxed text-slate-300">
          Other tools track first and ask never. Consent Resolve documents every visitor decision with a 7-year audit trail that stands up to GDPR, CCPA, HIPAA, and GLBA audits — so one violation never destroys the business. Every feature in this deck sits on that foundation.
        </p>

        <ul class="mx-auto mt-8 flex max-w-3xl flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-slate-300">
          <li class="flex items-center gap-1.5"><IconCircleCheck size={16} stroke={2.25} color="#00E5A0" /> 100% documented consent</li>
          <li class="flex items-center gap-1.5"><IconCircleCheck size={16} stroke={2.25} color="#00E5A0" /> 7-year audit trail</li>
          <li class="flex items-center gap-1.5"><IconCircleCheck size={16} stroke={2.25} color="#00E5A0" /> Zero legal risk</li>
        </ul>

        <div class="mt-10 flex flex-wrap justify-center gap-3">
          <a
            href="/features/built-in-compliance/"
            class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-brand)] px-7 py-3.5 text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--color-navy-900)] shadow-[0_18px_36px_-18px_rgba(0,229,160,0.55)] transition-all hover:-translate-y-0.5 hover:bg-[color:var(--color-brand-pressed)] hover:text-white"
          >
            See how compliance works
            <IconArrowRight size={16} stroke={2.5} />
          </a>
          <a
            href="https://dashboard.consentresolve.com/register"
            class="inline-flex items-center gap-2 rounded-full px-7 py-3.5 text-sm font-bold uppercase tracking-[0.14em] text-white ring-1 ring-inset ring-white/20 transition-all hover:bg-white/5"
          >
            Get Started
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- STICKY PART NAV                                                 -->
  <!-- ============================================================== -->
  <nav aria-label="Feature parts" class="sticky top-2 z-20 mx-auto w-fit max-w-[calc(100%-1rem)]">
    <ul class="flex w-max items-center gap-1 overflow-x-auto rounded-full bg-[color:var(--color-bg)] p-1.5 ring-1 ring-inset ring-[color:var(--color-rule)] shadow-[0_18px_40px_-20px_rgba(10,22,40,0.18)]">
      {parts.map((p) => (
        <li>
          <a
            href={`#${p.slug}`}
            class="inline-flex items-center whitespace-nowrap rounded-full px-4 py-2 text-[11px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-2)] transition-colors hover:bg-[color:var(--color-bg-alt)] hover:text-[color:var(--color-brand-pressed)]"
          >
            {p.navLabel}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- ============================================================== -->
  <!-- FOUR PARTS                                                      -->
  <!-- ============================================================== -->
  {parts.map((part, idx) => (
    <section id={part.slug} class={`${sectionBg(part.bg)} scroll-mt-24`}>
      <div class="container-content">
        {/* Header */}
        <div class="mx-auto mb-12 max-w-3xl">
          <Badge tone={part.badgeTone} variant="soft" surface={part.badgeSurface} size="md" uppercase>{part.partLabel}</Badge>
          <h2 class:list={["display-2", "mt-5", part.bg === "dark" ? "text-white" : "text-[color:var(--color-ink)]"]}>{part.headline}</h2>
          <p class:list={["mt-4", "text-[17px]", "leading-relaxed", "max-w-2xl", part.bg === "dark" ? "text-slate-300" : "text-[color:var(--color-ink-2)]"]}>
            {part.blurb}
          </p>
        </div>

        {/* Cards grid */}
        <div class:list={["grid", "gap-5", part.gridCols === 2 ? "md:grid-cols-2" : "md:grid-cols-3"]}>
          {part.cards.map((c) => (
            c.href ? (
              <a href={c.href} class:list={["group", "block", "rounded-2xl", "p-7", "transition-all", "hover:-translate-y-1", "hover:shadow-[0_30px_60px_-30px_rgba(0,229,160,0.4)]", cardSurface(part.bg)]}>
                <div class:list={["mb-4", "inline-flex", "size-11", "items-center", "justify-center", "rounded-xl", cardIconBg(part.bg)]}>
                  <c.Icon size={22} stroke={1.75} />
                </div>
                <h3 class:list={["font-display", "text-lg", "font-bold", "tracking-tight", part.bg === "dark" ? "text-white" : "text-[color:var(--color-ink)]"]}>{c.title}</h3>
                <p class:list={["mt-3", "text-[14px]", "leading-relaxed", cardBody(part.bg)]}>{c.body}</p>
                <span class:list={["mt-5", "inline-flex", "items-center", "gap-1.5", "text-[11px]", "font-bold", "uppercase", "tracking-[0.14em]", part.bg === "dark" ? "text-[color:var(--color-mint-400)]" : "text-[color:var(--color-brand-pressed)]"]}>
                  Learn more
                  <IconArrowRight size={12} stroke={2.5} class="transition-transform group-hover:translate-x-0.5" />
                </span>
              </a>
            ) : (
              <div class:list={["rounded-2xl", "p-7", "transition-all", cardSurface(part.bg)]}>
                <div class:list={["mb-4", "inline-flex", "size-11", "items-center", "justify-center", "rounded-xl", cardIconBg(part.bg)]}>
                  <c.Icon size={22} stroke={1.75} />
                </div>
                <h3 class:list={["font-display", "text-lg", "font-bold", "tracking-tight", part.bg === "dark" ? "text-white" : "text-[color:var(--color-ink)]"]}>{c.title}</h3>
                <p class:list={["mt-3", "text-[14px]", "leading-relaxed", cardBody(part.bg)]}>{c.body}</p>
              </div>
            )
          ))}

          {/* Part 4 gets the Pay-Per-Results risk-reversal closer card. */}
          {part.slug === "stay-legal" && (
            <div class="relative overflow-hidden rounded-2xl bg-[color:var(--color-navy-900)] p-7 ring-1 ring-inset ring-white/10 shadow-[0_30px_60px_-30px_rgba(10,22,40,0.45)]">
              <span class="absolute right-3 top-3 rounded-full bg-[color:var(--color-mint-400)] px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-navy-900)]">Our promise</span>
              <div class="mb-4 inline-flex size-11 items-center justify-center rounded-xl bg-[color:var(--color-mint-400)]/20 text-[color:var(--color-mint-400)]">
                <IconCash size={22} stroke={1.75} />
              </div>
              <h3 class="font-display text-lg font-bold tracking-tight text-white">Pay per result.</h3>
              <p class="mt-3 text-[14px] leading-relaxed text-slate-300">
                You only pay for the leads we actually identify. No flat fee for software that sits there. No matches, no charge. Your money follows results — flat $7 a lead, never resold.
              </p>
              <a
                href="/pricing/"
                class="mt-5 inline-flex items-center gap-2 rounded-full bg-[color:var(--color-mint-400)] px-5 py-2.5 text-[11px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-navy-900)] transition-all hover:-translate-y-0.5 hover:bg-white"
              >
                See pricing
                <IconArrowRight size={14} stroke={2.5} />
              </a>
            </div>
          )}
        </div>
      </div>
    </section>
  ))}

  <ComplianceBand />
  <FinalCTA
    heading="Right now, someone's on your website. Find out who."
    body="Install in about 10 minutes. Works with the site you already have. Flat $7 a lead — pay only when we deliver one."
    ctaLabel="See my hidden leads"
  />
</BaseLayout>
