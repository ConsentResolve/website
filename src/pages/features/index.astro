---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Badge from "~/components/ui/Badge.astro";
import FinalCTA from "~/components/sections/FinalCTA.astro";
import ComplianceBand from "~/components/sections/ComplianceBand.astro";
import { FEATURE_GROUPS, ALL_FEATURES } from "~/data/features";
import { breadcrumbSchema } from "~/lib/seo";
import { IconArrowRight } from "@tabler/icons-react";

const schemas = [
  breadcrumbSchema([
    { name: "Home", href: "/" },
    { name: "Features", href: "/features/" },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Consent Resolve Features",
    itemListElement: ALL_FEATURES.map((f, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: f.name,
      url: `https://consentresolve.com/features/${f.slug}/`,
    })),
  },
];
---

<BaseLayout
  title="Features | Consent Resolve — Every Tool That Turns Visitors Into Booked Jobs"
  description="Exclusive opt-in leads, real names and numbers, real-time mobile alerts, CRM delivery, ROI reporting. Plain-English walk-through of everything Consent Resolve does for a home-service contractor."
  schema={schemas}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/20 blur-[120px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-32 top-32 size-[420px] rounded-full bg-[color:var(--color-mint-400)]/15 blur-[120px]"></div>
    <div class="container-content section relative">
      <div class="mx-auto max-w-3xl text-center">
        <Badge tone="brand" variant="soft" size="md" uppercase>Features</Badge>
        <h1 class="display-1 mb-7 mt-7 text-[color:var(--color-ink)]">
          Every visitor who leaves without calling<br/>
          <span class="text-[color:var(--color-brand-pressed)]">is a job you'll never know you lost.</span>
        </h1>
        <p class="mx-auto max-w-2xl text-lg leading-relaxed text-[color:var(--color-ink-2)]">
          Consent Resolve turns the anonymous people on your website into named leads you can actually call — exclusively yours, every one opted in. Here's everything it does, in plain English.
        </p>
        <div class="mt-10">
          <a
            href="https://dashboard.consentresolve.com/register"
            class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-brand)] px-7 py-3.5 text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--color-navy-900)] shadow-[0_18px_36px_-18px_rgba(0,229,160,0.55)] transition-all hover:-translate-y-0.5 hover:bg-[color:var(--color-brand-pressed)] hover:text-white"
          >
            Get Started
            <IconArrowRight size={16} stroke={2.5} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Sticky chip nav -->
  <nav aria-label="Feature groups" class="sticky top-2 z-20 mx-auto w-fit max-w-[calc(100%-1rem)]">
    <ul class="flex w-max items-center gap-1 overflow-x-auto rounded-full bg-[color:var(--color-bg)] p-1.5 ring-1 ring-inset ring-[color:var(--color-rule)] shadow-[0_18px_40px_-20px_rgba(10,22,40,0.18)]">
      {FEATURE_GROUPS.map((g, gi) => (
        <li>
          <a
            href={`#${g.slug}`}
            class="inline-flex items-center gap-2 whitespace-nowrap rounded-full px-3.5 py-2 text-[11px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink-2)] transition-colors hover:bg-[color:var(--color-bg-alt)] hover:text-[color:var(--color-brand-pressed)]"
          >
            <span class="font-mono text-[color:var(--color-brand-pressed)]">{`0${gi + 1}`}</span>
            {g.title.replace(/\.$/, "")}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Groups -->
  {FEATURE_GROUPS.map((group, gi) => (
    <section id={group.slug} class={`section ${gi % 2 === 1 ? "bg-[color:var(--color-bg-alt)]" : ""} scroll-mt-24`}>
      <div class="container-content">
        <div class="mx-auto mb-14 max-w-3xl text-center">
          <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.16em] text-[color:var(--color-brand-pressed)]">
            <span class="font-mono">{`0${gi + 1}`}</span>
            <span class="h-px w-8 bg-[color:var(--color-brand)]/40"></span>
            {group.eyebrow}
          </span>
          <h2 class="display-2 mt-5 text-[color:var(--color-ink)]">{group.title}</h2>
          <p class="mt-4 text-[17px] leading-relaxed text-[color:var(--color-ink-2)]">{group.blurb}</p>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {group.features.map((f) => (
            <a
              href={`/features/${f.slug}/`}
              class="group flex h-full flex-col overflow-hidden rounded-3xl bg-[color:var(--color-bg)] ring-1 ring-inset ring-[color:var(--color-rule)] transition-all hover:-translate-y-1 hover:ring-[color:var(--color-brand)]/40 hover:shadow-[0_30px_60px_-28px_rgba(10,22,40,0.25)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-brand)] focus-visible:ring-offset-2"
            >
              {/* Illustration plate */}
              <div class="relative flex aspect-[5/3] items-center justify-center overflow-hidden bg-gradient-to-br from-[color:var(--color-brand-soft)] via-[#e9f9f1] to-[color:var(--color-bg-alt)]">
                <div aria-hidden="true" class="pointer-events-none absolute -right-12 -top-12 size-40 rounded-full bg-[color:var(--color-mint-400)]/20 blur-2xl"></div>
                <div aria-hidden="true" class="pointer-events-none absolute -left-10 -bottom-10 size-32 rounded-full bg-[color:var(--color-mint-400)]/15 blur-2xl"></div>
                <img
                  src={f.illustration}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="relative z-10 max-h-[70%] w-auto max-w-[70%] object-contain transition-transform duration-500 group-hover:scale-105"
                />
              </div>

              {/* Body */}
              <div class="flex flex-1 flex-col p-7">
                <h3 class="font-display text-xl font-black tracking-tight text-[color:var(--color-ink)]">
                  {f.name}
                </h3>
                <p class="mt-3 flex-1 text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">
                  {f.howItHelps}
                </p>
                <span class="mt-6 inline-flex items-center gap-1.5 text-[12px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-brand-pressed)] transition-all group-hover:gap-2.5">
                  Learn more
                  <IconArrowRight size={14} stroke={2.5} />
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <ComplianceBand />
  <FinalCTA />
</BaseLayout>
