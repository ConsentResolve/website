---
/**
 * Individual feature landing page — one per Feature in src/data/features.ts.
 * Content comes from the deck at /Users/aaronphillips/Downloads/consent-resolve-feature-pages.md.
 *
 * Shared sections (ComplianceBand, FinalCTA) are identical on every page
 * and live in their own components — DO NOT inline-duplicate that copy.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import FeatureCard from "~/components/ui/FeatureCard.astro";
import FinalCTA from "~/components/sections/FinalCTA.astro";
import ComplianceBand from "~/components/sections/ComplianceBand.astro";
import Accordion from "~/components/ui/Accordion.tsx";
import { ALL_FEATURES, getFeature, getFeatureGroupOf } from "~/data/features";
import { FEATURE_ICONS } from "~/lib/feature-icons";
import { breadcrumbSchema, faqSchema } from "~/lib/seo";
import { IconArrowRight, IconCheck, IconEye } from "@tabler/icons-react";

export async function getStaticPaths() {
  return ALL_FEATURES.map((feature) => ({
    params: { slug: feature.slug },
    props: { feature },
  }));
}

const { feature } = Astro.props;
const group = getFeatureGroupOf(feature.slug)!;
const Icon = FEATURE_ICONS[feature.iconKey];

// "Pairs Well With" — resolve the slugs from the deck to live Feature objects
const pairsWith = feature.pairsWith
  .map((slug) => getFeature(slug))
  .filter((f): f is NonNullable<typeof f> => Boolean(f));

const canonical = `https://consentresolve.com/features/${feature.slug}/`;
const schemas = [
  breadcrumbSchema([
    { name: "Home", href: "/" },
    { name: "Features", href: "/features/" },
    { name: feature.name, href: `/features/${feature.slug}/` },
  ]),
  faqSchema(feature.faq.items.map((f) => ({ question: f.q, answer: f.a }))),
];
---

<BaseLayout
  title={`${feature.name} | Consent Resolve`}
  description={feature.subhead}
  canonical={canonical}
  schema={schemas}
>
  <!-- 1. Hero -->
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 size-[480px] rounded-full bg-[color:var(--color-mint-400)]/20 blur-[120px]"></div>
    <div class="container-content section relative">
      <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
        <div>
          <p class="eyebrow mb-7 uppercase">{group.eyebrow}</p>
          <h1 class="display-1 mb-7 text-[color:var(--color-ink)]">{feature.name}</h1>
          <p class="mb-10 max-w-xl text-lg leading-relaxed text-[color:var(--color-ink-2)]">{feature.subhead}</p>
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              href="https://dashboard.consentresolve.com/register"
              class="inline-flex items-center gap-2 rounded-full bg-[color:var(--color-brand)] px-7 py-3.5 text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--color-navy-900)] shadow-[0_18px_36px_-18px_rgba(0,229,160,0.55)] transition-all hover:-translate-y-0.5 hover:bg-[color:var(--color-brand-pressed)] hover:text-white"
            >
              Get Started
              <IconArrowRight size={16} stroke={2.5} />
            </a>
            <a
              href="/sample-lead/"
              class="inline-flex items-center gap-2 rounded-full px-7 py-3.5 text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--color-ink)] ring-1 ring-inset ring-[color:var(--color-rule)] transition-all hover:ring-[color:var(--color-mint-400)]/60"
            >
              <IconEye size={16} stroke={2} />
              See a sample lead
            </a>
          </div>
        </div>
        <!-- Hero card — same brand illustration as the /features/ hub -->
        <div class="relative hidden lg:block">
          <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[color:var(--color-brand-soft)] via-[#e9f9f1] to-[color:var(--color-bg-alt)] p-10 ring-1 ring-inset ring-[color:var(--color-rule)] shadow-[0_30px_60px_-30px_rgba(10,22,40,0.18)]">
            <div aria-hidden="true" class="pointer-events-none absolute -right-12 -top-12 size-48 rounded-full bg-[color:var(--color-mint-400)]/25 blur-3xl"></div>
            <div aria-hidden="true" class="pointer-events-none absolute -left-12 -bottom-12 size-40 rounded-full bg-[color:var(--color-mint-400)]/15 blur-2xl"></div>
            <img
              src={feature.illustration}
              alt=""
              class="relative z-10 mx-auto block h-auto w-full max-w-[260px]"
              loading="eager"
              decoding="async"
            />
            <p class="relative z-10 mt-6 text-center font-display text-2xl font-bold tracking-tight text-[color:var(--color-ink)]">{feature.name}</p>
            <p class="relative z-10 mt-2 text-center text-sm text-[color:var(--color-ink-muted)]">{feature.tagline}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. AEO answer paragraph -->
  <section class="border-y border-[color:var(--color-rule)] bg-[color:var(--color-bg-alt)]">
    <div class="container-content py-10">
      <div class="mx-auto max-w-3xl">
        <p class="text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">{feature.aeoAnswer}</p>
      </div>
    </div>
  </section>

  <!-- 3. The Problem -->
  <section class="section section-dark">
    <div class="container-content">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow mb-5 justify-center" style="color:var(--color-mint-400)">The problem</p>
        <h2 class="display-2 text-white">{feature.problem.headline}</h2>
        <p class="mt-6 text-lg leading-relaxed text-slate-300">{feature.problem.body}</p>
      </div>
    </div>
  </section>

  <!-- 4. How it works -->
  <section class="section">
    <div class="container-content">
      <div class="mx-auto mb-14 max-w-2xl text-center">
        <p class="eyebrow mb-5 justify-center">How it works</p>
        <h2 class="display-2 text-[color:var(--color-ink)]">{feature.howItWorks.headline}</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {feature.howItWorks.steps.map((step, i) => (
          <div class="relative rounded-2xl bg-[color:var(--color-bg-alt)] p-8 ring-1 ring-inset ring-[color:var(--color-rule)]">
            <div class="step-badge mb-5">{i + 1}</div>
            <h3 class="font-display text-lg font-bold tracking-tight text-[color:var(--color-ink)]">{step.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. What You Get -->
  <section class="section bg-[color:var(--color-bg-alt)]">
    <div class="container-content">
      <div class="mx-auto mb-14 max-w-2xl text-center">
        <p class="eyebrow mb-5 justify-center">What you get</p>
        <h2 class="display-2 text-[color:var(--color-ink)]">{feature.benefits.headline}</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {feature.benefits.items.map((b) => (
          <FeatureCard variant="showcase" icon={Icon} title={b.title} body={b.body} />
        ))}
      </div>
    </div>
  </section>

  <!-- 6. (Contractor quote section intentionally removed — re-introduce
        ONLY with real, verifiable testimonials per FTC. The data spine
        still carries `quote` so future reinstatement is a swap.) -->

  <!-- 7. What's Included -->
  <section class="section section-dark">
    <div class="container-content max-w-4xl">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <p class="eyebrow mb-5 justify-center" style="color:var(--color-mint-400)">What's included</p>
        <h2 class="display-2 text-white">{feature.included.headline}</h2>
      </div>
      <ul class="grid gap-4 md:grid-cols-2">
        {feature.included.items.map((line) => (
          <li class="flex items-start gap-3 rounded-2xl bg-white/5 p-5 ring-1 ring-inset ring-white/10">
            <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-mint-400)]">
              <IconCheck size={14} stroke={3} color="#0A1628" />
            </span>
            <span class="text-[15px] leading-snug text-slate-200">{line}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 8. FAQ -->
  <section class="section">
    <div class="container-content max-w-3xl">
      <div class="mb-12 text-center">
        <p class="eyebrow mb-5 justify-center">FAQ</p>
        <h2 class="display-2 text-[color:var(--color-ink)]">{feature.faq.headline}</h2>
      </div>
      <div class="rounded-2xl bg-[color:var(--color-bg-alt)] p-2 ring-1 ring-inset ring-[color:var(--color-rule)]">
        <div class="px-5">
          <Accordion
            client:visible
            variant="chevron"
            defaultOpen={0}
            items={feature.faq.items.map((f) => ({ question: f.q, answer: f.a }))}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 9. Compliance (shared) -->
  <ComplianceBand />

  <!-- 10. Pairs Well With -->
  {pairsWith.length > 0 && (
    <section class="section bg-[color:var(--color-bg-alt)]">
      <div class="container-content">
        <div class="mx-auto mb-12 max-w-2xl text-center">
          <p class="eyebrow mb-5 justify-center">Pairs well with</p>
          <h2 class="display-2 text-[color:var(--color-ink)]">Stack {feature.name.toLowerCase()} with these.</h2>
        </div>
        <div class="grid gap-6 md:grid-cols-3">
          {pairsWith.map((p) => {
            const PIcon = FEATURE_ICONS[p.iconKey];
            return (
              <a
                href={`/features/${p.slug}/`}
                class="block rounded-2xl focus:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-brand)] focus-visible:ring-offset-2"
              >
                <FeatureCard variant="showcase" icon={PIcon} title={p.name} body={p.tagline} />
              </a>
            );
          })}
        </div>
        <div class="mt-12 text-center">
          <a
            href="/features/"
            class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-[0.14em] text-[color:var(--color-brand-pressed)] hover:text-[color:var(--color-ink)]"
          >
            See every feature
            <IconArrowRight size={14} stroke={2.5} />
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- 11. Final CTA (shared) -->
  <FinalCTA />
</BaseLayout>
