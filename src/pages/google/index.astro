---
import BaseLayout from "~/layouts/BaseLayout.astro";
import DemoForm from "~/components/DemoForm.astro";
import LeakVisual from "~/components/ui/demo/LeakVisual.astro";

// Google Search ads landing — intent-matched to "get more leads" searches.
// Link ads here with ?utm_source=google_search so channel attribution flows via cr_src.
// noindex — this is an ad destination, not organic content.
---

<BaseLayout
  ogImage="/og/demo.png"
  title="Get More Leads From the Traffic You Already Have — Consent Resolve"
  description="98% of your website visitors leave without filling out a form. Consent Resolve recovers them — with consent — as exclusive leads at a flat $7. See it on your own site in 60 seconds."
  noindex
>
  <section class="bg-[color:var(--color-bg-inverse)]">
    <div class="mx-auto max-w-6xl px-6 py-16 lg:py-24">
      <div class="grid items-start gap-12 lg:grid-cols-2">
        <div class="text-[color:var(--color-on-inverse)]">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[color:var(--color-brand)]">For home-service pros</p>
          <h1 class="mt-3 font-display text-4xl font-bold leading-[1.05] tracking-tight md:text-5xl">
            Get more leads from the traffic you already have.
          </h1>
          <p class="mt-5 max-w-md text-lg leading-relaxed text-[color:var(--color-on-inverse-muted)]">
            About 98% of the people who visit your site leave without ever filling out the form. Consent Resolve identifies them — with their consent — and hands them to you as <strong>exclusive</strong> leads at a flat <strong>$7</strong>. Never shared, never resold.
          </p>

          <ul class="mt-8 space-y-3">
            {[
              "Exclusive leads — never sold to 4 other contractors",
              "Flat $7 per lead. No contract, cancel anytime",
              "Consent-first: every lead carries a signed audit trail",
            ].map((t) => (
              <li class="flex gap-3 text-[color:var(--color-on-inverse)]">
                <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-brand)] text-xs font-bold text-[color:var(--color-on-brand)]">✓</span>
                <span>{t}</span>
              </li>
            ))}
          </ul>

          <p class="mt-8 text-sm text-[color:var(--color-on-inverse-muted)]">
            See exactly what it would recover on your own site — takes about 60 seconds.
          </p>
        </div>

        <div id="demo-register">
          <DemoForm heading="See it work on your site" sub="Register, browse a sample site, consent — and watch the exact new-lead notification land in your inbox. About 60 seconds." />
        </div>
      </div>

      <div class="mt-14 max-w-3xl">
        <LeakVisual />
      </div>
    </div>
  </section>
</BaseLayout>
