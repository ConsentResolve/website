---
/**
 * /before-after/ — the one-toggle visual story for cold social/ad traffic.
 *
 * A plumber lands here and in one click sees the problem (98 of 100 visitors
 * leave anonymous) flip to the fix (the ones who consent come back as named,
 * exclusive leads). Reuses the person dot-grid from the demo's "It all comes
 * together" finale, in the navy/mint brand.
 *
 * Voice locked: dry, no exclamation, no competitor names, email not phone, only
 * $7 is a fixed claim. Public/indexable — the FIX side is intentionally
 * qualitative (no "% identified" claim); the grid fill is labeled illustrative.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import { breadcrumbSchema } from "~/lib/seo";

const schemas = [
  breadcrumbSchema([
    { name: "Home", href: "/" },
    { name: "Before & after", href: "/before-after/" },
  ]),
];
const DEMO =
  "/demo?from=before-after&utm_source=site&utm_medium=before_after&utm_campaign=own_your_traffic";
---

<BaseLayout
  title="Before & after — what your website traffic is really doing · Consent Resolve"
  description="One toggle: see the problem (98 of 100 visitors leave anonymous) flip to the fix (the ones who consent come back as named, exclusive leads at $7 each)."
  schema={schemas}
>
  <section class="relative overflow-hidden" style="background:#0a1628">
    <div aria-hidden="true" class="pointer-events-none absolute -left-40 -top-40 size-[520px] rounded-full bg-[color:var(--color-mint-400)]/15 blur-[140px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-40 -bottom-40 size-[520px] rounded-full bg-[color:var(--color-mint-400)]/10 blur-[140px]"></div>

    <div class="relative mx-auto max-w-3xl px-6 py-16 text-center md:py-24">
      <!-- Toggle -->
      <div class="ba-seg" role="tablist" aria-label="Before and after">
        <button class="ba-btn is-active" data-m="before" role="tab" aria-selected="true">The problem</button>
        <button class="ba-btn" data-m="after" role="tab" aria-selected="false">How we fix it</button>
      </div>

      <p id="ba-eye" class="ba-fade mt-9 text-xs font-bold uppercase tracking-[0.16em]" style="color:#00e5a0">What happens now</p>
      <h1 id="ba-title" class="ba-fade mt-3 font-display text-4xl font-extrabold leading-[1.05] tracking-tight text-white md:text-6xl">98 of 100 just leave</h1>
      <p id="ba-sub" class="ba-fade mx-auto mt-5 max-w-xl text-lg leading-relaxed" style="color:#9fb0c4">You paid for every click. They browse your shop, then vanish — no name, no number, no way to follow up.</p>

      <div id="ba-grid" class="mx-auto mt-10 grid max-w-[360px] gap-[4px]" style="grid-template-columns:repeat(10,1fr)"></div>

      <p id="ba-cap" class="ba-fade mt-5 text-sm" style="color:#64748b">Only about 2 of 100 ever fill out a form.</p>

      <a
        href={DEMO}
        class="mt-10 inline-flex items-center justify-center gap-2 rounded-full px-7 py-3.5 text-sm font-bold uppercase tracking-[0.14em] transition-all hover:-translate-y-0.5"
        style="background:#00e5a0;color:#06281f"
      >
        See it work on you
      </a>
      <p class="mt-4 text-xs" style="color:#64748b">$7 a lead — exclusive, never resold.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .ba-seg { display:inline-flex; background:#0e1d33; border:1px solid rgba(255,255,255,0.08); border-radius:999px; padding:5px; }
  .ba-btn { appearance:none; border:none; background:transparent; color:#9fb0c4; font-size:14px; font-weight:700; padding:10px 22px; border-radius:999px; cursor:pointer; transition:color .2s ease, background .2s ease; }
  .ba-btn.is-active { background:#00e5a0; color:#06281f; }
  .ba-fade { transition:opacity .25s ease; }
  #ba-grid .pdot { width:100%; aspect-ratio:1; display:block; fill:#22304a; transition:fill .35s ease; }
  #ba-grid .pdot.on { fill:#00e5a0; }
</style>

<script>
  const PERSON =
    '<svg class="pdot" viewBox="0 0 24 24"><path d="M12 12a5 5 0 100-10 5 5 0 000 10zm0 2c-5 0-9 2.5-9 6v2h18v-2c0-3.5-4-6-9-6z"/></svg>';
  const COPY = {
    before: {
      eye: "What happens now",
      title: "98 of 100 just leave",
      sub: "You paid for every click. They browse your shop, then vanish — no name, no number, no way to follow up.",
      cap: "Only about 2 of 100 ever fill out a form.",
      n: 2,
    },
    after: {
      eye: "With Consent Resolve",
      title: "Now they come back",
      sub: "The visitors who consent return as named, exclusive leads — real name and email, yours alone.",
      cap: "Illustrative · $7 a lead, never resold.",
      n: 37,
    },
  };

  const grid = document.getElementById("ba-grid");
  const dots = [];
  for (let i = 0; i < 100; i++) {
    const span = document.createElement("span");
    span.innerHTML = PERSON;
    grid.appendChild(span);
    dots.push(span.firstChild);
  }
  const eye = document.getElementById("ba-eye");
  const title = document.getElementById("ba-title");
  const sub = document.getElementById("ba-sub");
  const cap = document.getElementById("ba-cap");
  let timers = [];

  function render(mode) {
    const c = COPY[mode];
    [eye, title, sub, cap].forEach((e) => (e.style.opacity = "0"));
    timers.forEach(clearTimeout);
    timers = [];
    setTimeout(() => {
      eye.textContent = c.eye;
      title.textContent = c.title;
      sub.textContent = c.sub;
      cap.textContent = c.cap;
      [eye, title, sub, cap].forEach((e) => (e.style.opacity = "1"));
    }, 250);
    dots.forEach((d) => d.classList.remove("on"));
    for (let k = 0; k < c.n; k++) {
      const idx = (k * 37) % 100;
      timers.push(setTimeout(() => dots[idx].classList.add("on"), 300 + k * 40));
    }
  }

  document.querySelectorAll(".ba-btn").forEach((b) => {
    b.addEventListener("click", () => {
      document.querySelectorAll(".ba-btn").forEach((x) => {
        x.classList.remove("is-active");
        x.setAttribute("aria-selected", "false");
      });
      b.classList.add("is-active");
      b.setAttribute("aria-selected", "true");
      render(b.getAttribute("data-m"));
    });
  });

  render("before");
</script>
