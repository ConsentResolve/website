---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Badge from "~/components/ui/Badge.astro";
import { breadcrumbSchema } from "~/lib/seo";

const schemas = [
  breadcrumbSchema([
    { name: "Home", href: "/" },
    { name: "Privacy Policy", href: "/privacy-policy/" },
  ]),
];
---

<BaseLayout
  title="Privacy Policy | Consent Resolve"
  description="The Consent Resolve Privacy Policy is being finalized and will be published here shortly."
  schema={schemas}
  noindex={true}
>
  <section class="container-content section">
    <div class="mx-auto max-w-xl py-24 text-center">
      <div class="mb-7 flex justify-center"><Badge tone="brand" variant="soft" size="md" uppercase>Privacy</Badge></div>
      <h1 class="display-1 text-[color:var(--color-ink)]">Coming Soon</h1>
      <p class="mt-5 text-lg leading-relaxed text-[color:var(--color-ink-2)]">
        Our Privacy Policy is being finalized and will be published here shortly. Questions in the meantime? Email
        <a class="font-semibold text-[color:var(--color-brand-pressed)] hover:underline" href="mailto:hello@consentresolve.com">hello@consentresolve.com</a>.
      </p>
    </div>
  </section>
</BaseLayout>
