{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "consentresolve2",
  "compatibility_date": "2024-12-01",
  // Worker entry handles /api/* (live demo). All other requests fall through to
  // the static Astro build via the ASSETS binding (asset-first by default), so
  // the marketing site is served exactly as before.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS"
  },
  // ── Live demo D1 ──────────────────────────────────────────────────────────
  // Make sure the schema is applied to this database before relying on the API:
  //   worker/schema.sql  (or paste it into the dashboard D1 console).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "consentresolve-demo",
      "database_id": "0ff8ca94-606b-4c17-8549-59fe155b3126"
    }
  ],
  //
  // Non-secret config. Secrets (RESEND_API_KEY, TURNSTILE_SECRET,
  // SALES_WEBHOOK_URL, TEAM_NOTIFY_URL) are set via `wrangler secret put` or the
  // dashboard — never commit them.
  "vars": {
    "FROM_EMAIL": "demo@consentresolve.com",
    "REPLY_TO": "sales@consentresolve.com",
    "EMAIL_MODE": "owner",
    "SAMPLE_PATH": "/demo/sample/",
    "CONSENT_TEXT_VERSION": "v1-2026-06",
    "ALLOWED_ORIGINS": "https://consentresolve.com,https://www.consentresolve.com"
  }
}
